apz.app.AadhaarDetails.toggleAddressRadios = function() {
    let rows = document.querySelectorAll(".addr-body-row");
    if (!rows.length) return;
    let isBM = gApzCOB?.LoggedInUserDetails?.loginResponse?.addInfo1 === 'BM';
    let wrappers = inSessionStore?.addressDetailsWrapperList?.[0]?.addressDetailsList || gApzCOB?.requestNodes?.addressDetailsWrapperList?.[0]
        ?.addressDetailsList || [];
    let custList = inSessionStore?.customerDetailsList || gApzCOB?.requestNodes?.customerDetailsList || [];
    let applicantWrapper = custList.find(c => c.customerType === "Applicant");
    let coApplicantWrapper = custList.find(c => c.customerType === "Co-App");
    let appCustDtlId = applicantWrapper?.custDtlId || gApzCOB?.userDetails?.custDtlId;
    let coAppCustDtlId = coApplicantWrapper?.custDtlId || gApzCOB?.userDetails?.CoApplicantCustomerId;
    let applicantPersonal = appCustDtlId ? wrappers.find(w => w.addressType === "Personal" && String(w.custDtlId) === String(appCustDtlId)) :
    null;
    let coApplicantPersonal = coAppCustDtlId ? wrappers.find(w => w.addressType === "Personal" && String(w.custDtlId) === String(
        coAppCustDtlId)) : null;
    // Aadhaar checks
    let applicantHasAadhaar = applicantPersonal?.payload?.addressList?.some(a => a.addressType === "SecondaryKyc" && a.addressLine1) || false;
    if (!applicantHasAadhaar && gApzCOB.currentApplicant === 1) {
        let live = apz.app.AadhaarDetails.getAadhaarAddrFromFields();
        if (live.addressLine1?.trim()) applicantHasAadhaar = true;
    }
    let coApplicantHasAadhaar = coApplicantPersonal?.payload?.addressList?.some(a => a.addressType === "SecondaryKyc" && a.addressLine1) || false;
    if (gApzCOB.currentApplicant === 2) {
        let live = apz.app.AadhaarDetails.getAadhaarAddrFromFields();
        if (live.addressLine1?.trim()) coApplicantHasAadhaar = true;
    }
    let checkedRow = null;
    rows.forEach((row, index) => {
        let rowNumber = index + 1;
        let radios = row.querySelectorAll("input[type='radio']");
        let disable = false;
        if (rowNumber === 3) disable = !applicantHasAadhaar;
        else if (rowNumber === 4) disable = !coApplicantHasAadhaar;
        radios.forEach(r => {
            if (r.checked) checkedRow = row;
            r.disabled = disable;
            r.closest(".addr-cell")?.classList.toggle("aadhar-radio-disable", disable);
            if (disable && !isBM) r.checked = false;
        });
    });
};
apz.app.AadhaarDetails.toggleAddressRadiosForBM = function() {
    let isBM = gApzCOB?.LoggedInUserDetails?.loginResponse?.addInfo1 === 'BM';
    if (isBM) {
        let rows = document.querySelectorAll(".addr-body-row");
        rows.forEach(row => {
            const radios = row.querySelectorAll("input[type='radio']");
            let hasChecked = false;
            radios.forEach(r => {
                if(r.checked) hasChecked = true;
                r.disabled = true;
                r.closest(".addr-cell")?.classList.toggle("aadhar-radio-disable", true);
            });
            if (!hasChecked) {
                row.classList.add('sno');
            } else {
                row.classList.remove('sno');
            }
        });
    }
}
apz.app.AadhaarDetails.clearScreenFields = function() {
    let $screen = $("#scr__" + AadhaarScrId + "main");
    if (!$screen.length) return;
    $screen.find("input, select, textarea").each(function() {
        if (this.type === "radio" || this.type === "checkbox") {
            this.checked = false;
            return;
        }
        if (this.tagName === "SELECT") {
            this.selectedIndex = 0;
            $(this).trigger("change");
            return;
        }
        if (this.type === "text" && this.hasAttribute("readonly")) {
            this.value = PleaseSelect;
            return;
        }
        this.value = "";
    });
    // ── RE-APPLY DEFAULTS after clear ──
    let p = AadhaarScrId;
    document.querySelectorAll(`[name="${p}typeHouse_"]`).forEach(r => {
        r.checked = (r.value === "HouType2");
    });
    apz.app.otherAddressState.present = false;
    apz.app.otherAddressState.permanent = false;
    const presentSection = document.querySelector('.other-present-details');
    const permanentSection = document.querySelector('.other-permanent-details');
    if (presentSection) presentSection.style.display = 'none';
    if (permanentSection) permanentSection.style.display = 'none';
};
apz.app.AadhaarDetails.onChangeResStability = function(pthis) {
    var cityValue = $("#" + AadhaarScrId + "A_residence_stabilit_present_city").val();
    var resValue = $("#" + AadhaarScrId + "A_residence_stability").val();
    var cityIndex = resYr.indexOf(cityValue);
    var resIndex = resYr.indexOf(resValue);
    if ((resIndex != 0 && resIndex < 3) || (cityIndex != 0 && cityIndex < 3)) {
        ApzCOB.fnDisplayMsg(ApzCOB.getDescfromLitCode("LIT_RESIDENTIAL_STABILITY_TWO_YR_ERR"), "E");
        $(pthis).val(PleaseSelect);
        $(`#${pthis.id}_div`).find('li').removeClass('is-selected hilt').first().addClass('is-selected hilt');
    } else if (cityIndex === 0 || resIndex === 0) {
        // do nothing
    } else if (resYr.indexOf(resValue) > resYr.indexOf(cityValue)) {
        ApzCOB.fnDisplayMsg(ApzCOB.getDescfromLitCode("LIT_RESIDENTIAL_STABILITY_ERR"), "E");
        $(pthis).val(PleaseSelect);
        $(`#${pthis.id}_div`).find('li').removeClass('is-selected hilt').first().addClass('is-selected hilt');
    }
};
// ADDRESS OBJECT BUILDER 
apz.app.AadhaarDetails.address = function() {
    let p = AadhaarScrId;
    let isApplicant = gApzCOB.currentApplicant === 1;
    let addressArr = [];
    let secondaryKycAddress = {
        "addressType": "SecondaryKyc",
        "addressLine1": $(`#${p}addline1`).val(),
        "addressLine2": $(`#${p}addline2`).val(),
        "addressLine3": $(`#${p}addline3`).val(),
        "pinCode": $(`#${p}addpin`).val(),
        "city": $(`#${p}aadCity`).val(),
        "district": $(`#${p}aadDistrict`).val(),
        "state": $(`#${p}aadState`).val(),
        "country": $(`#${p}aadCountry`).val(),
        "area": $(`#${p}aadArea`).val(),
        "landMark": $(`#${p}aadLandmark`).val(),
        "currentAddressProof": isApplicant ? "Applicant Aadhaar" : "Co-Applicant Aadhaar"
    };
    addressArr.push(secondaryKycAddress);
    //Co-Applicant: only SecondaryKyc is managed here.
    if (!isApplicant) {
        return addressArr;
    }
    // Applicant-only: build Present, Permanent, Communication 
    let residentialOwnership = $(`input[name="${p}residentialStatus_"]:checked`).val();
    let presentSameAs = apz.app.AadhaarDetails.getAddressSameAs("present");
    let permanentSameAs = residentialOwnership === "Own" ? presentSameAs : apz.app.AadhaarDetails.getAddressSameAs("permanent");
    let houseTypeRawCode = $(`input[name="${p}typeHouse_"]:checked`).val() || "HouType2";
    
    const codeToDisplay = {
        "HouType1": "Kuccha",
        "HouType2": "Pucca",
        "HouType3": "Semi Pucca"
    };
    let houseTypeValue = codeToDisplay[houseTypeRawCode] || "Pucca";
    let addressProofVal = '';
    if(presentSameAs !== "Other"){
        addressProofVal = sameAsMapping[presentSameAs];
    } else {
       addressProofVal = $(`#${p}addressProof`).val();
    }
    let presentAddress = {
        "addressType": "Present",
        "addressSameAs": presentSameAs,
        "addressLine1": $(`#${p}presentAddrLine1`).val(),
        "addressLine2": $(`#${p}presentAddrLine2`).val(),
        "addressLine3": $(`#${p}presentAddrLine3`).val(),
        "pinCode": $(`#${p}presentPincode`).val(),
        "city": $(`#${p}addPreCity`).val(),
        "district": $(`#${p}addPreDistrict`).val(),
        "state": $(`#${p}addPreState`).val(),
        "country": $(`#${p}addPreCountry`).val(),
        "area": $(`#${p}addPreArea`).val(),
        "landMark": $(`#${p}addPreLandmark`).val(),
        "residenceOwnership": residentialOwnership || "",
        "residenceCitySince": $(`#${p}A_residence_stabilit_present_city`).val(),
        "residenceAddressSince": $(`#${p}A_residence_stability`).val(),
        "houseType": houseTypeValue,
        "currentAddressProof": addressProofVal
    };
    addressArr.push(presentAddress);
    let permanentAddress = {
        "addressType": "Permanent",
        "addressSameAs": permanentSameAs,
        "addressLine1": $(`#${p}permanentAddrLine1`).val(),
        "addressLine2": $(`#${p}permanentAddrLine2`).val(),
        "addressLine3": $(`#${p}permanentAddrLine3`).val(),
        "pinCode": $(`#${p}permanentPincode`).val(),
        "city": $(`#${p}addPermCity`).val(),
        "district": $(`#${p}addPermDistrict`).val(),
        "state": $(`#${p}addPermState`).val(),
        "country": $(`#${p}addPermCountry`).val(),
        "area": $(`#${p}addPermArea`).val(),
        "landMark": $(`#${p}addPermLandmark`).val(),
        "currentAddressProof": $(`#${p}permanentAddressProof`).val()
    };
    addressArr.push(permanentAddress);
    let communicationAddress = {};
    if (window.selectedCommunicationAddress === "Present") {
        communicationAddress = {
            ...presentAddress,
            addressSameAs: "Present",
            addressType: "Communication"
        };
    } else /*if (window.selectedCommunicationAddress === "Permanent") */{
        communicationAddress = {
            ...permanentAddress,
            addressSameAs: "Permanent",
            addressType: "Communication"
        };
    }
    addressArr.push(communicationAddress);
    return addressArr;
};
apz.app.AadhaarDetails.createRequest = function() {
    if (window.CAPTURE_FROM_APPLICANT !== undefined && window.CAPTURE_FROM_APPLICANT !== null && apz.currentSubScreen === "documentCapture") {
        console.log("Skipping Aadhaar request rebuild during doc capture");
        return inSessionStore;
    }
    let p = AadhaarScrId;
    let isApplicant = gApzCOB.currentApplicant === 1;
    let custDtlId = isApplicant ? gApzCOB.userDetails.custDtlId : gApzCOB.userDetails.CoApplicantCustomerId;
    let customerType = isApplicant ? "Applicant" : "Co-App";
    let addressDtlsId = isApplicant ? gApzCOB.userDetails.addressDtlsId : gApzCOB.userDetails.CoApplicantAddressDtlsId;
    if (!inSessionStore.customerDetailsList) inSessionStore.customerDetailsList = [];
    if (!inSessionStore.addressDetailsWrapperList) inSessionStore.addressDetailsWrapperList = [{
        addressDetailsList: []
    }];
    if (!inSessionStore.addressDetailsWrapperList[0].addressDetailsList) inSessionStore.addressDetailsWrapperList[0].addressDetailsList = [];
    let custPayload = {
        "namePerAdhr": $(`#${p}aadharname`).val() || "",
        "aadhaarNumber": $(`#${p}aadharnum`).val() || "",
        "maritalStatus": $(`#${p}mrtsts`).val() || "",
        "fathersName": $(`#${p}fathersName`).val() || "",
        "spouseName": $(`#${p}spouseName`).val() || "",
        // "spouseKycID": $(`#${p}spouseKycID`).val() || "",
        // "spouseKycType": $(`#${p}spouseKYCType`).val() || "",
        // "spouseKycDob": $(`#${p}spouseDob`).val() || "",
        "education": $(`#${p}education`).val() || "",
        "religion": $(`#${p}religion`).val() || "",
        "caste": $(`#${p}caste`).val() || "",
        "secondaryKycId": $(`#${p}aadharnum`).val() || "",
        "secondaryKycDob": $(`#${p}aadhardob`).val() || "",
        "secondaryKycName": $(`#${p}aadharname`).val() || "",
        "secondaryKycType": "Aadhaar",
        "relationshipProof": $(`#${p}relationshipProof`).val() || ""
    };
    let existingCust = inSessionStore.customerDetailsList.find(c => String(c.custDtlId) === String(custDtlId));
    let mergedPayload = Object.assign({}, existingCust?.payload || {}, custPayload);
    let addressList = apz.app.AadhaarDetails.address();
    let custIndex = inSessionStore.customerDetailsList.findIndex(c => String(c.custDtlId) === String(custDtlId));
    if (custIndex >= 0) {
        inSessionStore.customerDetailsList[custIndex].payload = mergedPayload;
    } else {
        inSessionStore.customerDetailsList.push({
            "custDtlId": custDtlId,
            "customerType": customerType,
            "customerName": existingCust?.customerName || "",
            "mobileNumber": existingCust?.mobileNumber || "",
            "payload": mergedPayload
        });
    }
    let addrDetailsList = inSessionStore.addressDetailsWrapperList[0].addressDetailsList;
    let addrIndex = addrDetailsList.findIndex(a => String(a.custDtlId) === String(custDtlId) && a.addressType === "Personal");
    if (addrIndex >= 0) {
        let existingList = addrDetailsList[addrIndex].payload.addressList || [];
        if (isApplicant) {
            let aadhaarManagedTypes = ["Present", "Permanent", "SecondaryKyc", "Communication"];
            let preserved = existingList.filter(a => !aadhaarManagedTypes.includes(a.addressType));
            addrDetailsList[addrIndex].payload.addressList = [...preserved, ...addressList];
        } else {
            let preserved = existingList.filter(a => a.addressType !== "SecondaryKyc");
            let secKyc = addressList.find(a => a.addressType === "SecondaryKyc");
            addrDetailsList[addrIndex].payload.addressList = secKyc ? [...preserved, secKyc] : preserved;
        }
    } else {
        addrDetailsList.push({
            "addressDtlsId": addressDtlsId || "",
            "custDtlId": parseInt(custDtlId),
            "addressType": "Personal",
            "payload": {
                "addressList": addressList
            }
        });
    }
    let customerDetailsList = [{
        "custDtlId": custDtlId,
        "applicationId": gApzCOB.userDetails.applicationId,
        "customerType": customerType,
        "customerName": existingCust?.customerName || "",
        "mobileNumber": existingCust?.mobileNumber || "",
        "payload": mergedPayload
    }];
    let addressDetailsWrapperList = [{
        "addressDetailsList": [{
            "addressDtlsId": addressDtlsId || "",
            "custDtlId": parseInt(custDtlId),
            "addressType": "Personal",
            "payload": {
                "addressList": addressList
            }
        }]
    }];
    //  Save relationshipProof to applicationDocumentsWrapperList 
    let relationshipProofVal = $(`#${p}relationshipProof`).val();
    if (relationshipProofVal && relationshipProofVal !== PleaseSelect && !isApplicant) {
        if (!inSessionStore.applicationDocumentsWrapperList) {
            inSessionStore.applicationDocumentsWrapperList = [{
                applicationDocumentsList: []
            }];
        }
        if (!inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList) {
            inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList = [];
        }
        let docList = inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList;
        let existingIdx = docList.findIndex(d => d.payload?.documentType === "RELATIONSHIP_PROOF" && parseInt(d.custDtlId) === parseInt(
            custDtlId));
        let relDocObj = {
            appDocId: existingIdx >= 0 ? (docList[existingIdx].appDocId || "") : "",
            applicationId: gApzCOB.userDetails.applicationId,
            custDtlId: custDtlId,
            status: "A",
            payload: {
                documentType: "RELATIONSHIP_PROOF",
                documentName: relationshipProofVal,
                documentDesc: relationshipProofVal,
                screenId: "AadhaarDetails",
                docStatus: "A"
            }
        };
        if (existingIdx >= 0) {
            docList[existingIdx] = relDocObj;
        } else {
            docList.push(relDocObj);
        }
    }
    return {
        customerDetailsList,
        addressDetailsWrapperList,
        applicationDocumentsWrapperList: inSessionStore.applicationDocumentsWrapperList || []
    };
};
apz.app.AadhaarDetails.saveAadhaarDetails = function(skipValidation) {
    if (!skipValidation && !apz.app.AadhaarDetails.validateForm()) return;
    //sidebar status
    window._AADHAAR_PENDING_SNAPS = window._AADHAAR_PENDING_SNAPS || [];
    var _aadSnapVerified = !skipValidation && (window.isVerified === "Y");
    window._AADHAAR_PENDING_SNAPS.push({
        verified: _aadSnapVerified,
        applicantNo: gApzCOB.currentApplicant
    });
    try {
        var _aadOptNo = gApzCOB.currentApplicant;
        apz.app.Kmbase.markStageStatus("AadhaarDetails", _aadOptNo, _aadSnapVerified);
    } catch (e) {
        ApzCOB.traceFrontEndError(e,"");
    }
    let requestBody = apz.app.AadhaarDetails.createRequest();
    let secondaryKycType = "",
        secondaryKycId = "",
        alternateVoterId = "";
    if (!apz.isNull(inSessionStore.customerDetailsList)) {
        let applicantCustomerData = inSessionStore.customerDetailsList.find(cust => cust.customerType === "Applicant");
        if (!apz.isNull(applicantCustomerData)) {
            secondaryKycType = applicantCustomerData.payload.secondaryKycType;
            secondaryKycId = applicantCustomerData.payload.secondaryKycId;
            alternateVoterId = applicantCustomerData.payload.alternateVoterId;
        }
    }
    let isCoApp = gApzCOB.currentApplicant > 1;
    let custDtlId = isCoApp ? (gApzCOB.userDetails.CoApplicantCustomerId || "") : gApzCOB.userDetails.custDtlId;
    let addressDtlsId = isCoApp ? (parseInt(gApzCOB.userDetails.CoApplicantAddressDtlsId) || "") : gApzCOB.userDetails.addressDtlsId;
    let role = '';
    if (gApzCOB.LoggedInUserDetails.loginResponse.addInfo1 == 'BM') {
        role = gApzCOB.LoggedInUserDetails.loginResponse.addInfo1;
    }
    let req = {
        apiRequest: {
            interfaceName: "CreateLoan",
            appId: gAppId,
            userId: gApzCOB.LoggedInUserDetails.loginResponse.userDet.id,
            requestObj: {
                "isNewSourcing": "Y",
                "isStageVerified": isVerified,
                "appId": gApzCOB.userDetails.appId,
                "applicationId": gApzCOB.userDetails.applicationId,
                "versionNum": window.versionNum,
                "isExistingCustomer": "",
                "customerDetailsList": requestBody.customerDetailsList,
                "addressDetailsWrapperList": requestBody.addressDetailsWrapperList,
                "applicationDocumentsWrapperList": requestBody.applicationDocumentsWrapperList || [],
                "applicationMaster": {
                    "appId": gApzCOB.userDetails.appId,
                    "applicationId": gApzCOB.userDetails.applicationId,
                    "applicationType": "online",
                    "createdBy": gApzCOB.LoggedInUserDetails.loginResponse.userDet.id,
                    "currentScreenId": "AadhaarDetails",
                    "currentStageNo": 2,
                    "custDtlId": custDtlId,
                    "addressDtlsId": addressDtlsId,
                    "customerId": ApplicationType === "OpenMarket" || ApplicationType === "Vishesh" ? null : gApzCOB.userDetails.customerId,
                    "declarationFlag": gApzCOB.userDetails.declarationFlag,
                    "mobileNumber": !apz.isNull(gApzCOB.userDetails.mobileNum) ? gApzCOB.userDetails.mobileNum : null,
                    "productCode": apz.isNull(gApzCOB.productCode) ? '1009' : gApzCOB.productCode,
                    "productGroupCode": gApzCOB.product,
                    "searchCode1": gApzCOB.selLeadDtls.kendraId,
                    "searchCode2": gApzCOB.selLeadDtls.customerId,
                    "custDtlSlNum": gApzCOB.currentApplicant,
                    "applicantsCount": gApzCOB.noOfApplicants,
                    "mainProductGroupCode": gApzCOB.mainProductGroupCode,
                    "kendraId": gApzCOB.selLeadDtls.kendraId,
                    "kendraName": gApzCOB.selLeadDtls.kendraName,
                    "branchId": gApzCOB.selLeadDtls.glBranchId,
                    "branchName": gApzCOB.selLeadDtls.glBranchName,
                    "memberId": gApzCOB.selLeadDtls.customerId,
                    "primaryKycType": "Voter ID",
                    "primaryKycId": gApzCOB.selLeadDtls.primaryKyc,
                    "secondaryKycType": secondaryKycType,
                    "secondaryKycId": secondaryKycId,
                    "workitemNo": ProductData[0].productCode === "1001"
                                    ? String(gApzCOB.selLeadDtls.referenceId || gApzCOB.selLeadDtls.openMarketId)
                                    : gApzCOB.selLeadDtls.pid,
                    "alternateVoterId": alternateVoterId
                },
                "workflow": {
                    "currentRole": role
                }
            }
        }
    };
    if(["BMPUSHBACK", "IPUSHBACK", "CAPUSHBACK"].includes(window.ApplicationStatus)){
        req.apiRequest.requestObj.queryResponse = apz.app.Kmbase.prepareQueryResponse();
    }
    apz.startLoader();
    setTimeout(() => {
        ApzCOB.serverBuildParam(gAppId, "CreateLoan", "N", "N", req, false, apz.app.AadhaarDetails.saveAadhaarDetailsCB);
    }, 1000);
};
apz.app.AadhaarDetails.saveAadhaarDetailsCB = function(params) {
    apz.stopLoader();
    try {
        if (ApzCOB.handleServiceCallBacks(params)) {
            let savedStages = (inSessionStore.srcVerifiedStages || []).slice();
            let savedCustomerDetailsList = JSON.parse(JSON.stringify(inSessionStore.customerDetailsList || []));
            let savedAddressDetailsWrapperList = JSON.parse(JSON.stringify(inSessionStore.addressDetailsWrapperList || []));
            ApzCOB.updateInsessionData(params);
            let ifaceName = ApzCOB.GetInterfaceResMap(params);
            let response = JSON.parse(params.res[ifaceName].apiResponse.ResponseBody.responseObj);
            if (response?.hasOwnProperty("applicationId")) {
                gApzCOB.userDetails.applicationId = response.applicationId;
            }
            let serverStages = inSessionStore.srcVerifiedStages || [];
            let mergedStages = savedStages.slice();
            serverStages.forEach(function(serverEntry) {
                let keyBase = serverEntry.split('_').slice(0, 2).join('_') + '_';
                let alreadyHave = mergedStages.some(function(s) {
                    return s.indexOf(keyBase) === 0;
                });
                if (!alreadyHave) {
                    mergedStages.push(serverEntry);
                }
            });
            inSessionStore.srcVerifiedStages = mergedStages;
            apz.app.Kmbase.paintSidebarStatus();
            if (savedCustomerDetailsList.length > 0) {
                let updatedList = inSessionStore.customerDetailsList || [];
                savedCustomerDetailsList.forEach(function(savedEntry) {
                    let match = updatedList.find(function(e) {
                        return String(e.custDtlId) === String(savedEntry.custDtlId);
                    });
                    if (!match || !match.payload || Object.keys(match.payload).length === 0) {
                        if (match) {
                            match.payload = savedEntry.payload;
                        } else {
                            updatedList.push(savedEntry);
                        }
                    } else {
                        match.payload = Object.assign({}, savedEntry.payload, match.payload);
                    }
                });
                inSessionStore.customerDetailsList = updatedList;
            }
            if (savedAddressDetailsWrapperList.length > 0) {
                if (!inSessionStore.addressDetailsWrapperList || inSessionStore.addressDetailsWrapperList.length === 0) {
                    inSessionStore.addressDetailsWrapperList = savedAddressDetailsWrapperList;
                } else {
                    let savedAddrList = savedAddressDetailsWrapperList[0]?.addressDetailsList || [];
                    let updatedAddrList = inSessionStore.addressDetailsWrapperList[0].addressDetailsList || [];
                    savedAddrList.forEach(function(savedWrapper) {
                        let match = updatedAddrList.find(function(w) {
                            return String(w.custDtlId) === String(savedWrapper.custDtlId) && w.addressType === savedWrapper
                                .addressType;
                        });
                        if (!match || !match.payload || !match.payload.addressList || match.payload.addressList.length === 0) {
                            if (match) {
                                match.payload = savedWrapper.payload;
                            } else {
                                updatedAddrList.push(savedWrapper);
                            }
                        } else {
                            // Merge address entries — preserve saved entries the server didn't return
                            let serverAddrList = match.payload.addressList;
                            let savedAddrEntries = savedWrapper.payload.addressList || [];
                            savedAddrEntries.forEach(function(savedAddr) {
                                let serverMatch = serverAddrList.find(function(a) {
                                    return a.addressType === savedAddr.addressType;
                                });
                                if (!serverMatch || !serverMatch.addressLine1) {
                                    if (serverMatch) {
                                        Object.assign(serverMatch, savedAddr);
                                    } else {
                                        serverAddrList.push(savedAddr);
                                    }
                                }
                            });
                        }
                    });
                    inSessionStore.addressDetailsWrapperList[0].addressDetailsList = updatedAddrList;
                }
            }
            // Sync Aadhaar Present address → CBcheck Present address for applicant
            try {
                let appCustDtlId = gApzCOB.userDetails.custDtlId;
                let addrRoot = inSessionStore?.addressDetailsWrapperList?.[0]?.addressDetailsList || [];
                let appPersonal = addrRoot.find(w => w.addressType === "Personal" && String(w.custDtlId) === String(appCustDtlId));
                if (appPersonal?.payload?.addressList) {
                    let aadhaarPresent = appPersonal.payload.addressList.find(a => a.addressType === "Present");
                    if (aadhaarPresent && aadhaarPresent.addressLine1 && aadhaarPresent.addressLine1.trim() !== "") {
                        // Update CBcheck Present address with the same data
                        let cbPresent = appPersonal.payload.addressList.find(a => a.addressType === "Present");
                        if (cbPresent) {
                            cbPresent.addressLine1 = aadhaarPresent.addressLine1;
                            cbPresent.addressLine2 = aadhaarPresent.addressLine2 || "";
                            cbPresent.addressLine3 = aadhaarPresent.addressLine3 || "";
                            cbPresent.pinCode = aadhaarPresent.pinCode || "";
                            cbPresent.city = aadhaarPresent.city || "";
                            cbPresent.district = aadhaarPresent.district || "";
                            cbPresent.state = aadhaarPresent.state || "";
                            cbPresent.country = aadhaarPresent.country || "";
                            cbPresent.area = aadhaarPresent.area || "";
                            cbPresent.landMark = aadhaarPresent.landMark || "";
                        }
                    }
                }
            } catch (e) {
                ApzCOB.traceFrontEndError(e,"");
            }
            // Mark sidebar status using the pre-save snapshot
            try {
                var snaps = window._AADHAAR_PENDING_SNAPS || [];
                var snap = snaps.shift();
                if (snap) {
                    apz.app.Kmbase.markStageStatus("AadhaarDetails", snap.applicantNo, snap.verified);
                }
            } catch (e) {
                ApzCOB.traceFrontEndError(e,"");
            }
            // SAVE DRAFT 
            window.AADHAAR_SAVE_DRAFT = false;
            if (window.AADHAAR_EXPLICIT_DRAFT) {
                window.AADHAAR_EXPLICIT_DRAFT = false;
                window._AFTER_DRAFT_SAVE = null;
                ApzCOB.fnDisplayMsg("Draft saved successfully", "S");
                return;
            }
            //Partial save (tab switch / confirmNavigate) 
            if (typeof window._AFTER_DRAFT_SAVE === "function") {
                let fn = window._AFTER_DRAFT_SAVE;
                window._AFTER_DRAFT_SAVE = null;
                fn();
                return;
            }
            // BACK navigation
            if (window.AADHAAR_BACK_NAV) {
                window.AADHAAR_BACK_NAV = false;
                window.AADHAAR_SAVE_DRAFT = false;
                window.AADHAAR_EXPLICIT_DRAFT = false;
                let backFrom = window.AADHAAR_BACK_FROM_APPLICANT || gApzCOB.currentApplicant;
                window.AADHAAR_BACK_FROM_APPLICANT = null;
                if (backFrom === 1) {
                    window.CBCHECK_TAB_SWITCH_TARGET = 'CoApplicant';
                    ApzCOB.launchSubScreen("CBcheck", "KmSourc__Kmbase__KMLaunchCol", "");
                    $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
                    $(`#${kmbaseScr}CBcheck_hyp`).addClass('active');
                    $(`#${kmbaseScr}CoAppCBcheck_hyp`).addClass('active');
                } else {
                    let tabs = $('.aadhaarSubMenu');
                    apz.app.AadhaarDetails._doTabSwitch(tabs.eq(0), 'Applicant');
                }
                return;
            }
            // Sidebar tab switch (manual sidebar click)
            if (window.AADHAAR_TAB_SWITCH_TARGET) {
                let target = window.AADHAAR_TAB_SWITCH_TARGET;
                window.AADHAAR_TAB_SWITCH_TARGET = null;
                let tabs = $('.aadhaarSubMenu');
                if (target === 'CoApplicant' && tabs.length > 1) {
                    apz.app.AadhaarDetails._doTabSwitch(tabs.eq(1), 'CoApplicant');
                } else {
                    apz.app.AadhaarDetails._doTabSwitch(tabs.eq(0), 'Applicant');
                }
                return;
            }
            // Normal forward navigation (Next button)
            if (gApzCOB.currentApplicant === 1) {
                let tabs = $('.aadhaarSubMenu');
                if (tabs.length > 1) {
                    apz.app.AadhaarDetails._doTabSwitch(tabs.eq(1), 'CoApplicant');
                    $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
                    $(`#${kmbaseScr}AadhaarDetails_hyp`).addClass('active');
                    $(`#${kmbaseScr}CoAppAadhaarDetails_hyp`).addClass('active');
                } else {
                    ApzCOB.launchSubScreen("BusinessIncome", "KmSourc__Kmbase__KMLaunchCol", "");
                    $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
                    $(`#${kmbaseScr}BusinessIncome_hyp`).addClass('active');
                }
            } else {
                ApzCOB.launchSubScreen("BusinessIncome", "KmSourc__Kmbase__KMLaunchCol", "");
                $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
                $(`#${kmbaseScr}BusinessIncome_hyp`).addClass('active');
            }
        } else {
            ApzCOB.fnDisplayMsg("Failed to save Aadhaar details", "E");
        }
    } catch (e) {
        ApzCOB.traceFrontEndError(e,"");
        apz.stopLoader();
        ApzCOB.fnDisplayMsg(ApzCOB.getDescfromLitCode("LIT_COMM_ERR_TXT_TECHNICAL"), "E");
    }
};
apz.app.AadhaarDetails.getAddressSameAs = function(column) {
    let rows = document.querySelectorAll(".addr-body-row");
    let selectedRowIndex = -1;
    rows.forEach((row, index) => {
        const cells = row.children;
        const colIndex = column === "present" ? 1 : 2;
        const cell = cells[colIndex];
        if (!cell) return;
        const radio = cell.querySelector("input[type='radio']");
        if (radio && radio.checked) selectedRowIndex = index + 1;
    });
    const rowToSameAs = {
        1: "ApplicantVoter",
        2: "Co-AppVoter",
        3: "ApplicantSecondaryKyc",
        4: "Co-AppSecondaryKyc",
        5: "Other"
    };
    return rowToSameAs[selectedRowIndex] || "";
};

function checkRowRadio(rowIndex, colIndex) {
    let rows = Array.from(document.querySelectorAll('.addr-body-row'))
        .filter(row => row.id.startsWith('KmSourc__AadhaarDetails'));
    // Clear all radios in that column first
    rows.forEach(row => {
        let cell = row.children[colIndex];
        let radio = cell?.querySelector("input[type='radio']");
        if (radio) radio.checked = false;
    });
    let targetRow = rows[rowIndex - 1];
    if (!targetRow) return;
    let cell = targetRow.children[colIndex];
    let radio = cell?.querySelector("input[type='radio']");
    if (radio && !radio.disabled) {
        radio.checked = true;
        apz.app.handleColumnRadio(radio);
    }
}
apz.app.AadhaarDetails.prePopulateAll = function() {
    let p = AadhaarScrId;
    let custType = gApzCOB.currentApplicant === 1 ? "Applicant" : "Co-App";
    // Always clear screen before repainting so stale values 
    apz.app.AadhaarDetails.clearScreenFields();
    let customerList = inSessionStore?.customerDetailsList || gApzCOB?.requestNodes?.customerDetailsList;
    let addressWrapperRoot = inSessionStore?.addressDetailsWrapperList || gApzCOB?.requestNodes?.addressDetailsWrapperList;
    let custWrapper = customerList?.find(c => c.customerType === custType);
    let addrList = null;
    if (custWrapper) {
        let wrappers = addressWrapperRoot?.[0]?.addressDetailsList || addressWrapperRoot;
        let personalWrapper = wrappers?.find(w => w.addressType === "Personal" && String(w.custDtlId) === String(custWrapper.custDtlId));
        addrList = personalWrapper?.payload?.addressList;
    }
    let freshCase = apz.app.AadhaarDetails.isFreshCase();
    if (freshCase) {
        // FRESH CASE 
        apz.app.AadhaarDetails.paintFromFresh(p, custWrapper, addrList);
    } else {
        // BACK NAV / EDIT CASE
        if (custWrapper && addrList?.length) {
            apz.app.AadhaarDetails.paintFromSession(custWrapper, addrList, p);
        }
    }
    apz.app.AadhaarDetails.cleanOrphanedAddressProofDocs();
    apz.app.AadhaarDetails.toggleAddressRadios();
};
apz.app.AadhaarDetails.paintFromFresh = function(p, custWrapper, addrList) {
    // Resolve lead data based on customer type
    let isApplicant = gApzCOB.currentApplicant === 1;
    let lead = null;
    if (isApplicant) {
        lead = gApzCOB.selLeadDtls;
    } else {
        let leadCustomerList = gApzCOB.selLeadDtls?.customerDetailsList || inSessionStore?.leadDetails?.customerDetailsList || [];
        let coAppLead = leadCustomerList.find(c => c.customerType === "Co-App" || c.customerType === "CoApplicant" || c.customerType ===
            "CO_APPLICANT");
        lead = coAppLead || null;
    }
    if (lead) {
        let marital = lead.maritalStatus ? ApzCOB.capitalize(lead.maritalStatus.trim()) : PleaseSelect;
        $("#" + p + "mrtsts").val(marital).trigger("change");
        if (marital && marital !== PleaseSelect) {
            apz.app.AadhaarDetails.maritalStatusOnChange(marital);
        }
        let fatherName = (!lead.fathersName || lead.fathersName === "NULL") ? "" : lead.fathersName;
        let spouseName = (!lead.spouseName || lead.spouseName === "NULL") ? "" : lead.spouseName;
        $("#" + p + "fathersName").val(fatherName);
        $("#" + p + "spouseName").val(spouseName);
    }
    let defaultHouseType = "HouType2";
    document.querySelectorAll(`[name="${p}typeHouse_"]`).forEach(r => {
        r.checked = (r.value === defaultHouseType);
        if (r.checked) {
            r.dispatchEvent(new Event('change', {
                bubbles: true
            }));
        }
    });
    if (!isApplicant) {
        let coAppCust = inSessionStore?.customerDetailsList?.find(c => c.customerType === "Co-App");
        let relation = coAppCust?.payload?.relationShipWithApplicant || lead?.relationShipWithApplicant || "";
        if (relation && relation !== PleaseSelect) {
            $("#" + p + "relationApplicant").val(relation);
        }
    }
    let ownRadio = document.querySelector(`[name="${p}residentialStatus_"][value="Own"]`);
    if (ownRadio) {
        ownRadio.checked = true;
        apz.app.handleAddressType(ownRadio);
    }
    apz.app.AadhaarDetails.toggleAddressRadios();
    //Address table: default radios 
    checkRowRadio(1, 1);
    checkRowRadio(1, 2);
    let custListFresh = inSessionStore?.customerDetailsList || [];
    let custDtlIdFresh = custWrapper?.custDtlId || (isApplicant ? gApzCOB?.userDetails?.custDtlId : gApzCOB?.userDetails?.CoApplicantCustomerId);
    let custEntryFresh = custListFresh.find(c => String(c.custDtlId) === String(custDtlIdFresh));
    if (custEntryFresh?.payload) {
        let cp = custEntryFresh.payload;
        if (cp.secondaryKycName) $("#" + p + "aadharname").val(cp.secondaryKycName);
        if (cp.secondaryKycId) $("#" + p + "aadharnum").val(cp.secondaryKycId);
        if (cp.secondaryKycDob) $("#" + p + "aadhardob").val(ApzCOB.convertDateFormat(cp.secondaryKycDob, 'dd/mm/yyyy'));
    }
    let secondaryKycFresh = addrList?.find(a => a.addressType === "SecondaryKyc");
    if (secondaryKycFresh && secondaryKycFresh.addressLine1) {
        $("#" + p + "addline1").val(secondaryKycFresh.addressLine1 || "");
        $("#" + p + "addline2").val(secondaryKycFresh.addressLine2 || "");
        $("#" + p + "addline3").val(secondaryKycFresh.addressLine3 || "");
        $("#" + p + "addpin").val(secondaryKycFresh.pinCode || "");
        $("#" + p + "aadCity").val(secondaryKycFresh.city || "").trigger("change");
        $("#" + p + "aadDistrict").val(secondaryKycFresh.district || "").trigger("change");
        $("#" + p + "aadState").val(secondaryKycFresh.state || "").trigger("change");
        $("#" + p + "aadCountry").val(secondaryKycFresh.country || "").trigger("change");
        $("#" + p + "aadArea").val(secondaryKycFresh.area || "");
        $("#" + p + "aadLandmark").val(secondaryKycFresh.landMark || "");
        //reveal Aadhaar details section since data exists
        $("#" + p + "aadharDetails").removeClass('sno');
        $("#" + p + "captureAadhaar").removeClass('btm-seperator');
    }
    //  "Other" auto-detection — only for truly fresh cases with no sameAs saved
    if (custWrapper && addrList?.length) {
        let custDtlId = custWrapper.custDtlId;
        let voterAddr = apz.app.AadhaarDetails.getVoterAddrFromSession(custDtlId);
        let presentAddr = apz.app.AadhaarDetails.getPresentAddrFromSession(custDtlId);
        // Only auto-select Other if present has no sameAs (truly fresh/unset)
        let hasSameAs = presentAddr?.addressSameAs && presentAddr.addressSameAs !== "" && presentAddr.addressSameAs !== "Other";
        if (presentAddr && voterAddr && !apz.app.AadhaarDetails.addrEqual(presentAddr, voterAddr) && !hasSameAs) {
            apz.app.AadhaarDetails._selectOtherPresentRow();
            apz.app.AadhaarDetails.prefillOtherPresentFields(p, presentAddr);
        } else if (presentAddr && hasSameAs) {
            // Restore the correct row based on saved sameAs
            const sameAsToRow = {
                "ApplicantVoter": 1,
                "Co-AppVoter": 2,
                "ApplicantSecondaryKyc": 3,
                "Co-AppSecondaryKyc": 4
            };
            let rowNum = sameAsToRow[presentAddr.addressSameAs];
            if (rowNum) checkRowRadio(rowNum, 1);
        }
    }
    // RELATIONSHIP PROOF DOC — fresh case restore
    if (gApzCOB.currentApplicant !== 1) {
        let custDtlIdFresh = custWrapper?.custDtlId || gApzCOB?.userDetails?.CoApplicantCustomerId;
        let docWrappers = inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList || gApzCOB?.requestNodes
            ?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList || [];
        let relDoc = docWrappers.find(d => d.payload?.documentType === "RELATIONSHIP_PROOF" && parseInt(d.custDtlId) === parseInt(
        custDtlIdFresh));
        let coAppCustEntry = inSessionStore?.customerDetailsList?.find(c => String(c.custDtlId) === String(custDtlIdFresh));
        let relVal = coAppCustEntry?.payload?.relationshipProof || relDoc?.payload?.documentDesc || relDoc?.payload?.documentName || (relDoc
            ?.payload?.documentFileName || "").replace(/^Relationship_/i, "").trim() || "";
        if (relVal && relVal !== PleaseSelect) {
            $("#" + p + "relationshipProof").val(relVal).trigger("change");
        }
    }
    //Paint address table
    apz.app.AadhaarDetails.paintAddressTable();
};
apz.app.AadhaarDetails._selectOtherPresentRow = function() {
    let rows = document.querySelectorAll(".addr-body-row");
    let otherRow = rows[4];
    if (!otherRow) return;
    let cell = otherRow.children[1];
    let radio = cell?.querySelector("input[type='radio']");
    if (radio && !radio.disabled) {
        // Clear all present-column radios first
        rows.forEach(r => {
            let c = r.children[1];
            let rd = c?.querySelector("input[type='radio']");
            if (rd) rd.checked = false;
        });
        radio.checked = true;
        apz.app.otherAddressState.present = true;
    }
    const presentSection = document.querySelector('.other-present-details');
    if (presentSection) presentSection.style.display = '';
};
apz.app.AadhaarDetails.prefillOtherPresentFields = function(p, addr) {
    if (!addr) return;
    $(`#${p}presentAddrLine1`).val(addr.addressLine1 || "");
    $(`#${p}presentAddrLine2`).val(addr.addressLine2 || "");
    $(`#${p}presentAddrLine3`).val(addr.addressLine3 || "");
    $(`#${p}presentPincode`).val(addr.pinCode || "");
    $(`#${p}addPreCity`).val(addr.city || "").trigger("change");
    $(`#${p}addPreDistrict`).val(addr.district || "").trigger("change");
    $(`#${p}addPreState`).val(addr.state || "").trigger("change");
    $(`#${p}addPreCountry`).val(addr.country || "").trigger("change");
    $(`#${p}addPreArea`).val(addr.area || "");
    $(`#${p}addPreLandmark`).val(addr.landMark || "");
    if (addr.currentAddressProof) {
        $(`#${p}addressProof`).val(addr.currentAddressProof).trigger("change");
    }
    // Residence stability if available
    if (addr.residenceCitySince) $(`#${p}A_residence_stabilit_present_city`).val(addr.residenceCitySince).trigger("change");
    if (addr.residenceAddressSince) $(`#${p}A_residence_stability`).val(addr.residenceAddressSince).trigger("change");
    // Residential ownership radio
    if (addr.residenceOwnership) {
        const map = {
            "Owned": "Own",
            "Own": "Own",
            "Self Owned": "Own",
            "Leased": "Rented",
            "Rented": "Rented"
        };
        let uiValue = map[addr.residenceOwnership] || addr.residenceOwnership;
        document.querySelectorAll(`[name="${AadhaarScrId}residentialStatus_"]`).forEach(r => {
            r.checked = (r.value === uiValue);
            if (r.checked) apz.app.handleAddressType(r);
        });
    }
};
apz.app.AadhaarDetails.paintFromSession = function(custWrapper, addrList, p) {
    let cust = custWrapper.payload || custWrapper;
    $("#" + p + "mrtsts").val(cust.maritalStatus || PleaseSelect).trigger("change");
    if (cust.maritalStatus && cust.maritalStatus !== PleaseSelect) {
        apz.app.AadhaarDetails.maritalStatusOnChange(cust.maritalStatus);
    }
    let lead = gApzCOB.currentApplicant === 1 ? gApzCOB.selLeadDtls : (gApzCOB.selLeadDtls?.customerDetailsList || inSessionStore?.leadDetails
        ?.customerDetailsList || []).find(c => c.customerType === "Co-App" || c.customerType === "CoApplicant" || c.customerType ===
        "CO_APPLICANT");
    let fatherVal = (cust.fathersName && cust.fathersName !== "NULL") ? cust.fathersName : (lead?.fathersName && lead.fathersName !== "NULL" ?
        lead.fathersName : "");
    let spouseVal = (cust.spouseName && cust.spouseName !== "NULL") ? cust.spouseName : (lead?.spouseName && lead.spouseName !== "NULL" ? lead
        .spouseName : "");
    $("#" + p + "fathersName").val(fatherVal);
    $("#" + p + "spouseName").val(spouseVal);
    $("#" + p + "religion").val(cust.religion || PleaseSelect).trigger("change");
    if (gApzCOB.currentApplicant == 1 && ApplicationType === "OpenMarket") {
        const religion =
            (cust.religion && cust.religion !== "Please Select")
                ? cust.religion
                : (gApzCOB?.selLeadDtls?.appReligion || "Please Select");

        $("#" + p + "religion").val(religion).trigger("change");
    };
    $("#" + p + "caste").val(cust.caste || PleaseSelect).trigger("change");
    if (gApzCOB.currentApplicant == 1 && ApplicationType === "OpenMarket") {
        let OpCaste = gApzCOB?.selLeadDtls?.appCaste === "GEN" ? "General" : gApzCOB?.selLeadDtls?.appCaste
        const caste =
            (cust.caste && cust.caste !== "Please Select")
                ? cust.caste
                : (OpCaste || "Please Select");

        $("#" + p + "caste").val(caste).trigger("change");
    };
    $("#" + p + "education").val(cust.education || PleaseSelect).trigger("change");
    if (cust.secondaryKycId) $("#" + p + "aadharnum").val(cust.secondaryKycId);
    if (cust.secondaryKycName) $("#" + p + "aadharname").val(cust.secondaryKycName);
    if (cust.secondaryKycDob) $("#" + p + "aadhardob").val(ApzCOB.convertDateFormat(cust.secondaryKycDob, 'dd/mm/yyyy'));
    let relation = cust.relationShipWithApplicant || "";
    if (relation && relation !== PleaseSelect && gApzCOB.currentApplicant !== 1) {
        $("#" + p + "relationApplicant").val(relation);
    }
    if (gApzCOB.currentApplicant !== 1) {
        let relDocRestore = (inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList || []).find(d => d.payload
            ?.documentType === "RELATIONSHIP_PROOF" && parseInt(d.custDtlId) === parseInt(custWrapper.custDtlId));
        let relValRestore = cust.relationshipProof || relDocRestore?.payload?.documentDesc || relDocRestore?.payload?.documentName || (
            relDocRestore?.payload?.documentFileName || "").replace(/^Relationship_/i, "").trim() || "";
        if (relValRestore && relValRestore !== PleaseSelect) {
            $("#" + p + "relationshipProof").val(relValRestore).trigger("change");
        }
    }
    let present = addrList.find(a => a.addressType === "Present");
    let permanent = addrList.find(a => a.addressType === "Permanent");
    let secondaryKyc = addrList.find(a => a.addressType === "SecondaryKyc");
    let communication = addrList.find(a => a.addressType === "Communication");
    let _savedCommSameAs = communication?.addressSameAs || "";
    let _savedCommRadioVal = "";
    if (_savedCommSameAs) {
        let s = _savedCommSameAs.toLowerCase();
        _savedCommRadioVal = s.includes("present") ? "presentAddr" : s.includes("permanent") ? "permanentAddr" : "";
    }
    // PRESENT ADDRESS
    if (present) {
        if (present.residenceCitySince) {
            $(`#${p}A_residence_stabilit_present_city`).val(present.residenceCitySince).trigger("change");
        }
        if (present.residenceAddressSince) {
            $(`#${p}A_residence_stability`).val(present.residenceAddressSince).trigger("change");
        }
        if (present.currentAddressProof) {
            $(`#${p}addressProof`).val(present.currentAddressProof).trigger("change");
        }
        if (present.residenceOwnership) {
            const map = {
                "Owned": "Own",
                "Own": "Own",
                "Self Owned": "Own",
                "Leased": "Rented",
                "Rented": "Rented"
            };
            let uiValue = map[present.residenceOwnership] || present.residenceOwnership;
            let matchedRadio = null;
            document.querySelectorAll(`[name="${p}residentialStatus_"]`).forEach(r => {
                r.checked = (r.value === uiValue);
                if (r.checked) matchedRadio = r;
            });
            if (matchedRadio) apz.app.handleAddressType(matchedRadio);
        } else {
            let ownRadio = document.querySelector(`[name="${p}residentialStatus_"][value="Own"]`);
            if (ownRadio) {
                ownRadio.checked = true;
                apz.app.handleAddressType(ownRadio);
            }
        }
        // House type radio — fire change only once on the checked element
        if (present.houseType) {
            const displayToCode = {
                "Kuccha": "HouType1",
                "Pucca": "HouType2",
                "Semi Pucca": "HouType3",
                "HouType1": "HouType1",
                "HouType2": "HouType2",
                "HouType3": "HouType3"
            };
            let radioCode = displayToCode[present.houseType] || "HouType2";
            let checkedHouseRadio = null;
            document.querySelectorAll(`[name="${p}typeHouse_"]`).forEach(r => {
                r.checked = (r.value === radioCode);
                if (r.checked) checkedHouseRadio = r;
            });
            if (checkedHouseRadio) checkedHouseRadio.dispatchEvent(new Event('change', {
                bubbles: true
            }));
        } else {
            let defaultRadio = document.querySelector(`[name="${p}typeHouse_"][value="HouType2"]`);
            if (defaultRadio) {
                defaultRadio.checked = true;
                defaultRadio.dispatchEvent(new Event('change', {
                    bubbles: true
                }));
            }
        }
        // Present address row selection
        if (present.addressSameAs === "Other") {
            $(`#${p}presentAddrLine1`).val(present.addressLine1 || "");
            $(`#${p}presentAddrLine2`).val(present.addressLine2 || "");
            $(`#${p}presentAddrLine3`).val(present.addressLine3 || "");
            $(`#${p}presentPincode`).val(present.pinCode || "");
            $(`#${p}addPreCity`).val(present.city || "").trigger("change");
            $(`#${p}addPreDistrict`).val(present.district || "").trigger("change");
            $(`#${p}addPreState`).val(present.state || "").trigger("change");
            $(`#${p}addPreCountry`).val(present.country || "").trigger("change");
            $(`#${p}addPreArea`).val(present.area || "");
            $(`#${p}addPreLandmark`).val(present.landMark || "");
            apz.app.otherAddressState.present = true;
            const presentSection = document.querySelector('.other-present-details');
            if (presentSection) presentSection.style.display = '';
            checkRowRadio(5, 1);
        } else {
            apz.app.otherAddressState.present = false;
            const presentSection = document.querySelector('.other-present-details');
            if (presentSection) presentSection.style.display = 'none';
            const sameAsToRow = {
                "ApplicantVoter": 1,
                "Co-AppVoter": 2,
                "ApplicantSecondaryKyc": 3,
                "Co-AppSecondaryKyc": 4
            };
            checkRowRadio(sameAsToRow[present.addressSameAs] || 1, 1);
        }
    }
    // PERMANENT ADDRESS
    let checkedResidential = document.querySelector(`[name="${p}residentialStatus_"]:checked`);
    if (permanent) {
        if (permanent.currentAddressProof) {
            $(`#${p}permanentAddressProof`).val(permanent.currentAddressProof).trigger("change");
        }
        if (permanent.addressSameAs === "Other" && checkedResidential.value !== "Own") {
            $(`#${p}permanentAddrLine1`).val(permanent.addressLine1 || "");
            $(`#${p}permanentAddrLine2`).val(permanent.addressLine2 || "");
            $(`#${p}permanentAddrLine3`).val(permanent.addressLine3 || "");
            $(`#${p}permanentPincode`).val(permanent.pinCode || "");
            $(`#${p}addPermCity`).val(permanent.city || "").trigger("change");
            $(`#${p}addPermDistrict`).val(permanent.district || "").trigger("change");
            $(`#${p}addPermState`).val(permanent.state || "").trigger("change");
            $(`#${p}addPermCountry`).val(permanent.country || "").trigger("change");
            $(`#${p}addPermArea`).val(permanent.area || "");
            $(`#${p}addPermLandmark`).val(permanent.landMark || "");
            apz.app.otherAddressState.permanent = true;
            const permanentSection = document.querySelector('.other-permanent-details');
            if (permanentSection) permanentSection.style.display = '';
            checkRowRadio(5, 2);
        } else {
            apz.app.otherAddressState.permanent = false;
            const permanentSection = document.querySelector('.other-permanent-details');
            if (permanentSection) permanentSection.style.display = 'none';
            const sameAsToRow = {
                "ApplicantVoter": 1,
                "Co-AppVoter": 2,
                "ApplicantSecondaryKyc": 3,
                "Co-AppSecondaryKyc": 4,
                "Other": 5
            };
            checkRowRadio(sameAsToRow[permanent.addressSameAs] || 1, 2);
        }
    } else {
        checkRowRadio(1, 2);
    }
    // SECONDARY KYC ADDRESS
    if (secondaryKyc && secondaryKyc.addressLine1) {
        $("#" + p + "addline1").val(secondaryKyc.addressLine1 || "");
        $("#" + p + "addline2").val(secondaryKyc.addressLine2 || "");
        $("#" + p + "addline3").val(secondaryKyc.addressLine3 || "");
        $("#" + p + "addpin").val(secondaryKyc.pinCode || "");
        $("#" + p + "aadCity").val(secondaryKyc.city || "").trigger("change");
        $("#" + p + "aadDistrict").val(secondaryKyc.district || "").trigger("change");
        $("#" + p + "aadState").val(secondaryKyc.state || "").trigger("change");
        $("#" + p + "aadCountry").val(secondaryKyc.country || "").trigger("change");
        $("#" + p + "aadArea").val(secondaryKyc.area || "");
        $("#" + p + "aadLandmark").val(secondaryKyc.landMark || "");
        $("#" + p + "aadharDetails").removeClass('sno');
        $("#" + p + "captureAadhaar").removeClass('btm-seperator');
    }
    // Residential column visibility — handles Own/Rented layout only
    // Does NOT set communication radio (that is done below, always last)
    if (checkedResidential && checkedResidential.value !== "Own") {
        apz.app.handleAddressType(checkedResidential);
    } else if (checkedResidential && checkedResidential.value === "Own") {
        let anyPermanentChecked = Array.from(document.querySelectorAll('.addr-body-row'))
        .filter(row => row.id.startsWith('KmSourc__AadhaarDetails')).some(row => {
            let radio = row.children[2]?.querySelector("input[type='radio']");
            return radio && radio.checked;
        });
        if (!anyPermanentChecked) {
            checkRowRadio(1, 2);
        }
        document.querySelectorAll('.addr-header-row, .addr-body-row').forEach(row => {
            const cells = row.children;
            if (cells && cells.length >= 3) cells[2].style.display = 'none';
        });
        const addressRow = document.querySelector('.address-selection');
        if (addressRow) addressRow.classList.add('disabled');
        // No communication radio set here — restored from snapshot below
    }
    // COMMUNICATION ADDRESS RADIO — always restored LAST so nothing overwrites it
    if (_savedCommRadioVal) {
        document.querySelectorAll(`input[name="${p}communicationAddress_"]`).forEach(r => {
            r.checked = (r.value === _savedCommRadioVal);
            if (r.checked) r.dispatchEvent(new Event('change', {
                bubbles: true
            }));
        });
        window.selectedCommunicationAddress = _savedCommRadioVal === "presentAddr" ? "Present" : "Permanent";
    } else {
        // Fallback — default to Present
        document.querySelectorAll(`input[name="${p}communicationAddress_"]`).forEach(r => {
            r.checked = (r.value === "presentAddr");
            if (r.checked) r.dispatchEvent(new Event('change', {
                bubbles: true
            }));
        });
        window.selectedCommunicationAddress = "Present";
    }
};
apz.app.AadhaarDetails.rebuildAddressTable = function() {
    try {
        let addrDetailsList = inSessionStore?.addressDetailsWrapperList?.[0]?.addressDetailsList || [];
        let custDtlId = gApzCOB.currentApplicant === 1 ? gApzCOB.userDetails.custDtlId : gApzCOB.userDetails.CoApplicantCustomerId;
        let hasPersonalWrapper = addrDetailsList.some(w => w.addressType === "Personal" && String(w.custDtlId) === String(custDtlId));
        if (!hasPersonalWrapper) {
            apz.app.AadhaarDetails.createAddressFromAadhaarFields();
            apz.app.AadhaarDetails.paintAddressTable();
        }
    } catch (e) {
        ApzCOB.traceFrontEndError(e,"");
        console.error("Address table rebuild failed:", e);
    }
};
apz.app.AadhaarDetails.createAddressFromAadhaarFields = function() {
    let p = AadhaarScrId;
    let isApplicant = gApzCOB.currentApplicant === 1;
    let custDtlId = isApplicant ? gApzCOB.userDetails.custDtlId : gApzCOB.userDetails.CoApplicantCustomerId;
    let addressDtlsId = isApplicant ? gApzCOB.userDetails.addressDtlsId : gApzCOB.userDetails.CoApplicantAddressDtlsId;
    let addr = {
        addressType: "SecondaryKyc",
        addressLine1: $(`#${p}addline1`).val() || "",
        addressLine2: $(`#${p}addline2`).val() || "",
        addressLine3: $(`#${p}addline3`).val() || "",
        pinCode: $(`#${p}addpin`).val() || "",
        city: $(`#${p}aadCity`).val() || "",
        district: $(`#${p}aadDistrict`).val() || "",
        state: $(`#${p}aadState`).val() || "",
        country: $(`#${p}aadCountry`).val() || "",
        area: $(`#${p}aadArea`).val() || "",
        landMark: $(`#${p}aadLandmark`).val() || "",
        currentAddressProof: isApplicant ? "Applicant Aadhaar" : "Co-Applicant Aadhaar"
    };
    if (!addr.addressLine1) return;
    if (!inSessionStore.addressDetailsWrapperList) {
        inSessionStore.addressDetailsWrapperList = [{
            addressDetailsList: []
        }];
    }
    let addrDetailsList = inSessionStore.addressDetailsWrapperList[0].addressDetailsList;
    let existingIdx = addrDetailsList.findIndex(w => w.addressType === "Personal" && String(w.custDtlId) === String(custDtlId));
    // AFTER — merge instead of replace
    if (existingIdx >= 0) {
        let addrList = addrDetailsList[existingIdx].payload.addressList || [];
        let secIdx = addrList.findIndex(a => a.addressType === "SecondaryKyc");
        if (secIdx >= 0) {
            addrList[secIdx] = addr;
        } else {
            addrList.push(addr);
        }
    } else {
        addrDetailsList.push({
            addressDtlsId: addressDtlsId || "",
            custDtlId: parseInt(custDtlId),
            addressType: "Personal",
            payload: {
                addressList: [addr]
            }
        });
    }
};
apz.app.AadhaarDetails._resolveAddrBySameAs = function(sameAs) {
    let custList = inSessionStore?.customerDetailsList || [];
    let addrRoot = inSessionStore?.addressDetailsWrapperList?.[0]?.addressDetailsList || [];

    function getAddr(custDtlId, addrType) {
        let personal = addrRoot.find(w => w.addressType === "Personal" && String(w.custDtlId) === String(custDtlId));
        return personal?.payload?.addressList?.find(a => a.addressType === addrType) || null;
    }
    let appCustDtlId = custList.find(c => c.customerType === "Applicant")?.custDtlId || gApzCOB.userDetails.custDtlId;
    let coAppCustDtlId = custList.find(c => c.customerType === "Co-App")?.custDtlId || gApzCOB.userDetails.CoApplicantCustomerId;
    if (sameAs === "ApplicantVoter") return getAddr(appCustDtlId, "Voter");
    if (sameAs === "Co-AppVoter") return getAddr(coAppCustDtlId, "Voter");
    if (sameAs === "ApplicantSecondaryKyc") return getAddr(appCustDtlId, "SecondaryKyc");
    if (sameAs === "Co-AppSecondaryKyc") return getAddr(coAppCustDtlId, "SecondaryKyc");
    return null;
};
apz.app.AadhaarDetails.toggleRelationshipDropdown = function() {
    let docs = (inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList || []);
    let custDtlId = gApzCOB.currentApplicant === 1 ? gApzCOB.userDetails.custDtlId : gApzCOB.userDetails.CoApplicantCustomerId;
    let relDocs = docs.filter(d => d.payload.documentType === "RELATIONSHIP_PROOF" && parseInt(d.custDtlId) === parseInt(custDtlId) && d.payload
        .documentFileName);
    let dropdownId = AadhaarScrId + "relationshipProof";
    let $dropdown = $("#" + dropdownId);
    let isDisabled = relDocs.length > 0;
    $dropdown.prop("disabled", isDisabled);
    $dropdown.closest('.ett-inpt').toggleClass("disabled", isDisabled);
};
apz.app.AadhaarDetails.toggleAddressProofDropdown = function() {
    let docs = (inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList || []);
    let custDtlId = gApzCOB.currentApplicant === 1 
        ? gApzCOB.userDetails.custDtlId 
        : gApzCOB.userDetails.CoApplicantCustomerId;

    // PRESENT
    let presentDocs = docs.filter(d =>
        d.payload.documentType === "ADDRESS_PROOF" &&
        parseInt(d.custDtlId) === parseInt(custDtlId) &&
        (d.payload.documentDesc || "").toUpperCase() === "PRESENT" &&
        d.payload.documentFileName
    );
    let presentCaptured = presentDocs.length > 0;
    let $presentDropdown = $("#" + AadhaarScrId + "addressProof");
    $presentDropdown.prop("disabled", presentCaptured);
    $presentDropdown.closest('.ett-inpt').toggleClass("disabled", presentCaptured);

    // ← ONLY remove docs UI if dropdown is empty AND no docs exist in session
    let presentVal = ($presentDropdown.val() || "").trim();
    if (!presentCaptured && (!presentVal || presentVal === PleaseSelect)) {
        $(`#${AadhaarScrId}presentAddrImg`).find('.km-doc-upload-row').remove();
    }

    // PERMANENT
    let permanentDocs = docs.filter(d =>
        d.payload.documentType === "ADDRESS_PROOF" &&
        parseInt(d.custDtlId) === parseInt(custDtlId) &&
        (d.payload.documentDesc || "").toUpperCase() === "PERMANENT" &&
        d.payload.documentFileName
    );
    let permanentCaptured = permanentDocs.length > 0;
    let $permanentDropdown = $("#" + AadhaarScrId + "permanentAddressProof");
    $permanentDropdown.prop("disabled", permanentCaptured);
    $permanentDropdown.closest('.ett-inpt').toggleClass("disabled", permanentCaptured);

    // ← ONLY remove docs UI if dropdown is empty AND no docs exist in session
    let permanentVal = ($permanentDropdown.val() || "").trim();
    if (!permanentCaptured && (!permanentVal || permanentVal === PleaseSelect)) {
        $(`#${AadhaarScrId}permanentAddrImg`).find('.km-doc-upload-row').remove();
    }
};
apz.app.AadhaarDetails._getOtherDocType = function(colIndex) {
    return "ADDRESS_PROOF";
};
apz.app.AadhaarDetails._otherDocExists = function(colIndex) {
    let descFilter = colIndex === 1 ? "PRESENT" : "PERMANENT";
    let custDtlId = gApzCOB.currentApplicant === 1 ? gApzCOB.userDetails.custDtlId : gApzCOB.userDetails.CoApplicantCustomerId;
    let docs = inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList || [];
    return docs.some(d =>
        d.payload.documentType === "ADDRESS_PROOF" &&
        parseInt(d.custDtlId) === parseInt(custDtlId) &&
        (d.payload.documentDesc || "").toUpperCase() === descFilter &&
        d.payload.documentFileName
    );
};
apz.app.AadhaarDetails._deleteOtherDoc = function(colIndex) {
    let descFilter = colIndex === 1 ? "PRESENT" : "PERMANENT";
    let custDtlId = gApzCOB.currentApplicant === 1 ? gApzCOB.userDetails.custDtlId : gApzCOB.userDetails.CoApplicantCustomerId;
    let docList = inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList || [];
    let idx = docList.findIndex(d =>
        d.payload.documentType === "ADDRESS_PROOF" &&
        parseInt(d.custDtlId) === parseInt(custDtlId) &&
        (d.payload.documentDesc || "").toUpperCase() === descFilter
    );
    if (idx >= 0) docList.splice(idx, 1);
    let p = AadhaarScrId;
    if (colIndex === 1) {
        $(`#${p}addressProof`).val(PleaseSelect).trigger("change");
        $(`#${p}addressProof`).prop("disabled", false).closest('.ett-inpt').removeClass("disabled");
    } else {
        $(`#${p}permanentAddressProof`).val(PleaseSelect).trigger("change");
        $(`#${p}permanentAddressProof`).prop("disabled", false).closest('.ett-inpt').removeClass("disabled");
    }
    apz.app.Kmbase.paintAllDocuments();
};
apz.app.AadhaarDetails.cleanOrphanedAddressProofDocs = function() {
    let isApplicant = gApzCOB.currentApplicant === 1;
    if (!isApplicant) return; 

    let custDtlId = gApzCOB.userDetails.custDtlId;
    let p = AadhaarScrId;

    let isPresentOther = apz.app.otherAddressState.present;
    let isPermanentOther = apz.app.otherAddressState.permanent;

    let docList = inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList || [];

    if (!isPresentOther) {
        let presentDocs = docList.filter(d =>
            d.payload.documentType === "ADDRESS_PROOF" &&
            parseInt(d.custDtlId) === parseInt(custDtlId) &&
            (d.payload.documentDesc || "").toUpperCase() === "PRESENT" &&
            d.payload.documentFileName
        );
        if (presentDocs.length > 0) {
            inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList =
                docList.filter(d => !(
                    d.payload.documentType === "ADDRESS_PROOF" &&
                    parseInt(d.custDtlId) === parseInt(custDtlId) &&
                    (d.payload.documentDesc || "").toUpperCase() === "PRESENT" &&
                    d.payload.documentFileName
                ));
            // Clear UI
            $(`#${p}addressProof`).val(PleaseSelect).trigger("change");
            $(`#${p}addressProof`).prop("disabled", false).closest('.ett-inpt').removeClass("disabled");
            $(`#${AadhaarScrId}presentAddrImg`).find('.km-doc-upload-row').remove();
            console.warn("Cleaned orphaned PRESENT ADDRESS_PROOF docs (Other radio not active)");
        }
    }

    docList = inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList || [];

    if (!isPermanentOther) {
        let permanentDocs = docList.filter(d =>
            d.payload.documentType === "ADDRESS_PROOF" &&
            parseInt(d.custDtlId) === parseInt(custDtlId) &&
            (d.payload.documentDesc || "").toUpperCase() === "PERMANENT" &&
            d.payload.documentFileName
        );
        if (permanentDocs.length > 0) {
            inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList =
                docList.filter(d => !(
                    d.payload.documentType === "ADDRESS_PROOF" &&
                    parseInt(d.custDtlId) === parseInt(custDtlId) &&
                    (d.payload.documentDesc || "").toUpperCase() === "PERMANENT" &&
                    d.payload.documentFileName
                ));
            $(`#${p}permanentAddressProof`).val(PleaseSelect).trigger("change");
            $(`#${p}permanentAddressProof`).prop("disabled", false).closest('.ett-inpt').removeClass("disabled");
            $(`#${AadhaarScrId}permanentAddrImg`).find('.km-doc-upload-row').remove();
           
        }
    }
};
