window.AadhaarScrId = 'KmSourc__AadhaarDetails__';
var TempImageObject = {},
    addrProfArr = [],
    KM_CURR_STAGE_NAME = 'AadhaarDetails',
    KM_CURR_STAGE_NO = 2,
    relatArr = [];
window.selectedCommunicationAddress = "";
window.AADHAAR_ROW_FALLBACK = {
    applicant: false,
    coapplicant: false
};
window.AADHAAR_ADDRESS_MAP = {
    applicant: {
        present: {},
        permanent: {}
    },
    coapplicant: {
        present: {},
        permanent: {}
    }
};
window.AADHAAR_INIT_DONE = false;
var residentialAddressFields = [
    AadhaarScrId + "presentAddrLine1",
    AadhaarScrId + "presentAddrLine2",
    AadhaarScrId + "presentAddrLine3",
    AadhaarScrId + "presentPincode",
    AadhaarScrId + "addPreCity",
    AadhaarScrId + "addPreDistrict",
    AadhaarScrId + "addPreState",
    AadhaarScrId + "addressProof"
];
var permanentAddressFields = [
    AadhaarScrId + "permanentAddrLine1",
    AadhaarScrId + "permanentAddrLine2",
    AadhaarScrId + "permanentAddrLine3",
    AadhaarScrId + "permanentPincode",
    AadhaarScrId + "addPermCity",
    AadhaarScrId + "addPermDistrict",
    AadhaarScrId + "addPermState",
    AadhaarScrId + "permanentAddressProof"
];
window.Aadhaar_Validate = {
    required: function(fieldId, message) {
        let $el = $("#" + fieldId);
        if ($el.length === 0) return true;
        if ($el.prop("disabled") || !$el.is(":visible")) return true;
        let value = ($el.val() || "").trim();
        if (!value || value === PleaseSelect) {
            showFieldError(fieldId, message);
            return false;
        }
        return true;
    },
    radio: function(name, message) {
        let radios = document.querySelectorAll(`input[name='${name}']`);
        if (!radios.length) return true;
        let isChecked = Array.from(radios).some(r => r.checked);
        let firstId = radios[0].id;
        clearFieldError(firstId);
        if (!isChecked) {
            showFieldError(firstId, message);
            return false;
        }
        return true;
    },
    addFieldMandatory: function(elementIds) {
        $("#" + elementIds).parents().parents().eq(3).find(".flb").eq(0).addClass("req");
        $("#" + elementIds).addClass("mand");
    },
    removeFieldMandatory: function(elementIds) {
        $("#" + elementIds).removeClass("mand");
        $("#" + elementIds).parents().parents().eq(3).find(".flb").eq(0).removeClass("req");
        $("#" + elementIds).parents().eq(3).find(".err-msg").addClass("sno");
        $("#" + elementIds).removeClass("err");
    },
    fnCheckMaxMinLengthOnBlur: function(pthis) {
        let minlength = pthis.minLength;
        let maxlength = pthis.maxLength;
        let value = pthis.value.trim();
        let $field = $("#" + pthis.id);
        if (!apz.isNull(value) && (value.length < minlength || value.length > maxlength)) {
            window.gIsMinMaxErr = true;
            $field.addClass("err");
            $("#" + pthis.id + "_ul").next().removeClass("sno");
            let errTxtFieldId = $("#" + pthis.id + "_ul").next()?.find('.icon-Error')?.next() ?? $('#dummyid');
            errTxtFieldId?.text(`Please enter minimum:${minlength} and maximum:${maxlength} characters!`);
            let wrapper;
            if ($field.closest(".etb-slct").length) {
                wrapper = $field.closest(".etb-slct").parent().parent();
            } else if ($field.closest(".ett-inpt").length) {
                wrapper = $field.closest(".ett-inpt").parent().parent();
            } else if ($field.closest("ul").length) {
                wrapper = $field.closest("ul").parent().parent();
            }
            wrapper?.addClass("error-inline");
        } else {
            window.gIsMinMaxErr = false;
            let wrapper;
            if ($field.closest(".etb-slct").length) {
                wrapper = $field.closest(".etb-slct").parent().parent();
            } else if ($field.closest(".ett-inpt").length) {
                wrapper = $field.closest(".ett-inpt").parent().parent();
            } else if ($field.closest("ul").length) {
                wrapper = $field.closest("ul").parent().parent();
            }
            wrapper?.removeClass("error-inline");
        }
    },
    getAddressOrFallback: function(address) {
        if (!address || address.trim() === "") {
            return "Data not available, please update the aadhaar details";
        }
        return address;
    }
};
apz.app.otherAddressState = {
    present: false,
    permanent: false
};
apz.app.resetOtherAddressByColumn = function(colIndex) {
    if (colIndex === 1) {
        apz.app.otherAddressState.present = false;
        const presentSection = document.querySelector('.other-present-details');
        if (presentSection) presentSection.style.display = 'none';
    }
    if (colIndex === 2) {
        apz.app.otherAddressState.permanent = false;
        const permanentSection = document.querySelector('.other-permanent-details');
        if (permanentSection) permanentSection.style.display = 'none';
    }
};
apz.app.AadhaarDetails.isFreshCase = function() {
    let key = gApzCOB.currentApplicant === 1 ? "applicant" : "coapplicant";
    let custType = gApzCOB.currentApplicant === 1 ? "Applicant" : "Co-App";
    let customerList = inSessionStore?.customerDetailsList;
    if (!customerList || !customerList.length) return true;
    let custWrapper = customerList.find(c => c.customerType === custType);
    if (!custWrapper || !custWrapper.payload) return true;
    let p = custWrapper.payload;
    let hasMarital = p.maritalStatus && p.maritalStatus.trim() !== "" && p.maritalStatus !== PleaseSelect;
    let hasFather = p.fathersName && p.fathersName.trim() !== "" && p.fathersName !== "NULL";
    let hasSpouse = p.spouseName && p.spouseName.trim() !== "" && p.spouseName !== "NULL";
    return !(hasMarital || hasFather || hasSpouse);
};
//get voter address from inSessionStore
apz.app.AadhaarDetails.getVoterAddrFromSession = function(custDtlId) {
    let addrDetailsList = inSessionStore?.addressDetailsWrapperList?.[0]?.addressDetailsList || [];
    let personalWrapper = addrDetailsList.find(w => w.addressType === "Personal" && String(w.custDtlId) === String(custDtlId));
    if (!personalWrapper) return null;
    let addrList = personalWrapper.payload?.addressList || [];
    return addrList.find(a => a.addressType === "Voter") || null;
};
//get Present address from inSessionStore
apz.app.AadhaarDetails.getPresentAddrFromSession = function(custDtlId) {
    let addrDetailsList = inSessionStore?.addressDetailsWrapperList?.[0]?.addressDetailsList || [];
    let personalWrapper = addrDetailsList.find(w => w.addressType === "Personal" && String(w.custDtlId) === String(custDtlId));
    if (!personalWrapper) return null;
    let addrList = personalWrapper.payload?.addressList || [];
    return addrList.find(a => a.addressType === "Present") || null;
};
// read live Aadhaar address fields from the screen 
apz.app.AadhaarDetails.getAadhaarAddrFromFields = function() {
    let p = AadhaarScrId;
    return {
        addressLine1: $(`#${p}addline1`).val() || "",
        addressLine2: $(`#${p}addline2`).val() || "",
        addressLine3: $(`#${p}addline3`).val() || "",
        pinCode: $(`#${p}addpin`).val() || "",
        city: $(`#${p}aadCity`).val() || "",
        district: $(`#${p}aadDistrict`).val() || "",
        state: $(`#${p}aadState`).val() || "",
        country: $(`#${p}aadCountry`).val() || "",
        area: $(`#${p}aadArea`).val() || "",
        landMark: $(`#${p}aadLandmark`).val() || ""
    };
};
//build a display string from an address object
apz.app.AadhaarDetails.buildAddrString = function(addr) {
    if (!addr) return "";
    return [
        addr.addressLine1, addr.addressLine2, addr.addressLine3,
        addr.city, addr.district, addr.state, addr.pinCode
    ].filter(Boolean).join(", ");
};
//compare two address objects for equality 
apz.app.AadhaarDetails.addrEqual = function(a, b) {
    if (!a || !b) return false;
    return (a.addressLine1 || "") === (b.addressLine1 || "") && (a.pinCode || "") === (b.pinCode || "") && (a.city || "") === (b.city || "") && (a
        .state || "") === (b.state || "");
};
apz.app.onLoad_AadhaarDetails = function() {
    $(`#${kmbaseScr}nxtBtn`).prop('disabled', false).removeClass('sno');
    $(`#${kmbaseScr}SaveDraft`).removeClass('sno');
    // INITIAL SETUP 
    apz.app.AadhaarDetails.commoncodeConfTypesLst();
    apz.populateDropdown(document.getElementById(AadhaarScrId + 'mrtsts'), ApzCOB.formatDropDownforArray(maritalStatus));
    let filteredReligion = religion;
    if (ApplicationType === 'OpenMarket' && /Other/.test(religion)) {
        filteredReligion = religion.filter(item => item !== "Others" && item !== "Other");
    }
    apz.populateDropdown(document.getElementById(AadhaarScrId + 'religion'), ApzCOB.formatDropDownforArray(filteredReligion));
    apz.populateDropdown(document.getElementById(AadhaarScrId + 'caste'), ApzCOB.formatDropDownforArray(caste));
    apz.populateDropdown(document.getElementById(AadhaarScrId + 'education'), ApzCOB.formatDropDownforArray(education));
    apz.populateDropdown(document.getElementById(`${AadhaarScrId}A_residence_stabilit_present_city`), ApzCOB.formatDropDownforArray(resYr));
    apz.populateDropdown(document.getElementById(`${AadhaarScrId}A_residence_stability`), ApzCOB.formatDropDownforArray(resYr));
    apz.populateDropdown(document.getElementById(AadhaarScrId + 'relationshipProof'), relatArr);
    // Guard: only unshift "Please Select" once
    if (addrProfArr.length === 0 || addrProfArr[0]?.val !== PleaseSelect) {
        addrProfArr.unshift({
            val: PleaseSelect,
            desc: PleaseSelect
        });
    }
    apz.populateDropdown(document.getElementById(AadhaarScrId + 'addressProof'), addrProfArr);
    apz.populateDropdown(document.getElementById(AadhaarScrId + 'permanentAddressProof'), addrProfArr);
    // UI DEFAULT SETUP
    window.AADHAAR_INIT_DONE = true;
    apz.app.otherAddressState.present = false;
    apz.app.otherAddressState.permanent = false;
    const presentSection = document.querySelector('.other-present-details');
    const permanentSection = document.querySelector('.other-permanent-details');
    if (presentSection) presentSection.style.display = 'none';
    if (permanentSection) permanentSection.style.display = 'none';
    // Guard: bind error clearing only once
    let $screen = $("#scr__" + AadhaarScrId + "main");
    $screen.off("mousedown.aadhaar").on("mousedown.aadhaar", "input, select", function() {
        clearFieldError(this.id);
    });
    $screen.off("change.aadhaar").on("change.aadhaar", "input[type=radio]", function() {
        clearFieldError(this.id);
    });
    // Min/Max setup
    ApzCOB.setMinMaxLength([{
        fieldName: 'MaritalStatus',
        fieldId: AadhaarScrId + 'mrtsts'
    }, {
        fieldName: 'Name',
        fieldId: AadhaarScrId + 'fathersName'
    }, {
        fieldName: 'Name',
        fieldId: AadhaarScrId + 'spouseName'
    }, {
        fieldName: 'AddressLine1',
        fieldId: AadhaarScrId + 'presentAddrLine1'
    }, {
        fieldName: 'AddressLine2',
        fieldId: AadhaarScrId + 'presentAddrLine2'
    }, {
        fieldName: 'AddressLine3',
        fieldId: AadhaarScrId + 'presentAddrLine3'
    }, {
        fieldName: 'Pincode',
        fieldId: AadhaarScrId + 'presentPincode'
    }, {
        fieldName: 'Pincode',
        fieldId: AadhaarScrId + 'permanentPincode'
    }, {
        fieldName: 'AddressLine1',
        fieldId: AadhaarScrId + 'permanentAddrLine1'
    }, {
        fieldName: 'AddressLine2',
        fieldId: AadhaarScrId + 'permanentAddrLine2'
    }, {
        fieldName: 'AddressLine3',
        fieldId: AadhaarScrId + 'permanentAddrLine3'
    }]);
    if (window.AADHAAR_TAB_SWITCH_TARGET) {
        gApzCOB.currentApplicant = window.AADHAAR_TAB_SWITCH_TARGET === 'CoApplicant' ? 2 : 1;
    } else {
        gApzCOB.currentApplicant = 1;
    }
    // Data paint
    apz.app.AadhaarDetails.paintAddressTable();
    apz.app.AadhaarDetails.prePopulateAll();
    apz.app.AadhaarDetails.rebuildAddressTable();
    apz.app.Kmbase.paintAllDocuments();
    // show/hide Aadhaar details section 
    let aadhaarNum = ($("#" + AadhaarScrId + "aadharnum").val() || "").trim();
    let isApplicant = gApzCOB.currentApplicant === 1;
    let custDtlId = isApplicant ? gApzCOB.userDetails.custDtlId : gApzCOB.userDetails.CoApplicantCustomerId;
    let addrDetailsList = inSessionStore?.addressDetailsWrapperList?.[0]?.addressDetailsList || [];
    let personalWrapper = addrDetailsList.find(w => w.addressType === "Personal" && String(w.custDtlId) === String(custDtlId));
    let hasSecondaryKyc = personalWrapper?.payload?.addressList?.some(a => a.addressType === "SecondaryKyc" && a.addressLine1);
    let comingFromNext = window.AADHAAR_NEXT_TAB_SWITCH === true;
    ///document capture changes
    if (aadhaarNum !== "" || hasSecondaryKyc) {
        // already has data — always show regardless of back/next
        $("#" + AadhaarScrId + "aadharDetails").removeClass('sno');
        $("#" + AadhaarScrId + "captureAadhaar").removeClass('btm-seperator');
    } else if (comingFromNext) {
        // coming from Next with fresh OCR data — show fields
        $("#" + AadhaarScrId + "aadharDetails").removeClass('sno');
        $("#" + AadhaarScrId + "captureAadhaar").removeClass('btm-seperator');
    } else {
        // coming from Back — hide fields, don't touch session
        $("#" + AadhaarScrId + "aadharDetails").addClass('sno');
        window.AADHAAR_DOC_CAPTURE_SUCCESS = false;
    }
    // Tab switch — must be LAST after all paints are done
    if (window.AADHAAR_TAB_SWITCH_TARGET) {
        let target = window.AADHAAR_TAB_SWITCH_TARGET;
        //window.AADHAAR_TAB_SWITCH_TARGET = null;
        let tabs = $('.aadhaarSubMenu');
        if (target === 'CoApplicant' && tabs.length > 1) {
            apz.app.AadhaarDetails._doTabSwitch(tabs.eq(1), 'CoApplicant');
        } else {
            apz.app.AadhaarDetails._doTabSwitch(tabs.eq(0), 'Applicant');
        }
    }
    let aadhaarCfgLoad = window.KM_DOC_VIEWER_CONFIG['SECONDARY_KYC'];
    $(`#${aadhaarCfgLoad.rowId}`).removeClass('km-doc-upload-row').addClass('sno');
    $(`#${aadhaarCfgLoad.captureBtnId}`).removeClass('sno');
    let _paintFor = (window.AADHAAR_PAINT_DOC_ON_LOAD != null) ? window.AADHAAR_PAINT_DOC_ON_LOAD : gApzCOB.currentApplicant;
    window.AADHAAR_PAINT_DOC_ON_LOAD = null;
    apz.app.Kmbase.paintAadhaarKycDocsInScreen(_paintFor);
    apz.app.Kmbase.paintSidebarStatus();
    apz.app.AadhaarDetails.toggleAddressProofDropdown();
    apz.app.AadhaarDetails.toggleRelationshipDropdown();
    apz.app.Kmbase.bmRecommendation();
    apz.app.AadhaarDetails.toggleAddressRadiosForBM();
};
apz.app.onShown_AadhaarDetails = function() {
    if ($('#KmSourc__Kmbase__sidebar_col').hasClass('sideon')) {
        apz.app.Kmbase.toggleSidebar();
    }
    let appCustDtlId = gApzCOB.userDetails.custDtlId;
    let coAppCustDtlId = gApzCOB.userDetails.CoApplicantCustomerId;
    let addrDetailsList = inSessionStore?.addressDetailsWrapperList?.[0]?.addressDetailsList || [];
    let appPersonal = addrDetailsList.find(w => w.addressType === "Personal" && String(w.custDtlId) === String(appCustDtlId));
    let coAppPersonal = addrDetailsList.find(w => w.addressType === "Personal" && String(w.custDtlId) === String(coAppCustDtlId));
    let appHasSecondaryKyc = appPersonal?.payload?.addressList?.some(a => a.addressType === "SecondaryKyc" && a.addressLine1);
    let coAppHasSecondaryKyc = coAppPersonal?.payload?.addressList?.some(a => a.addressType === "SecondaryKyc" && a.addressLine1);
    // which tab are we landing on
    let targetTab = window.AADHAAR_TAB_SWITCH_TARGET === 'CoApplicant' ? 'CoApplicant' : 'Applicant';
    let hasSecondaryKyc = targetTab === 'CoApplicant' ? coAppHasSecondaryKyc : appHasSecondaryKyc;
    let comingFromNext = window.AADHAAR_FROM_DOC_NEXT === true;
    let capturedFor = window.AADHAAR_FROM_DOC_NEXT_FOR; // 1 = applicant, 2 = co-app
    window.AADHAAR_FROM_DOC_NEXT = false;
    window.AADHAAR_FROM_DOC_NEXT_FOR = null;
    // coming from Next — only show fields for the tab that was just captured
    let comingFromNextForThisTab = comingFromNext && (
        (targetTab === 'Applicant' && capturedFor === 1) || (targetTab === 'CoApplicant' && capturedFor === 2));
    // SIDEBAR ACTIVE STATE — parent always active
    $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
    $(`#${kmbaseScr}AadhaarDetails_hyp`).addClass('active');
    // Child active based on target
    if (window.AADHAAR_TAB_SWITCH_TARGET === 'CoApplicant') {
        $(`#${kmbaseScr}CoAppAadhaarDetails_hyp`).addClass('active');
        $(`#${AadhaarScrId}el_btn_2`).addClass('active');
    } else {
        $(`#${kmbaseScr}AppAadhaarDetails_hyp`).addClass('active');
        $(`#${AadhaarScrId}el_btn_1`).addClass('active');
    }
    window.AADHAAR_TAB_SWITCH_TARGET = null;
    // Aadhaar doc capture UI
    if (hasSecondaryKyc) {
        // already has saved data — always show
        $("#" + AadhaarScrId + "aadharDetails").removeClass('sno');
        $("#" + AadhaarScrId + "captureAadhaar").removeClass('btm-seperator');
    } else if (comingFromNextForThisTab) {
        // fresh OCR confirmed via Next for this tab — show fields
        $("#" + AadhaarScrId + "aadharDetails").removeClass('sno');
        $("#" + AadhaarScrId + "captureAadhaar").removeClass('btm-seperator');
    } else {
        // Back navigation or different tab — hide fields
        $('.aadharDetails').addClass('sno');
        window.AADHAAR_DOC_CAPTURE_SUCCESS = false;
    }
    apz.app.Kmbase.paintSidebarStatus();
    if ($(`#KmSourc__AadhaarDetails__el_txt_3`).is(":visible")) {
        $(`#KmSourc__AadhaarDetails__sc_row_189`).removeClass("sno");
    } else {
        $(`#KmSourc__AadhaarDetails__sc_row_189`).addClass("sno");
    }
    if (ApplicationType === 'OpenMarket') {
        $("#KmSourc__AadhaarDetails__residentialStatus_option_Own").click()
        $("#KmSourc__AadhaarDetails__residentialStatus_option_Rented").prop("disabled", true);
    }
    const scrollContainer = document.querySelector('#APZCBO__BaseScreens__baseRow');
    scrollContainer.scrollTop = 0;
    // ── Enable Name Field in Fetch OCR Section  ───────────────────────
    $("#" + kmbaseScr + "ocrNameSection").removeClass('disabled').prop('disabled', false);
    document.querySelector('label[for="KmSourc__Kmbase__ocrNameSection"]')
        ?.classList.add('req');
};
apz.app.handleColumnRadio = function(pthis) {
    if (!pthis) return;
    const cell = pthis.closest('.addr-cell');
    if (!cell) return;
    const row = pthis.closest('.addr-body-row');
    if (!row) return;
    const cells = Array.from(row.children);
    const colIndex = cells.indexOf(cell);
    const isOtherRow = pthis.closest('.other-address-row');
    if (!isOtherRow) {
        const otherActive = colIndex === 1 ? apz.app.otherAddressState.present : apz.app.otherAddressState.permanent;
        if (otherActive && apz.app.AadhaarDetails._otherDocExists(colIndex)) {
            const docLabel = colIndex === 1 ? "Address Proof" : "Permanent Address Proof";
            pthis.checked = false;
            const allRows = document.querySelectorAll('.addr-body-row');
            const otherRow = allRows[4];
            if (otherRow) {
                const otherCell = otherRow.children[colIndex];
                const otherRadio = otherCell?.querySelector('input[type="radio"]');
                if (otherRadio) otherRadio.checked = true;
            }
            ApzCOB.fnDisplayMsg(`Please delete the captured ${docLabel} document before changing the address source.`, "E");
            return;
        }
    }
    if (!isOtherRow) {
        if (colIndex === 1) {
            apz.app.otherAddressState.present = false;
            const presentSection = document.querySelector('.other-present-details');
            if (presentSection) presentSection.style.display = 'none';
            let p = AadhaarScrId;
            $(`#${p}presentAddrLine1`).val("");
            $(`#${p}presentAddrLine2`).val("");
            $(`#${p}presentAddrLine3`).val("");
            $(`#${p}presentPincode`).val("");
            $(`#${p}addPreCity`).val("").trigger("change");
            $(`#${p}addPreDistrict`).val("").trigger("change");
            $(`#${p}addPreState`).val("").trigger("change");
            $(`#${p}addPreCountry`).val("").trigger("change");
            $(`#${p}addPreArea`).val("");
            $(`#${p}addPreLandmark`).val("");
            $(`#${p}addressProof`).val(PleaseSelect).trigger("change");
            $(`#${p}addressProof`).prop("disabled", false).closest('.ett-inpt').removeClass("disabled");
        }
        if (colIndex === 2) {
            apz.app.otherAddressState.permanent = false;
            const permanentSection = document.querySelector('.other-permanent-details');
            if (permanentSection) permanentSection.style.display = 'none';
            let p = AadhaarScrId;
            $(`#${p}permanentAddrLine1`).val("");
            $(`#${p}permanentAddrLine2`).val("");
            $(`#${p}permanentAddrLine3`).val("");
            $(`#${p}permanentPincode`).val("");
            $(`#${p}addPermCity`).val("").trigger("change");
            $(`#${p}addPermDistrict`).val("").trigger("change");
            $(`#${p}addPermState`).val("").trigger("change");
            $(`#${p}addPermCountry`).val("").trigger("change");
            $(`#${p}addPermArea`).val("");
            $(`#${p}addPermLandmark`).val("");
            $(`#${p}permanentAddressProof`).val(PleaseSelect).trigger("change");
            $(`#${p}permanentAddressProof`).prop("disabled", false).closest('.ett-inpt').removeClass("disabled");
        }
        const allRows = Array.from(document.querySelectorAll('.addr-body-row'));
        const rowIndex = allRows.indexOf(pthis.closest('.addr-body-row')) + 1;
        const rowToSameAs = {
            1: "ApplicantVoter",
            2: "Co-AppVoter",
            3: "ApplicantSecondaryKyc",
            4: "Co-AppSecondaryKyc"
        };

        function getAddrForRow(rowNum) {
            let custList = inSessionStore?.customerDetailsList || [];
            let addrRoot = inSessionStore?.addressDetailsWrapperList?.[0]?.addressDetailsList || [];

            function getAddr(custDtlId, addrType) {
                let personal = addrRoot.find(w => w.addressType === "Personal" && String(w.custDtlId) === String(custDtlId));
                return personal?.payload?.addressList?.find(a => a.addressType === addrType) || null;
            }
            let appCustDtlId = custList.find(c => c.customerType === "Applicant")?.custDtlId || gApzCOB.userDetails.custDtlId;
            let coAppCustDtlId = custList.find(c => c.customerType === "Co-App")?.custDtlId || gApzCOB.userDetails.CoApplicantCustomerId;
            if (rowNum === 1) return getAddr(appCustDtlId, "Voter");
            if (rowNum === 2) return getAddr(coAppCustDtlId, "Voter");
            if (rowNum === 3) return getAddr(appCustDtlId, "SecondaryKyc");
            if (rowNum === 4) return getAddr(coAppCustDtlId, "SecondaryKyc");
            return null;
        }
        let sourceAddr = getAddrForRow(rowIndex);
        let p = AadhaarScrId;
        if (colIndex === 1) {
            if (sourceAddr && sourceAddr.addressLine1) {
                $(`#${p}presentAddrLine1`).val(sourceAddr.addressLine1 || "");
                $(`#${p}presentAddrLine2`).val(sourceAddr.addressLine2 || "");
                $(`#${p}presentAddrLine3`).val(sourceAddr.addressLine3 || "");
                $(`#${p}presentPincode`).val(sourceAddr.pinCode || "");
                $(`#${p}addPreCity`).val(sourceAddr.city || "").trigger("change");
                $(`#${p}addPreDistrict`).val(sourceAddr.district || "").trigger("change");
                $(`#${p}addPreState`).val(sourceAddr.state || "").trigger("change");
                $(`#${p}addPreCountry`).val(sourceAddr.country || "").trigger("change");
                $(`#${p}addPreArea`).val(sourceAddr.area || "");
                $(`#${p}addPreLandmark`).val(sourceAddr.landMark || "");
            } else {
                $(`#${p}presentAddrLine1`).val("");
                $(`#${p}presentAddrLine2`).val("");
                $(`#${p}presentAddrLine3`).val("");
                $(`#${p}presentPincode`).val("");
                $(`#${p}addPreCity`).val("").trigger("change");
                $(`#${p}addPreDistrict`).val("").trigger("change");
                $(`#${p}addPreState`).val("").trigger("change");
                $(`#${p}addPreCountry`).val("").trigger("change");
                $(`#${p}addPreArea`).val("");
                $(`#${p}addPreLandmark`).val("");
            }
        }
        if (colIndex === 2) {
            if (sourceAddr && sourceAddr.addressLine1) {
                $(`#${p}permanentAddrLine1`).val(sourceAddr.addressLine1 || "");
                $(`#${p}permanentAddrLine2`).val(sourceAddr.addressLine2 || "");
                $(`#${p}permanentAddrLine3`).val(sourceAddr.addressLine3 || "");
                $(`#${p}permanentPincode`).val(sourceAddr.pinCode || "");
                $(`#${p}addPermCity`).val(sourceAddr.city || "").trigger("change");
                $(`#${p}addPermDistrict`).val(sourceAddr.district || "").trigger("change");
                $(`#${p}addPermState`).val(sourceAddr.state || "").trigger("change");
                $(`#${p}addPermCountry`).val(sourceAddr.country || "").trigger("change");
                $(`#${p}addPermArea`).val(sourceAddr.area || "");
                $(`#${p}addPermLandmark`).val(sourceAddr.landMark || "");
            } else {
                $(`#${p}permanentAddrLine1`).val("");
                $(`#${p}permanentAddrLine2`).val("");
                $(`#${p}permanentAddrLine3`).val("");
                $(`#${p}permanentPincode`).val("");
                $(`#${p}addPermCity`).val("").trigger("change");
                $(`#${p}addPermDistrict`).val("").trigger("change");
                $(`#${p}addPermState`).val("").trigger("change");
                $(`#${p}addPermCountry`).val("").trigger("change");
                $(`#${p}addPermArea`).val("");
                $(`#${p}addPermLandmark`).val("");
            }
        }
    }
    document.querySelectorAll('.addr-body-row').forEach(r => {
        const targetCell = r.children[colIndex];
        if (!targetCell) return;
        const radio = targetCell.querySelector('input[type="radio"]');
        if (radio && radio !== pthis) {
            radio.checked = false;
        }
    });
};
apz.app.handleAddressType = function(pthis) {
    if (!pthis) return;
    const value = pthis.value;
    document.querySelectorAll('.addr-header-row, .addr-body-row').forEach(row => {
        const cells = row.children;
        if (!cells || cells.length < 3) return;
        const presentCell = cells[1];
        const permanentCell = cells[2];
        if (value === 'Own') {
            presentCell.style.display = '';
            permanentCell.style.display = 'none';
            permanentCell.querySelectorAll('input[type="radio"]').forEach(r => r.checked = false);
            $(`#${AadhaarScrId}permanentAddressProof`).val(PleaseSelect);
        } else {
            presentCell.style.display = '';
            permanentCell.style.display = '';
        }
    });
    const addressRow = document.querySelector('.address-selection');
    if (!addressRow) return;
    const optionRadios = addressRow.querySelectorAll('input[type="radio"]');
    if (value === 'Own') {
        addressRow.classList.add('disabled');
        optionRadios.forEach(r => {
            if (r.value === 'presentAddr') {
                r.checked = true;
                r.dispatchEvent(new Event('change', {
                    bubbles: true
                }));
            } else {
                r.checked = false;
            }
        });
        apz.app.otherAddressState.permanent = false;
        const otherPermanentSection = document.querySelector('.other-permanent-details');
        if (otherPermanentSection) otherPermanentSection.style.display = 'none';
        window.selectedCommunicationAddress = "Present";
        apz.app.AadhaarDetails.captureCommunicationAddress();
    } else {
        addressRow.classList.remove('disabled');
        optionRadios.forEach(r => r.checked = false);
        window.selectedCommunicationAddress = "";
        let anyPermanentChecked = Array.from(document.querySelectorAll('.addr-body-row')).some(row => {
            let radio = row.children[2]?.querySelector("input[type='radio']");
            return radio && radio.checked;
        });
        if (!anyPermanentChecked) {
            checkRowRadio(1, 2);
        }
    }
};
apz.app.handleOtherAddressSelection = function(pthis) {
    if (!apz.app.otherAddressState) {
        apz.app.otherAddressState = {
            present: false,
            permanent: false
        };
    }
    const value = pthis?.value || '';
    let p = AadhaarScrId;
    if (value === 'presentOther') {
        apz.app.otherAddressState.present = !apz.app.otherAddressState.present;
        if (apz.app.otherAddressState.present) {
            $(`#${p}presentAddrLine1`).val("");
            $(`#${p}presentAddrLine2`).val("");
            $(`#${p}presentAddrLine3`).val("");
            $(`#${p}presentPincode`).val("");
            $(`#${p}addPreCity`).val("").trigger("change");
            $(`#${p}addPreDistrict`).val("").trigger("change");
            $(`#${p}addPreState`).val("").trigger("change");
            $(`#${p}addPreCountry`).val("").trigger("change");
            $(`#${p}addPreArea`).val("");
            $(`#${p}addPreLandmark`).val("");
        }
    }
    if (value === 'permanentOther') {
        apz.app.otherAddressState.permanent = !apz.app.otherAddressState.permanent;
        if (apz.app.otherAddressState.permanent) {
            $(`#${p}permanentAddrLine1`).val("");
            $(`#${p}permanentAddrLine2`).val("");
            $(`#${p}permanentAddrLine3`).val("");
            $(`#${p}permanentPincode`).val("");
            $(`#${p}addPermCity`).val("").trigger("change");
            $(`#${p}addPermDistrict`).val("").trigger("change");
            $(`#${p}addPermState`).val("").trigger("change");
            $(`#${p}addPermCountry`).val("").trigger("change");
            $(`#${p}addPermArea`).val("");
            $(`#${p}addPermLandmark`).val("");
        }
    }
    const presentSection = document.querySelector('.other-present-details');
    const permanentSection = document.querySelector('.other-permanent-details');
    if (!presentSection || !permanentSection) return;
    presentSection.style.display = apz.app.otherAddressState.present ? '' : 'none';
    permanentSection.style.display = apz.app.otherAddressState.permanent ? '' : 'none';
};
apz.app.AadhaarDetails.handletabSwitch = function(pthis, CustType) {
    if (!pthis) return;
    if (!window.AADHAAR_TAB_SWITCH_SAVING) {
        window.AADHAAR_NEXT_TAB_SWITCH = false;
        window.AADHAAR_SKIP_SAVE = false;
    }
    if (window.AADHAAR_INIT_DONE && !window.AADHAAR_TAB_SWITCH_SAVING) {
        // programmatic Next navigation — skip confirm modal
        if (window.AADHAAR_NEXT_TAB_SWITCH) {
            window.AADHAAR_NEXT_TAB_SWITCH = false;
            window.AADHAAR_TAB_SWITCH_SAVING = true;
            window.AADHAAR_TAB_SWITCH_TARGET = (CustType === 'Applicant') ? 'Applicant' : 'CoApplicant';
            window.AADHAAR_SAVE_DRAFT = false;
            window.AADHAAR_EXPLICIT_DRAFT = false;
            window.isVerified = "N";
            window._AFTER_DRAFT_SAVE = function() {
                window.AADHAAR_TAB_SWITCH_SAVING = false;
                apz.app.AadhaarDetails._doTabSwitch(pthis, CustType);
            };
            apz.app.AadhaarDetails.saveAadhaarDetails(true);
            return;
        }
        if (window.AADHAAR_SKIP_SAVE) {
            window.AADHAAR_SKIP_SAVE = false;
            window.AADHAAR_NEXT_TAB_SWITCH = false;
            apz.app.AadhaarDetails._doTabSwitch(pthis, CustType);
            return;
        }
        apz.app.Kmbase.confirmNavigate(function() {
            window.AADHAAR_TAB_SWITCH_SAVING = true;
            window.AADHAAR_TAB_SWITCH_TARGET = (CustType === 'Applicant') ? 'Applicant' : 'CoApplicant';
            window.AADHAAR_SAVE_DRAFT = false;
            window.AADHAAR_EXPLICIT_DRAFT = false;
            window.isVerified = "N";
            try {
                var _aadLeavingNo = gApzCOB.currentApplicant;
                var _aadLeavingCode = (_aadLeavingNo === 2) ? "C" : "A";
                apz.app.Kmbase.updateSrcVerifiedStages(2, _aadLeavingCode, "N");
                apz.app.Kmbase.paintSidebarStatus();
            } catch (e) {
                ApzCOB.traceFrontEndError(e,"");
            }
            window._AFTER_DRAFT_SAVE = function() {
                window.AADHAAR_TAB_SWITCH_SAVING = false;
                apz.app.AadhaarDetails._doTabSwitch(pthis, CustType);
            };
            apz.app.AadhaarDetails.saveAadhaarDetails(true);
        });
        return;
    }
    apz.app.AadhaarDetails._doTabSwitch(pthis, CustType);
};
apz.app.AadhaarDetails._doTabSwitch = function(pthis, CustType) {
    $(`#${kmbaseScr}nxtBtn`).prop('disabled', false);
    resetAllMinMaxErrors();
    var $btn = $(pthis);
    $('.aadhaarSubMenu').removeClass('active');
    $btn.addClass('active');
    if (CustType === 'Applicant') {
        gApzCOB.currentApplicant = 1;
        $('.src-coapp').addClass('sno');
        $('.src-app').removeClass('sno');
        $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
        $(`#${kmbaseScr}AadhaarDetails_hyp`).addClass('active');
        $(`#${kmbaseScr}AppAadhaarDetails_hyp`).addClass('active');
    } else {
        gApzCOB.currentApplicant = 2;
        $('.src-app').addClass('sno');
        $('.src-coapp').removeClass('sno');
        $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
        $(`#${kmbaseScr}AadhaarDetails_hyp`).addClass('active');
        $(`#${kmbaseScr}CoAppAadhaarDetails_hyp`).addClass('active');
    }
    apz.app.AadhaarDetails.clearScreenFields();
    apz.app.AadhaarDetails.paintAddressTable();
    apz.app.AadhaarDetails.prePopulateAll();
    apz.app.Kmbase.paintAllDocuments();
    apz.app.AadhaarDetails.toggleAddressProofDropdown();
    apz.app.AadhaarDetails.toggleRelationshipDropdown();
    // re-evaluate aadhaar details visibility for the new tab
    let _switchCustDtlId = CustType === 'CoApplicant' ? gApzCOB.userDetails.CoApplicantCustomerId : gApzCOB.userDetails.custDtlId;
    let _switchAddrList = inSessionStore?.addressDetailsWrapperList?.[0]?.addressDetailsList || [];
    let _switchPersonal = _switchAddrList.find(w => w.addressType === "Personal" && String(w.custDtlId) === String(_switchCustDtlId));
    let _switchHasSecKyc = _switchPersonal?.payload?.addressList?.some(a => a.addressType === "SecondaryKyc" && a.addressLine1);
    if (_switchHasSecKyc) {
        $("#" + AadhaarScrId + "aadharDetails").removeClass('sno');
        $("#" + AadhaarScrId + "captureAadhaar").removeClass('btm-seperator');
    } else {
        $("#" + AadhaarScrId + "aadharDetails").addClass('sno');
        $("#" + AadhaarScrId + "captureAadhaar").addClass('btm-seperator');
    }
    let aadhaarCfgSwitch = window.KM_DOC_VIEWER_CONFIG['SECONDARY_KYC'];
    $(`#${aadhaarCfgSwitch.rowId}`).removeClass('km-doc-upload-row').addClass('sno');
    $(`#${aadhaarCfgSwitch.captureBtnId}`).removeClass('sno');
    apz.app.Kmbase.paintAadhaarKycDocsInScreen(gApzCOB.currentApplicant);
    //window.scrollTo(0, 0);
    ApzCOB.scrollTopKMSourcing();
    apz.app.Kmbase.bmRecommendation();
//   apz.app.AadhaarDetails.handleOpenMarketFields()
    if(window.AADHAAR_TAB_SWITCH_TARGET === 'Applicant'){
        apz.app.AadhaarDetails.toggleAddressRadiosForBM();
    }
    apz.app.Kmbase.paintQueryResponsedata();
    if(lastBM)
    apz.app.Kmbase.paintQueryResponsedata(true);
};
apz.app.AadhaarDetails.handleOpenMarketFields = function () {
    let applicantMaritalStatus  = inSessionStore.customerDetailsList.filter((e) => e.customerType === "Applicant")[0].payload.maritalStatus || "";

    let coApplicantRelationwithApplicant = inSessionStore.customerDetailsList.filter((e) => e.customerType === 'Co-App')[0].payload.relationShipWithApplicant || "";

    if (gApzCOB.currentApplicant === 2 && gApzCOB.productCode === "1001" && (applicantMaritalStatus === "Married" && coApplicantRelationwithApplicant !== "Spouse")) {
        var today = new Date();
        var maxDob = new Date();
        maxDob.setFullYear(today.getFullYear() - 18);
        var defaultDob = new Date();
        defaultDob.setFullYear(today.getFullYear() - 18);
        $("#KmSourc__AadhaarDetails__spouseDob").datepicker("option", {
            maxDate: maxDob
        });
        $("#KmSourc__AadhaarDetails__spouseDob").datepicker("setDate", defaultDob);
        let kycTypes = ['Please Select', 'Aadhaar Card', 'Voter ID', 'Driving License', 'Passport'];
        apz.populateDropdown(document.getElementById('KmSourc__AadhaarDetails__spouseKYCType'), ApzCOB.formatDropDownforArray(kycTypes));
        $("#" + AadhaarScrId + "spouseKycID_row").removeClass("sno");
        $("#" + AadhaarScrId + "spouseKYCType_row").removeClass("sno");
        $("#" + AadhaarScrId + "spouseDob_row").removeClass("sno");
    } else {
        $("#" + AadhaarScrId + "spouseKycID_row").addClass("sno");
        $("#" + AadhaarScrId + "spouseKYCType_row").addClass("sno");
        $("#" + AadhaarScrId + "spouseDob_row").addClass("sno");
        $("#" + AadhaarScrId + "spouseKycID").val("");
        $("#" + AadhaarScrId + "spouseKYCType").val("");
        $("#" + AadhaarScrId + "spouseDob").val("");
    }
}
