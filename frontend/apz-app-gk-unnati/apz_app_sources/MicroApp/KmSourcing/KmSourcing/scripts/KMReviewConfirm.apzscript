apz.app.KMReviewConfirm.successConfirmToggleKM = function () {
    const role = gApzCOB?.LoggedInUserDetails?.loginResponse?.addInfo1;
    const isBM = role === 'BM';
    const isKMRenewal = role === 'KM' && window.ApplicationType === 'RENEWAL';
    let { applicationStatus } = inSessionStore?.applicationMaster;
    let message;
    if (isBM || isKMRenewal || applicationStatus === "IPUSHBACK") {
        message = "Are you sure you want to submit the application to RPC?";
    } else {
        message = "Are you sure you want to submit the application to BM?";
    }
    $("#KmSourc__Kmbase__confirmationText_txtcnt").text(message);
    ApzCOB.toggleModal(kmbaseScr + "conFormation_mdl");
};
// ------------- CHINNA CODE CHANGES END FOR KM TO RPC ------------------------
apz.app.KMReviewConfirm.selectstagemomentCall = function () {
    const isBM = gApzCOB?.LoggedInUserDetails?.loginResponse?.addInfo1 === 'BM';
    let { applicationStatus } = inSessionStore?.applicationMaster;
    if (applicationStatus === 'INPROGRESS') {
        apz.app.KMReviewConfirm.finalConfirmStageMovement();
    } else {
        let gaction = 'APPROVED';
        switch (applicationStatus) {
            case "PENDING":
                gaction = 'APPROVED';
                break;
            case "BMPUSHBACK":
                gaction = 'PENDING';
                window.KM_updatedRejectString = inSessionStore?.sourcingQueryResponse?.response ?? "";
                break;
            case "CAPUSHBACK":
                gaction = 'RPCVERIFIED';
                window.KM_updatedRejectString = inSessionStore?.sourcingQueryResponse?.response ?? "";
                break;
            case "IPUSHBACK":
                window.KM_updatedRejectString = inSessionStore?.sourcingQueryResponse?.response ?? "";
                gaction = 'APPROVED';
                break;
            default:
                gaction = 'CONTINUE';
        }
        apz.app.Kmbase.kmApproveReject(gaction)
    }
};
apz.app.KMReviewConfirm.finalConfirmStageMovement = function () {
    var currentRole = ""
    var action = ""
    var workflowId = ""
    var stage = ""
    var req = {};
    let intfName = "CreateLoan";
    req.apiRequest = {};
    req.apiRequest.requestObj = {};
    let workflow = {};
    let workflowData = inSessionStore?.applnWfDefinitionList;
    // --------------- CHINNA COMMENTED FOR KM TO RPC CODE UPDATE START --------------
    // if (gApzCOB?.LoggedInUserDetails?.loginResponse?.addInfo1 === 'KM') {
    //     let matched = workflowData.find(item =>
    //         item.workFlowId === "CREATEAPPLICATION"
    //     );
    //     if (matched) {
    //         workflow = {
    //             currentRole: matched.currentRole,
    //             action: matched.action,
    //             workflowId: matched.workFlowId,
    //             stage: matched.fromStageId
    //         };
    //     }
    // } 
    // --------------- CHINNA COMMENTED FOR KM TO RPC CODE UPDATE START --------------
    // -------------- CHINNA CODE CHANGES START FOR KM TO RPC -------------------------
    if (gApzCOB?.LoggedInUserDetails?.loginResponse?.addInfo1 === 'KM') {
        const isRenewal = window.ApplicationType === 'RENEWAL';
        // RENEWAL uses "RENEWAPPLICATION" → routes directly to PENDINGWITHRPCMAKER (RPC)
        // NEW / OpenMarket uses "CREATEAPPLICATION" → routes to SUBMITFORAPPROVAL (BM)
        const targetWorkflowId = isRenewal ? "RENEWAPPLICATION" : "CREATEAPPLICATION";

        let matched = workflowData.find(item =>
            item.workFlowId === targetWorkflowId
        );
        if (matched) {
            workflow = {
                currentRole: matched.currentRole,
                action: matched.action,
                workflowId: matched.workFlowId,
                stage: matched.fromStageId
            };
        }
    }
    // -------------- CHINNA CODE CHANGES END FOR KM TO RPC ------------------------- 
    else if (gApzCOB?.LoggedInUserDetails?.loginResponse?.addInfo1 === 'BM') {
        let matched = workflowData.find(item =>
            item.workFlowId === "APPROVEAPPLICATION"
        );

        if (matched) {
            workflow = {
                currentRole: matched.currentRole,
                action: matched.action,
                workflowId: matched.workFlowId,
                stage: matched.fromStageId
            };
        }
    }
    req.apiRequest.userId = gApzCOB.LoggedInUserDetails.loginResponse.userDet.id;
    req.apiRequest.appId = gAppId;
    req.apiRequest.interfaceName = intfName;
    req.apiRequest.requestObj = {
        isNewSourcing: "N",
        isStageVerified: isVerified,
        appId: gApzCOB.userDetails.appId,
        applicationId: !apz.isNull(gApzCOB.relatedApplicationId) ? gApzCOB.relatedApplicationId : gApzCOB.userDetails.applicationId,
        versionNum: window.versionNum,
        isExistingCustomer: "",
        applicationMaster: {
            applicationType: "online",
            appId: gApzCOB.userDetails.appId,
            applicationId: gApzCOB.userDetails.applicationId,
            createdBy: gApzCOB.LoggedInUserDetails.loginResponse.userDet.id,
            currentScreenId: "CONFIRMATION",
            currentStageNo: 1,
            custDtlId: gApzCOB.userDetails.custDtlId,
            addressDtlsId: gApzCOB.userDetails.addressDtlsId,
            customerId: ProductData[0].productCode === "1001" ? "" : gApzCOB.userDetails.customerId,
            declarationFlag: gApzCOB.userDetails.declarationFlag,
            mobileNumber: !apz.isNull(gApzCOB.userDetails.mobileNum) ? gApzCOB.userDetails.mobileNum : "",
            productCode: apz.isNull(gApzCOB.productCode) ? "1009" : gApzCOB.productCode,
            productGroupCode: gApzCOB.product,
            searchCode1: gApzCOB.selLeadDtls.kendraId,
            searchCode2: gApzCOB.selLeadDtls.customerId,
            custDtlSlNum: gApzCOB.currentApplicant,
            applicantsCount: gApzCOB.noOfApplicants,
            mainProductGroupCode: gApzCOB.mainProductGroupCode,
            kendraId: gApzCOB.selLeadDtls.kendraId,
            kendraName: gApzCOB.selLeadDtls.kendraName,
            branchId: gApzCOB.selLeadDtls.glBranchId,
            branchName: gApzCOB.selLeadDtls.glBranchName,
            memberId: gApzCOB.selLeadDtls.customerId,
            primaryKycType: "Voter ID",
            primaryKycId: gApzCOB.selLeadDtls.primaryKyc,
            workitemNo: ProductData[0].productCode === "1001"
                ? String(gApzCOB.selLeadDtls.referenceId || gApzCOB.selLeadDtls.openMarketId)
                : gApzCOB.selLeadDtls.pid
        },
        workflow: workflow
    }
    apz.startLoader();
    ApzCOB.serverBuildParam(gAppId, "CreateLoan", "N", "N", req, false, apz.app.KMReviewConfirm.finalConfirmStageMovementCB);
};
