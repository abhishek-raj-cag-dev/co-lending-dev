apz.app.KMReviewConfirm.paintDocuments = function () {
    const s = inSessionStore;
    const docs = s?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList ?? [];
    const hasAdditionalDocs = docs?.some(doc => doc?.documentType === "ADDITIONAL_DOCS");
    const changedBank = docs?.some(doc => doc?.documentType === "CHANGED_BANK_DOCS"); // chinna added doc
    const editBankDetails = inSessionStore?.bankDetailsWrapperList?.[0]?.bankDetails?.payload?.editBankDetails;
    const bankDocumentType = inSessionStore?.bankDetailsWrapperList?.[0]?.bankDetails?.payload?.bankdocumentType;
    if (hasAdditionalDocs) {
        console.log("Additional documents exist");
        $("#KmSourc__KMReviewConfirm__additionalDocBlock").removeClass("sno"); // show
    } else {
        console.log("No additional documents");
        $("#KmSourc__KMReviewConfirm__additionalDocBlock").addClass("sno"); // hide
    }
    if (editBankDetails === "Yes") {
        $("#KmSourc__KMReviewConfirm__changedBankDocDiv").addClass("APP_BANK_ACCOUNT_PROOF");
        $("#KmSourc__KMReviewConfirm__firstBankDocDiv").removeClass("APP_BANK_ACCOUNT_PROOF");
        $("#KmSourc__KMReviewConfirm__changedBankDocDiv").removeClass("sno");
        $("#KmSourc__KMReviewConfirm__firstBankDocDiv").addClass("sno");
        $("#KmSourc__KMReviewConfirm__penniEnachtypeDocEle").addClass("sno");
        $("#KmSourc__KMReviewConfirm__changeBankofDoc").removeClass("sno");
        apz.setElmValue("KmSourc__OtherInfoData__i__newBankDetails__typeOfDocument_txtcnt",bankDocumentType)        
    } else {
        $("#KmSourc__KMReviewConfirm__firstBankDocDiv").addClass("APP_BANK_ACCOUNT_PROOF");
        $("#KmSourc__KMReviewConfirm__changedBankDocDiv").removeClass("APP_BANK_ACCOUNT_PROOF");
        $("#KmSourc__KMReviewConfirm__changedBankDocDiv").addClass("sno");
        $("#KmSourc__KMReviewConfirm__firstBankDocDiv").removeClass("sno");
        $("#KmSourc__KMReviewConfirm__penniEnachtypeDocEle").removeClass("sno");
        $("#KmSourc__KMReviewConfirm__changeBankofDoc").addClass("sno")
        apz.setElmValue("KmSourc__OtherInfoData__i__bankDetails__typeOfDocument_txtcnt",bankDocumentType)        
    }
    // ── Resolve custDtlId by customerType ────────────────────────────────────
    const custList = s?.customerDetailsList ?? [];
    const appDtlId = custList.find(c => c.customerType === 'Applicant')?.custDtlId;
    const coAppDtlId = custList.find(c => c.customerType === 'Co-App')?.custDtlId;

    const PREFIX_MAP = {
        'APP_': appDtlId,
        'CO_': coAppDtlId,
    };
    const PREFIXES = Object.keys(PREFIX_MAP);

    // ── Strip " Doc" suffix for comparison only ───────────────────────────────
    const normalizeType = (type) => type?.replace(/\s+Doc$/i, '').trim() ?? '';

    // ── Bytes → KB label ─────────────────────────────────────────────────────
    const toKB = (bytes) => bytes ? (bytes / 1024).toFixed(1) + ' KB' : '---';

    // ── Build request object for console log ─────────────────────────────────
    const buildDocReq = (doc) => ({
        appDocId: doc.appDocId,
        applicationId: doc.applicationId,
        appId: doc.appId,
        custDtlId: doc.custDtlId,
        documentId: doc.documentId,
        documentType: doc.documentType,
        documentFormat: doc.payload?.documentFormat,
        documentFileName: doc.payload?.documentFileName,
        documentLoc: doc.payload?.documentLoc,
        docSide: doc.payload?.docSide,
        docLevel: doc.payload?.docLevel,
        uploadedBy: doc.payload?.uploadedBy,
        uploadedTs: doc.payload?.uploadedTs,
        status: doc.status,
    });

    // ── Paint one uploadimg block with doc data ───────────────────────────────
    // Finds hyperlink / name / size by CLASS within the block — not by ID
    const paintBlock = (block, doc) => {

        // Hyperlink anchor — class "ett-hypl"
        const anchor = block.querySelector('a.ett-hypl');
        if (anchor) {
            // Hyperlink text — the <span> directly inside the anchor (not the svg)
            const hplTxt = anchor.querySelector('span');
            //if (hplTxt) hplTxt.textContent = doc.payload?.documentFormat || '---'; // chinna commented DOC
            if(!apz.isNull(doc)){
                if (hplTxt) hplTxt.textContent = doc?.payload?.documentFileName || '---'; // chinna added doc
                anchor.setAttribute('data-doc-id', doc.appDocId);
                anchor.setAttribute('data-doc-type', doc.documentType);
                anchor.setAttribute('data-doc-format', doc.payload?.documentFormat || '');
                anchor.onclick = function () {
                    const req = buildDocReq(doc);
                    console.log('[KMReviewConfirm] viewDocument request >', req);
                    apz.app.KMReviewConfirm.viewDocument(req.documentId);
                };
            }
        }

        // // Doc name — first "ett-para" span txtcnt (inside scb-col85)
        // const nameCol = block.querySelector('.scb-col85');
        // if (nameCol) {
        //     const nameTxt = nameCol.querySelector('p.ett-para span');
        //     if (nameTxt) nameTxt.textContent = doc.payload?.documentFileName || '---';
        // }

        // File size — second "ett-para" span txtcnt (inside scb-col15)
        const sizeCol = block.querySelector('.scb-col15');
        if (sizeCol) {
            const sizeTxt = sizeCol.querySelector('p.ett-para span');
            if (sizeTxt) sizeTxt.textContent = toKB(doc?.payload?.docSize || "");
        }
    };
    const paintedDocIds = new Set();
    // ── Non-doc utility classes on every uploadimg — ignore these ─────────────
    // const IGNORE_CLASSES = new Set(['srb', 'pri', 'uploadimg', 'scb-col100', 'lft', 'rht']); // chinna commented doc
    const IGNORE_CLASSES = new Set(['srb', 'pri', 'uploadimg', 'scb-col100', 'lft', 'rht', 'marginBottom']); // chinna added doc
    // ── Query only .uploadimg elements ────────────────────────────────────────
    document.querySelectorAll('.uploadimg').forEach((uploadBlock) => {
        
        // Skip already painted rows added for Defect CAGLM-369
    if (uploadBlock.classList.contains("km-doc-upload-row")) {
        return;
    } 
    //
        // chinna fix start - skip business address proof blocks, handled by paintBusinessDocs 15/06/2026
        if (uploadBlock.closest('[id*="businessAddressADdetailsBlc"]') ||
            uploadBlock.closest('.business-address-doc-container')) {
            return;
        }
        // chinna fix end 15/06/2026

        // Doc class = the ONE class not in ignore list
        const docClass = [...uploadBlock.classList].find(c => !IGNORE_CLASSES.has(c));
        if (!docClass) return;

        // Check for customer prefix (App_ / co_)
        const matchedPrefix = PREFIXES.find(p => docClass.startsWith(p));

        let matchedDocs;

        if (matchedPrefix) {
            const baseType = docClass.slice(matchedPrefix.length);
            const custDtlId = PREFIX_MAP[matchedPrefix];
            // chinna commenting start 15/06/2026
            // matchedDocs = docs.filter(d =>
            //     normalizeType(d.documentType) === baseType &&
            //     d.custDtlId === custDtlId
            // );
            // chinna commenting end 15/06/2026

            // chinna start 15/06/2026
            if (baseType === 'ADDRESS_PROOF') {
                // Present address block → only PRESENT desc docs
                matchedDocs = docs.filter(d =>
                    d.documentType === 'ADDRESS_PROOF' &&
                    d.custDtlId === custDtlId &&
                    (d.payload?.documentDesc || '').toUpperCase() === 'PRESENT'
                );
            } else if (baseType === 'PERMANENT_ADDRESS_PROOF') {
                // Permanent address block → resolve back to ADDRESS_PROOF type, filter by PERMANENT desc
                matchedDocs = docs.filter(d =>
                    d.documentType === 'ADDRESS_PROOF' &&
                    d.custDtlId === custDtlId &&
                    (d.payload?.documentDesc || '').toUpperCase() === 'PERMANENT'
                );
            } else {
                matchedDocs = docs.filter(d =>
                    (normalizeType(d.documentType) === baseType &&
                    (d.documentType == 'ADDITIONAL_DOCS' || d.custDtlId === custDtlId))
                );
            }
            // chinna end 15/06/2026

        } else {
            matchedDocs = docs.filter(d => normalizeType(d.documentType) === docClass);
        }
        // ── NEW: dedupe against docs already painted into an earlier block ──────
    matchedDocs = matchedDocs.filter(d => !paintedDocIds.has(d.appDocId));

        // chinna changes start 13/06/2025
        matchedDocs = matchedDocs.sort((a, b) => {
            const levelA = parseInt(a.payload?.docLevel) || 0;
            const levelB = parseInt(b.payload?.docLevel) || 0;
            return levelA - levelB;
        });
        // chinna changes end 15/06/2026
        if (!matchedDocs.length){
              uploadBlock.classList.add('sno');  
              return;  
        } else {
              uploadBlock.classList.remove('sno')  
        }
        // ── NEW: mark these docs as consumed so no later block repaints them ────
        matchedDocs.forEach(d => paintedDocIds.add(d.appDocId));
        if (docClass === values?.appResidencePremisePhoto) {
            const parent = uploadBlock?.parentNode;
            // remove duplicate html blocks already present
            parent?.querySelectorAll('.uploadimg.APP_RESIDENCE_PREMISE_PHOTO')?.forEach((block, index) => {
                if (index > 0) {
                    if (block?.nextElementSibling && block?.nextElementSibling.classList.contains('res-img-meta')) {
                        block?.nextElementSibling.remove();
                    }
                    block.remove();
                }
            });
            // remove existing metadata from original
            if (uploadBlock?.nextElementSibling && uploadBlock?.nextElementSibling.classList.contains('res-img-meta')) {
                uploadBlock?.nextElementSibling.remove();
            }
            matchedDocs?.forEach((doc, idx) => {
                let targetBlock;
                if (idx === 0) {
                    targetBlock = uploadBlock;
                } else {
                    targetBlock = uploadBlock.cloneNode(true);
                    targetBlock.querySelectorAll('[id]').forEach(el => {
                        el.id = el.id + '_clone_' + idx;
                    });
                    parent?.appendChild(targetBlock);
                }
                paintBlock(targetBlock, doc);
                let dateTimeStr = doc?.payload?.uploadedTs ? ApzCOB.formatDateTimeObject(doc?.payload.uploadedTs) : '---';
                let lat = (doc?.payload?.latitude || '').toString().trim();
                let lng = (doc?.payload?.longitude || '').toString().trim();
                let locationStr = (lat && lat !== '0' && lng && lng !== '0') ? `${lat}, ${lng}` : 'Not available';
                const metaDiv = document.createElement('div');
                metaDiv.className = 'res-img-meta mb16';
                metaDiv.innerHTML = `
<span>
<span class="res-meta-title">Date / Time: </span>
<span class="res-meta-value">${dateTimeStr}</span>
</span>
<span style="margin-left:20px;">
<span class="res-meta-title">Location: </span>
<span class="res-meta-value">${locationStr}</span>
</span>
        `;
                targetBlock.after(metaDiv);
            });
            return;
        }

        const parent = uploadBlock.parentNode;

        // Paint first doc into existing block
        paintBlock(uploadBlock, matchedDocs[0]);

        // Clone block for each additional doc of the same type
        matchedDocs.slice(1).forEach((doc, idx) => {
            const clone = uploadBlock.cloneNode(true);

            // Make all IDs unique on clone
            clone.querySelectorAll('[id]').forEach(el => {
                el.id = el.id + '_clone_' + (idx + 1);
            });

            parent.insertBefore(clone, uploadBlock.nextSibling);
            paintBlock(clone, doc);
        });
    });
};
apz.app.KMReviewConfirm.paintBusinessDocs = function () {
    const docs = inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList ?? [];
    // Business doc types mapping — normalized type → what's stored
    const BUSINESS_DOC_TYPES = ['Dairy Doc', 'Kirana Doc', 'Tailoring Doc', 'Other Doc'];
    document.querySelectorAll('.business-doc-container').forEach((container) => {

        const rowno = container.closest('[rowno]')?.getAttribute('rowno');
        if (rowno == null) return;
        const rowIndex = parseInt(rowno);
        // all business docs for this business
        const businessDocs = docs.filter(d =>
            BUSINESS_DOC_TYPES.includes(d.documentType) &&
            String(d.payload?.businessIndex) === String(rowIndex + 1)
        );

        if (!businessDocs.length) return;
        const template = container.querySelector('.uploadimg.APP_KIRANA');
        if (!template) return;

        // remove previously cloned docs
        container.querySelectorAll('.business-doc-clone').forEach(x => x.remove());
        businessDocs.forEach((doc, idx) => {
            let block;
            if (idx === 0) {
                block = template;
            } else {
                block = template.cloneNode(true);
                block.classList.add('business-doc-clone');
                block.querySelectorAll('[id]').forEach(el => {
                    el.id = el.id + '_doc_' + idx;
                });
                container.appendChild(block);
            }
            block.classList.remove('sno');
            const anchor = block.querySelector('a.ett-hypl');
            if (anchor) {
                const txt = anchor.querySelector('span');
                if (txt) {
                    // txt.textContent = doc.payload?.documentFileName || '---'; // chinna commented 09/06/2026
                    txt.textContent = doc.payload?.documentType || '---';  // chinna updated 09/06/2026
                }
                anchor.onclick = function () {
                    apz.app.KMReviewConfirm.viewDocument(doc.documentId);
                };
            }

            const sizeTxt = block.querySelector('.scb-col15 p.ett-para span');
            if (sizeTxt) {
                const bytes = doc.payload?.docSize;
                sizeTxt.textContent = bytes
                    ? (bytes / 1024).toFixed(1) + ' KB'
                    : '---';
            }
        });
    });

    document.querySelectorAll('.business-address-doc-container').forEach((container) => {
        const rowno = container.closest('[rowno]')?.getAttribute('rowno');
        if (rowno == null) return;
        const rowIndex = parseInt(rowno);
        // all business docs for this business
        const businessDocs = docs.filter(d =>
            BUSINESS_ADDRESS_PROOF.includes(d.documentType) &&
            String(d.payload?.docNo) === String(rowIndex + 1)
        );

        if (!businessDocs.length) return;
        const template = container.querySelector('.uploadimg.APP_KIRANA');
        if (!template) return;
        // remove previously cloned docs
        container.querySelectorAll('.business-doc-clone').forEach(x => x.remove());
        businessDocs.forEach((doc, idx) => {
            let block;
            if (idx === 0) {
                block = template;
            } else {
                block = template.cloneNode(true);
                block.classList.add('business-doc-clone');
                block.querySelectorAll('[id]').forEach(el => {
                    el.id = el.id + '_doc_' + idx;
                });
                container.appendChild(block);
            }
            block.classList.remove('sno');
            const anchor = block.querySelector('a.ett-hypl');
            if (anchor) {
                const txt = anchor.querySelector('span');
                if (txt) {
                    txt.textContent = doc.payload?.documentFileName || '---';
                }
                anchor.onclick = function () {
                    apz.app.KMReviewConfirm.viewDocument(doc.documentId);
                };
            }
            const sizeTxt = block.querySelector('.scb-col15 p.ett-para span');
            if (sizeTxt) {
                const bytes = doc.payload?.docSize;
                sizeTxt.textContent = bytes
                    ? (bytes / 1024).toFixed(1) + ' KB'
                    : '---';
            }
        });
    });
    $('.crt-list > ul.pri > li > span').css({
        'margin-bottom': '12px',
        'padding-bottom': '12px'
    });

    // ── chinna fix start ─────────── 09/06/2026
    document.querySelectorAll('.uploadimg.APP_ADDRESS_PROOF').forEach((uploadBlock) => {
        const anchor = uploadBlock.querySelector('a.ett-hypl[rowno]');
        if (!anchor) return;
        const rowno = anchor.getAttribute('rowno');
        if (rowno == null) return;
        const businessIndex = parseInt(rowno) + 1; // rowno is 0-based list index

        const addressDocs = docs.filter(d =>
            d.documentType === 'BUSINESS_ADDRESS_PROOF' &&
            String(d.payload?.businessIndex) === String(businessIndex)
        );

        if (!addressDocs.length) return;

        const parent = uploadBlock.parentNode;

        // Remove previously painted clones for this block
        parent.querySelectorAll('.business-addr-proof-clone').forEach(x => x.remove());

        // Paint first doc into the existing block
        const firstDoc = addressDocs[0];
        const firstTxt = anchor.querySelector('span');
        if (firstTxt) firstTxt.textContent = firstDoc.payload?.documentDesc || '---';
        anchor.onclick = function () {
            apz.app.KMReviewConfirm.viewDocument(firstDoc.documentId);
        };
        const firstSize = uploadBlock.querySelector('.scb-col15 p.ett-para span');
        if (firstSize) {
            firstSize.textContent = firstDoc.payload?.docSize
                ? (firstDoc.payload.docSize / 1024).toFixed(1) + ' KB'
                : '---';
        }

        addressDocs.slice(1).forEach((doc, idx) => {
            const clone = uploadBlock.cloneNode(true);
            clone.classList.add('business-addr-proof-clone');
            clone.querySelectorAll('[id]').forEach(el => {
                el.id = el.id + '_addrproof_' + (idx + 1);
            });

            const cloneAnchor = clone.querySelector('a.ett-hypl');
            if (cloneAnchor) {
                const cloneTxt = cloneAnchor.querySelector('span');
                if (cloneTxt) cloneTxt.textContent = doc.payload?.documentDesc || '---';
                cloneAnchor.onclick = function () {
                    apz.app.KMReviewConfirm.viewDocument(doc.documentId);
                };
            }
            const cloneSize = clone.querySelector('.scb-col15 p.ett-para span');
            if (cloneSize) {
                cloneSize.textContent = doc.payload?.docSize
                    ? (doc.payload.docSize / 1024).toFixed(1) + ' KB'
                    : '---';
            }

            parent.insertBefore(clone, uploadBlock.nextSibling);
        });
    });
    // ── chinna fix end 09/06/2026 ───────────────────────────────────────────────────────

    $('[id="KmSourc__KMReviewConfirm__businessPremiDoc_row"]').each(function () { // chinna updated 09/06/2026
        const div = document.createElement('div');

        div.id = this.id;
        div.className = this.className;
        div.style.cssText = this.style.cssText;

        while (this.firstChild) {
            div.appendChild(this.firstChild);
        }

        this.parentNode.replaceChild(div, this);
    });
    $('.uploadimg').css('marginTop', '8px');
};
apz.app.KMReviewConfirm.viewDocument = function (documentId) {
    //  let $uploadDiv = $(pthis).closest('.uploadimg');
    // let documentId = $uploadDiv.attr('data-doc-id');
    if (!documentId) {
        ApzCOB.fnDisplayMsg("Document is not available");
        return;
    }
    window._aadhaarDocIds = [];
    window._aadhaarDocIdx = 0;
    $(`#${kmbaseScr}docNavRow`).addClass('sno');
    let docDetails = inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList.find(doc => parseInt(doc.appDocId) === parseInt(
        documentId));
    if (!apz.isObjectEmpty(docDetails)) {
        //window.paintFileName = docDetails?.payload?.documentFormat || (docDetails?.payload?.documentFileName + ".jpg"); // chinna commented doc
        window.paintFileName = docDetails?.payload?.documentFileName; // chinna added doc
        const specialDocTypes = [     // chinna added 09/06/2026
            "Dairy Doc",
            "Tailoring Doc",
            "Other Doc",
            "Kirana Doc"
        ];
        window.ImageLocationDetails = {
            latitude: docDetails?.payload?.latitude || "",
            longitude: docDetails?.payload?.longitude || "",
            uploadedTs: docDetails?.payload?.uploadedTs || "",
            // documentFileName: docDetails?.payload?.documentFileName || "",  // chinna commented this 09/06/2026
            documentFileName: docDetails?.payload?.documentType === "BUSINESS_ADDRESS_PROOF"
                ? docDetails?.payload?.documentDesc : specialDocTypes.includes(docDetails?.payload?.documentType)
                    ? docDetails?.payload?.documentType : docDetails?.payload?.documentFileName || "" // chinna added this 09/06/2026
        };
        ApzCOB.downloadFileFromServer(paintFileName, apz.app.Kmbase.viewDocumentCB);
    } else {
        ApzCOB.fnDisplayMsg("Document is not available");
    }
}
/* Final Stage Movement API*/
