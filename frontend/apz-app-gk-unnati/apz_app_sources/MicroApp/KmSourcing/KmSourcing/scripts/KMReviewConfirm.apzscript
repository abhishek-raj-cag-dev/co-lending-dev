var getAddressLabel = (addressSameAs) => {
    const addressLabelMap = {
        "ApplicantVoter": "Applicant's voter ID address",
        "Co-AppVoter": "Co-applicant's voter ID address",
        "ApplicantAadhaar": "Applicant's aadhaar card address",
        "Co-AppAadhaar": "Co-applicant's aadhaar card address",
        "ApplicantSecondaryKyc": "Applicant's aadhaar card address", // chinna added 09/06/2026
        "Co-AppSecondaryKyc": "Co-applicant's aadhaar card address", // chinna added 09/06/2026
        "Other": "Other address"
    };
    return addressLabelMap?.[addressSameAs] ?? null;
};

var getOwnedBy = (business) => {
    return business?.DairyType
        ?? business?.tailoringType
        ?? business?.kiranaType
        ?? business?.otherType
        ?? null;
};

var mapBusinessWithAddress = (businessData, addressDetailsList) => {
    const occupationAddressList = addressDetailsList
        ?.find(item => item?.addressType === "Occupation")
        ?.payload?.addressList ?? [];

    const allBusinesses = Object.entries(businessData ?? {})
        .flatMap(([type, list]) =>
            (list ?? []).map(business => ({ ...business, businessCategory: type }))
        )
        .sort((a, b) => Number(a?.businessIndex) - Number(b?.businessIndex));

    return allBusinesses.map((business, index) => {
        const matchedAddress = occupationAddressList
            ?.find(addr => String(addr?.businessIndex) === String(business?.businessIndex))
            ?? occupationAddressList?.find(addr => addr?.addressSameAs === business?.addressSameAs)
            ?? {};

        const isOther = business?.addressSameAs === "Other";

        const mergedAddressTxt = !isOther
            ? [
                matchedAddress?.addressLine1,
                matchedAddress?.addressLine2,
                matchedAddress?.addressLine3,
                matchedAddress?.city,
                matchedAddress?.district,
                matchedAddress?.state,
                matchedAddress?.pinCode
            ].filter(Boolean).join(", ")
            : "Other";

        const ownedBy = getOwnedBy(business);

        const ownedByLabel = ownedBy === "Applicant" ? "Applicant's Business"
            : ownedBy === "Co-Applicant" ? "Co-Applicant's Business"
                : ownedBy === "Both" ? "Applicant's & Co-Applicant's Business"
                    : null;

        const businessType = business?.businessCategory === "Other"
            ? (business?.lineOfOtherBusiness ?? "Other")
            : business?.businessCategory ?? null;

        return {
            // Business fields
            buisnessCount: business?.businessIndex ?? null,  // ✅ updated
            ownedByBis: ownedByLabel,
            netBusinessIncomeBis: business?.netMonthlyIncome ?? business?.netBusinessIncome ?? null,
            businessType: businessType,
            otherLineOfBusinessBis: business?.lineOfOtherBusiness ?? null,
            isStreetVendorBis: business?.streetVendor ?? null,

            // Address fields
            addressSameAs: business?.addressSameAs ?? null,
            addressLbl: getAddressLabel(business?.addressSameAs),
            addressTxt: mergedAddressTxt ?? null,
            addressLine1Bis: matchedAddress?.addressLine1 ?? null,
            addressLine2Bis: matchedAddress?.addressLine2 ?? null,
            addressLine3Bis: matchedAddress?.addressLine3 ?? null,
            pincodeBis: matchedAddress?.pinCode ?? null,
            cityOrTownBis: matchedAddress?.city ?? null,
            districtBis: matchedAddress?.district ?? null,
            stateBis: matchedAddress?.state ?? null,
            AddressProofBis: matchedAddress?.currentAddressProof ?? null,
        };
    });
};
apz.app.KMReviewConfirm.paintBusinessDetails = function () {
    apz.data.scrdata.KmSourc__IPaintReviewBusiness_Req = {}
    apz.data.scrdata.KmSourc__IPaintReviewBusiness_Req.businessIncomeDetails = mapBusinessWithAddress(inSessionStore?.bcmpiIncomeDetails?.bcmpiIncomeDetailsWrapper?.business, inSessionStore?.addressDetailsWrapperList?.[0]?.addressDetailsList);
    apz.data.loadData("IPaintReviewBusiness", "KmSourc")
    Promise.resolve().then(() => {
        const businessList = apz.data.scrdata.KmSourc__IPaintReviewBusiness_Req.businessIncomeDetails || [];
        const isVisheshProduct = gApzCOB.SelectedProductName === "Vishesh" && gApzCOB.productCode === "1003";
        if (!businessList.length) {
            $('#KmSourc__KMReviewConfirm__businessLstDiv').addClass('sno')
            if(isVisheshProduct){
                $('#KmSourc__KMReviewConfirm__el_txt_1208_ul').addClass('sno');
                $('#KmSourc__KMReviewConfirm__ct_nav_1').addClass('sno');
                $('#KmSourc__KMReviewConfirm__ct_frm_35').addClass('sno');
            }
            return;
        }
        $('input[type="radio"][id*="businessRadioButton"][id*="option_presentOther"]')
            .not('#KmSourc__KMReviewConfirm__othAddressRadioBtn_option_presentOther')
            .not('#KmSourc__KMReviewConfirm__permRadioBtnOne_option_presentOther')
            .not('#KmSourc__KMReviewConfirm__secondAddPresRadio_option_presentOther')
            .not('#KmSourc__KMReviewConfirm__secondAddPermRadio_option_presentOther')
            .prop("checked", true);
        businessList.forEach((business, index) => {
            if (business?.addressSameAs !== "Other") {
                // hide all address related fields (label + value)
                ["addressLine1Bis", "addressLine2Bis", "addressLine3Bis", "pincodeBis", "cityOrTownBis", "districtBis",
                    "stateBis", "AddressProofBis"
                ].forEach(field => {
                    $(`#KmSourc__IPaintReviewBusiness__i__businessIncomeDetails__${field}_${index}`).closest('.srb').prev(
                        '.srb').addBack().addClass('sno');
                });
                // hide upload document
                $(`#KmSourc__KMReviewConfirm__businessHypLink_${index}`).closest('.uploadimg').addClass('sno');
                // hide wrapper block
                $(`#KmSourc__IPaintReviewBusiness__i__businessIncomeDetails__addressLine1Bis_${index}`).closest(
                    'span[id="KmSourc__KMReviewConfirm__businessAddressADdetailsBlc_li"]').addClass('sno');
            }
            // ── chinna fix start: Other line of business — show only for Other type ── 09/06/2026
            const otherLinePara = document.getElementById(
                `KmSourc__IPaintReviewBusiness__i__businessIncomeDetails__otherLineOfBusinessBis_${index}`
            );
            if (otherLinePara) {
                const isOtherBusiness = business?.businessType !== null
                    && business?.businessType !== undefined
                    && business?.businessType !== "dairy"
                    && business?.businessType !== "Tailoring"
                    && business?.businessType !== "Kirana";

                const isOtherCategory = !["dairy", "Tailoring", "Kirana"].includes(
                    // re-derive category from businessType sentinel values
                    business?.businessType === "dairy" ? "dairy"
                        : business?.businessType === "Tailoring" ? "Tailoring"
                            : business?.businessType === "Kirana" ? "Kirana"
                                : "Other"
                );
                if (isOtherCategory) {
                    // show: remove sno from the label row + value row
                    otherLinePara.closest('.srb')?.parentElement?.parentElement?.classList.remove('sno');
                    otherLinePara.closest('.srb')?.parentElement?.parentElement?.previousElementSibling?.classList.remove('sno');
                } else {
                    // hide: add sno to the label row + value row
                    otherLinePara.closest('.srb')?.parentElement?.parentElement?.classList.add('sno');
                    otherLinePara.closest('.srb')?.parentElement?.previousElementSibling?.classList.add('sno');
                }
            }
            // ── Street vendor — show only for Kirana type ─────────────────────
            const streetVendorPara = document.getElementById(
                `KmSourc__IPaintReviewBusiness__i__businessIncomeDetails__isStreetVendorBis_${index}`
            );
            if (streetVendorPara) {
                const isKirana = business?.businessType === "Kirana";
                if (isKirana) {
                    streetVendorPara.closest('.srb')?.classList.remove('sno');
                    streetVendorPara.closest('.srb')?.previousElementSibling?.classList.remove('sno');
                } else {
                    streetVendorPara.closest('.srb')?.classList.add('sno');
                    streetVendorPara.closest('.srb')?.previousElementSibling?.classList.add('sno');
                }
            }
            // ── chinna fix end ──────────────────────────────────────────────── 09/06/2026
        });
        // chinna start 09/06/2026
        document.querySelectorAll('[id*="KMReviewConfirm__addressTypeSelRow_row"]').forEach((bodyRow) => {
            const bodyWrap = bodyRow.closest('[id*="businessAddreMainRow_row"]');
            if (bodyWrap) {
                bodyWrap.classList.add('crt-list', 'list-data', 'pt0', 'pb0', 'address-table', 'kmsourcing-table', 'addr-body-list');
            }
        });

        document.querySelectorAll('[id*="KMReviewConfirm__businessAddreHeader_row"]').forEach((headerRow) => {
            const headerWrap = headerRow.closest('[id*="businessAddresMainRow_row"]');
            if (headerWrap) {
                headerWrap.classList.add('crt-list', 'list-hdr', 'pb0', 'address-table', 'addr-header-list');
            }
        });
        // chinna end 09/06/2026
    });
    const incomeSources = getAvailableIncomeSources(inSessionStore?.bcmpiIncomeDetails?.bcmpiIncomeDetailsWrapper || {});
    $("#KmSourc__KMReviewConfirm__sourceOfIncomeTypes_txtcnt").text(incomeSources);
}
function getAvailableIncomeSources(incomeWrapper) {
    const sources = [];
    if (incomeWrapper?.business && Object.keys(incomeWrapper?.business).some(key => Array.isArray(incomeWrapper?.business[key]) && incomeWrapper
        .business[key].length > 0)) {
        sources.push("Business");
    }
    if (incomeWrapper?.agriculture && Object.keys(incomeWrapper?.agriculture).length > 0) {
        sources.push("Agriculture");
    }
    if (incomeWrapper?.salary && Object.keys(incomeWrapper?.salary).length > 0) {
        sources.push("Salary");
    }
    if (incomeWrapper?.wage && Object.keys(incomeWrapper?.wage).length > 0) {
        sources.push("Wage");
    }
    if (incomeWrapper?.pension && Object.keys(incomeWrapper?.pension).length > 0) {
        sources.push("Pension");
    }
    if (incomeWrapper?.rentalIncome && Object.keys(incomeWrapper?.rentalIncome).length > 0) {
        sources.push("Rental Income");
    }
    return sources.join(", ");
}

var checkAddressesSame = (presentAddr, permanentAddr) => {
    // Define the critical fields that determine if the address is the same
    const fieldsToCompare = [
        'addressLine1',
        'addressLine2',
        'addressLine3',
        'area',
        'city',
        'district',
        'state',
        'country',
        'pinCode'
    ];

    // Check if every single field matches between the two objects
    const isSame = fieldsToCompare.every(field => {
        // Normalize values to handle cases like undefined vs "" or different casing
        const val1 = (presentAddr[field] || '').toString().trim().toLowerCase();
        const val2 = (permanentAddr[field] || '').toString().trim().toLowerCase();
        return val1 === val2;
    });

    return isSame;
}

apz.app.KMReviewConfirm.paintIncomeSummary = function () {

    const P = 'KmSourc__KMReviewConfirm__';
    const inc = inSessionStore?.bcmpiIncomeDetails?.bcmpiIncomeDetailsWrapper ?? {};
    const biz = inc?.business ?? {};

    const toNum = (v) => { const n = parseFloat(String(v ?? '').replace(/,/g, '')); return isNaN(n) ? 0 : n; };
    const fmtINR = (n) => n ? `₹ ${Number(n).toLocaleString('en-IN')}` : '---';
    const setTxt = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v ?? '---'; };

    const ownerLabel = (v) => {
        switch (v) {
            case 'Applicant': return "Applicant";
            case 'Co-Applicant': return "Co-Applicant";
            case 'Both': return "Both";
            default: return v ?? '---';
        }
    };

    const BIZ_CFG = {
        dairy: { label: 'Dairy', ownerKey: 'DairyType', incKey: 'netMonthlyIncome' },
        Tailoring: { label: 'Tailoring', ownerKey: 'tailoringType', incKey: 'netMonthlyIncome' },
        Kirana: { label: 'Kirana/Utility store', ownerKey: 'kiranaType', incKey: 'netMonthlyIncome' },
        Other: { label: 'Other', ownerKey: 'otherType', incKey: 'netBusinessIncome' },
    };

    const allEntries = [];
    Object.keys(BIZ_CFG).forEach(typeKey => {
        const cfg = BIZ_CFG[typeKey];
        const entries = biz[typeKey] ?? [];
        entries.forEach(entry => allEntries.push({ typeKey, cfg, entry }));
    });
    allEntries.sort((a, b) => toNum(a.entry.businessIndex) - toNum(b.entry.businessIndex));

    const bizGroups = {};           // { 'dairy': { totalIncome, owners:Set, count, cfg }, ... }
    allEntries.forEach(({ typeKey, cfg, entry }) => {
        if (!bizGroups[typeKey]) {
            bizGroups[typeKey] = { totalIncome: 0, owners: new Set(), count: 0, cfg };
        }
        bizGroups[typeKey].totalIncome += toNum(entry[cfg.incKey]);
        const owner = entry[cfg.ownerKey];
        if (owner) bizGroups[typeKey].owners.add(ownerLabel(owner));
        bizGroups[typeKey].count++;
    });

    const orderedTypes = [];
    allEntries.forEach(({ typeKey }) => {
        if (!orderedTypes.includes(typeKey)) orderedTypes.push(typeKey);
    });

    const templateRow = document.getElementById('KmSourc__KMReviewConfirm__sc_row_3223');
    if (templateRow) {
        // Remove old clones from any previous paint
        document.querySelectorAll('.biz-income-clone').forEach(el => el.remove());
        const parent = templateRow.parentNode;

        orderedTypes.forEach((typeKey, idx) => {
            const grp = bizGroups[typeKey];
            let row;

            if (idx === 0) {
                row = templateRow;
                row.classList.remove('sno');
            } else {
                row = templateRow.cloneNode(true);
                row.classList.add('biz-income-clone');
                row.querySelectorAll('[id]').forEach(el => { el.id = el.id + `_bizgrp_${idx}`; });
                parent.appendChild(row);
            }

            const cells = row.querySelectorAll('dd.eic');

            // Cell 1 — "Business N - TypeLabel"  (N = row number in summary, 1-based)
            if (cells[0]) cells[0].textContent = `Business ${idx + 1} - ${grp.cfg.label}`;

            // Cell 2 — owners joined  e.g. "Applicant, Both"
            if (cells[1]) cells[1].textContent = [...grp.owners].join(', ') || '---';

            // Cell 3 — total income formatted
            if (cells[2]) cells[2].textContent = fmtINR(grp.totalIncome);
        });

        if (!orderedTypes.length) templateRow.classList.add('sno');
    }

    const paintOtherRow = (ownerElId, incomeElId, appVal, coAppVal) => {
        const hasApp = appVal !== undefined && appVal !== null && String(appVal).trim() !== '';
        const hasCoApp = coAppVal !== undefined && coAppVal !== null && String(coAppVal).trim() !== '';

        // Always keep the row visible — show "None" when no data
        $(`#${ownerElId}_ctrl_grp_div`).closest('.srb').removeClass('sno');

        let owner = hasApp && hasCoApp ? 'Both'
            : hasApp ? 'Applicant'
                : hasCoApp ? 'Co-Applicant'
                    : 'None';   // ← new

        const total = toNum(appVal) + toNum(coAppVal);

        const ownerEl = document.getElementById(ownerElId);
        const incomeEl = document.getElementById(incomeElId);
        if (ownerEl) ownerEl.textContent = owner;
        if (incomeEl) incomeEl.textContent = total > 0 ? fmtINR(total) : "₹ 0";
    };


    paintOtherRow(
        `${P}otherInAgrBis`, `${P}otherAgrIncomeBis`,
        inc?.agriculture?.applicant?.declaredIncome,
        inc?.agriculture?.coApplicant?.declaredIncome
    );

    paintOtherRow(
        `${P}otherInASalBis`, `${P}otherSalIncomeBis`,
        inc?.salary?.applicant?.netSalary,
        inc?.salary?.coApplicant?.netSalary
    );

    paintOtherRow(
        `${P}otherInAWageBis`, `${P}otherWageIncomeBis`,
        inc?.wage?.applicant?.other?.selfDeclaredWage,
        inc?.wage?.coApplicant?.other?.selfDeclaredWage
    );

    paintOtherRow(
        `${P}otherInPensionBis`, `${P}otherPensionIncomeBis`,
        inc?.pension?.applicant?.applicantPensionIncome,
        inc?.pension?.coApplicant?.coApplicantPensionIncome
    );

    paintOtherRow(
        `${P}otherInRentalBis`, `${P}otherRentalIncomeBis`,
        inc?.rentalIncome?.applicant?.monthlyRentalIncome,
        inc?.rentalIncome?.coApplicant?.monthlyRentalIncome
    );

    const sumArr = (arr, key) =>
        (arr ?? []).reduce((s, e) => s + toNum(e[key] ?? e.netMonthlyIncome ?? e.netBusinessIncome), 0);

    const sumBoth = (appVal, coAppVal) => toNum(appVal) + toNum(coAppVal);

    const dairyTotal = sumArr(biz.dairy, 'netMonthlyIncome');
    const kiranaTotal = sumArr(biz.Kirana, 'netMonthlyIncome');
    const tailoringTotal = sumArr(biz.Tailoring, 'netMonthlyIncome');
    const otherTotal = sumArr(biz.Other, 'netBusinessIncome');

    const agriTotal = sumBoth(inc?.agriculture?.applicant?.declaredIncome, inc?.agriculture?.coApplicant?.declaredIncome);
    const salaryTotal = sumBoth(inc?.salary?.applicant?.netSalary, inc?.salary?.coApplicant?.netSalary);
    const wageTotal = sumBoth(inc?.wage?.applicant?.other?.selfDeclaredWage, inc?.wage?.coApplicant?.other?.selfDeclaredWage);
    const pensionTotal = sumBoth(inc?.pension?.applicant?.applicantPensionIncome, inc?.pension?.coApplicant?.coApplicantPensionIncome);
    const rentalTotal = sumBoth(inc?.rentalIncome?.applicant?.monthlyRentalIncome, inc?.rentalIncome?.coApplicant?.monthlyRentalIncome);

    const monthly = dairyTotal + kiranaTotal + tailoringTotal + otherTotal
        + agriTotal + salaryTotal + wageTotal + pensionTotal + rentalTotal;
    const annually = monthly * 12;

    const monthEl = document.getElementById(`${P}totalNetMonthBis`);
    const annualEl = document.getElementById(`${P}totalNetAnuallyBis`);
    if (monthEl) monthEl.textContent = fmtINR(monthly);
    if (annualEl) annualEl.textContent = fmtINR(annually);
};
apz.app.ReviewConfirm.reInitiateReject = function (pthis, gaction) {
    apz.startLoader();
    apz.app.BaseScreens.stageBasedOnAction(pthis, gaction);
    window.approveRejectAction = gaction;
    if (!apz.isNull(inSessionStore.customerDetailsList)) {
        if (inSessionStore.customerDetailsList.length > 0) {
            inSessionStore.customerDetailsList.map(cust => {
                if (cust.customerType === "Applicant") {
                    gApzCOB.userDetails.custDtlId = cust.custDtlId;
                } else {
                    gApzCOB.userDetails.CoApplicantCustomerId = cust.custDtlId;
                }
            })
        }
    }
    var req = {
        "apiRequest": {
            // "interfaceName": approveRejectAction === 'APPROVED' ? "CreateApplication" : "",
            "interfaceName": "",
            "appId": gAppId,
            "requestObj": {
                "appId": gApzCOB.userDetails.appId,
                "status": "INPROGRESS",
                "userId": gApzCOB.LoggedInUserDetails.loginResponse.userDet.id,
                "applicationId": gApzCOB.userDetails.applicationId,
                "versionNum": gApzCOB.userDetails.versionNum,
                "custDtlId": gApzCOB.userDetails.custDtlId,
                "remarks": "",
                "workflow": {
                    "currentRole": "Initiator",
                    "action": "REINITIATE",
                    "workflowId": "REJECTAPPLICATION",
                    "stage": "INPUT"
                }
            }
        }
    }
    ApzCOB.serverBuildParam(gAppId, "RejectReinitiate", "N", "N", req, false, apz.app.ReviewConfirm.reInitiateRejectCB);
};
apz.app.ReviewConfirm.reInitiateRejectCB = function (params) {
    try {
        if (ApzCOB.handleServiceCallBacks(params)) {
            window.IS_REINITIATE_APPLICATION = true;
            window.currentApplication = "InProgress";
            ApzCOB.FetchApplication(undefined, apz.app.KMReviewConfirm.fetchAppCB);
            if (!apz.isNull(inSessionStore)) {
                window.bankIndex = inSessionStore?.bankDetailsWrapperList?.findIndex(el => el.bankDetails.custDtlId === ApzCOB.getCustDetailID('Applicant'))
            }
            if (inSessionStore?.bankDetailsWrapperList?.[bankIndex]?.bankDetails?.payload) {
                inSessionStore.bankDetailsWrapperList[bankIndex].bankDetails.payload.accntVerified = "";
            }
            //  else {
            //     ApzCOB.getPayloadDatafromWrapper("accntVerified", "Applicant", "bankDetailsWrapperList") = '';
            // }
        } else {
            apz.stopLoader();
            ApzCOB.fnDisplayMsg(ApzCOB.getDescfromLitCode("LIT_REJECT_REINITIATE_SERVICE_FAILED"), "E");
        }
    } catch (e) {
        ApzCOB.traceFrontEndError(e,"");
    }
}
apz.app.KMReviewConfirm.fetchAppCB = function (params) {
    try {
        if (ApzCOB.handleServiceCallBacks(params)) {
            apz.stopLoader();
            ApzCOB.updateInsessionData(params);
            ApzCOB.launchSubScreen("CBcheck", "KmSourc__Kmbase__KMLaunchCol", "");
        }
    } catch(e) {
    ApzCOB.traceFrontEndError(e,"");
    }
}
apz.app.KMReviewConfirm.paintAMLResponses = function () {
    const amlList = inSessionStore?.amlQuestion?.payload?.amlQuestionList || [];
    amlList.forEach((item, index) => {
        const appText =
            String(item.applicant).toLowerCase() === "yes"
                ? "Yes (Low Risk)"
                : "No (High Risk)";
        const coAppText =
            String(item.coApplicant).toLowerCase() === "yes"
                ? "Yes (Low Risk)"
                : "No (High Risk)";
        $(`#KmSourc__KMReviewConfirm__appQuestVal_${index}_option_yes_span_${index}`).text(appText);
        $(`#KmSourc__KMReviewConfirm__co-appQuestVal_${index}_option_yes_span_${index}`).text(coAppText);
        $(`#KmSourc__KMReviewConfirm__appQuestVal_${index}_option_yes`).prop("checked", true).prop("disabled", true);
        $(`#KmSourc__KMReviewConfirm__co-appQuestVal_${index}_option_yes`).prop("checked", true).prop("disabled", true);
        $(`[id*='appQuestVal_${index}_option_yes']`)
            .parent()
            .css({
                "pointer-events": "none",
                "opacity": "0.7"
            });
    });
};
apz.app.KMReviewConfirm.fnDateFormat = function (pthis) {
    if (!pthis) return '';
    const parts = pthis.split(/[-/]/);
    return parts[0].length === 4
        ? `${parts[2]}/${parts[1]}/${parts[0]}`
        : `${parts[0]}/${parts[1]}/${parts[2]}`;
}
