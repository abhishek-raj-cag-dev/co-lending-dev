var kmScrId = 'KmSourc__KMReviewConfirm__',
    KM_CURR_STAGE_NAME = 'KMReviewConfirm',
    KM_CURR_STAGE_NO;
    if(!iskmPreview) KM_CURR_STAGE_NO = 5;
var custDetIndexApp = "";
var custDetIndexCoApp = "";
var values = {
    Other: "Other",
    Present: "Present",
    relationshipProof: "RELATIONSHIP_PROOF",
    appResidencePremisePhoto: "APP_RESIDENCE_PREMISE_PHOTO",
    changeBankDocs: "CHANGED_BANK_DOCS", // chinna added doc
    firstBankAccProof: "BANK_ACCOUNT_PROOF" // chinna added doc
}
apz.app.onLoad_KMReviewConfirm = function () {
    let hidefooterElements = ['nxtBtn', 'SaveDraft'];
    hidefooterElements.forEach(id => {
        $(`#${kmbaseScr}${id}`).addClass('sno');
    });
    if (!(window.currentApplication === 'Rejected')) {
        apz.app.Kmbase.toggleSidebar();
    }
};
apz.app.onShown_KMReviewConfirm = function () {
    // Chinna start
    var reviewHypId = kmbaseScr + "KMReviewConfirm_hyp";
    if(!iskmPreview){
        $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
        $(`#${kmbaseScr}KMReviewConfirm_hyp`).addClass('active');
    }
    var cbApp = apz.app.Kmbase.getSrcVerifiedStatus(1, "A");
    var cbCoApp = apz.app.Kmbase.getSrcVerifiedStatus(1, "C");
    var aadhaarApp = apz.app.Kmbase.getSrcVerifiedStatus(2, "A");
    var aadhaarCoApp = apz.app.Kmbase.getSrcVerifiedStatus(2, "C");
    var business = apz.app.Kmbase.getSrcVerifiedStatus(3, "A");
    var otherInfo = apz.app.Kmbase.getSrcVerifiedStatus(4, "A");

    var allVerified = (cbApp === "Y" && cbCoApp === "Y" && aadhaarApp === "Y" && aadhaarCoApp === "Y" && business === "Y" && otherInfo === "Y");
    console.log("allVerified", allVerified);
    // chinna end

    $(`#KmSourc__KMReviewConfirm__appNachSuc`).addClass("kmenachsucc ");
    $(`#KmSourc__KMReviewConfirm__coappNachSuc`).addClass("kmenachsucc ");
    $(`#KmSourc__KMReviewConfirm__appNachFail`).addClass("kmenacherr");
    $(`#KmSourc__KMReviewConfirm__coappNachFail`).addClass("kmenacherr");
    // apz.app.KMReviewConfirm.paintData();
    // ApzCOB.FetchApplication();
    // apz.app.KMReviewConfirm.paintDataForOtherInformation();
    // apz.app.KMReviewConfirm.paintDocuments();
    // apz.app.KMReviewConfirm.paintBusinessDetails();
    // apz.app.KMReviewConfirm.paintIncomeSummary();
    // chinna fix start - wrap all paint calls inside FetchApplication callback
    // so inSessionStore is fully populated before painting on first load
    ApzCOB.FetchApplication(); //16th june changes
    // setTimeout(function () {
    //     apz.app.KMReviewConfirm.paintData();
    //     apz.app.KMReviewConfirm.paintDataForOtherInformation();
    //     apz.app.KMReviewConfirm.paintDocuments();
    //     apz.app.KMReviewConfirm.paintBusinessDetails();
    //     apz.app.KMReviewConfirm.paintBusinessDocs();
    //     apz.app.KMReviewConfirm.paintIncomeSummary();
    // }, 1000);
    // chinna fix end
    //$('input[type="radio"][id*="option_presentOther"]')
    // .not('#KmSourc__KMReviewConfirm__othAddressRadioBtn_option_presentOther')
    // .not('#KmSourc__KMReviewConfirm__permRadioBtnOne_option_presentOther')
    // .not('#KmSourc__KMReviewConfirm__secondAddPresRadio_option_presentOther')
    // .not('#KmSourc__KMReviewConfirm__secondAddPermRadio_option_presentOther')
    // .prop("checked", true);
    document.querySelectorAll("#KmSourc__KMReviewConfirm__amlList input[type='radio']").forEach(radio => radio.disabled = true);
    if (window.currentApplication === 'Rejected') {
        $(`#${kmScrId}screenTitle_txtcnt`).text("Re-initiate");
        $(`#${kmbaseScr}confirmBtn`).addClass('sno');
        $(`#${kmScrId}rejectReasonRow`).removeClass('sno');
        $(`#${kmScrId}rejectReasonTitle_txtcnt`).addClass('rejTitle');
        const rejectedDetails = inSessionStore?.applicationTimelineDtl?.[
            inSessionStore?.applicationTimelineDtl?.length - 1];
        ApzCOB.fetchQueryResponseFromAllStage(rejectedDetails, `#KmSourc__KMReviewConfirm__rejectReasonList`);
        const rejectedReasons = rejectedDetails?.remarks?.split('|') ?? [];
        const reasonsList = JSON.parse((DBKIT_MASTERDATA || []).find(s => s.stageName === "KMREJECT" && s.appId === "ALL").rejectReasons).rejectReason;
        let rejectedReasonsDescList = [];
        const lastReason = rejectedReasons[rejectedReasons.length - 1];
        if (rejectedDetails.stage.includes("RPC")) {
            rejectedReasonsDescList = rejectedDetails?.remarks ? [rejectedDetails.remarks] : [];
        }
        else {
            rejectedReasonsDescList = reasonsList?.filter(
                item => rejectedReasons.includes(item.id))?.map(item => item.value);
            if (lastReason?.startsWith("oth?")) {
                rejectedReasonsDescList.push(lastReason.substring(4));
            }
        }
        if (rejectedReasonsDescList.length < 1 && typeof lastReason == 'string') {
            rejectedReasonsDescList.push(...rejectedReasons);
        }
        const rejectRemark = $(`#${kmScrId}rejectReasonList`);
        if (rejectedReasonsDescList.length > 1) {
            rejectRemark.html(rejectedReasonsDescList.filter(msg => msg).map(msg => `• ${msg}`).join("<br>"));
        } else {
            rejectRemark.html(rejectedReasonsDescList[0]);
        }
        const otherDetails = [];
        otherDetails.push(rejectedDetails.userId);
        if (rejectedDetails.stage) otherDetails.push(rejectedDetails.stage);
        otherDetails.push(rejectedDetails.timeStamp);
        $(`#${kmScrId}rejectOtherDetails`).html(otherDetails.join(" | "));
    }
    else {
        $(`#${kmScrId}screenTitle_txtcnt`).text("Review & Confirm");
        $(`#${kmbaseScr}confirmBtn`).removeClass('sno');
        $(`#${kmScrId}rejectReasonRow`).addClass('sno');
    }
    if (inSessionStore?.srcStatDetails && inSessionStore?.srcStatDetails?.length !== 0) {
        $(`#${kmbaseScr}sendback`).removeClass('sno')
        $(`#${kmbaseScr}confirmBtn`).prop('disabled', true)
    } else {
        $(`#${kmbaseScr}sendback`).addClass('sno')
        if (!allVerified) {
            $(`#${kmbaseScr}confirmBtn`).prop('disabled', true);
        } else {
            $(`#${kmbaseScr}confirmBtn`).prop('disabled', false);
        }
    }
    ApzCOB.scrollTopKMSourcing();

    // chinna changes end
    //apz.app.Kmbase.checkpendingstage(); // chinna commented this because of apz.app.Kmbase.checkpendingstage is not a function
    $(`#${kmbaseScr}KMReviewConfirm_hyp`).removeClass("disabled-sidebar")
    if (iskmPreview) {
        apz.app.Kmbase.hideNshowBtns();
    } else {
        $(`#${kmbaseScr}scrDtls`).addClass('disabled-sidebar');
    }
    if ($("#KmSourc__Kmbase__sidebar_col").hasClass("sideon")) { //31st july fixes
        apz.app.Kmbase.toggleSidebar();
    }
    if(gApzCOB.productCode === '1003') {
     $("#KmSourc__KMReviewConfirm__el_label_37").text("Unnati Lite decision");
     $("#KmSourc__KMReviewConfirm__el_label_80").text("Unnati Lite decision");
     $("#KmSourc__KMReviewConfirm__el_label_38").text("Unnati Lite decision reason");
     $("#KmSourc__KMReviewConfirm__el_label_81").text("Unnati Lite decision reason");
     $("#KmSourc__KMReviewConfirm__el_label_85").text("Unnati Lite approved amount");
    }
    if ($('#APZCBO__BaseScreens__BaseDIV_apz_1').length) {
        $('#APZCBO__BaseScreens__BaseDIV_apz_1').remove();
    }
    if ($('#APZCBO__BaseScreens__BaseDIV_apz_2').length) {
        $('#APZCBO__BaseScreens__BaseDIV_apz_2').remove();
    }
};
apz.app.KMReviewConfirm.createRequest = function () { };

apz.app.KMReviewConfirm.paintData = function () {
    const s = inSessionStore;
    const val = (v) => (v !== undefined && v !== null && v !== '') ? v : '---';
    const iA = s.customerDetailsList[0].customerType === 'Applicant' ? 0 : 1;
    const iC = iA === 0 ? 1 : 0;
    const app = s.customerDetailsList[iA];
    const coap = s.customerDetailsList[iC];
    if (ApzCOB.getPayloadDatafromWrapper("isNewCustomer", "Co-App", "customerDetailsList") === 'Create a new Co-Applicant') {
        $("#KmSourc__KMReviewConfirm__co-app-name").text("New Co-Applicant Name");
    }
    const coAppNameAndRelation = (inSessionStore?.customerDetailsList || []).filter(x => x?.customerType === "Co-App").map(x => `${x?.customerName || ""}${x?.payload?.relationShipWithApplicant ? ` (${x.payload.relationShipWithApplicant})` : ""}`);
    const addrBlocks = s.addressDetailsWrapperList?.[0]?.addressDetailsList ?? [];
    const getBlock = (custDtlId, type) =>
        addrBlocks.find(b => b.custDtlId === custDtlId && b.addressType === type);
    const getAddr = (block, type) =>
        block?.payload?.addressList?.find(a => a.addressType === type) ?? {};

    const appPersonal = getBlock(app?.custDtlId, 'Personal'); // chinna doc added null handler
    const coapPersonal = getBlock(coap?.custDtlId, 'Personal'); // chinna doc added null handler

    // Applicant addresses
    const appPresent = getAddr(appPersonal, 'Present');
    const appPermanent = getAddr(appPersonal, 'Permanent');
    const appVoter = getAddr(appPersonal, 'Voter');
    const appSecKyc = getAddr(appPersonal, 'SecondaryKyc');

    // Co-applicant addresses
    const coapPresent = getAddr(coapPersonal, 'Present');
    const coapPermanent = getAddr(coapPersonal, 'Permanent');
    const coapVoter = getAddr(coapPersonal, 'Voter');
    const coapSecKyc = getAddr(coapPersonal, 'SecondaryKyc');

    // ── CB / CIBIL ────────────────────────────────────────────────────────────
    // Match cibil entry by custDtlId
    const cbFor = (id) =>
        s.cibilDetailsWrapperList?.find(w => w.cibilDetails.custDtlId === id)?.cibilDetails?.payload ?? {};
    const cbA = cbFor(app.custDtlId);
    const cbC = cbFor(coap?.custDtlId);
    const cbApplicantStatus = s?.cibilDetailsWrapperList?.[0]?.cibilDetails?.cbStatus || '';
    const cbCopplicantStatus = s?.cibilDetailsWrapperList?.[1]?.cibilDetails?.cbStatus || '';
    // Helper: split "Label : VALUE | STATUS" → VALUE | STATUS part
    const splitCb = (str) => val(str?.split(':')?.[1]?.trim());

    // ── Loan ──────────────────────────────────────────────────────────────────
    const loan = s.loanDetails ?? {};
    const lp = loan.payload ?? {};

    // ── Income ────────────────────────────────────────────────────────────────
    const inc = s.bcmpiIncomeDetails?.bcmpiIncomeDetailsWrapper ?? {};
    const biz = inc.business ?? {};

    // ── Set helpers ───────────────────────────────────────────────────────────
    const set = (id, v) => apz.setElmValue(id, val(v));
    const setAddr = (prefix, addr) => {
        set(`KmSourc__KMReviewConfirm__${prefix}addressLine1Txt_txtcnt`, addr.addressLine1);
        set(`KmSourc__KMReviewConfirm__${prefix}addressLine2Txt_txtcnt`, addr.addressLine2);
        set(`KmSourc__KMReviewConfirm__${prefix}addressLine3Txt_txtcnt`, addr.addressLine3);
        set(`KmSourc__KMReviewConfirm__${prefix}pincodeTxt_txtcnt`, addr.pinCode);
        set(`KmSourc__KMReviewConfirm__${prefix}cityTownVillageTxt_txtcnt`, addr.city);
        set(`KmSourc__KMReviewConfirm__${prefix}districtTxt_txtcnt`, addr.district);
        set(`KmSourc__KMReviewConfirm__${prefix}stateTxt_txtcnt`, addr.state);
    };

    // ════════════════════════════════════════════════════════════════════════
    // APPLICANT – Basic / KYC
    // ════════════════════════════════════════════════════════════════════════
    set('KmSourc__KMReviewConfirm__primaryMobileTxt_txtcnt', "+91 " + app.mobileNumber);
    set('KmSourc__KMReviewConfirm__secondaryMobileTxt_txtcnt', "+91 " + app.payload?.secMobileNo);
    set('KmSourc__KMReviewConfirm__reqLoanAmountTxt_txtcnt', loan.loanAmount);
    set('KmSourc__KMReviewConfirm__purposeOfLoanTxt_txtcnt', lp.loanPurpose);
    set('KmSourc__KMReviewConfirm__subPurposeOfLoanTxt_txtcnt', lp.subCategory);
    set('KmSourc__KMReviewConfirm__frequencyOfRepaymentTxt_txtcnt', lp.frequencyOfRepayment);
    set('KmSourc__KMReviewConfirm__nameAsPerVoterTxt_txtcnt', app.payload?.namePerKyc);
    set('KmSourc__KMReviewConfirm__voterIdTxt_txtcnt', app.payload?.primaryKycId);
    set('KmSourc__KMReviewConfirm__alternateVoterIdText_txtcnt', app.payload?.alternateVoterId);
    set('KmSourc__KMReviewConfirm__cKYCTxt_txtcnt', app.payload?.ckyc);
    set('KmSourc__KMReviewConfirm__nameAsPerT24Txt_txtcnt', app.customerName);
    set('KmSourc__KMReviewConfirm__genderTxt_txtcnt', app.payload?.gender);
    set('KmSourc__KMReviewConfirm__dobTxt_txtcnt', ApzCOB.convertDateFormat(app.payload?.dob, 'dd/mm/yyyy'));
    set('KmSourc__KMReviewConfirm__ageTxt_txtcnt', app.payload?.age);

    // Applicant – Present address (what was selected on the address screen)
    setAddr('', appPresent);

    // Applicant – PAN
    set('KmSourc__KMReviewConfirm__havePanTxt_txtcnt',['y', 'yes'].includes((app.payload?.panNumberValue || '').trim().toLowerCase())? 'Yes' : 'No');
    set('KmSourc__KMReviewConfirm__panCardNoTxt_txtcnt', app.payload?.panNumber);
    set('KmSourc__KMReviewConfirm__nameAsPerPanTxt_txtcnt', app.payload?.namePerPan);

    if (['n', 'no'].includes(app.payload?.panNumberValue?.toLowerCase())) {
        $("#KmSourc__KMReviewConfirm__appPancardNo").addClass("sno");
        $("#KmSourc__KMReviewConfirm__appNamepePan").addClass("sno");
        $("#KmSourc__KMReviewConfirm__appPanDocBlock").addClass("sno");
    } else {
        $("#KmSourc__KMReviewConfirm__appPancardNo").removeClass("sno");
        $("#KmSourc__KMReviewConfirm__appNamepePan").removeClass("sno");
        $("#KmSourc__KMReviewConfirm__appPanDocBlock").removeClass("sno");
    }
    let isApproved = (cbA?.finalDecision || "").includes("Approved");
    let product_code = inSessionStore.applicationMaster.productCode;
    // Applicant – Loan / CB
    set('KmSourc__KMReviewConfirm__requestedLoanAmtTxt_txtcnt', loan.loanAmount);
    set('KmSourc__KMReviewConfirm__loanTenureTxt_txtcnt', loan.tenure);
    set('KmSourc__KMReviewConfirm__ROITxt_txtcnt', cbA.roi);
    set('KmSourc__KMReviewConfirm__lastCBDateTxt_txtcnt',
        formatDate(s.cibilDetailsWrapperList?.find(w => w.cibilDetails.custDtlId === app.custDtlId)?.cibilDetails?.cbDate));
    set('KmSourc__KMReviewConfirm__lastCBCheckStatusTxt_txtcnt',
        s.cibilDetailsWrapperList?.find(w => w.cibilDetails.custDtlId === app.custDtlId)?.cibilDetails?.cbStatus);
    set('KmSourc__KMReviewConfirm__bureauNameTxt_txtcnt', cbA.bureauName);
    set('KmSourc__KMReviewConfirm__hitOrNoHitTxt_txtcnt', cbA.irisMessage);
    set('KmSourc__KMReviewConfirm__cbScoreTxt_txtcnt', cbA.cbScore);
    set('KmSourc__KMReviewConfirm__totalIndebtednessTxt_txtcnt', splitCb(cbA.totIndebtness));
    set('KmSourc__KMReviewConfirm__suitFilledTxt_txtcnt', splitCb(cbA.writeoffSuitFiledFlag));
    set('KmSourc__KMReviewConfirm__overdueAmtTxt_txtcnt', splitCb(cbA.overdueAmt));
    set('KmSourc__KMReviewConfirm__writtenoffAmtTxt_txtcnt', splitCb(cbA.writeOffAmt));
    set('KmSourc__KMReviewConfirm__runningEMITxt_txtcnt', cbA.foir);
    set('KmSourc__KMReviewConfirm__caglDPDTxt_txtcnt', splitCb(cbA.caglUnnatiFlag));
     if(product_code === "1009"){
    set('KmSourc__KMReviewConfirm__unnatiDecisionTxt_txtcnt', cbApplicantStatus); // 17th june
    set('KmSourc__KMReviewConfirm__unnatiDecisionReasonTxt_txtcnt', isApproved ? 'Approved':cbA?.rejectionReason || "-" );
    $("#KmSourc__KMReviewConfirm__sc_row_1702").addClass("sno");
    $("#KmSourc__KMReviewConfirm__sc_row_1705").addClass("sno");
    }else if(product_code === "1003"){
    $("#KmSourc__KMReviewConfirm__sc_row_1696").addClass("sno");
    $("#KmSourc__KMReviewConfirm__sc_row_1699").addClass("sno");
    set('KmSourc__KMReviewConfirm__visheshDecisionTxt_txtcnt', cbApplicantStatus);
    set('KmSourc__KMReviewConfirm__visheshDecisionReasonTxt_txtcnt', isApproved ? 'Approved':cbA?.rejectionReason || "-");
    }else{
    set('KmSourc__KMReviewConfirm__unnatiDecisionTxt_txtcnt', cbApplicantStatus); // 17th june
    set('KmSourc__KMReviewConfirm__unnatiDecisionReasonTxt_txtcnt', isApproved ? 'Approved':cbA?.rejectionReason || "-" );
    set('KmSourc__KMReviewConfirm__visheshDecisionTxt_txtcnt', cbA.visheshDecision);
    set('KmSourc__KMReviewConfirm__visheshDecisionReasonTxt_txtcnt', cbA.visheshDecisionReason);
    }
    // ════════════════════════════════════════════════════════════════════════
    // APPLICANT – Aadhaar / Additional Details
    // ════════════════════════════════════════════════════════════════════════
    set('KmSourc__KMReviewConfirm__adhaadharNoAdh_txtcnt', app.payload?.secondaryKycId);
    set('KmSourc__KMReviewConfirm__nameoOFPerAadharAdh_txtcnt', app.payload?.secondaryKycName);
    set('KmSourc__KMReviewConfirm__dobAdh_txtcnt', app.payload?.secondaryKycDob);

    // Aadhaar address (SecondaryKyc address block)
    set('KmSourc__KMReviewConfirm__addressline1Adh_txtcnt', appSecKyc.addressLine1);
    set('KmSourc__KMReviewConfirm__addressLine2Adh_txtcnt', appSecKyc.addressLine2);
    set('KmSourc__KMReviewConfirm__addressLine3Adh_txtcnt', appSecKyc.addressLine3);
    set('KmSourc__KMReviewConfirm__pincodeAdh_txtcnt', appSecKyc.pinCode);
    set('KmSourc__KMReviewConfirm__cityOrTwonAdh_txtcnt', appSecKyc.city);
    set('KmSourc__KMReviewConfirm__districtAdh_txtcnt', appSecKyc.district);
    set('KmSourc__KMReviewConfirm__stateAdh_txtcnt', appSecKyc.state);

    // Applicant additional personal info
    set('KmSourc__KMReviewConfirm__maritalStatusAdh_txtcnt', app.payload?.maritalStatus);
    set('KmSourc__KMReviewConfirm__fatherNameAdh_txtcnt', app.payload?.fathersName);
    set('KmSourc__KMReviewConfirm__spouseNameAdh_txtcnt', app.payload?.spouseName);
    set('KmSourc__KMReviewConfirm__educationAdh_txtcnt', app.payload?.education);
    set('KmSourc__KMReviewConfirm__religionAdh_txtcnt', app.payload?.religion);
    set('KmSourc__KMReviewConfirm__casteAdh_txtcnt', app.payload?.caste);

    const isAddressSame = checkAddressesSame(appPresent, appPermanent);

    if (appPresent?.residenceOwnership !== "Rented") {
        $("#KmSourc__KMReviewConfirm__secondResidentAddrBlock").addClass("sno");
        $("#KmSourc__KMReviewConfirm__permRadioOneBlock_li").addClass("sno");
        $("#KmSourc__KMReviewConfirm__permntLabel_li").addClass("sno"); // Chinna added 02/06/2026
    } else if (appPresent?.residenceOwnership === "Rented" && isAddressSame) {
        $("#KmSourc__KMReviewConfirm__secondResidentAddrBlock").addClass("sno");
        $("#KmSourc__KMReviewConfirm__permRadioOneBlock_li").removeClass("sno");
    } else {
        $("#KmSourc__KMReviewConfirm__secondResidentAddrBlock").removeClass("sno");
        $("#KmSourc__KMReviewConfirm__permRadioOneBlock_li").removeClass("sno");
    }

    if (appPresent?.addressType === "Present" && isAddressSame) {
        document.getElementById('KmSourc__KMReviewConfirm__othAddressRadioBtn_option_presentOther').checked = true;
        document.getElementById('KmSourc__KMReviewConfirm__permRadioBtnOne_option_presentOther').checked = true;

        $('#KmSourc__KMReviewConfirm__secondAddPresRadio_option_presentOther').prop('disabled', true);
        $('#KmSourc__KMReviewConfirm__secondAddPermRadio_option_presentOther').prop('disabled', true);
    } else if (appPresent?.addressType === "Present" && !isAddressSame) {
        document.getElementById('KmSourc__KMReviewConfirm__othAddressRadioBtn_option_presentOther').checked = true;
        document.getElementById('KmSourc__KMReviewConfirm__permRadioBtnOne_option_presentOther').checked = false;
        $('#KmSourc__KMReviewConfirm__permRadioBtnOne_option_presentOther').prop('disabled', true);
    } else if (appPresent?.addressType !== "Present" && !isAddressSame) {
        document.getElementById('KmSourc__KMReviewConfirm__othAddressRadioBtn_option_presentOther').checked = false;
        $('#KmSourc__KMReviewConfirm__othAddressRadioBtn_option_presentOther').prop('disabled', true);
        document.getElementById('KmSourc__KMReviewConfirm__permRadioBtnOne_option_presentOther').checked = true;
    }

    if (appPermanent?.addressType === "Present" && isAddressSame) {
        document.getElementById('KmSourc__KMReviewConfirm__secondAddPresRadio_option_presentOther').checked = true;
        document.getElementById('KmSourc__KMReviewConfirm__secondAddPermRadio_option_presentOther').checked = true;

        $('#KmSourc__KMReviewConfirm__othAddressRadioBtn_option_presentOther').prop('disabled', true);
        $('#KmSourc__KMReviewConfirm__permRadioBtnOne_option_presentOther').prop('disabled', true);
    } else if (appPermanent?.addressType === "Present" && !isAddressSame) {
        document.getElementById('KmSourc__KMReviewConfirm__secondAddPresRadio_option_presentOther').checked = true;
        document.getElementById('KmSourc__KMReviewConfirm__secondAddPermRadio_option_presentOther').checked = false;
        $('#KmSourc__KMReviewConfirm__secondAddPermRadio_option_presentOther').prop('disabled', true);
    } else if (appPermanent?.addressType !== "Present" && !isAddressSame) {
        document.getElementById('KmSourc__KMReviewConfirm__secondAddPresRadio_option_presentOther').checked = false;
        document.getElementById('KmSourc__KMReviewConfirm__secondAddPermRadio_option_presentOther').checked = true;
        $('#KmSourc__KMReviewConfirm__secondAddPresRadio_option_presentOther').prop('disabled', true);
    }
    if(appPresent?.residenceOwnership == 'Rented' && appPermanent?.addressSameAs === "Other"){
        $("#KmSourc__KMReviewConfirm__permanentAddressBlock").removeClass("sno");
    } else {
        $("#KmSourc__KMReviewConfirm__permanentAddressBlock").addClass("sno");
    }
    if (appPresent?.addressSameAs === "Other" ) {
        $("#KmSourc__KMReviewConfirm__presentAddressBlock").removeClass("sno"); 
    } else {
        $("#KmSourc__KMReviewConfirm__presentAddressBlock").addClass("sno");
    }
    if (appPresent.addressSameAs !== values?.Other) {
        var formattedPresentAddress = [
            appPresent.addressLine1,
            appPresent.addressLine2,
            appPresent.addressLine3,
            appPresent.district,
            appPresent.city,
            appPresent.pinCode,
            appPresent.state,
            appPresent.country
        ].filter(Boolean).join(", ");
        //$("#KmSourc__KMReviewConfirm__OthAddressColumn_li").find("label").text(formattedPresentAddress); // chinna changes start
        $("#KmSourc__KMReviewConfirm__OthAddressColumn_li").find("label").html('<span class="ett-para pri fs12">' + getAddressLabel(appPresent.addressSameAs) + ' </span><br>' + formattedPresentAddress); // chinna updated 09/06/2026
    } else {
