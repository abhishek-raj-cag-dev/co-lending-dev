apz.app.onLoad_OtherInformation = function () {
    gApzCOB.currentApplicant = 1;
    const mandatoryFields = [
        "bankDetTypeOfDocument",
        "changeBankRadioBtn",
        "typeOfDocChangeBank",
        "insuranceNotOptingReasons",
        "nameOfAdditionalDoc",
        "otherReasonInput",
        "changeBankTypeOfDoc"
    ];
    mandatoryFields.forEach(fieldId => {
        ApzCOB.addFieldMandatory(`${kmScrId}${fieldId}`);
    });
    const applicantElm = [
        "appNomineeForIns",
        "appGender",
        "appDob",
        "appRelationWithNom"
    ]
    applicantElm.forEach(fieldId => {
        ApzCOB.addFieldMandatory(`${kmIPaintAppInsuranceDetailsId}${fieldId}`);
    });
    $("#KmSourc__IPaintCustomNomineeDetails__o__customNomineeDetails__customNomContactNumber").addClass("phnNmbr");
    const custApplicantElm = [
        "custAppNomineeForIns",
        "custAppGender",
        "custAppDob",
        "custAppRelationWithNom",
        "custAppNomContactNumber"
    ]
    custApplicantElm.forEach(fieldId => {
        ApzCOB.addFieldMandatory(`${kmIPaintCustAppInsDetailsId}${fieldId}`);
    });
    const coApplicantElm = [
        "coAppNomineeForIns",
        "coAppGender",
        "coAppDob",
        "coAppRelationWithNom",
    ]
    coApplicantElm.forEach(fieldId => {
        ApzCOB.addFieldMandatory(`${kmIPaintCoAppInsuranceDetailsId}${fieldId}`);
    });
    const customNomineeElm = [
        "customNomineeForIns",
        "customGender",
        "customDob",
        "customRelationWithNom",
        "customNomContactNumber"
    ]
    customNomineeElm.forEach(fieldId => {
        ApzCOB.addFieldMandatory(`${kmIPaintCustomInsDetailsId}${fieldId}`);
    });
    const custEditElm = [
        "editModelNomineeName",
        "editModelNomineeGender",
        "editModelNomineeDOB",
        "editNomineeRelationship"
    ]
    custEditElm.forEach(fieldId => {
        ApzCOB.addFieldMandatory(`${kmIPaintEditInsuranceDetailsId}${fieldId}`);
    });
    const disableFieldIds = [
        "accountHolderNameInput",
        "accountNumberInput",
        "ifscCodeInput",
        "bankNameInput",
        "branchNameInput",
        "accountTypeBankDetials",
        // "bankName",
        // "branchName",
        "changeBankBankName",
        "changeBankBranchName"
    ];
    disableFieldIds.forEach(fieldId => {
        ApzCOB.AddOrRemoveDisableFields([`${kmScrId}${fieldId}`], true);
    });
    const insuranceDetails = [
        "sumAssuredInput",
        //"nameOfInsurerInput",
        "insurancePremiumInput"
    ]
    insuranceDetails.forEach(fieldId => {
        ApzCOB.AddOrRemoveDisableFields([`${kmIPaintInsuranceDetailsId}${fieldId}`], true);
    });
    const appInsuranceDetails = [
        "appNomineeForIns",
        "appGender",
        "appDob",
        "appAgeOfNominee",
        "appRelationWithNom"
    ]
    appInsuranceDetails.forEach(fieldId => {
        ApzCOB.AddOrRemoveDisableFields([`${kmIPaintAppInsuranceDetailsId}${fieldId}`], true);
    });
    const custAppInsDetails = [
        "custAppAge"
    ]
    custAppInsDetails.forEach(fieldId => {
        ApzCOB.AddOrRemoveDisableFields([`${kmIPaintCustAppInsDetailsId}${fieldId}`], true);
    });
    const coAppInsuranceDetails = [
        "coAppNomineeForIns",
        "coAppGender",
        "coAppDob",
        "coAppAgeOfNominee",
        //"coAppRelationWithNom",
    ]
    coAppInsuranceDetails.forEach(fieldId => {
        ApzCOB.AddOrRemoveDisableFields([`${kmIPaintCoAppInsuranceDetailsId}${fieldId}`], true);
    });
    const customNomineeDetails = [
        "customAge",
    ]
    customNomineeDetails.forEach(fieldId => {
        ApzCOB.AddOrRemoveDisableFields([`${kmIPaintCustomInsDetailsId}${fieldId}`], true);
    });
    const editInsuranceDetails = [
        "editModelNomineeAge"
    ]
    editInsuranceDetails.forEach(fieldId => {
        ApzCOB.AddOrRemoveDisableFields([`${kmIPaintEditInsuranceDetailsId}${fieldId}`], true);
    });
    //apz.app.Kmbase.toggleSidebar();
};
apz.app.onShown_OtherInformation = function () {
    $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
    $(`#${kmbaseScr}OtherInformation_hyp`).addClass('active');
    apz.populateDropdown(document.getElementById(kmScrId + "insuranceNotOptingReasons"), apz.app.OtherInformation.buildDDValues(otherReasonsDDValues));
    apz.populateDropdown(document.getElementById(kmIPaintAppInsuranceDetailsId + "appGender"), apz.app.OtherInformation.buildDDValues(genderDDValues));
    apz.populateDropdown(document.getElementById(kmIPaintCustAppInsDetailsId + "custAppGender"), apz.app.OtherInformation.buildDDValues(genderDDValues));
    apz.populateDropdown(document.getElementById(kmIPaintCoAppInsuranceDetailsId + "coAppGender"), apz.app.OtherInformation.buildDDValues(genderDDValues));
    apz.populateDropdown(document.getElementById(kmIPaintCustomInsDetailsId + "customGender"), apz.app.OtherInformation.buildDDValues(genderDDValues));
    apz.populateDropdown(document.getElementById(kmIPaintEditInsuranceDetailsId + "editModelNomineeGender"), apz.app.OtherInformation.buildDDValues(genderDDValues));
    apz.populateDropdown(document.getElementById(kmScrId + "changeBankAccountType"), apz.app.OtherInformation.buildDDValues(accountTypeDDValues));
    apz.populateDropdown(document.getElementById(kmScrId + "accountTypeBankDetials"), apz.app.OtherInformation.buildDDValues(accountTypeDDValues));
    apz.populateDropdown(document.getElementById(kmScrId + "bankDetTypeOfDocument"), apz.app.OtherInformation.buildDDValues(typeOfDocDDValues));
    apz.populateDropdown(document.getElementById(kmScrId + "changeBankTypeOfDoc"), apz.app.OtherInformation.buildDDValues(typeOfDocDDValues));
    apz.populateDropdown(document.getElementById(kmIPaintAppInsuranceDetailsId + "appRelationWithNom"), apz.app.OtherInformation.buildDDValues(relations));
    apz.populateDropdown(document.getElementById(kmIPaintCustAppInsDetailsId + "custAppRelationWithNom"), apz.app.OtherInformation.buildDDValues(relations));
    apz.populateDropdown(document.getElementById(kmIPaintCoAppInsuranceDetailsId + "coAppRelationWithNom"), apz.app.OtherInformation.buildDDValues(relations));
    apz.populateDropdown(document.getElementById(kmIPaintCustomInsDetailsId + "customRelationWithNom"), apz.app.OtherInformation.buildDDValues(relations));
    apz.populateDropdown(document.getElementById(kmIPaintEditInsuranceDetailsId + "editNomineeRelationship"), apz.app.OtherInformation.buildDDValues(relations));
    apz.app.OtherInformation.fnLoadAMLQuestions();
    apz.app.OtherInformation.setMinMaxLength();
    //apz.app.OtherInformation.fnLoadInsuranceDetails();
    if (inSessionStore.customerDetailsList.length === 2) {
        apz.app.OtherInformation.paintApplicantInsuranceDetails();
    }
    // ApzCOB.fetcheNachBankData();
    $("#KmSourc__IPaintCustAppInsDetails__o__custAppInsDetails__custAppDob").datepicker("option", "maxDate", Date.parse(DATE_TODAY));
    //$("#KmSourc__IPaintCustomNomineeDetails__o__customNomineeDetails__customDob").datepicker("option", "maxDate", Date.parse(DATE_TODAY));
    $("#KmSourc__IPaintEditInsuranceDetails__o__editInsuranceDetails__editModelNomineeDOB").datepicker("option", "maxDate", Date.parse(DATE_TODAY));
    $('input.hasDatepicker').datepicker("option", {
        maxDate: Date.parse(DATE_TODAY),
        yearRange: "-100:+0"
    });
    // apz.app.OtherInformation.fnPrefixValidatePhoneNo("KmSourc__IPaintCustAppInsDetails__o__custAppInsDetails__custAppNomContactNumber", "KmSourc__OtherInformation__sc_row_273");
    // apz.app.OtherInformation.fnPrefixValidatePhoneNo("KmSourc__IPaintCustomNomineeDetails__o__customNomineeDetails__customNomContactNumber", "KmSourc__OtherInformation__sc_row_345");
    if (inSessionStore?.amlQuestion?.payload?.amlQuestionList?.length > 0) {
        apz.app.OtherInformation.setAMLQuestionnaireData(inSessionStore?.amlQuestion?.payload)
    }
    let docList = inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList ?? [];
    let custDtlId = gApzCOB?.userDetails?.custDtlId;
    let AddDocExists = docList.some(item =>
        parseInt(item?.custDtlId) === parseInt(custDtlId) &&
        item?.payload?.documentType === 'COAPPLNT_CUST_NOMINEE_DOCS'
    );
    if (AddDocExists) {
        $("#KmSourc__OtherInformation__insuranceTypeRadioBtn_option_bothInsurance").attr("checked", true);
    }
    if (gApzCOB?.LoggedInUserDetails?.loginResponse?.addInfo1 !== 'BM') {
        apz.app.OtherInformation.fnInsuranceTypeOnChange();
    }
    ApzCOB.scrollTopKMSourcing();
    apz.app.OtherInformation.fnInsuranceTypeInSession();
    apz.app.OtherInformation.onShownPaintBankDetails();
    apz.app.OtherInformation.fnPaintAllDocuments();
    //Disable after painting document
    apz.app.Kmbase.bmRecommendation();
    apz.app.OtherInformation.fnLoadBankBasicDetails();
    apz.app.OtherInformation.bankAccNoVerify();
    apz.app.OtherInformation.paintCoApplicantInsuranceDetails();
    apz.app.Kmbase.paintQueryResponsedata();
    if (lastBM)
        apz.app.Kmbase.paintQueryResponsedata(true);
    if (gApzCOB.productCode === "1001") {
        $("#KmSourc__OtherInformation__changeBankRadioBtn_option_yes").click()
        $("#" + kmScrId + "changeBankRadioBtn_option_no").attr("disabled", true)
        $("#" + kmScrId + "changeBankRadioBtn_option_no").addClass('BankDetailsDisable');
        $("#KmSourc__OtherInformation__validateENachbtn").addClass("sno");
        $("#" + kmScrId + "pennyChackbtn").addClass("sno");
        $("#" + kmScrId + "pennyCheckSuccessbtn").addClass("sno");
        $("#KmSourc__OtherInformation__uploadDocDiv").addClass("sno");
        $("#" + kmScrId + "eNachValidatedbtn").addClass("sno")
        $("#KmSourc__OtherInformation__eNachInvalidbtn").addClass("sno");
    }
    $("#KmSourc__OtherInformation__changeBankTypeOfDoc_ext").attr("readonly", "readonly");
    $("#KmSourc__OtherInformation__changeBankTypeOfDoc").attr("readonly", "readonly");
    $("#KmSourc__OtherInformation__bankDetTypeOfDocument").attr("readonly", "readonly");
    $("#KmSourc__OtherInformation__bankDetTypeOfDocument_ext").attr("readonly", "readonly");
    $("#KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput").attr("readonly", "readonly");
    $("#KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput_ext").attr("readonly", "readonly");
};
