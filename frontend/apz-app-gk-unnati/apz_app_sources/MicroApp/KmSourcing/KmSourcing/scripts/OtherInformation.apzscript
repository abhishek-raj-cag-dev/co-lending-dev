            $("#" + kmScrId + "changeBankeNachInvalid").addClass("sno");
            $("#" + kmScrId + "changeBankValidateENachbtn").addClass("sno");
            // // for temp purpose (hiding all primary bank buttons if secondary bank is checked) 
            // $("#" + kmScrId + "validateENachbtn").addClass("sno");
            // $("#" + kmScrId + "eNachValidatedbtn").addClass("sno");
            // $("#" + kmScrId + "eNachInvalidbtn").addClass("sno");
            // $("#" + kmScrId + "pennyChackbtn").addClass("sno");
            // $("#" + kmScrId + "pennyCheckSuccessbtn").addClass("sno");
            // $("#" + kmScrId + "pennyCheckFailurebtn").addClass("sno");
            // $("#" + kmScrId + "uploadDocDiv").addClass("sno");
            // $("#KmSourc__OtherInformation__changeBankIFSCCode").val(loadBasicBankDetails?.secIfsc);
            // $("#KmSourc__OtherInformation__changeBankBankName").val(loadBasicBankDetails?.secBankName);
