apz.app.OtherInformation.fnCommonDocUpload = function (parentID, docType, pthis) {
    if (docType === "BANK_ACCOUNT_PROOF") {
        let BankProofDocValuePri = $("#" + kmScrId + "bankDetTypeOfDocument").val();
        const bankDocCount1 = inSessionStore.applicationDocumentsWrapperList[0]
            .applicationDocumentsList
            .filter(doc => doc.documentType === "BANK_ACCOUNT_PROOF")
            .length;
        if (bankDocCount1 > 9) {
            ApzCOB.fnDisplayMsg("User allowed to upload maximum of 10 documents", "E");
            return false;
        }
        if (BankProofDocValuePri !== "Please Select" && !apz.isNull(BankProofDocValuePri)) {
            bankSelected = "Primary";
            apz.app.Kmbase.validateMaxDocs(parentID, docType, pthis);
        } else if (BankProofDocValuePri === "Please Select" || apz.isNull(BankProofDocValuePri)) {
            ApzCOB.fnDisplayMsg("Please select document type", "E");
        }
    }
    // else if (docType === "CHANGED_BANK_DOCS") {  //16th june Bank_account_proof changes 
    //     const newBankDocCount1 = inSessionStore.applicationDocumentsWrapperList[0]
    //         .applicationDocumentsList
    //         .filter(doc => doc.documentType === "CHANGED_BANK_DOCS")
    //         .length;
    //     if (newBankDocCount1 > 9) {
    //         ApzCOB.fnDisplayMsg("User allowed to upload maximum of 10 documents", "E");
    //         return false;
    //     }
    //     if ($("#" + kmScrId + "changeBankTypeOfDoc").val() !== "Please Select") {
    //         apz.app.Kmbase.validateMaxDocs(parentID, docType, pthis);
    //     } else if ($("#" + kmScrId + "changeBankTypeOfDoc").val() === "Please Select") {
    //         ApzCOB.fnDisplayMsg("Please select document type", "E");
    //     }
    // }
    else if (docType === "ADDITIONAL_DOCS") {
        let docNameLength = $("#" + kmScrId + "nameOfAdditionalDoc").val().length;
        if (docNameLength >= 4 && docNameLength <= 25) {
            apz.app.Kmbase.validateMaxDocs(parentID, docType, pthis);
        } else {
            $("#" + kmScrId + "nameOfAdditionalDoc").val('');
            ApzCOB.fnDisplayMsg("Please enter the document type name with 4 to 25 characters", "E");
        }
    } else {
        apz.app.Kmbase.validateMaxDocs(parentID, docType, pthis);
    }
}
apz.app.OtherInformation.fnNewBankDocUpload = function (parentID, docType, pthis) {
    let BankProofType = $("#" + kmScrId + "changeBankTypeOfDoc").val()
    if (docType === "BANK_ACCOUNT_PROOF") {  //16th june Bank_account_proof changes 
        const newBankDocCount1 = inSessionStore.applicationDocumentsWrapperList[0]
            .applicationDocumentsList
            .filter(doc => doc.documentType === "BANK_ACCOUNT_PROOF")
            .length;
        if (newBankDocCount1 > 9) {
            ApzCOB.fnDisplayMsg("User allowed to upload maximum of 10 documents", "E");
            return false;
        }
        if (BankProofType !== "Please Select" && !apz.isNull(BankProofType)) {
            bankSelected = "Secondary";
            apz.app.Kmbase.validateMaxDocs(parentID, docType, pthis);
        } else if (BankProofType === "Please Select" || apz.isNull(BankProofType)) {
            ApzCOB.fnDisplayMsg("Please select document type", "E");
        }
    }
}
apz.app.OtherInformation.fnEditAppCoAppNomDetails = function (custType) {
    let custData = "";
    if (custType === "APPLICANT") {
        othInforEditFlag.OtherInfocustType = "APPLICANT"
        custData = apz.data.scrdata.KmSourc__IPaintAppInsuranceDetails_Res.appInsuranceDetails
        apz.data.scrdata.KmSourc__IPaintEditInsuranceDetails_Res = {}
        apz.data.scrdata.KmSourc__IPaintEditInsuranceDetails_Res.editInsuranceDetails = {}
        var lData = {
            editModelNomineeName: custData.appNomineeForIns,
            editModelNomineeGender: custData.appGender,
            editModelNomineeDOB: custData.appDob,
            editModelNomineeAge: custData.appAgeOfNominee,
            editNomineeRelationship: custData.appRelationWithNom,
        }
        apz.data.scrdata.KmSourc__IPaintEditInsuranceDetails_Res.editInsuranceDetails = lData;
        apz.data.loadData("IPaintEditInsuranceDetails", "KmSourc");
        ApzCOB.toggleModal(kmScrId + "editNomineeModel");
    } else if (custType === "COAPPLICANT") {
        othInforEditFlag.OtherInfocustType = "COAPPLICANT"
        custData = apz.data.scrdata.KmSourc__IPaintCoAppInsuranceDetails_Res.coAppInsuranceDetails
        apz.data.scrdata.KmSourc__IPaintEditInsuranceDetails_Res = {}
        apz.data.scrdata.KmSourc__IPaintEditInsuranceDetails_Res.editInsuranceDetails = {}
        var lData = {
            editModelNomineeName: custData.coAppNomineeForIns,
            editModelNomineeGender: custData.coAppGender,
            editModelNomineeDOB: custData.coAppDob,
            editModelNomineeAge: custData.coAppAgeOfNominee,
            editNomineeRelationship: custData.coAppRelationWithNom,
        }
        apz.data.scrdata.KmSourc__IPaintEditInsuranceDetails_Res.editInsuranceDetails = lData;
        apz.data.loadData("IPaintEditInsuranceDetails", "KmSourc");
        ApzCOB.toggleModal(kmScrId + "editNomineeModel");
    }
}
apz.app.OtherInformation.fnConfirmAppCoAppNomDetails = function () {
    let lCurrentData = apz.data.buildData("IPaintEditInsuranceDetails", "KmSourc")
    let currentData = lCurrentData.KmSourc__IPaintEditInsuranceDetails_Res.editInsuranceDetails;
    let cNomineeGender = $('#' + kmIPaintEditInsuranceDetailsId + 'editModelNomineeGender').val();
    let cRelationshipWithNominee = $('#' + kmIPaintEditInsuranceDetailsId + 'editNomineeRelationship').val();
    let cNomineeForInsurance = $('#' + kmIPaintEditInsuranceDetailsId + 'editModelNomineeName').val();
    let cNomineeDOB = $('#' + kmIPaintEditInsuranceDetailsId + 'editModelNomineeDOB').val();
    if (cNomineeGender === "Please Select" || cRelationshipWithNominee === "Please Select") {
        ApzCOB.fnDisplayMsg("Please select a value from the dropdown", "E");
        return;
    } else if (apz.isNull(cNomineeForInsurance) || apz.isNull(cNomineeDOB)) {
        ApzCOB.fnDisplayMsg("Please fill all required fields", "E");
        return;
    }
    if (othInforEditFlag.OtherInfocustType === "APPLICANT") {
        let lData = {
            appNomineeForIns: currentData.editModelNomineeName,
            appGender: currentData.editModelNomineeGender,
            appDob: currentData.editModelNomineeDOB,
            appAgeOfNominee: currentData.editModelNomineeAge,
            appRelationWithNom: currentData.editNomineeRelationship
        }
        apz.data.scrdata.KmSourc__IPaintAppInsuranceDetails_Res.appInsuranceDetails = {}
        apz.data.scrdata.KmSourc__IPaintAppInsuranceDetails_Res.appInsuranceDetails = lData;
        apz.data.loadData("IPaintAppInsuranceDetails", "KmSourc");
        othInforEditFlag.OtherInfocustType = ""
        ApzCOB.toggleModal(kmScrId + "editNomineeModel");
    } else if (othInforEditFlag.OtherInfocustType === "COAPPLICANT") {
        let lData = {
            coAppNomineeForIns: currentData.editModelNomineeName,
            coAppGender: currentData.editModelNomineeGender,
            coAppDob: currentData.editModelNomineeDOB,
            coAppAgeOfNominee: currentData.editModelNomineeAge,
            coAppRelationWithNom: currentData.editNomineeRelationship
        }
        apz.data.scrdata.KmSourc__IPaintCoAppInsuranceDetails_Res.coAppInsuranceDetails = {}
        apz.data.scrdata.KmSourc__IPaintCoAppInsuranceDetails_Res.coAppInsuranceDetails = lData;
        apz.data.loadData("IPaintCoAppInsuranceDetails", "KmSourc");
        othInforEditFlag.OtherInfocustType = ""
        ApzCOB.toggleModal(kmScrId + "editNomineeModel");
    }
}
