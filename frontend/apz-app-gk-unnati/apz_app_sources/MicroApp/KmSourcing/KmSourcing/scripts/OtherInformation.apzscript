            // $("#KmSourc__OtherInformation__changeBankAccountType").val(loadBasicBankDetails?.secAccountType);
            // $("#KmSourc__OtherInformation__changeBankTypeOfDoc").val(loadBasicBankDetails?.secBankdocumentType);
            //if (apz.isNull(loadBasicBankDetails.accountNumber) || gApzCOB.productCode === "1001" || !apz.isNull(loadBasicBankDetails.pennyResp)) { //23rd june changes - to avoid 1st bank painting in 2nd bank details
