        //     coApplicantRelationWithNominee = "Daughter-In-law";
        // } else if (sessionVal === "daughter-in-law") {
        //     coApplicantRelationWithNominee = "Mother-In-law";
        // } else {
        //     coApplicantRelationWithNominee = "Please Select";
        // }
    }
    apz.data.scrdata.KmSourc__IPaintCoAppInsuranceDetails_Res = {}
    apz.data.scrdata.KmSourc__IPaintCoAppInsuranceDetails_Res.coAppInsuranceDetails = {}
    var coAppInsPayload = gApzCOB.requestNodes.customerDetailsList[newInsIndex].payload;
    if (typeof coAppInsPayload === "string") {
        coAppInsPayload = JSON.parse(coAppInsPayload);
    }
    var lData = {
        coAppNomineeForIns: gApzCOB.requestNodes.customerDetailsList[newInsIndex].customerName,
        coAppGender: coAppInsPayload.gender === "F" ? "Female" : coAppInsPayload.gender === "M" ? "Male" : coAppInsPayload.gender,
        coAppDob: (coAppInsPayload.dob && coAppInsPayload.dob.includes("/"))
            ? coAppInsPayload.dob.split("/").reverse().join("-")
            : coAppInsPayload.dob,
        coAppAgeOfNominee: coAppInsPayload.age,
        //coAppRelationWithNom: coApplicantRelationWithNominee,
        coAppRelationWithNom: inSessionStore?.insuranceDetailsWrapperList?.find(item => item?.insuranceDetails?.insuredCustType === "Co-App")?.insuranceDetails?.payload?.nomineeRelation ?? "Please Select",
    };
    // var lData = {
    //     coAppNomineeForIns: gApzCOB.requestNodes.customerDetailsList[newInsIndex].customerName,
    //     coAppGender: gApzCOB.requestNodes.customerDetailsList[newInsIndex].payload.gender,
    //     coAppDob: gApzCOB.requestNodes.customerDetailsList[newInsIndex].payload.dob,
    //     coAppAgeOfNominee: gApzCOB.requestNodes.customerDetailsList[newInsIndex].payload.age,
    //     //coAppRelationWithNom: inSessionStore.customerDetailsList[0].payload?.relationShipWithApplicant,
    //     coAppRelationWithNom: coApplicantRelationWithNominee
    // }
    apz.data.scrdata.KmSourc__IPaintCoAppInsuranceDetails_Res.coAppInsuranceDetails = lData;
    apz.data.loadData("IPaintCoAppInsuranceDetails", "KmSourc");
};
apz.app.OtherInformation.bankAccNoVerify = function () {
    let bankCurrIndex = !apz.isNull(inSessionStore.bankDetailsWrapperList) ? ApzCOB.getIndexforBankWrapper("Applicant") : 0;
    let accntVerifiedFromSession = inSessionStore?.bankDetailsWrapperList?.[bankCurrIndex]?.bankDetails?.payload?.accntVerified ?? "";
    if (window.bankAccountNoVerifiedOtherInfo === "Verified" || accntVerifiedFromSession === "Verified") {
        $("#KmSourc__OtherInformation__accountVerifyBtn").addClass('sno');
        $("#KmSourc__OtherInformation__accountVerifiedBtn").removeClass("sno");
        $("#KmSourc__OtherInformation__verifiedAccount").removeClass("sno");
        $("#KmSourc__OtherInformation__verifiedAccount").addClass('suc');
    } else if (window.bankAccountNoVerifiedOtherInfo === "Invalid" || accntVerifiedFromSession === "Invalid") {
        $("#KmSourc__OtherInformation__accountVerifyBtn").addClass('sno');
        $("#KmSourc__OtherInformation__accountInvalidBtn").removeClass("sno");
        $("#KmSourc__OtherInformation__invalidAccount").removeClass("sno");
        $("#KmSourc__OtherInformation__invalidAccount").addClass('failed');
    }
}
apz.app.OtherInformation.setMinMaxLength = function () {
    const fieldMap = {
        //accountHolderNameInput: "Name",
        //accountNumberInput: "AccountNumber",
        //ifscCodeInput: "IFSC",
        //bankNameInput: "BankName",
        //branchNameInput: "BankName",
        changeBankIFSCCode: "IFSC",
        changeBankBankName: "BankName",
        changeBankBranchName: "BankName"
        //otherReasonInput:"",
        //nameOfAdditionalDoc:""
    };
    ApzCOB.setMinMaxLength(Object.entries(fieldMap).map(([fieldId, fieldName]) => ({
        fieldName,
        fieldId: kmScrId + fieldId
    })));
    const fieldMapEdit = {
        editModelNomineeName: "Name",
        editModelNomineeDOB: "Dob"
    };
    ApzCOB.setMinMaxLength(Object.entries(fieldMapEdit).map(([fieldId, fieldName]) => ({
        fieldName,
        fieldId: kmIPaintEditInsuranceDetailsId + fieldId
    })));
    const fieldMapCustApp = {
        custAppNomineeForIns: "Name",
        custAppNomContactNumber: "MobileNumber",
        custAppDob: "Dob"
    };
    ApzCOB.setMinMaxLength(Object.entries(fieldMapCustApp).map(([fieldId, fieldName]) => ({
        fieldName,
        fieldId: kmIPaintCustAppInsDetailsId + fieldId
    })));
    const fieldMapCustomNominee = {
        customNomineeForIns: "Name",
        customNomContactNumber: "MobileNumber",
        customDob: "Dob"
    };
    ApzCOB.setMinMaxLength(Object.entries(fieldMapCustomNominee).map(([fieldId, fieldName]) => ({
        fieldName,
        fieldId: kmIPaintCustomInsDetailsId + fieldId
    })));
};
apz.app.OtherInformation.buildDDValues = function (items) {
    let params = [];
    items.forEach((desc, index) => {
        params.push({
            val: desc,
            desc: desc,
        });
    });
    if (!items.includes("Please Select")) {
        params.unshift({
            val: "",
            desc: "Please Select"
        });
    }
    return params;
};
apz.app.OtherInformation.fnLoadAMLQuestions = function () {
    apz.data.scrdata.KmSourc__loadAMLQuestions_Req = {};
    apz.data.scrdata.KmSourc__loadAMLQuestions_Req.amlQuestions = []
    if (apz.isNull(DBKIT_MASTERDATA) || Object.keys(DBKIT_MASTERDATA).length === 0) {
        ApzCOB.FetchDBKITMasterData("KMSOURCING");
    }
    if (apz.isNull(DBKIT_MASTERDATA) || Object.keys(DBKIT_MASTERDATA).length === 0) {
        let amlQuestionFilePath = apz.getDataFilesPath() + "/amlQuestionaire.json"
        let amlQuesDataSet = apz.getFile(amlQuestionFilePath)
        apz.data.scrdata.KmSourc__loadAMLQuestions_Req.amlQuestions = JSON.parse(amlQuesDataSet)
    } else {
        apz.data.scrdata.KmSourc__loadAMLQuestions_Req.amlQuestions = JSON.parse(DBKIT_MASTERDATA.find(({ stageName }) => stageName === "OtherInformation")?.queries)
    }
    let amlQuestions = apz.data.scrdata.KmSourc__loadAMLQuestions_Req.amlQuestions;
    apz.data.loadData("loadAMLQuestions", "KmSourc")
    for (let i = 0; i < amlQuestions.length; i++) {
        $("#KmSourc__loadAMLQuestions__i__amlQuestions__question_" + i).empty();
        $("#KmSourc__loadAMLQuestions__i__amlQuestions__question_" + i).append(`${amlQuestions[i].question}`);
        var $li = $('#' + kmScrId + 'amlQuestionList_row_' + i);
        var onclickCode = $li.attr('onclick');
        if (onclickCode) {
            onclickCode = onclickCode
                .replace('apz.data.selectRow(this, event);', '')
                .replace('apz.data.rowClicked(this,event);', '');
            $li.attr('onclick', onclickCode);
        }
    }
}
apz.app.OtherInformation.insNotOptDropDownValue = function () {
    let selectedReasons = $("#" + kmScrId + "insuranceNotOptingReasons").val();
    if (selectedReasons === "Other") {
        $("#" + kmScrId + "otherReasonRow").removeClass("sno");
    } else {
        $("#" + kmScrId + "otherReasonRow").addClass("sno");
    }
};
apz.app.OtherInformation.validateENach = function () {
    let ifscInput = $("#" + kmScrId + "ifscCodeInput").val().trim().toUpperCase();
    let changeBankBankStatus = apz.getElmValue(kmScrId + "changeBankRadioBtn");
    let bankCurrIndex = !apz.isNull(inSessionStore.bankDetailsWrapperList) ? ApzCOB.getIndexforBankWrapper("Applicant") : 0;
    let accntVerifiedFromSession = inSessionStore?.bankDetailsWrapperList?.[bankCurrIndex]?.bankDetails?.payload?.accntVerified ?? "";
    if (apz.isNull(window.bankAccountNoVerifiedOtherInfo) && accntVerifiedFromSession !== "Verified") {
        ApzCOB.fnDisplayMsg("Please verify the existing applicant's bank account number", "E");
    } else if (window.bankAccountNoVerifiedOtherInfo === "invalid") {
        ApzCOB.fnDisplayMsg("The applicant's bank account number must be verified to perform eNACH", "E");
    } else if (changeBankBankStatus === "yes") {
        ApzCOB.fnDisplayMsg("Please select No for Change Bank Details to proceed with eNACH", "E");
    } else {
        if (ALL_eNACH_BANKS.length > 0) {
            let ifscPrefix = ifscInput.substring(0, 4);
            // const bankExists = ALL_eNACH_BANKS.some(bank =>
            //     bank.code.toUpperCase() === ifscPrefix
            // );
            const bankExists = ALL_eNACH_BANKS.filter(e1 =>
                [
                    e1.new_ifsc?.toUpperCase()?.trim(),
                    e1.old_ifsc?.toUpperCase()?.trim()
                ].includes(ifscPrefix?.toUpperCase()?.trim())
            );
            if (bankExists?.length > 0) {
                $("#" + kmScrId + "validateENachbtn").addClass("sno");
                $("#" + kmScrId + "eNachValidatedbtn").removeClass("sno");
                $("#" + kmScrId + "pennyChackbtn").removeClass("sno");
                othInforEditFlag.valEnach = "true"; //19th june changes
                //$("#"+kmScrId + "changeBankRadioBtn_option_yes").attr("disabled", true)
            } else {
                $("#" + kmScrId + "validateENachbtn").addClass("sno");
                $("#" + kmScrId + "eNachInvalidbtn").removeClass("sno");
                $("#" + kmScrId + "changeBankRadioBtn_option_no").attr("disabled", true)
                $("#" + kmScrId + "changeBankRadioBtn_option_no").addClass('BankDetailsDisable');
                $("#" + kmScrId + "changeBankRadioBtn_option_yes").attr("checked", true)
                apz.app.OtherInformation.fnChangeAccountDetailsOnChange();
                othInforEditFlag.valEnach = "false";  //19th june changes
            }
        } else {
            ApzCOB.fnDisplayMsg("Please try again later", "E");
        }
    }
};
apz.app.OtherInformation.validateENachOnChangeBank = function () {
    if (ALL_eNACH_BANKS.length !== 0) {
        let ifscInputLength = $("#" + kmScrId + "changeBankIFSCCode").val().trim().toUpperCase().length;
        if (ifscInputLength === 11) {
            let ifscInput = $("#" + kmScrId + "changeBankIFSCCode").val().trim().toUpperCase();
            if (!apz.isNull($("#" + kmScrId + "changeBankIFSCCode").val())) {
                let ifscPrefix = ifscInput.substring(0, 4);
                // const bankExistsOnChangeBank = ALL_eNACH_BANKS.some(bank =>
                //     bank.code.toUpperCase() === ifscPrefix
                // );
                const bankExistsOnChangeBank = ALL_eNACH_BANKS.filter(e1 =>
                [
                    e1.new_ifsc?.toUpperCase()?.trim(),
                    e1.old_ifsc?.toUpperCase()?.trim()
                ].includes(ifscPrefix?.toUpperCase()?.trim())
            );
                if (bankExistsOnChangeBank?.length > 0) {
                    $("#" + kmScrId + "changeBankValidateENachbtn").addClass("sno");
                    $("#" + kmScrId + "changeBankeNachValidatedbtn").removeClass("sno");
                    othInforEditFlag.newBankValEnach = "true"; //19th june changes
                    isOtherInfoSaveDraft = "";
                    apz.app.OtherInformation.fnSaveDraftOrNext(true);
                } else {
                    $("#" + kmScrId + "changeBankValidateENachbtn").addClass("sno");
                    $("#" + kmScrId + "changeBankeNachInvalid").removeClass("sno");
                    othInforEditFlag.newBankValEnach = "false"; //19th june changes
                }
            } else {
                ApzCOB.fnDisplayMsg("Please enter valid IFSC code", "E");
            }
        } else {
            $("#" + kmScrId + "changeBankIFSCCode").val("")
            ApzCOB.fnDisplayMsg("Invalid IFSC code length. Expected 11 characters", "E");
        }
    } else {
        ApzCOB.fnDisplayMsg("Please try again later", "E");
    }
};
apz.app.OtherInformation.fnInsuranceTypeInSession = function () {
    const insTypeFromSession =
        inSessionStore?.insuranceDetailsWrapperList?.find(
            item => item?.insuranceDetails?.insuranceType
        )?.insuranceDetails?.insuranceType;
    if (apz.isNull(insTypeFromSession)) return;
    insuranceTypeSelected = insTypeFromSession;
    /* Filter as per insurance type then load */
    let insuranceData = inSessionStore?.insuranceDetailsWrapperList;
    var filteredInsuranceData = insuranceData?.filter(
        item => item?.insuranceDetails?.insuranceType
    ) || [];
    let loanAmountSession = filteredInsuranceData?.[0]?.insuranceDetails?.payload?.loanAmount ?? "";
    $("#" + kmScrId + "nomineeCustomDiv").addClass("sno");
    $("#KmSourc__OtherInformation__noInsCheckBox").prop("checked", false);
    //$("#KmSourc__OtherInformation__insuranceNotOptingReasons").val("Please Select");
    apz.setElmValue("KmSourc__OtherInformation__insuranceNotOptingReasons", "Please Select")
    $("#KmSourc__OtherInformation__otherReasonInput").val('');
    let custDtlIdApplicant = ApzCOB.getCustDetailID('Co-App');
    //apz.setElmValue("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__sumAssuredInput", loanAmountSession == null ? '' : (loanAmountSession > 200000 ? 200000 : loanAmountSession)); // new insurance changes 31st july
    //apz.setElmValue("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__sumAssuredInput", inSessionStore?.insuranceDetailsWrapperList?.[0]?.insuranceDetails?.payload?.loanAmount ?? "")
    //apz.setElmValue("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__insurancePremiumInput", filteredInsuranceData?.[0]?.insuranceDetails?.payload?.insurancePremium ?? "") // new insurance changes 31st july
    if (insTypeFromSession === "bothInsurance") {
        $("#KmSourc__OtherInformation__insuranceTypeRadioBtn_option_bothInsurance").attr("checked", true);
        let docList = inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList;
        let custDtlId = gApzCOB.userDetails.custDtlId;
        let AddDocExists = docList.some(item =>
            parseInt(item.custDtlId) === parseInt(custDtlId) &&
            item.payload.documentType === 'COAPPLNT_CUST_NOMINEE_DOCS'
        );
        if (AddDocExists) {
            $("#" + kmScrId + "nomineeCustomDiv").removeClass("sno");
        }
        ApzCOB.addFieldMandatory("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput");
        apz.populateDropdown(document.getElementById("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput"), apz.app.OtherInformation.buildDDValues(insurersBothDDValues));
        $("#KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput").attr("readonly", "readonly");
        $("#KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput_ext").attr("readonly", "readonly");
        apz.setElmValue("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput", filteredInsuranceData?.[0]?.insuranceDetails?.payload?.insurerName ?? "")
        $("#" + kmScrId + "jiontInsuranceNote").removeClass("sno");
        $("#" + kmScrId + "applicantInsuranceNote").addClass("sno");
        $("#" + kmScrId + "nomineeApplicantDiv").removeClass("sno");
        $("#" + kmScrId + "nomineeCoApplicantDiv").removeClass("sno");
        $("#" + kmScrId + "insuranceWarningDiv").addClass("sno");
        // $("#" + kmScrId + "addCustomNomineeBtnRow").removeClass("sno");
        apz.setElmValue(kmIPaintCoAppInsuranceDetailsId + "coAppRelationWithNom", inSessionStore?.insuranceDetailsWrapperList?.find(item => item?.insuranceDetails?.insuredCustType === "Co-App")?.insuranceDetails?.payload?.nomineeRelation ?? "Please Select");
        ApzCOB.AddOrRemoveDisableFields([`KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput`], false);
        // new insurance changes 31st july - start
        let loanAmount = inSessionStore?.cibilDetailsWrapperList?.find(item =>
            item?.cibilDetails?.custDtlId === Number(gApzCOB?.userDetails?.CoApplicantCustomerId))?.cibilDetails?.eligibleAmt ?? 0;
        let insuranceChargeApplicant = inSessionStore?.cibilDetailsWrapperList?.find(x => x?.cibilDetails?.custDtlId == custDtlIdApplicant)?.cibilDetails?.payload?.insuranceChargeMember ?? '';
        let insuranceChargeSpouse = inSessionStore?.cibilDetailsWrapperList?.find(x => x?.cibilDetails?.custDtlId == custDtlIdApplicant)?.cibilDetails?.payload?.insuranceChargeSpouse ?? '';
        let insuranceChargeBoth = Number(insuranceChargeApplicant) + Number(insuranceChargeSpouse);
        apz.setElmValue("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__sumAssuredInput", loanAmount == null ? '' : (loanAmount > 200000 ? 200000 : loanAmount));
        apz.setElmValue("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__insurancePremiumInput", insuranceChargeBoth);
        // new insurance changes 31st july - end    
        const hasCustNominee = inSessionStore.insuranceDetailsWrapperList?.some(
            item => item.insuranceDetails?.insuredCustType === "Cust-Nominee"
        );
        if (hasCustNominee) {
            const custNomineeData = inSessionStore?.insuranceDetailsWrapperList?.find(
                item => item?.insuranceDetails?.insuredCustType === "Cust-Nominee"
            )?.insuranceDetails?.payload;
            $("#" + kmScrId + "nomineeCustomDiv").removeClass("sno");
            apz.setElmValue(kmIPaintCustomInsDetailsId + "customNomineeForIns", inSessionStore?.insuranceDetailsWrapperList?.find(item => item?.insuranceDetails?.insuredCustType === "Cust-Nominee")?.insuranceDetails?.payload?.nomineeName ?? "");
            apz.setElmValue(kmIPaintCustomInsDetailsId + "customGender", inSessionStore?.insuranceDetailsWrapperList?.find(item => item?.insuranceDetails?.insuredCustType === "Cust-Nominee")?.insuranceDetails?.payload?.gender ?? "Please Select");
            apz.setElmValue(kmIPaintCustomInsDetailsId + "customDob", apz.app.OtherInformation.formatDate(inSessionStore?.insuranceDetailsWrapperList?.find(item => item?.insuranceDetails?.insuredCustType === "Cust-Nominee")?.insuranceDetails?.payload?.nomineeDob ?? ""));
            apz.setElmValue(kmIPaintCustomInsDetailsId + "customAge", inSessionStore?.insuranceDetailsWrapperList?.find(item => item?.insuranceDetails?.insuredCustType === "Cust-Nominee")?.insuranceDetails?.payload?.age ?? "");
            apz.setElmValue(kmIPaintCustomInsDetailsId + "customRelationWithNom", inSessionStore?.insuranceDetailsWrapperList?.find(item => item?.insuranceDetails?.insuredCustType === "Cust-Nominee")?.insuranceDetails?.payload?.nomineeRelation ?? "Please Select");
            apz.setElmValue(kmIPaintCustomInsDetailsId + "customNomContactNumber", inSessionStore?.insuranceDetailsWrapperList?.find(item => item?.insuranceDetails?.insuredCustType === "Cust-Nominee")?.insuranceDetails?.payload?.mobileNumber ?? "");
            othInforEditFlag.customNominee = true;
            apz.app.OtherInformation.insuranceDetailsHideAndShow();
        } else {
            othInforEditFlag.customNominee = false;
            apz.app.OtherInformation.insuranceDetailsHideAndShow();
        }
    }

    else if (insTypeFromSession === "applicant") {
        const reason = inSessionStore.insuranceDetailsWrapperList
            ?.find(item => item.insuranceDetails?.insuranceType === "applicant")
            ?.insuranceDetails?.payload?.reason;
        const hasOtherReasonValue = inSessionStore.insuranceDetailsWrapperList?.some(
            item =>
                item.insuranceDetails?.insuranceType === "applicant" &&
                item.insuranceDetails?.payload?.otherReason?.trim()
        );
        const otherReasonValue = inSessionStore.insuranceDetailsWrapperList
            ?.find(
                item =>
                    item.insuranceDetails?.insuranceType === "applicant" &&
                    item.insuranceDetails?.payload?.otherReason?.trim()
            )
            ?.insuranceDetails?.payload?.otherReason;
        const appInsuranceConsent = inSessionStore.insuranceDetailsWrapperList
            ?.find(
                item => item.insuranceDetails?.insuranceType === "applicant"
            )
            ?.insuranceDetails?.payload?.insuranceConsent;
        $("#KmSourc__OtherInformation__insuranceTypeRadioBtn_option_applicant").attr("checked", true);
        //$("#KmSourc__OtherInformation__noInsCheckBox").prop("checked", true);
        apz.setElmValue("KmSourc__OtherInformation__insuranceNotOptingReasons", apz.isNull(reason) ? "Please Select" : reason)
        if (appInsuranceConsent === "true") {
            $("#KmSourc__OtherInformation__noInsCheckBox").prop("checked", true);
        }
        if (hasOtherReasonValue) {
            $("#KmSourc__OtherInformation__otherReasonRow").removeClass("sno");
            $("#KmSourc__OtherInformation__otherReasonInput").val(otherReasonValue);
        }
        $("#KmSourc__OtherInformation__insuranceTypeRadioBtn_option_applicant").attr("checked", true);
        let docList = inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList;
        let custDtlId = gApzCOB.userDetails.custDtlId;
        let AddDocExists = docList.some(item =>
            parseInt(item.custDtlId) === parseInt(custDtlId) &&
            item.payload.documentType === 'COAPPLNT_CUST_NOMINEE_DOCS'
        );
        if (AddDocExists) {
            $("#" + kmScrId + "nomineeCustomDiv").removeClass("sno");
        }
        $("#KmSourc__OtherInformation__applicantInsCoLabel").removeClass("sno")
        ApzCOB.addFieldMandatory("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput");
        apz.populateDropdown(document.getElementById("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput"), apz.app.OtherInformation.buildDDValues(insurersApplicantDDValues));
        $("#KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput").attr("readonly", "readonly");
        $("#KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput_ext").attr("readonly", "readonly");
        apz.setElmValue("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput", filteredInsuranceData?.[0]?.insuranceDetails?.payload?.insurerName ?? "")
        // $("#" + kmScrId + "addCustomNomineeBtnRow").removeClass("sno");
        $("#" + kmScrId + "applicantInsuranceNote").removeClass("sno");
        $("#" + kmScrId + "jiontInsuranceNote").addClass("sno");
        $("#" + kmScrId + "nomineeApplicantDiv").removeClass("sno");
        $("#" + kmScrId + "nomineeCoApplicantDiv").addClass("sno");
        $("#" + kmScrId + "insuranceWarningDiv").removeClass("sno");
        ApzCOB.AddOrRemoveDisableFields([`KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput`], false);
        // new insurance changes 31st july - start
        let loanAmount = inSessionStore?.cibilDetailsWrapperList?.find(item =>
            item?.cibilDetails?.custDtlId === Number(gApzCOB?.userDetails?.CoApplicantCustomerId))?.cibilDetails?.eligibleAmt ?? 0;
        let insuranceChargeApplicant = inSessionStore?.cibilDetailsWrapperList?.find(x => x?.cibilDetails?.custDtlId == custDtlIdApplicant)?.cibilDetails?.payload?.insuranceChargeMember ?? '';
        apz.setElmValue("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__sumAssuredInput", loanAmount == null ? '' : (loanAmount > 200000 ? 200000 : loanAmount));
        apz.setElmValue("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__insurancePremiumInput", insuranceChargeApplicant);
        // new insurance changes 31st july - end    
        const hasCustNominee = inSessionStore.insuranceDetailsWrapperList?.some(
            item => item.insuranceDetails?.insuredCustType === "Cust-Nominee"
        );
        if (hasCustNominee) {
            const custNomineeData = inSessionStore?.insuranceDetailsWrapperList?.find(
                item => item?.insuranceDetails?.insuredCustType === "Cust-Nominee"
            )?.insuranceDetails?.payload;
            $("#" + kmScrId + "nomineeCustomDiv").removeClass("sno");
            apz.setElmValue(kmIPaintCustomInsDetailsId + "customNomineeForIns", inSessionStore?.insuranceDetailsWrapperList?.find(item => item?.insuranceDetails?.insuredCustType === "Cust-Nominee")?.insuranceDetails?.payload?.nomineeName ?? "");
            apz.setElmValue(kmIPaintCustomInsDetailsId + "customGender", inSessionStore?.insuranceDetailsWrapperList?.find(item => item?.insuranceDetails?.insuredCustType === "Cust-Nominee")?.insuranceDetails?.payload?.gender ?? "Please Select");
            apz.setElmValue(kmIPaintCustomInsDetailsId + "customDob", apz.app.OtherInformation.formatDate(inSessionStore?.insuranceDetailsWrapperList?.find(item => item?.insuranceDetails?.insuredCustType === "Cust-Nominee")?.insuranceDetails?.payload?.nomineeDob ?? ""));
            apz.setElmValue(kmIPaintCustomInsDetailsId + "customAge", inSessionStore?.insuranceDetailsWrapperList?.find(item => item?.insuranceDetails?.insuredCustType === "Cust-Nominee")?.insuranceDetails?.payload?.age ?? "");
            apz.setElmValue(kmIPaintCustomInsDetailsId + "customRelationWithNom", inSessionStore?.insuranceDetailsWrapperList?.find(item => item?.insuranceDetails?.insuredCustType === "Cust-Nominee")?.insuranceDetails?.payload?.nomineeRelation ?? "Please Select");
            apz.setElmValue(kmIPaintCustomInsDetailsId + "customNomContactNumber", inSessionStore?.insuranceDetailsWrapperList?.find(item => item?.insuranceDetails?.insuredCustType === "Cust-Nominee")?.insuranceDetails?.payload?.mobileNumber ?? "");
            othInforEditFlag.customNominee = true;
            apz.app.OtherInformation.insuranceDetailsHideAndShow();
        } else {
            othInforEditFlag.customNominee = false;
            apz.app.OtherInformation.insuranceDetailsHideAndShow();
        }
    }

    else if (insTypeFromSession === "noInsurance") {
        const reason = inSessionStore.insuranceDetailsWrapperList
            ?.find(item => item.insuranceDetails?.insuranceType === "noInsurance")
            ?.insuranceDetails?.payload?.reason;
        const hasOtherReasonValue = inSessionStore.insuranceDetailsWrapperList?.some(
            item =>
                item.insuranceDetails?.insuranceType === "noInsurance" &&
                item.insuranceDetails?.payload?.otherReason?.trim()
        );
        const otherReasonValue = inSessionStore.insuranceDetailsWrapperList
            ?.find(
                item =>
                    item.insuranceDetails?.insuranceType === "noInsurance" &&
                    item.insuranceDetails?.payload?.otherReason?.trim()
            )
            ?.insuranceDetails?.payload?.otherReason;
        const noInsInsuranceConsent = inSessionStore.insuranceDetailsWrapperList
            ?.find(
                item => item.insuranceDetails?.insuranceType === "noInsurance"
            )
            ?.insuranceDetails?.payload?.insuranceConsent;
        let docList = inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList;
        let custDtlId = gApzCOB.userDetails.custDtlId;
        let AddDocExists = docList.some(item =>
            parseInt(item.custDtlId) === parseInt(custDtlId) &&
            item.payload.documentType === 'COAPPLNT_CUST_NOMINEE_DOCS'
        );
        if (AddDocExists) {
            ApzCOB.fnDisplayMsg("Please delete the uploaded documents to proceed with changing insurance type", "E");
            $("#KmSourc__OtherInformation__insuranceTypeRadioBtn_option_bothInsurance").attr("checked", true)
            apz.app.OtherInformation.fnInsuranceTypeOnChange();
            return;
        }
        $("#KmSourc__OtherInformation__insuranceTypeRadioBtn_option_noInsurance").attr("checked", true);
        ApzCOB.removeFieldMandatory("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput");
        apz.setElmValue("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__sumAssuredInput", "---");
        apz.populateDropdown(document.getElementById("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput"), apz.app.OtherInformation.buildDDValues(insurersNoInsDDValues));
        ApzCOB.AddOrRemoveDisableFields([`KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput`], true);
        //$("#KmSourc__OtherInformation__noInsCheckBox").prop("checked", true);
        apz.setElmValue("KmSourc__OtherInformation__insuranceNotOptingReasons", apz.isNull(reason) ? "Please Select" : reason)
        if (noInsInsuranceConsent === "true") {
            $("#KmSourc__OtherInformation__noInsCheckBox").prop("checked", true);
        }
        if (hasOtherReasonValue) {
            $("#KmSourc__OtherInformation__otherReasonRow").removeClass("sno");
            $("#KmSourc__OtherInformation__otherReasonInput").val(otherReasonValue);
        }
        //$("#KmSourc__OtherInformation__insuranceNotOptingReasons").val(reason);
        $("#" + kmIPaintCustomInsDetailsId + "customNomineeForIns").val("");
        apz.setElmValue(kmIPaintCustomInsDetailsId + "customGender", "")
        $("#" + kmIPaintCustomInsDetailsId + "customDob").val("");
        $("#" + kmIPaintCustomInsDetailsId + "customAge").val("");
        apz.setElmValue(kmIPaintCustomInsDetailsId + "customRelationWithNom", "Please Select")
        $("#" + kmIPaintCustomInsDetailsId + "customNomContactNumber").val("");
        $("#" + kmScrId + "applicantInsuranceNote").addClass("sno");
        $("#" + kmScrId + "jiontInsuranceNote").addClass("sno");
        $("#" + kmScrId + "nomineeApplicantDiv").addClass("sno");
        $("#" + kmScrId + "nomineeCoApplicantDiv").addClass("sno");
        $("#" + kmScrId + "insuranceWarningDiv").removeClass("sno");
        $("#" + kmScrId + "addCustomNomineeBtnRow").addClass("sno");
        othInforEditFlag.customApplicant = false;
        othInforEditFlag.customNominee = false;
        // new insurance changes 31st july - start
        apz.setElmValue("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__sumAssuredInput", "---");
        apz.setElmValue("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__insurancePremiumInput", "---");
        // new insurance changes 31st july - end
    }
}
apz.app.OtherInformation.fnInsuranceTypeOnChange = function (pthis) {
    insuranceTypeSelected = apz.getElmValue(kmScrId + "insuranceTypeRadioBtn");
    //$("#" + kmScrId + "nomineeCustomApplicantDiv").addClass("sno");
    $("#" + kmScrId + "nomineeCustomDiv").addClass("sno");
    $("#KmSourc__OtherInformation__noInsCheckBox").prop("checked", false);
    $("#KmSourc__OtherInformation__insuranceNotOptingReasons").val("Please Select");
    $("#KmSourc__OtherInformation__otherReasonInput").val('');
    let custDtlIdApplicant = ApzCOB.getCustDetailID('Co-App');
    if (insuranceTypeSelected === "bothInsurance") {
        let docList = inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList;
        let custDtlId = gApzCOB.userDetails.custDtlId;
        // let AddDocExists = docList.some(function (item) {
        //     if (parseInt(item.custDtlId) === parseInt(custDtlId)) {
        //         return item.payload.documentType === 'COAPPLNT_CUST_NOMINEE_DOCS';
        //     }
        // });
        let AddDocExists = docList.some(item =>
            parseInt(item.custDtlId) === parseInt(custDtlId) &&
            item.payload.documentType === 'COAPPLNT_CUST_NOMINEE_DOCS'
        );
        if (AddDocExists) {
            // ApzCOB.fnDisplayMsg("Please delete the uploaded documents to proceed with changing insurance type", "E");
            // $("#KmSourc__OtherInformation__insuranceTypeRadioBtn_option_applicant").attr("checked", true)
            // return;
            othInforEditFlag.customNominee = true;
            $("#" + kmScrId + "nomineeCustomDiv").removeClass("sno");
        } else {
            othInforEditFlag.customNominee = false; //9th june new insurance changes
        }
        // $("#" + kmIPaintCustomInsDetailsId + "customNomineeForIns").val("");
        // apz.setElmValue(kmIPaintCustomInsDetailsId + "customGender", "")
        // $("#" + kmIPaintCustomInsDetailsId + "customDob").val("");
        // $("#" + kmIPaintCustomInsDetailsId + "customAge").val("");
        // apz.setElmValue(kmIPaintCustomInsDetailsId + "customRelationWithNom", "Please Select")
        // $("#" + kmIPaintCustomInsDetailsId + "customNomContactNumber").val("");
        $("#" + kmScrId + "jiontInsuranceNote").removeClass("sno");
        $("#" + kmScrId + "applicantInsuranceNote").addClass("sno");
        $("#" + kmScrId + "nomineeApplicantDiv").removeClass("sno");
        $("#" + kmScrId + "nomineeCoApplicantDiv").removeClass("sno");
        $("#" + kmScrId + "insuranceWarningDiv").addClass("sno");
        // $("#" + kmScrId + "addCustomNomineeBtnRow").removeClass("sno");
        apz.setElmValue(kmIPaintCoAppInsuranceDetailsId + "coAppRelationWithNom", inSessionStore?.insuranceDetailsWrapperList?.find(item => item?.insuranceDetails?.insuredCustType === "Co-App")?.insuranceDetails?.payload?.nomineeRelation ?? "Please Select");
        // new insurance changes 26th june
        let loanAmount = inSessionStore?.cibilDetailsWrapperList?.find(item =>
            item?.cibilDetails?.custDtlId === Number(gApzCOB?.userDetails?.CoApplicantCustomerId))?.cibilDetails?.eligibleAmt ?? 0;
        let insuranceChargeApplicant = inSessionStore?.cibilDetailsWrapperList?.find(x => x?.cibilDetails?.custDtlId == custDtlIdApplicant)?.cibilDetails?.payload?.insuranceChargeMember ?? '';
        let insuranceChargeSpouse = inSessionStore?.cibilDetailsWrapperList?.find(x => x?.cibilDetails?.custDtlId == custDtlIdApplicant)?.cibilDetails?.payload?.insuranceChargeSpouse ?? '';
        let insuranceChargeBoth = Number(insuranceChargeApplicant) + Number(insuranceChargeSpouse);
        ApzCOB.AddOrRemoveDisableFields([`KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput`], false);
        ApzCOB.addFieldMandatory("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput");
        ApzCOB.addFieldMandatory("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput");
        apz.populateDropdown(document.getElementById("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput"), apz.app.OtherInformation.buildDDValues(insurersBothDDValues));
        apz.setElmValue("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__sumAssuredInput", loanAmount == null ? '' : (loanAmount > 200000 ? 200000 : loanAmount));
        apz.setElmValue("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__insurancePremiumInput", insuranceChargeBoth); // 24 june changes
        apz.app.OtherInformation.insuranceDetailsHideAndShow();
        $("#KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput").attr("readonly", "readonly");
        $("#KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput_ext").attr("readonly", "readonly");
    }
    else if (insuranceTypeSelected === "applicant") {
        let docList = inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList;
        let custDtlId = gApzCOB.userDetails.custDtlId;
        // let AddDocExists = docList.some(function (item) {
        //     if (parseInt(item.custDtlId) === parseInt(custDtlId)) {
        //         return item.payload.documentType === 'COAPPLNT_CUST_NOMINEE_DOCS';
        //     }
        // });
        let AddDocExists = docList.some(item =>
            parseInt(item.custDtlId) === parseInt(custDtlId) &&
            item.payload.documentType === 'COAPPLNT_CUST_NOMINEE_DOCS'
        );
        if (AddDocExists) {
            // ApzCOB.fnDisplayMsg("Please delete the uploaded documents to proceed with changing insurance type", "E");
            // $("#KmSourc__OtherInformation__insuranceTypeRadioBtn_option_bothInsurance").attr("checked", true)
            // return;
            othInforEditFlag.customNominee = true;
            $("#" + kmScrId + "nomineeCustomDiv").removeClass("sno");
        } else {
            othInforEditFlag.customNominee = false;
        }
        // $("#" + kmIPaintCustomInsDetailsId + "customNomineeForIns").val("");
        // apz.setElmValue(kmIPaintCustomInsDetailsId + "customGender", "")
        // $("#" + kmIPaintCustomInsDetailsId + "customDob").val("");
        // $("#" + kmIPaintCustomInsDetailsId + "customAge").val("");
        // apz.setElmValue(kmIPaintCustomInsDetailsId + "customRelationWithNom", "Please Select")
        // $("#" + kmIPaintCustomInsDetailsId + "customNomContactNumber").val("");
        // $("#" + kmScrId + "addCustomNomineeBtnRow").removeClass("sno");
        $("#" + kmScrId + "applicantInsuranceNote").removeClass("sno");
        $("#" + kmScrId + "jiontInsuranceNote").addClass("sno");
        $("#" + kmScrId + "nomineeApplicantDiv").removeClass("sno");
        $("#" + kmScrId + "nomineeCoApplicantDiv").addClass("sno");
        $("#" + kmScrId + "insuranceWarningDiv").removeClass("sno");
        $("#KmSourc__OtherInformation__applicantInsCoLabel").removeClass("sno")
        // new insurance changes 26th june
        let loanAmount = inSessionStore?.cibilDetailsWrapperList?.find(item =>
            item?.cibilDetails?.custDtlId === Number(gApzCOB?.userDetails?.CoApplicantCustomerId))?.cibilDetails?.eligibleAmt ?? 0;
        let insuranceChargeMember = inSessionStore?.cibilDetailsWrapperList?.find(x => x?.cibilDetails?.custDtlId == custDtlIdApplicant)?.cibilDetails?.payload?.insuranceChargeMember ?? '';
        apz.setElmValue("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__sumAssuredInput", loanAmount == null ? '' : (loanAmount > 200000 ? 200000 : loanAmount));
        ApzCOB.AddOrRemoveDisableFields([`KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput`], false);
        ApzCOB.addFieldMandatory("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput")
        ApzCOB.addFieldMandatory("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput")
        apz.populateDropdown(document.getElementById("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput"), apz.app.OtherInformation.buildDDValues(insurersApplicantDDValues));
        apz.setElmValue("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__insurancePremiumInput", insuranceChargeMember); // 24 june changes
        apz.app.OtherInformation.insuranceDetailsHideAndShow();
        $("#KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput").attr("readonly", "readonly");
        $("#KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput_ext").attr("readonly", "readonly");
    }
    else if (insuranceTypeSelected === "noInsurance") {
        let docList = inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList;
        let custDtlId = gApzCOB.userDetails.custDtlId;
        let AddDocExists = docList.some(item =>
            parseInt(item.custDtlId) === parseInt(custDtlId) &&
            item.payload.documentType === 'COAPPLNT_CUST_NOMINEE_DOCS'
        );
        if (AddDocExists) {
            ApzCOB.fnDisplayMsg("Please delete the uploaded documents to proceed with changing insurance type", "E");
            $("#KmSourc__OtherInformation__insuranceTypeRadioBtn_option_bothInsurance").attr("checked", true)
            apz.app.OtherInformation.fnInsuranceTypeOnChange();
            return;
        }
        $("#" + kmIPaintCustomInsDetailsId + "customNomineeForIns").val("");
        apz.setElmValue(kmIPaintCustomInsDetailsId + "customGender", "")
        $("#" + kmIPaintCustomInsDetailsId + "customDob").val("");
        $("#" + kmIPaintCustomInsDetailsId + "customAge").val("");
        apz.setElmValue(kmIPaintCustomInsDetailsId + "customRelationWithNom", "")
        $("#" + kmIPaintCustomInsDetailsId + "customNomContactNumber").val("");
        $("#" + kmScrId + "applicantInsuranceNote").addClass("sno");
        $("#" + kmScrId + "jiontInsuranceNote").addClass("sno");
        $("#" + kmScrId + "nomineeApplicantDiv").addClass("sno");
        $("#" + kmScrId + "nomineeCoApplicantDiv").addClass("sno");
        $("#" + kmScrId + "insuranceWarningDiv").removeClass("sno");
        $("#KmSourc__OtherInformation__applicantInsCoLabel").addClass("sno")
        $("#" + kmScrId + "addCustomNomineeBtnRow").addClass("sno");
        othInforEditFlag.customApplicant = false;
        othInforEditFlag.customNominee = false;
        // new insurance changes 26th june
        apz.setElmValue("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__sumAssuredInput", "---");
        apz.setElmValue("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__insurancePremiumInput", "---"); // 24 june changes
        ApzCOB.AddOrRemoveDisableFields([`KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput`], true);
        ApzCOB.removeFieldMandatory("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput");
        apz.populateDropdown(document.getElementById("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput"), apz.app.OtherInformation.buildDDValues(insurersNoInsDDValues));
        //apz.setElmValue("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput", ""); // 24 june changes
    }
};
apz.app.OtherInformation.fnChangeAccountDetailsOnChange = function (pthis) {
    //let selectedChangeBankRadioBtn = pthis.value; 
    let bankCurrIndex = !apz.isNull(inSessionStore.bankDetailsWrapperList) ? ApzCOB.getIndexforBankWrapper("Applicant") : 0;
    let selectedChangeBankRadioBtn = apz.getElmValue(kmScrId + "changeBankRadioBtn");
    if (selectedChangeBankRadioBtn === "yes") {
        let docList = inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList;
        let custDtlId = gApzCOB.userDetails.custDtlId;
        let changeBankDetailsStatusOnChange = inSessionStore?.bankDetailsWrapperList?.[bankCurrIndex]?.bankDetails?.payload?.editBankDetails;
        let AddDocExists = docList.some(item =>
            parseInt(item.custDtlId) === parseInt(custDtlId) &&
            item.payload.documentType === 'BANK_ACCOUNT_PROOF'
        );
        if (AddDocExists) {
            if (changeBankDetailsStatusOnChange !== "Yes" && gApzCOB.productCode !== "1001") {
                ApzCOB.fnDisplayMsg("Please delete the uploaded documents of the old bank account to proceed with changing the bank account details", "E");
                $("#" + kmScrId + "changeBankRadioBtn_option_no").attr("checked", true)
                return;
            }
        }
        let pennyResponseSession = inSessionStore?.bankDetailsWrapperList?.[bankCurrIndex]?.bankDetails?.payload?.pennyResp;
        if (
            (!apz.isNull(pennyResponse) || (!apz.isNull(pennyResponseSession) && changeBankDetailsStatusOnChange !== "Yes") || othInforEditFlag.valPennyCheck === "true")
            && gApzCOB.productCode !== "1001"
        ) {
            ApzCOB.fnDisplayMsg("e-NACH & Penny check response will be changed. Are you sure you want to continue?", "C", apz.app.OtherInformation.erasePennyResponse);
        }
        // if (pennyResponse !== "") {
        //     ApzCOB.fnDisplayMsg("The applicable image/document/verifications/data will be permanently removed, Are you sure you want to continue?", "C", apz.app.OtherInformation.erasePennyResponse);
        // }
        othInforEditFlag.valChangeBank = true;
        // if (inSessionStore?.bankDetailsWrapperList?.[0]?.bankDetails?.payload) {
        //     inSessionStore.bankDetailsWrapperList[0].bankDetails.payload.editBankDetails = "Yes";
        // }
        apz.setElmValue(kmScrId + "changeBankAccountType", "Savings");
        $("#" + kmScrId + "changedBankDetails").removeClass("sno");
        //$("#" + kmScrId + "validateENachbtn").addClass("sno"); MUI-364 fixes (code merging issue)
        //to enable eNach-validate button if it is disabled
        // $("#" + kmScrId + "changeBankValidateENachbtn").removeClass("sno");
        // $("#" + kmScrId + "changeBankeNachValidatedbtn").addClass("sno");
        $("#" + kmScrId + "changeBankeNachValidatedbtn").addClass("sno");
        $("#" + kmScrId + "changeBankeNachInvalid").addClass("sno");
        $("#" + kmScrId + "changeBankValidateENachbtn").addClass("sno");
    }
    else if (selectedChangeBankRadioBtn === "no") {
        let docList = inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList;
        let custDtlId = gApzCOB.userDetails.custDtlId;
        let AddDocExists = docList.some(item =>  //16th june Bank_account_proof changes 
            parseInt(item.custDtlId) === parseInt(custDtlId) &&
            item.payload.documentType === 'BANK_ACCOUNT_PROOF'
        );
        if (AddDocExists) {
            ApzCOB.fnDisplayMsg("Please delete the uploaded documents to proceed with changing bank account details", "E");
            $("#" + kmScrId + "changeBankRadioBtn_option_yes").attr("checked", true)
            return;
        }
        othInforEditFlag.valChangeBank = false;
        // if (inSessionStore?.bankDetailsWrapperList?.[0]?.bankDetails?.payload) {
        //     inSessionStore.bankDetailsWrapperList[0].bankDetails.payload.editBankDetails = "No";
        // }
        $("#" + kmScrId + "changeBankIFSCCode").val("");
        $("#" + kmScrId + "changeBankBankName").val("");
        $("#" + kmScrId + "changeBankBranchName").val("");
        $("#" + kmScrId + "changedBankDetails").val("");
        apz.setElmValue(kmScrId + "changeBankAccountType", "Savings");
        apz.setElmValue(kmScrId + "changeBankTypeOfDoc", "");
        $("#" + kmScrId + "changedBankDetails").addClass("sno");
        //$("#" + kmScrId + "validateENachbtn").removeClass("sno"); // MUI-171 fixes (code merging issue)
    }
}
apz.app.OtherInformation.erasePennyResponse = function (params) {
    if (params.choice) {
        let bankCurrIndex = !apz.isNull(inSessionStore.bankDetailsWrapperList) ? ApzCOB.getIndexforBankWrapper("Applicant") : 0;
        pennyResponse = "";
        if (gApzCOB.productCode !== "1001") {
            $("#" + kmScrId + "pennyChackbtn").removeClass("sno");
        }
        $("#" + kmScrId + "pennyChackbtn").addClass("sno");
        $("#" + kmScrId + "validateENachbtn").removeClass("sno");
        //$("#" + kmScrId + "validateENachbtn").addClass("sno");  MUI-364 fixes (code merging issue)
        $("#" + kmScrId + "eNachValidatedbtn").addClass("sno");
        $("#" + kmScrId + "pennyCheckSuccessbtn").addClass("sno");
        $("#" + kmScrId + "uploadDocDiv").addClass("sno");
        othInforEditFlag.valPennyCheck = "";
        othInforEditFlag.valChangeBank = true;
        // if (inSessionStore?.bankDetailsWrapperList?.[0]?.bankDetails?.payload) {
        //     inSessionStore.bankDetailsWrapperList[0].bankDetails.payload.editBankDetails = "Yes";
        // }
        apz.setElmValue(kmScrId + "changeBankAccountType", "Savings");
        $("#" + kmScrId + "changedBankDetails").removeClass("sno");
        $("#" + kmScrId + "changeBankeNachValidatedbtn").addClass("sno");
        $("#" + kmScrId + "changeBankeNachInvalid").addClass("sno");
        $("#" + kmScrId + "changeBankValidateENachbtn").addClass("sno");
        let loadBasicBankDetails = inSessionStore?.bankDetailsWrapperList?.[bankCurrIndex]?.bankDetails?.payload;
        if (loadBasicBankDetails?.editBankDetails == "Yes" && apz.isNull(loadBasicBankDetails?.secondaryENachStatus)) { //31st july fixes
            $("#" + kmScrId + "changeBankValidateENachbtn").removeClass("sno");
        }
    } else {
        $("#" + kmScrId + "changeBankRadioBtn_option_no").attr("checked", true);
        othInforEditFlag.valChangeBank = false;
        // if (inSessionStore?.bankDetailsWrapperList?.[0]?.bankDetails?.payload) {
        //     inSessionStore.bankDetailsWrapperList[0].bankDetails.payload.editBankDetails = "No";
        // }
        $("#" + kmScrId + "changeBankIFSCCode").val("");
        $("#" + kmScrId + "changeBankBankName").val("");
        $("#" + kmScrId + "changeBankBranchName").val("");
        $("#" + kmScrId + "changedBankDetails").val("");
        apz.setElmValue(kmScrId + "changeBankAccountType", "Savings");
        apz.setElmValue(kmScrId + "changeBankTypeOfDoc", "");
        $("#" + kmScrId + "changedBankDetails").addClass("sno");
    }
}
apz.app.OtherInformation.validateENachChangeBank = function () {
    $("#" + kmScrId + "changeBankValidateENachbtn").addClass("sno");
    $("#" + kmScrId + "changeBankeNachValidatedbtn").removeClass("sno");
};
apz.app.OtherInformation.fnOnFocusIFSCCode = function () {
    $("#" + kmScrId + "changeBankeNachValidatedbtn").addClass("sno");
    $("#" + kmScrId + "changeBankeNachInvalid").addClass("sno");
    $("#" + kmScrId + "changeBankValidateENachbtn").removeClass("sno");
    othInforEditFlag.newBankValEnach = ""
    if ($("#" + kmScrId + "changeBankIFSCCode").next(".err").length > 0) {
        $("#" + kmScrId + "changeBankBankName").val('')
        $("#" + kmScrId + "changeBankBranchName").val('')
    }
};
apz.app.OtherInformation.onChangeBankNameSecondary = function () {
    let bankNamelenght = $("#" + kmScrId + "changeBankBankName").val().length;
    if (bankNamelenght > 0) {
        $("#" + kmScrId + "changeBankValidateENachbtn").removeClass("sno");
    } else {
        $("#" + kmScrId + "changeBankeNachValidatedbtn").addClass("sno");
        $("#" + kmScrId + "changeBankeNachInvalid").addClass("sno");
        $("#" + kmScrId + "changeBankValidateENachbtn").addClass("sno");
    }
};
apz.app.OtherInformation.ageCalculator = function (pthis) {
    var age = ApzCOB.getAge($(pthis).val());
    if (pthis.id === 'KmSourc__IPaintCustAppInsDetails__o__custAppInsDetails__custAppDob') {
        if (age > 0 && age < 60) {
            $('#' + kmIPaintCustAppInsDetailsId + 'custAppAge').val(age).change();
            ApzCOB.removeErrMessgae(kmIPaintCustAppInsDetailsId + 'custAppAge', "element");
        } else {
            $('#' + kmIPaintCustAppInsDetailsId + 'custAppAge').val('');
            $(pthis).val("")
            ApzCOB.fnDisplayMsg(`Please select valid age(min:${newMinAge},max:${newMaxAge})`, "E");
        }
    } else if (pthis.id === 'KmSourc__IPaintCustomNomineeDetails__o__customNomineeDetails__customDob') {
        if (age > 0 && age < 60) {
            $('#' + kmIPaintCustomInsDetailsId + 'customAge').val(age).change();
            ApzCOB.removeErrMessgae(kmIPaintCustomInsDetailsId + 'customAge', "element");
        } else {
            $('#' + kmIPaintCustomInsDetailsId + 'customAge').val('');
            $(pthis).val("")
            ApzCOB.fnDisplayMsg(`Please select valid age(min:${newMinAge},max:${newMaxAge})`, "E");
        }
    } else {
        if (age > 0 && age < 60) {
            $('#' + kmIPaintEditInsuranceDetailsId + 'editModelNomineeAge').val(age).change();
            ApzCOB.removeErrMessgae(kmIPaintEditInsuranceDetailsId + 'editModelNomineeAge', "element");
        } else {
            $('#' + kmIPaintEditInsuranceDetailsId + 'editModelNomineeAge').val('');
            $(pthis).val("")
            ApzCOB.fnDisplayMsg(`Please select valid age(min:${newMinAge},max:${newMaxAge})`, "E");
        }
    }
};
apz.app.OtherInformation.dobValidation = function (pthis) {
    let age = $(pthis).val();
    let msg = `Please select valid age(min:${newMinAge},max:${newMaxAge})`;
    if (!(parseInt(age) >= newMinAge)) {
        $(pthis).val("");
        if (pthis.id === "KmSourc__IPaintEditInsuranceDetails__o__editInsuranceDetails__editModelNomineeAge") {
            $("#" + kmIPaintEditInsuranceDetailsId + "editModelNomineeDOB").val("")
        } else if (pthis.id === "KmSourc__IPaintCustAppInsDetails__o__custAppInsDetails__custAppAge") {
            $("#" + kmIPaintCustAppInsDetailsId + "custAppDob").val("")
            KmSourc__IPaintCustAppInsDetails__o__custAppInsDetails__custAppDob
        } else if (pthis.id === "KmSourc__IPaintCustomNomineeDetails__o__customNomineeDetails__customAge") {
            $("#" + kmIPaintCustomInsDetailsId + "customDob").val("")
        }
        ApzCOB.fnDisplayMsg(msg, "E");
    }
};
