apz.app.OtherInformation.fnSaveDraftOrNext = function (isDraft) {
    apz.startLoader();
    var isVerified = "";
    if (isDraft) {
        isVerified = "N"
    } else {
        isVerified = "Y"
    }
    let docNamePrimaryBank = $("#KmSourc__OtherInformation__bankDetTypeOfDocument").val();
    let docNameSecondaryBank = $("#KmSourc__OtherInformation__changeBankTypeOfDoc").val();
    amlQuestionConsent = $("#KmSourc__OtherInformation__amlCheckBox").is(":checked");
    let insData = apz.data.buildData("IPaintInsuranceDetails", "KmSourc").KmSourc__IPaintInsuranceDetails_Res.insuranceDetails;
    let insAppNomData = apz.data.buildData("IPaintAppInsuranceDetails", "KmSourc").KmSourc__IPaintAppInsuranceDetails_Res.appInsuranceDetails;
    let insCoAppNomData = apz.data.buildData("IPaintCoAppInsuranceDetails", "KmSourc").KmSourc__IPaintCoAppInsuranceDetails_Res.coAppInsuranceDetails;
    let insCustAppNomData = apz.data.buildData("IPaintCustAppInsDetails", "KmSourc").KmSourc__IPaintCustAppInsDetails_Res.custAppInsDetails;
    let insCustomNomineeData = apz.data.buildData("IPaintCustomNomineeDetails", "KmSourc").KmSourc__IPaintCustomNomineeDetails_Res.customNomineeDetails
    let bankDetails = apz.app.OtherInformation.fnBuildDataForBankDetails();
    let changeBankDetails = apz.app.OtherInformation.fnBuildDataForChangeBankDetails();
    let bankDetailsAllPayload = apz.app.OtherInformation.getBankPayload(bankDetails, othInforEditFlag, changeBankDetails, docNamePrimaryBank, docNameSecondaryBank)
    let req = {};
    let role = gApzCOB.LoggedInUserDetails.loginResponse.addInfo1;
    let intfName = "CreateLoan";
    req.apiRequest = {};
    req.apiRequest.requestObj = {};
    req.apiRequest.userId = gApzCOB.LoggedInUserDetails.loginResponse.userDet.id;
    req.apiRequest.appId = gAppId;
    req.apiRequest.interfaceName = intfName;
    req.apiRequest.requestObj = {
        isNewSourcing: "Y",
        isStageVerified: isVerified,
        appId: gApzCOB.userDetails.appId,
        applicationId: !apz.isNull(gApzCOB.relatedApplicationId) ? gApzCOB.relatedApplicationId : gApzCOB.userDetails.applicationId,
        versionNum: window.versionNum,
        isExistingCustomer: "",
        customerDetailsList: inSessionStore.customerDetailsList,
        addressDetailsWrapperList: inSessionStore.addressDetailsWrapperList,
        applicationDocumentsWrapperList: inSessionStore.applicationDocumentsWrapperList || [],
        applicationMaster: {
            applicationType: "online",
            appId: gApzCOB.userDetails.appId,
            applicationId: gApzCOB.userDetails.applicationId,
            createdBy: gApzCOB.LoggedInUserDetails.loginResponse.userDet.id,
            currentScreenId: "OtherInformation",
            currentStageNo: 1,
            custDtlId: gApzCOB.userDetails.custDtlId,
            addressDtlsId: gApzCOB.userDetails.addressDtlsId,
            customerId: ProductData[0].productCode === "1001" ? "" : gApzCOB.userDetails.customerId,
            declarationFlag: gApzCOB.userDetails.declarationFlag,
            mobileNumber: !apz.isNull(gApzCOB.userDetails.mobileNum) ? gApzCOB.userDetails.mobileNum : "",
            productCode: apz.isNull(gApzCOB.productCode) ? "1009" : gApzCOB.productCode,
            productGroupCode: gApzCOB.product,
            searchCode1: gApzCOB.selLeadDtls.kendraId,
            searchCode2: gApzCOB.selLeadDtls.customerId,
            custDtlSlNum: gApzCOB.currentApplicant,
            applicantsCount: gApzCOB.noOfApplicants,
            mainProductGroupCode: gApzCOB.mainProductGroupCode,
            kendraId: gApzCOB.selLeadDtls.kendraId,
            kendraName: gApzCOB.selLeadDtls.kendraName,
            branchId: gApzCOB.selLeadDtls.glBranchId,
            branchName: gApzCOB.selLeadDtls.glBranchName,
            memberId: gApzCOB.selLeadDtls.customerId,
            primaryKycType: "Voter ID",
            primaryKycId: gApzCOB.selLeadDtls.primaryKyc,
            // secondaryKycType: secondaryKycType,
            // secondaryKycId: secondaryKycId,
            workitemNo: ProductData[0].productCode === "1001"
                ? String(gApzCOB.selLeadDtls.referenceId || gApzCOB.selLeadDtls.openMarketId)
                : gApzCOB.selLeadDtls.pid
            // alternateVoterId: alternateVoterId
        },
        amlQuestion: {
            "applicationId": gApzCOB.userDetails.applicationId,
            "payload": {
                "amlQuestionList": apz.app.OtherInformation.getAMLQuestionnaireData()?.amlQuestionList,
                "amlQuestionsConsent": amlQuestionConsent
            }
        },
        "bankDetailsWrapperList": [
            {
                "bankDtlId": "",
                "bankDetails": {
                    appId: gApzCOB.userDetails.appId,
                    applicationId: !apz.isNull(gApzCOB.relatedApplicationId) ? gApzCOB.relatedApplicationId : gApzCOB.userDetails.applicationId,
                    versionNum: window.versionNum,
                    "bankDtlId": "",
                    "custDtlId": gApzCOB.userDetails.custDtlId,
                    "payload": {
                        "bankdocumentType": bankDetailsAllPayload.bankdocumentType,
                        "accountType": bankDetailsAllPayload.accountType,
                        "accountName": bankDetailsAllPayload.accountName,
                        "ifsc": bankDetailsAllPayload.ifsc,
                        "bankName": bankDetailsAllPayload.bankName,
                        "branchName": bankDetailsAllPayload.branchName,
                        "accountNumber": bankDetailsAllPayload.accountNumber,
                        "editBankDetails": bankDetailsAllPayload.editBankDetails,
                        "pennyCheckStatus": bankDetailsAllPayload.pennyCheckStatus,
                        "pennyResp": bankDetailsAllPayload.pennyResp,
                        "eNachStatus": bankDetailsAllPayload.eNachStatus,
                        "primaryPennyCheckStatus": bankDetailsAllPayload.primaryPennyCheckStatus,
                        "primaryENachStatus": bankDetailsAllPayload.primaryENachStatus,
                        "secondaryENachStatus": bankDetailsAllPayload.secondaryENachStatus,
                        "accntVerified": bankDetailsAllPayload.accntVerified,
                        "reEnterAccountNumber": bankDetailsAllPayload.reEnterAccountNumber,
                    }
                }
            }
        ],
        "insuranceType": insuranceTypeSelected,
        "insuranceDetailsWrapperList": getInsurancePayload({
            radioValue: insuranceTypeSelected,        // or "Applicant" or "NoInsurance"
            isNomineeRequired: othInforEditFlag.customNominee,    // true → includes Cust-Nominee object
            insData,
            insAppNomData,
            insCoAppNomData,
            insCustomNomineeData,
            gApzCOB,
            gAppId,
        }),
        workflow: {
            currentRole: role
        }
    }
    if (["BMPUSHBACK", "IPUSHBACK", "CAPUSHBACK"].includes(window.ApplicationStatus))
        req.apiRequest.requestObj.queryResponse = apz.app.Kmbase.prepareQueryResponse();
    ApzCOB.serverBuildParam(gAppId, "CreateLoan", "N", "N", req, false, apz.app.OtherInformation.fnOtherInformationCB);
}
apz.app.OtherInformation.fnOtherInformationCB = function (params) {
    apz.stopLoader();
    if (apz.isNull(params.errors)) {
        if (params.res.hasOwnProperty("APZCBO__CreateLoan_Res") && params.res.APZCBO__CreateLoan_Res?.apiResponse?.ResponseHeader?.ResponseCode == '0') {
            ApzCOB.updateInsessionData(params);
            apz.app.Kmbase.paintSidebarStatus();
            if (params.req?.apiRequest?.requestObj?.isStageVerified == 'N' && isOtherInfoSaveDraft === true) {
                ApzCOB.showNewCommonSuccessModal({
                    text: "Draft saved successfully",
                    Btn: {
                        text: "OK",
                        onClick: "ApzCOB.closeCommonModal(`newCommonSuccModal`)"
                    }
                });
                return;
            }
            if (params.req?.apiRequest?.requestObj?.isStageVerified == 'Y') {

            }
        }
    }
};
apz.app.OtherInformation.fnBuildDataForBankDetails = function () {
    let bankCurrIndex = !apz.isNull(inSessionStore.bankDetailsWrapperList) ? ApzCOB.getIndexforBankWrapper("Applicant") : 0;
    return {
        "accountType": $("#KmSourc__OtherInformation__accountTypeBankDetials").val(),
        "accountName": apz.getElmValue("KmSourc__OtherInformation__accountHolderNameInput"),
        "ifsc": apz.getElmValue("KmSourc__OtherInformation__ifscCodeInput"),
        "bankName": apz.getElmValue("KmSourc__OtherInformation__bankNameInput"),
        "branchName": apz.getElmValue("KmSourc__OtherInformation__branchNameInput"),
        "accountNumber": apz.getElmValue("KmSourc__OtherInformation__accountNumberInput"),
        "pennyCheckStatus": othInforEditFlag.valPennyCheck,
        "pennyResp": "",
        "eNachStatus": othInforEditFlag.valEnach,
        "accntVerified": !apz.isNull(window.bankAccountNoVerifiedOtherInfo)
            ? window.bankAccountNoVerifiedOtherInfo
            : !apz.isNull(inSessionStore?.bankDetailsWrapperList?.[bankCurrIndex]?.bankDetails?.payload?.accntVerified)
                ? inSessionStore.bankDetailsWrapperList[bankCurrIndex].bankDetails.payload.accntVerified
                : "",
    }
}
