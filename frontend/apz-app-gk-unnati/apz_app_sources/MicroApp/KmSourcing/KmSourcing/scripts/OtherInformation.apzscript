apz.app.OtherInformation.paintApplicantInsuranceDetails = function () {
    apz.data.scrdata.KmSourc__IPaintAppInsuranceDetails_Res = {}
    apz.data.scrdata.KmSourc__IPaintAppInsuranceDetails_Res.appInsuranceDetails = {}
    // if (inSessionStore.customerDetailsList[0].payload.hasOwnProperty("gkCustomerType")){
    // insIndex = (inSessionStore.customerDetailsList[0].payload.gkCustomerType !== 'Applicant') ? 0 : 1;
    // } else {
    //     insIndex = 1;
    // }
    // var lData = {
    //     appNomineeForIns: inSessionStore.customerDetailsList[insIndex]?.customerName,
    //     appGender: inSessionStore.customerDetailsList[insIndex].payload?.gender,
    //     appDob: inSessionStore.customerDetailsList[insIndex].payload?.dob,
    //     appAgeOfNominee: inSessionStore.customerDetailsList[insIndex].payload?.age,
    //     appRelationWithNom: inSessionStore.customerDetailsList[insIndex].payload?.relationShipWithApplicant,
    // }
    insIndex = (gApzCOB.requestNodes.customerDetailsList[0].customerType === 'Applicant') ? 1 : 0;
    let appInsPayload = gApzCOB.requestNodes.customerDetailsList[insIndex].payload;
    if (typeof appInsPayload === "string") {
        appInsPayload = JSON.parse(appInsPayload);
    }
    var lData = {
        appNomineeForIns: inSessionStore.customerDetailsList[insIndex]?.customerName,
        appGender: appInsPayload.gender === "F" ? "Female" : appInsPayload.gender === "M" ? "Male" : appInsPayload.gender,
        appDob: (appInsPayload.dob && appInsPayload.dob.includes("/"))
            ? appInsPayload.dob.split("/").reverse().join("-")
            : appInsPayload.dob,
        appAgeOfNominee: appInsPayload.age,
        appRelationWithNom: appInsPayload.relationShipWithApplicant,
    };
    // var lData = {
    //     appNomineeForIns: gApzCOB.requestNodes.customerDetailsList[insIndex].customerName,
    //     appGender: gApzCOB.requestNodes.customerDetailsList[insIndex].payload.gender,
    //     appDob: gApzCOB.requestNodes.customerDetailsList[insIndex].payload.dob,
    //     appAgeOfNominee: gApzCOB.requestNodes.customerDetailsList[insIndex].payload.age,
    //     appRelationWithNom: gApzCOB.requestNodes.customerDetailsList[insIndex].payload.relationShipWithApplicant,
    // }
    apz.data.scrdata.KmSourc__IPaintAppInsuranceDetails_Res.appInsuranceDetails = lData;
    apz.data.loadData("IPaintAppInsuranceDetails", "KmSourc");
};
apz.app.OtherInformation.paintCoApplicantInsuranceDetails = function () {
    let appInsPayload = gApzCOB.requestNodes.customerDetailsList[insIndex].payload;
