        "accountNumber": "",
        "pennyCheckStatus": "",
        "pennyResp": "",
        "eNachStatus": othInforEditFlag.newBankValEnach
    }
}
apz.app.OtherInformation.fnPaintAllDocuments = function () {
    let docList = inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList;
    let bankCurrIndex = !apz.isNull(inSessionStore.bankDetailsWrapperList) ? ApzCOB.getIndexforBankWrapper("Applicant") : 0;
    let changeBankDetailsStatus = inSessionStore?.bankDetailsWrapperList?.[bankCurrIndex]?.bankDetails?.payload?.editBankDetails;
    if (apz.isNull(changeBankDetailsStatus) && gApzCOB.productCode == "1001") {
        changeBankDetailsStatus = 'Yes'; //Open Market JIRA - UAU-1344
    }
    let lDocTypeOthInfo = [
        "BANK_ACCOUNT_PROOF",
        //"CHANGED_BANK_DOCS",
        "APPLNT_CUST_NOMINEE_DOCS",
        "COAPPLNT_CUST_NOMINEE_DOCS",
        "ADDITIONAL_DOCS"
    ];
    lDocTypeOthInfo.forEach(function (lDocType) {
        apz.app.Kmbase.paintDocumentName(lDocType);
    });
    lDocTypeOthInfo.forEach(function (docType) {
        let exists = docList.some(function (item) {
            //if ((item.payload.documentType === docType) && (docType === "BANK_ACCOUNT_PROOF" || docType === "CHANGED_BANK_DOCS")) {
            if ((item.payload.documentType === docType) && (docType === "BANK_ACCOUNT_PROOF")) { // 16 june changes 
                selectedDDvalueForDocs = item?.payload?.documentFileName ?? '';
            }
            return item.payload.documentType === docType;
        });
        if (exists) {
            switch (docType) {
                case "BANK_ACCOUNT_PROOF":
                    if (changeBankDetailsStatus === "No") {
                        //UAU-1548 fixes
                        // $("#" + kmScrId + "validateENachbtn").addClass("sno");
                        // $("#" + kmScrId + "eNachValidatedbtn").removeClass("sno");
                        // $("#" + kmScrId + "pennyChackbtn").addClass("sno");
                        // $("#" + kmScrId + "pennyCheckSuccessbtn").removeClass("sno");
                        $("#" + kmScrId + "uploadDocDiv").removeClass("sno");
                        let docTypePri = selectedDDvalueForDocs.replace(/_\d+\.[^.]+$/, '').replace(/_/g, ' ');
                        //$("#KmSourc__OtherInformation__bankDetTypeOfDocument").val(selectedDDvalueForDocs);
                        apz.setElmValue("KmSourc__OtherInformation__bankDetTypeOfDocument", docTypePri)
                        let docDDValuePriBank = $("#KmSourc__OtherInformation__bankDetTypeOfDocument").val();
                        if ((!apz.isNull(docDDValuePriBank)) && docDDValuePriBank !== "Please Select") {
                            ApzCOB.AddOrRemoveDisableFields([`${kmScrId}bankDetTypeOfDocument`], true);
                        } else {
                            ApzCOB.AddOrRemoveDisableFields([`${kmScrId}bankDetTypeOfDocument`], false);
                        }
                        //othInforEditFlag.valEnach = "true"; //UAU-1548 fixes
                        //othInforEditFlag.valPennyCheck = "true"; //UAU-1548 fixes
                    } else if (changeBankDetailsStatus === "Yes") {
                        //$("#KmSourc__OtherInformation__changeBankTypeOfDoc").val(selectedDDvalueForDocs);
                        let docTypeSec = selectedDDvalueForDocs.replace(/_\d+\.[^.]+$/, '').replace(/_/g, ' ');
                        apz.setElmValue("KmSourc__OtherInformation__changeBankTypeOfDoc", docTypeSec)
                        let docDDValueSecBank = $("#KmSourc__OtherInformation__changeBankTypeOfDoc").val();
                        if ((!apz.isNull(docDDValueSecBank)) && docDDValueSecBank !== "Please Select") {
                            ApzCOB.AddOrRemoveDisableFields([`${kmScrId}changeBankTypeOfDoc`], true);
                        } else {
                            ApzCOB.AddOrRemoveDisableFields([`${kmScrId}changeBankTypeOfDoc`], false);
                        }
                        $("#" + kmScrId + "changeBankRadioBtn_option_yes").attr("checked", true)
                        apz.app.OtherInformation.fnChangeAccountDetailsOnChange();
                    }
                    break;
                case "APPLNT_CUST_NOMINEE_DOCS":
                    //$("#" + kmScrId + "nomineeCustomApplicantDiv").removeClass("sno");
                    othInforEditFlag.customApplicant = true;
                    break;
                case "COAPPLNT_CUST_NOMINEE_DOCS":
                    $("#" + kmScrId + "nomineeCustomDiv").removeClass("sno");
                    apz.setElmValue(kmIPaintCustomInsDetailsId + "customNomineeForIns", inSessionStore?.insuranceDetailsWrapperList?.find(item => item?.insuranceDetails?.insuredCustType === "Cust-Nominee")?.insuranceDetails?.payload?.nomineeName ?? "");
                    apz.setElmValue(kmIPaintCustomInsDetailsId + "customGender", inSessionStore?.insuranceDetailsWrapperList?.find(item => item?.insuranceDetails?.insuredCustType === "Cust-Nominee")?.insuranceDetails?.payload?.gender ?? "Please Select");
                    apz.setElmValue(kmIPaintCustomInsDetailsId + "customDob", apz.app.OtherInformation.formatDate(inSessionStore?.insuranceDetailsWrapperList?.find(item => item?.insuranceDetails?.insuredCustType === "Cust-Nominee")?.insuranceDetails?.payload?.nomineeDob ?? ""));
                    apz.setElmValue(kmIPaintCustomInsDetailsId + "customAge", inSessionStore?.insuranceDetailsWrapperList?.find(item => item?.insuranceDetails?.insuredCustType === "Cust-Nominee")?.insuranceDetails?.payload?.age ?? "");
                    apz.setElmValue(kmIPaintCustomInsDetailsId + "customRelationWithNom", inSessionStore?.insuranceDetailsWrapperList?.find(item => item?.insuranceDetails?.insuredCustType === "Cust-Nominee")?.insuranceDetails?.payload?.nomineeRelation ?? "Please Select");
                    apz.setElmValue(kmIPaintCustomInsDetailsId + "customNomContactNumber", inSessionStore?.insuranceDetailsWrapperList?.find(item => item?.insuranceDetails?.insuredCustType === "Cust-Nominee")?.insuranceDetails?.payload?.mobileNumber ?? "")
                    othInforEditFlag.customNominee = true;
                    apz.app.OtherInformation.insuranceDetailsHideAndShow();
                    break;
                case "ADDITIONAL_DOCS":
                    $("#" + kmScrId + "additionalDocumentDiv").removeClass("sno");
                    //$("#" + kmScrId + "additionalDocUploadBtnDiv").addClass("sno");
                    $("#" + kmScrId + "addDocFrm").addClass("sno");
                    $("#" + kmScrId + "upldaddocNav").addClass("sno");
                    ApzCOB.AddOrRemoveDisableFields([`${kmScrId}nameOfAdditionalDoc`], false);
                    break;
            }
        }
    });
}
apz.app.OtherInformation.setAMLQuestionnaireData = function (data) {
    if (!data || !data.amlQuestionList || data.amlQuestionList.length === 0) return;
    const questionRows = document.querySelectorAll('[id^="KmSourc__OtherInformation__amlQuestionList_row_"]');
    if (!questionRows || questionRows.length === 0) return;
    let amlConsent = inSessionStore?.amlQuestion?.payload?.amlQuestionsConsent;
    if (amlConsent === "true") {
        $("#KmSourc__OtherInformation__amlCheckBox").prop("checked", true);
    } else {
        $("#KmSourc__OtherInformation__amlCheckBox").prop("checked", false);
    }
    data.amlQuestionList.forEach((item, index) => {
        const row = questionRows[index];
        if (!row) return;

        const rowNo = index;

        const questionEl = document.querySelector(
            `#KmSourc__loadAMLQuestions__i__amlQuestions__question_${rowNo}`
        );
        const questionHeader = questionEl?.querySelector('h3')?.innerText?.trim();

        if (!questionHeader || questionHeader !== item.questionType) {
            console.warn("Question mismatch at row:", rowNo);
            return;
        }

        if (item.applicant) {
            const applicantRadio = row.querySelector(
                `input[name="KmSourc__OtherInformation__el_rdo_3_${rowNo}_${rowNo}"][value="${item.applicant}"]`
            );
            if (applicantRadio) applicantRadio.checked = true;
        }

        if (item.coApplicant) {
            const coApplicantRadio = row.querySelector(
                `input[name="KmSourc__OtherInformation__el_rdo_6_${rowNo}_${rowNo}"][value="${item.coApplicant}"]`
            );
            if (coApplicantRadio) coApplicantRadio.checked = true;
        }
    });
};
apz.app.OtherInformation.fnValidateMobileNumber = function (pthis) {
    if (!apz.isNull($("#" + pthis.id).val())) {
        let mobRegex = "^[6789]\\d{9}$";
        let err = ApzCOB.commonRegex(mobRegex, $("#" + pthis.id).val());
        if (!err) {
            $("#" + pthis.id).val('');
            $("#" + pthis.id + "_ul").next().removeClass("sno");
            let errTxtFieldId = $("#" + pthis.id + "_ul").next()?.find('.icon-Error')?.next() ?? $('#dummyid');
            errTxtFieldId?.text(`Please enter a valid mobile number`);
        } else {
            $("#" + pthis.id).removeClass("err");
            $("#" + pthis.id + "_ul").next().addClass("sno");
        }
    }
}
