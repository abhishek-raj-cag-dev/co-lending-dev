        }
        if (gApzCOB?.LoggedInUserDetails?.loginResponse?.addInfo1 === 'BM') { //UAU-1703
            $("#KmSourc__OtherInformation__validateENachbtn").addClass("sno")
            $("#KmSourc__OtherInformation__pennyChackbtn").addClass("sno")
        }
    }
}
apz.app.OtherInformation.sortAdditionalDocs = function (docs) {
    // Filter only ADDITIONAL_DOCS
    const additionalDocs = docs.filter(
        (doc) => doc.documentType === "ADDITIONAL_DOCS"
    );

    return [...additionalDocs].sort((a, b) => {
        const nameA = a.payload.documentFileName;
        const nameB = b.payload.documentFileName;

        const parseFileName = function (fileName) {
            const match = fileName.match(/^(.+?)_(\d+)(\.\w+)?$/);
            if (match) {
                return { base: match[1], num: parseInt(match[2], 10) };
            }
            return { base: fileName, num: 0 };
        };

        const parsedA = parseFileName(nameA);
        const parsedB = parseFileName(nameB);

        // Primary sort: group by base name
        if (parsedA.base < parsedB.base) return -1;
        if (parsedA.base > parsedB.base) return 1;

        // Secondary sort: numeric order within same base name
        if (parsedA.num !== parsedB.num) return parsedA.num - parsedB.num;

        // Tertiary sort: uploadedTs ascending
        return (
            new Date(a.payload.uploadedTs).getTime() -
            new Date(b.payload.uploadedTs).getTime()
        );
    });
};
apz.app.OtherInformation.getUpdatedFileName = function (newFileName, existingDocs) {
    // Extract base name and extension from incoming file
    // "Aadhar.jpeg" → base: "Aadhar", ext: ".jpeg"
    const extractParts = function (fileName) {
        const dotIndex = fileName.lastIndexOf(".");
        if (dotIndex !== -1) {
            return {
                base: fileName.substring(0, dotIndex),
                ext: fileName.substring(dotIndex)  // includes the dot
            };
        }
        return { base: fileName, ext: "" };
    };

    const { base, ext } = extractParts(newFileName);

    // Filter only ADDITIONAL_DOCS
    const additionalDocs = existingDocs.filter(
        (doc) => doc.documentType === "ADDITIONAL_DOCS"
    );

    // Count how many existing docs match the same base name
    // Matches both "Aadhar.jpeg" and "Aadhar_1.jpeg", "Aadhar_2.jpeg"
    const matchCount = additionalDocs.filter(function (doc) {
        const existingName = doc.payload.documentFileName;
        const { base: existingBase } = extractParts(existingName);

        // Strip trailing _number from existing base if present
        // "Aadhar_1" → "Aadhar", "Aadhar" → "Aadhar"
        const strippedBase = existingBase.replace(/_\d+$/, "");

        return strippedBase === base;
    }).length;

    if (matchCount === 0) {
        // No existing doc with same name → return as _1
        return base + "_1" + ext;  // "Aadhar_1.jpeg"
    } else {
        // Existing docs found → return next counter
        return base + "_" + (matchCount + 1) + ext;  // "Aadhar_3.jpeg"
    }
};
function getInsurancePayload({
    radioValue,          // "bothInsurance" | "applicant" | "noInsurance"
    isNomineeRequired,   // boolean flag for Cust-Nominee
    insData,
    insAppNomData,
    insCoAppNomData,
    insCustomNomineeData,
    gApzCOB,
    gAppId,
}) {
    let loanAmount = inSessionStore?.cibilDetailsWrapperList?.find(item =>
        item?.cibilDetails?.custDtlId === Number(gApzCOB?.userDetails?.CoApplicantCustomerId))?.cibilDetails?.eligibleAmt ?? 0;
    var noInsCheckBoxResponse = $("#KmSourc__OtherInformation__noInsCheckBox").is(":checked");
    var insNotOptingReason = $("#KmSourc__OtherInformation__insuranceNotOptingReasons").val();
    insNotOptingReason = (insNotOptingReason === "Please Select") ? "" : insNotOptingReason;
    var insNotOptingOtherReason = apz.getElmValue("KmSourc__OtherInformation__otherReasonInput");
    var checkInsuranceType = "";
    if (radioValue === 'bothInsurance') {
        checkInsuranceType = 'Both'
    }
    if (radioValue === 'applicant') {
        checkInsuranceType = 'Applicant'
    }
    var customNominee = "";
    if (othInforEditFlag.customNominee === true) {
        customNominee = 'Y'
    }
    if (othInforEditFlag.customNominee === false) {
        customNominee = 'N'
    }
    const baseDetails = {
        applicationId: gApzCOB.userDetails.applicationId,
        versionNum: 1,
        appId: gAppId
    };
    var customerData = inSessionStore.customerDetailsList
    var applicantCustDtlId =
        Array.isArray(customerData) && customerData.length > 0
            ? customerData.find(
                customer =>
                    customer?.customerType &&
                    customer.customerType === "Applicant"
            )?.custDtlId ?? null
            : null;

    var coApplicantCustDtlId =
        Array.isArray(customerData) && customerData.length > 0
            ? customerData.find(
                customer =>
                    customer?.customerType &&
                    customer.customerType === "Co-App"
            )?.custDtlId ?? null
            : null;
    const applicantObj = {
        insuranceDetails: {
            ...baseDetails,
            insuranceDtlId: "",
            insuredCustType: "Applicant",
            insuranceType: radioValue,
            custDtlId: applicantCustDtlId,
            payload: {
                insuranceReqd: "Y",
                insuredName: "Applicant",
                nomineeName: insAppNomData.appNomineeForIns,
                nomineeRelation: insAppNomData.appRelationWithNom,
                nomineeDob: insAppNomData.appDob, //1999 - 10 - 31, //demo purpose
                coApplicantInsurance: "Yes",
                age: insAppNomData.appAgeOfNominee,
                rpcEditCheck: false,
                gender: insAppNomData.appGender,
                loanAmount: loanAmount,
                insurerName: insData.nameOfInsurerInput,
                insurancePremium: insData.insurancePremiumInput,
                insuranceOption: checkInsuranceType,
                nomineeAdded: customNominee,
                reason: insNotOptingReason,
                otherReason: insNotOptingOtherReason,
                insuranceConsent: noInsCheckBoxResponse

            },
        },
    }

    const coApplicantObj = {
        insuranceDetails: {
            ...baseDetails,
            insuranceDtlId: "",
            insuredCustType: "Co-App",
            insuranceType: radioValue,
            custDtlId: coApplicantCustDtlId,
            payload: {
                insuranceReqd: "Y",
                insuredName: "Co-App",
                nomineeName: insCoAppNomData.coAppNomineeForIns,
                nomineeRelation: insCoAppNomData.coAppRelationWithNom,
                nomineeDob: insCoAppNomData.coAppDob, //1990 - 12 - 12,// demo purpose
                coApplicantInsurance: "Yes",
                age: insCoAppNomData.coAppAgeOfNominee,
                rpcEditCheck: false,
                gender: insCoAppNomData.coAppGender,
                loanAmount: loanAmount,
                insurerName: insData.nameOfInsurerInput,
                insurancePremium: insData.insurancePremiumInput,
                insuranceOption: checkInsuranceType,
                nomineeAdded: customNominee,
                reason: "",
                otherReason: "",
                insuranceConsent: ""
            },
        },
    };

    const custNomineeObj = {
        insuranceDetails: {
            ...baseDetails,
            insuranceDtlId: "",
            insuredCustType: "Cust-Nominee",
            insuranceType: radioValue,
            custDtlId: "",
            payload: {
                insuranceReqd: "Y",
                insuredName: "Cust-Nominee",
                nomineeName: insCustomNomineeData.customNomineeForIns,
                nomineeRelation: insCustomNomineeData.customRelationWithNom,
                nomineeDob: insCustomNomineeData.customDob, //1990 - 11 - 11, //demo purpose
                coApplicantInsurance: "Yes",
                age: insCustomNomineeData.customAge,
                rpcEditCheck: false,
                gender: insCustomNomineeData.customGender,
                loanAmount: loanAmount,
                insurerName: insData.nameOfInsurerInput,
                insurancePremium: insData.insurancePremiumInput,
                insuranceOption: checkInsuranceType,
                nomineeAdded: customNominee,
                mobileNumber: insCustomNomineeData.customNomContactNumber,
                reason: "",
                otherReason: "",
                insuranceConsent: ""
            },
        },
    };

    const noInsuranceObj = {
        insuranceDetails: {
            ...baseDetails,
            insuranceDtlId: gApzCOB.userDetails.insuranceDtlsId,
            insuredCustType: "Applicant",
            insuranceType: radioValue,
            custDtlId: applicantCustDtlId,
            payload: {
                insuranceReqd: "N",
                insuredName: "No Insurance",
                nomineeName: "",
                nomineeRelation: "",
                nomineeDob: "",
                coApplicantInsurance: "",
                age: "",
                rpcEditCheck: false,
                gender: "",
                loanAmount: loanAmount,
                insurerName: "",
                insurancePremium: "",
                insuranceOption: "No",
                nomineeAdded: "N",
                reason: insNotOptingReason,
                otherReason: insNotOptingOtherReason,
                insuranceConsent: noInsCheckBoxResponse
            },
        },
    };
    switch (radioValue) {
        case "bothInsurance": {
            const payload = [applicantObj, coApplicantObj];
            if (isNomineeRequired) payload.push(custNomineeObj);
            console.log(payload)
            return payload;
        }

        case "applicant": {
            const payload = [applicantObj];
            if (isNomineeRequired) payload.push(custNomineeObj);
            console.log(payload)
            return payload;
        }

        case "noInsurance":
            console.log(noInsuranceObj)
            return [noInsuranceObj];

        default:
            console.warn("Unknown radio value:", radioValue);
            return [];
    }
}
apz.app.OtherInformation.formatDate = function (cbDate) {
    if (!cbDate) return '';
    const d = new Date(cbDate);
    const day = String(d.getDate()).padStart(2, '0');
    const month = String(d.getMonth() + 1).padStart(2, '0');
    const year = d.getFullYear();
    return `${day}/${month}/${year}`;
}
apz.app.OtherInformation.getBankPayload = function (bankDetails, othInforEditFlag, changeBankDetails, docNamePrimaryBank, docNameSecondaryBank) {
    const isEditBank = othInforEditFlag?.valChangeBank === true;
    let bankCurrIndex = !apz.isNull(inSessionStore.bankDetailsWrapperList) ? ApzCOB.getIndexforBankWrapper("Applicant") : 0;
    var payload = inSessionStore?.bankDetailsWrapperList?.[bankCurrIndex]?.bankDetails?.payload;
    var bankDetailsResp =
        payload?.editBankDetails === "Yes"
            ? {
                accountName: payload?.accountName || "",
                accountNumber: payload?.accountNumber || "",
                pennyResp: payload?.pennyResp || "",
                pennyCheckStatus: payload?.pennyCheckStatus || "",
                reEnterAccountNumber: payload?.reEnterAccountNumber || "",
                accntVerified: payload?.accntVerified || ""
            }
            : {};
    return {
        editBankDetails:
            othInforEditFlag?.valChangeBank === true
                ? "Yes" : othInforEditFlag?.valChangeBank === false
                    ? "No" : "No",
        // Fields only when valChangeBank = true
        ...(!isEditBank && {
            accountName: bankDetails.accountName,
            accountNumber: bankDetails.accountNumber,
            accountType: bankDetails.accountType,
            ifsc: bankDetails.ifsc,
            bankName: bankDetails.bankName,
            branchName: bankDetails.branchName,
            pennyCheckStatus: bankDetails.pennyCheckStatus === "true" ? "PASS" : bankDetails.pennyCheckStatus === "false" ? "FAIL" : "",
            eNachStatus: bankDetails.eNachStatus,
            pennyResp: !apz.isNull(pennyResponse)
                ? pennyResponse
                : !apz.isNull(
                    inSessionStore?.bankDetailsWrapperList?.[bankCurrIndex]?.bankDetails?.payload?.pennyResp
                )
                    ? inSessionStore.bankDetailsWrapperList[bankCurrIndex].bankDetails.payload.pennyResp
                    : "",
            primaryPennyCheckStatus: bankDetails.pennyCheckStatus,
            primaryENachStatus: bankDetails.eNachStatus,
            secondaryENachStatus: "",
            accntVerified: bankDetails.accntVerified,
            bankdocumentType: (docNamePrimaryBank == "Please Select" || !docNamePrimaryBank) ? "" : docNamePrimaryBank,
        }),
        // Fields only when valChangeBank = false
        ...(isEditBank && {
            accountName: bankDetailsResp.accountName,
            accountNumber: bankDetailsResp.accountNumber,
            accountType: changeBankDetails.accountType,
            ifsc: changeBankDetails.ifsc,
            bankName: changeBankDetails.bankName,
            branchName: changeBankDetails.branchName,
            pennyCheckStatus: bankDetailsResp.pennyCheckStatus,
            eNachStatus: changeBankDetails.eNachStatus,
            pennyResp: bankDetailsResp.pennyResp,
            primaryPennyCheckStatus: bankDetails.pennyCheckStatus,
            primaryENachStatus: bankDetails.eNachStatus,
            secondaryENachStatus: changeBankDetails.eNachStatus,
            accntVerified: bankDetailsResp.accntVerified,
            reEnterAccountNumber: bankDetailsResp.reEnterAccountNumber,
            bankdocumentType: (docNameSecondaryBank == "Please Select" || !docNameSecondaryBank) ? "" : docNameSecondaryBank,
        })
    };
}
apz.app.OtherInformation.paintSideBar = function () {
    if (apz.childScr === "KMReviewConfirm" ? "OtherInformation" : "OtherInformation" === "OtherInformation") { // chinna updated this
        try {
            if (window.isVerified === "N") {
                apz.app.Kmbase.updateSrcVerifiedStages(4, "A", "N");
            } else {
                apz.app.Kmbase.updateSrcVerifiedStages(4, "A", "Y");
            }
            apz.app.OtherInformation.fnSaveDraftOrNext(true); // navigation issue fixes 10th june
            apz.app.Kmbase.paintSidebarStatus();
        } catch (e) { 
            ApzCOB.traceFrontEndError(e,"");
        }
    }
}
apz.app.OtherInformation.isAMLQuestionnaireAllYes = function () {
    const questionRows = document.querySelectorAll(
        '[id^="KmSourc__OtherInformation__amlQuestionList_row_"]'
    );
    if (!questionRows || questionRows.length === 0) return null;
    for (let index = 0; index < questionRows.length; index++) {
        const row = questionRows[index];
        const applicantValue = row.querySelector(`input[name="KmSourc__OtherInformation__el_rdo_3_${index}_${index}"]:checked`)?.value;
        const coApplicantValue = row.querySelector(`input[name="KmSourc__OtherInformation__el_rdo_6_${index}_${index}"]:checked`)?.value;
        // If either applicant or co-applicant has not answered
        if (applicantValue == null || coApplicantValue == null) {
            return null;
        }
        // If any answer is No, return false immediately
        if (applicantValue.toLowerCase() === "no" || coApplicantValue.toLowerCase() === "no") {
            return false;
        }
    }
    // All answers are Yes
    return true;
};
apz.app.OtherInformation.deleteDocument = function (pthis, bankType) {
    if (bankType === "Primary") {
        bankSelected = "Primary";
    } else if (bankType === "Secondary") {
        bankSelected = "Secondary";
    }
    apz.app.Kmbase.deleteDocument(pthis);
};
apz.app.OtherInformation.validateMaxIFSCLength = function (pthis) {
    let $input = $("#" + kmScrId + "changeBankIFSCCode");
    let value = $input.val().trim().toUpperCase();
    if (value.length > 11) {
        $input.val(value.substring(0, 11));
        ApzCOB.fnDisplayMsg("IFSC code cannot be longer than 11 characters", "E");
    }
};
apz.app.OtherInformation.insuranceDetailsHideAndShow = function () {
    let insuranceTypeSelectedHS = apz.getElmValue(kmScrId + "insuranceTypeRadioBtn");
    if (insuranceTypeSelectedHS === "bothInsurance") {
        if (othInforEditFlag.customNominee === true) {
            $("#KmSourc__OtherInformation__nomineeApplicantDiv").addClass("sno");
            $("#KmSourc__OtherInformation__nomineeCoApplicantDiv").addClass("sno");
            $("#KmSourc__OtherInformation__coappdiffnomneRow").addClass("sno");
        } else {
            $("#KmSourc__OtherInformation__nomineeApplicantDiv").removeClass("sno");
            $("#KmSourc__OtherInformation__nomineeCoApplicantDiv").removeClass("sno");
            $("#KmSourc__OtherInformation__coappdiffnomneRow").removeClass("sno");
        }
    } else if (insuranceTypeSelectedHS === "applicant") {
        if (othInforEditFlag.customNominee === true) {
            $("#KmSourc__OtherInformation__nomineeApplicantDiv").addClass("sno");
            $("#KmSourc__OtherInformation__coappdiffnomneRow").addClass("sno");
        } else {
            $("#KmSourc__OtherInformation__nomineeApplicantDiv").removeClass("sno");
            $("#KmSourc__OtherInformation__coappdiffnomneRow").removeClass("sno");
        }
    }
    $("#KmSourc__OtherInformation__coappdiffnomneRow").addClass("sno");
};
