apz.app.OtherInformation.fnValidateOtherInformation = function () {
    // if (gApzCOB.productCode === "1001") {
    //     othInforEditFlag.valEnach = true;
    //     othInforEditFlag.valPennyCheck = true;
    // }
    let bankCurrIndex = !apz.isNull(inSessionStore.bankDetailsWrapperList) ? ApzCOB.getIndexforBankWrapper("Applicant") : 0;
    let accntVerifiedFromSession = inSessionStore?.bankDetailsWrapperList?.[bankCurrIndex]?.bankDetails?.payload?.accntVerified ?? "";
    let nameOfInsurerVal = $("#KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput").val();
    let amlCheckBoxVal = $("#KmSourc__OtherInformation__amlCheckBox").is(":checked");
    let appCbStatus = (ApplicationStatus !== 'PENDING' && document.querySelector("#KmSourc__Kmbase__AppCBcheck_hyp svg").classList.contains("error"));
    let coAppCbStatus = (ApplicationStatus !== 'PENDING' && document.querySelector("#KmSourc__Kmbase__CoAppCBcheck_hyp svg").classList.contains("error"));
    let appAadharAddressAdditionalStatus = document.querySelector("#KmSourc__Kmbase__AppAadhaarDetails_hyp svg").classList.contains("suc")
        || (ApplicationStatus === 'PENDING' && document.querySelector("#KmSourc__Kmbase__AppAadhaarDetails_hyp svg").classList.contains("error"));
    let coAppAadharAddressAdditionalStatus = document.querySelector("#KmSourc__Kmbase__CoAppAadhaarDetails_hyp svg").classList.contains("suc")
        || (ApplicationStatus === 'PENDING' && document.querySelector("#KmSourc__Kmbase__CoAppAadhaarDetails_hyp svg").classList.contains("error"));
    let businessIncomeStatus = document.querySelector("#KmSourc__Kmbase__BusinessIncome_hyp svg").classList.contains("suc")
        || document.querySelector("#KmSourc__Kmbase__BusinessIncome_hyp svg").classList.contains("error");
    if ((apz.isNull(window.bankAccountNoVerifiedOtherInfo) && accntVerifiedFromSession !== "Verified") && othInforEditFlag.valChangeBank === false && gApzCOB?.LoggedInUserDetails?.loginResponse?.addInfo1 == 'KM') {
        ApzCOB.fnDisplayMsg("Please verify the existing applicant's bank account number", "E");
        return false;
    }
    if (othInforEditFlag.valEnach === "" && othInforEditFlag.valChangeBank === false) //MUI-191
    {
        ApzCOB.fnDisplayMsg("Complete eNACH to verify bank details", "E");
        return false;
    }
    if (othInforEditFlag.valPennyCheck === "" && othInforEditFlag.valChangeBank === false) //MUI-191
    {
        ApzCOB.fnDisplayMsg("Complete penny check to verify bank details", "E");
        return false;
    }
    if (othInforEditFlag.valChangeBank === false && othInforEditFlag.valPennyCheck === "true") { //19th june changes
        const bankDocCount = inSessionStore.applicationDocumentsWrapperList[0]
            .applicationDocumentsList
            .filter(doc => doc.documentType === "BANK_ACCOUNT_PROOF")
            .length;
        if (bankDocCount < 2) {
            ApzCOB.fnDisplayMsg("Please upload a minimum of 2 documents for the existing applicant bank account", "E");
            return false;
        }
    }
    if (apz.getElmValue(kmScrId + "changeBankRadioBtn") === "yes") {
        if (!(apz.app.OtherInformationvalidateFields(kmScrId + "changeBankBankName", kmScrId + "changeBankAccountType"))) {
            ApzCOB.fnDisplayMsg("Please enter the new bank account details", "E");
            return false;
            //} else if (othInforEditFlag.newBankValEnach === false) { 
        } else if (othInforEditFlag.newBankValEnach === "") {  //19th june changes
            ApzCOB.fnDisplayMsg("Complete eNACH to verify new bank details", "E");
            return false;
        } else if (othInforEditFlag.newBankValEnach === "false") {  //19th june changes
            ApzCOB.fnDisplayMsg("eNACH verification is required for the new bank account details to proceed", "E");
            return false;
        }
    }
    if (othInforEditFlag.valChangeBank === true && othInforEditFlag.newBankValEnach === "true") { //19th june changes
        const newBankDocCount = inSessionStore.applicationDocumentsWrapperList[0]
            .applicationDocumentsList
            .filter(doc => doc.documentType === "BANK_ACCOUNT_PROOF") //16th june change Bank Proof
            .length;
        if (newBankDocCount < 2) {
            ApzCOB.fnDisplayMsg("Please upload a minimum of 2 documents for the new applicant bank account", "E");
            return false;
        }
    }
    if (apz.isNull(apz.app.OtherInformation.getAMLQuestionnaireData())) {
        ApzCOB.fnDisplayMsg("Please complete the AML questionnaire", "E");
        return false;
    }
    if (!(apz.app.OtherInformation.isAMLQuestionnaireAllYes())) {
        ApzCOB.fnDisplayMsg("Both the applicant and co-applicant must select 'Yes' for all AML questions", "E");
        return false;
    }
    if (!amlCheckBoxVal) {
        ApzCOB.fnDisplayMsg("Please select the AML Questions checkbox before proceeding", "E");
        return false;
    }
    // if (othInforEditFlag.customApplicant === true) {
    //     if (!(apz.app.OtherInformationvalidateFields(kmIPaintCustAppInsDetailsId + "custAppNomineeForIns",
    //         kmIPaintCustAppInsDetailsId + "custAppGender", kmIPaintCustAppInsDetailsId + "custAppDob",
    //         kmIPaintCustAppInsDetailsId + "custAppRelationWithNom", kmIPaintCustAppInsDetailsId + "custAppNomContactNumber"))) {
    //         ApzCOB.fnDisplayMsg("Please enter required applicant custom nominee details", "E");
    //         return false;
    //     }
    // }
    if (othInforEditFlag.customNominee === true) {
        if (!(apz.app.OtherInformationvalidateFields(kmIPaintCustomInsDetailsId + "customNomineeForIns",
            kmIPaintCustomInsDetailsId + "customGender", kmIPaintCustomInsDetailsId + "customDob",
            kmIPaintCustomInsDetailsId + "customRelationWithNom", kmIPaintCustomInsDetailsId + "customNomContactNumber"))) {
            ApzCOB.fnDisplayMsg("Please enter required co-applicant custom nominee details", "E");
            return false;
        }
    }
    if (othInforEditFlag.customNominee === true) {
        const customNomineeDocCount = inSessionStore.applicationDocumentsWrapperList[0]
            .applicationDocumentsList
            .filter(doc => doc.documentType === "COAPPLNT_CUST_NOMINEE_DOCS")
            .length;
        if (customNomineeDocCount < 2) {
            ApzCOB.fnDisplayMsg("Please upload a minimum of 2 documents for Custom Nominee KYC", "E");
            return false;
        }
    }
    if (insuranceTypeSelected === "bothInsurance") {
        let appRelationWithNominee = $("#KmSourc__IPaintCoAppInsuranceDetails__o__coAppInsuranceDetails__coAppRelationWithNom").val();
        if ((apz.isNull(appRelationWithNominee) || appRelationWithNominee == "Please Select") && othInforEditFlag.customNominee === false) {
            ApzCOB.fnDisplayMsg("Please select the Nominee Relationship with Co-applicant for the Co-Applicant insurance", "E");
            return false;
        }
        if (apz.isNull(nameOfInsurerVal) || nameOfInsurerVal == "Please Select") {
            ApzCOB.fnDisplayMsg("Please select the Name of the insurer", "E");
            return false;
        }
    }
    if (insuranceTypeSelected === "applicant") {
        if (apz.isNull(nameOfInsurerVal) || nameOfInsurerVal == "Please Select") {
            ApzCOB.fnDisplayMsg("Please select the Name of the insurer", "E");
            return false;
        }
    }
    if (insuranceTypeSelected === "noInsurance" || insuranceTypeSelected === "applicant") {
        let checkBox = $("#KmSourc__OtherInformation__noInsCheckBox").is(":checked");
        let selectedNotOptingDDValue = $("#KmSourc__OtherInformation__insuranceNotOptingReasons").val();
        selectedNotOptingDDValue = !apz.isNull(selectedNotOptingDDValue) ? selectedNotOptingDDValue : "Please Select";
        let otherReasonValue = $("#KmSourc__OtherInformation__otherReasonInput").val();
        if (!checkBox) {
            ApzCOB.fnDisplayMsg("Please ensure the no insurance checkbox is selected", "E");
            return false;
        } else if (selectedNotOptingDDValue === "Please Select") {
            ApzCOB.fnDisplayMsg("Please select a reason for not opting for insurance", "E");
            return false;
        } else if (selectedNotOptingDDValue === "Other") {
            if ((otherReasonValue.length < 20 || otherReasonValue.length > 100)) {
                ApzCOB.fnDisplayMsg("Other reason should contain at least 20 characters and not exceed 100 characters", "E");
                return false;
            }
        }
    }
    if (appCbStatus || coAppCbStatus) {
        ApzCOB.fnDisplayMsg(`Please complete the ${appCbStatus ? 'Applicant' : 'Co-Applicant'} CB check section`, "E");
        return false;
    }
    if (!appAadharAddressAdditionalStatus) {
        ApzCOB.fnDisplayMsg("Please complete the Applicant Aadhaar, Address & additional details section", "E");
        return false;
    }
    if (!coAppAadharAddressAdditionalStatus) {
        ApzCOB.fnDisplayMsg("Please complete the Co-Applicant Aadhaar, Address & additional details section", "E");
        return false;
    }
    if (!businessIncomeStatus) {
        ApzCOB.fnDisplayMsg("Please complete the Business/income source details section", "E");
        return false;
    }
    if (!apz.app.Kmbase.validateQueryResponse()) {
        return false;
    }
    // if (othInforEditFlag.AdditionalDoc === true) {
    //     let docNameLength = $("#" + kmScrId + "nameOfAdditionalDoc").val().length;
    //     if (!(docNameLength >= 4 && docNameLength <= 25)) {
    //         $("#" + kmScrId + "nameOfAdditionalDoc").val('');
    //         ApzCOB.fnDisplayMsg("Please enter the document type name with 4 to 25 characters", "E");
    //         return false;
    //     } 
    // }
    return true;
}
apz.app.OtherInformationvalidateFields = function (...ids) {
    for (let i = 0; i < ids.length; i++) {
        let el = document.getElementById(ids[i]);

        if (!el) continue;

        let tag = el.tagName.toLowerCase();
        let type = el.type ? el.type.toLowerCase() : "";

        // Textbox / input
        if (tag === "input" && type !== "radio") {
            if (el.value.trim() === "" || el.value.trim() === "Please Select") {
                return false;
            }
        }
        // Radio button group
        if (tag === "input" && type === "radio") {
            let radios = document.getElementsByName(el.name);
            let checked = false;

            for (let r of radios) {
                if (r.checked) {
                    checked = true;
                    break;
                }
            }
            if (!checked) {
                return false;
            }
        }
        // Dropdown
        if (tag === "select") {
            if (el.value === "" || el.selectedIndex === 0) {
                return false;
            }
        }
    }
    return true;
}
// AML Questionnaire input validation
apz.app.OtherInformation.getAMLQuestionnaireData = function () {
    const questionRows = document.querySelectorAll('[id^="KmSourc__OtherInformation__amlQuestionList_row_"]');
    if (!questionRows || questionRows.length === 0) return null;
    const amlQuestionList = [];
    for (let index = 0; index < questionRows.length; index++) {
        const row = questionRows[index];
        const rowNo = index;
        // Get question text
        const questionEl = document.querySelector(
            `#KmSourc__loadAMLQuestions__i__amlQuestions__question_${rowNo}`
        );
        const questionHeader = questionEl?.querySelector('h3')?.innerText?.trim() || null;
        // If question header itself is null, return null
        if (questionHeader === null) return null;
        // Get applicant selected radio value
        const applicantRadio = row.querySelector(
            `input[name="KmSourc__OtherInformation__el_rdo_3_${rowNo}_${rowNo}"]:checked`
        );
        const applicantValue = applicantRadio ? applicantRadio.value : null;
        // Get co-applicant selected radio value
        const coApplicantRadio = row.querySelector(
            `input[name="KmSourc__OtherInformation__el_rdo_6_${rowNo}_${rowNo}"]:checked`
        );
        const coApplicantValue = coApplicantRadio ? coApplicantRadio.value : null;
        // If either applicant or co-applicant has not answered, return null
        if (applicantValue === null || coApplicantValue === null) return null;
        amlQuestionList.push({
            questionType: questionHeader,
            applicant: applicantValue,
            coApplicant: coApplicantValue,
        });
    }
    return amlQuestionList.length > 0 ? { amlQuestionList } : null;
}
