//   CB CHECK SCREEN
window.CBcheckScr = 'KmSourc__CBcheck__';
var screenId = 'KmSourc__CBcheck__',
KM_CURR_STAGE_NAME = 'CBcheck',
KM_CURR_STAGE_NO = 1;
var otpScreenId = 'KmSourc__Kmbase__';
window.CBCHECK_EXPLICIT_DRAFT = false;
window.CB_LOAN_ID = null;
window.productSwitch = "N"
window.CB_UI_LOCKED = {
    applicant: false,
    coapplicant: false
};
window.CB_BRE_PENDING = false;
window.CB_API_ATTEMPTED = {
    applicant: false,
    coapplicant: false
};
//  IS_MOBILE_DEDUPE_REQ = true;
//  OTP GLOBAL STATE
window.CB_OTP_TIMER = null;
window.CB_OTP_TIME_LEFT = 150;
window.CB_OTP_RESEND_COUNT = 0;
window.CB_OTP_MAX_RESEND = 3;
window.CB_API_TRIGGERED = {
    applicant: false,
    coapplicant: false
};
window.CB_FORM_STATE = {
    applicant: {
        validated: false
    },
    coapplicant: {
        validated: false
    }
};
window.CB_OTP_STATE = {
    applicant: {
        verified: false,
        mobile: null
    },
    coapplicant: {
        verified: false,
        mobile: null
    }
};
window.CB_OTP_UI_UNLOCK = {
    applicant: false,
    coapplicant: false
};
window.CB_VERIFIED_MOBILES = {
    applicant: new Set(),
    coapplicant: new Set()
};
window.CB_Validate = {
    fnCheckMaxMinLengthOnBlur: function(pthis) {
        let minlength = pthis.minLength;
        let maxlength = pthis.maxLength;
        let value = pthis.value.trim();
        let $field = $("#" + pthis.id);
        if (!apz.isNull(value) && (value.length < minlength || value.length > maxlength)) {
            window.gIsMinMaxErr = true;
            $field.addClass("err");
            $("#" + pthis.id + "_ul").next().removeClass("sno");
            let errTxtFieldId = $("#" + pthis.id + "_ul").next()?.find('.icon-Error')?.next() ?? $('#dummyid');
            errTxtFieldId?.text(`Please enter minimum:${minlength} and maximum:${maxlength} characters!`);
            let wrapper;
            if ($field.closest(".etb-slct").length) {
                wrapper = $field.closest(".etb-slct").parent().parent();
            } else if ($field.closest(".ett-inpt").length) {
                wrapper = $field.closest(".ett-inpt").parent().parent();
            } else if ($field.closest("ul").length) {
                wrapper = $field.closest("ul").parent().parent();
            }
            wrapper?.addClass("error-inline");
        } else {
            window.gIsMinMaxErr = false;
            let wrapper;
            if ($field.closest(".etb-slct").length) {
                wrapper = $field.closest(".etb-slct").parent().parent();
            } else if ($field.closest(".ett-inpt").length) {
                wrapper = $field.closest(".ett-inpt").parent().parent();
            } else if ($field.closest("ul").length) {
                wrapper = $field.closest("ul").parent().parent();
            }
            wrapper?.removeClass("error-inline");
        }
    },
    required: function(fieldId, message) {
        let $el = $("#" + fieldId);
        if ($el.length === 0) return true;
        let value = ($el.val() || "").trim();
        if (!value || value === PleaseSelect) {
            showFieldError(fieldId, message);
            return false;
        }
        return true;
    },
    regex: function(fieldId, regex, message) {
        let $el = $("#" + fieldId);
        if ($el.length === 0) return true;
        let value = ($el.val() || "").trim();
        if (value && !regex.test(value)) {
            showFieldError(fieldId, message);
            return false;
        }
        return true;
    },
    lengthRange: function(fieldId, min, max, message) {
        let $el = $("#" + fieldId);
        if ($el.length === 0) return true;
        let value = ($el.val() || "").trim();
        if (value && (value.length < min || value.length > max)) {
            showFieldError(fieldId, message);
            return false;
        }
        return true;
    },
    maxLength: function(fieldId, max, message) {
        let $el = $("#" + fieldId);
        if ($el.length === 0) return true;
        let value = ($el.val() || "").trim();
        if (value && value.length > max) {
            showFieldError(fieldId, message);
            return false;
        }
        return true;
    }
};
//   ON LOAD
apz.app.onLoad_CBcheck = function() {
    inSessionStore.cibilDetailsWrapperList = inSessionStore.cibilDetailsWrapperList?.filter(cb => cb?.cibilDetails?.payload?.isReinitiated !== 'Y' );
    if (apz.isNull(inSessionStore?.applicationId)) {
        $(`#${kmbaseScr}rejectButton`).addClass('sno');
    }
    apz.app.CBcheck.showSlider();
    apz.app.CBcheck.setDefaultSliderValue();
    $('#KmSourc__CBcheck__loanSlider').removeClass("wrapped");
    gApzCOB.currentApplicant = 1;
    PerDetScrId = CBcheckScr;
    var applicantBtn = document.querySelector('.cbcheckSubMenu');
    if (applicantBtn) {
        window.CBCHECK_NEXT_TAB_SWITCH = true;
        apz.app.CBcheck.handletabSwitch(applicantBtn, 'Applicant', true);
        window.shouldValidatePanDocs = false;
    }
    const relationshipElement = document.getElementById(`${CBcheckScr}relationShipWithApplicant`);
    if (relationshipElement) {
        apz.populateDropdown(relationshipElement, ApzCOB.formatDropDownforArray(ApzCOB.filterRelns(relations)));
    }
    const loanPurposeElement = document.getElementById(`${CBcheckScr}loanPurpose`);
    if (loanPurposeElement) {
        apz.populateDropdown(loanPurposeElement, ApzCOB.formatDropDownforArray(loanPurpose));
    }
    const subLoanPurposeElement = document.getElementById(`${CBcheckScr}subLoanPurpose`);
    if (subLoanPurposeElement) {
        apz.populateDropdown(subLoanPurposeElement, ApzCOB.formatDropDownforArray([ApzCOB.getDescfromLitCode("LIT_COMM_MSG_PLEASE_SELECT")]));
        $(`#${CBcheckScr}subLoanPurpose`).attr('disabled', true);
    }
    let leadData = gApzCOB?.selLeadDtls ?? inSessionStore.leadDetails;
    var kendraFreq = (leadData?.kendraMeetingFreq || '').toUpperCase();
    if (kendraFreq === "WEEKLY") {
        filteredFrequencies = frequencyOfRepayment.slice(0, 4);
    } else if (["BIWEEKLY", "BI-WEEKLY", "BI WEEKLY"].includes(kendraFreq)) {
        filteredFrequencies = [0, 2, 3].map(i => frequencyOfRepayment[i]);
    } else {
        filteredFrequencies = [0, 3].map(i => frequencyOfRepayment[i]);
    }
    const frequencyElement = document.getElementById(`${CBcheckScr}frequencyOfRepayment`);
    if (frequencyElement) {
        apz.populateDropdown(frequencyElement, ApzCOB.formatDropDownforArray(filteredFrequencies));
    }
    const coGenderElement = document.getElementById(`${CBcheckScr}coGender`);
    if (coGenderElement) {
        apz.populateDropdown(coGenderElement, ApzCOB.formatDropDownforArray(gender));
    }
    apz.app.CBcheck.populateMaritalStatus();
    apz.app.CBcheck.populateTenureDropdown();
    apz.app.CBcheck.populateModeOfDisbDropdown();
    apz.app.CBcheck.setRateOfInterest();
    apz.app.CBcheck.setDefaultMOS();
    apz.app.CBcheck.paintLoanDetails();
    $('.cb-otp-protected').addClass('sno');
    ApzCOB.setMinMaxLength([{
        'fieldName': 'Name',
        'fieldId': CBcheckScr + 'coCustomerName'
    }, {
        'fieldName': 'MobileNumber',
        'fieldId': CBcheckScr + 'primaryMobile'
    }, {
        'fieldName': 'MobileNumber',
        'fieldId': CBcheckScr + 'sec_mobile'
    }, {
        'fieldName': 'CKYC',
        'fieldId': CBcheckScr + 'ckycNumber'
    }, {
        'fieldName': 'AddressLine1',
        'fieldId': CBcheckScr + 'addressLine1'
    }, {
        'fieldName': 'AddressLine2',
        'fieldId': CBcheckScr + 'addressLine2'
    }, {
        'fieldName': 'AddressLine3',
        'fieldId': CBcheckScr + 'addressLine3'
    }, {
        'fieldName': 'Pincode',
        'fieldId': CBcheckScr + 'pincode'
    }, {
        'fieldName': 'City',
        'fieldId': CBcheckScr + 'addPreCity'
    }, {
        'fieldName': 'District',
        'fieldId': CBcheckScr + 'addPreDistrict'
    }, {
        'fieldName': 'State',
        'fieldId': CBcheckScr + 'addPreState'
    }]);
    // apz.app.CBcheck.togglePanView();
    $("#scr__" + screenId + "main").on("mousedown", "input, select", function() {
        clearFieldError(this.id);
    });
    $(`#${screenId}primaryMobile`).on('input', function() {
        this.value = this.value.replace(/[^0-9]/g, '');
        let newMobile = $(this).val();
        let isApplicant = gApzCOB.currentApplicant <= 1;
        let state = isApplicant ? CB_OTP_STATE.applicant : CB_OTP_STATE.coapplicant;
        let verifiedCache = isApplicant ? CB_VERIFIED_MOBILES.applicant : CB_VERIFIED_MOBILES.coapplicant;
        //  CO-APPLICANT SAME AS LAST VERIFIED APPLICANT MOBILE
        if (!isApplicant && CB_OTP_STATE.applicant.mobile && newMobile === CB_OTP_STATE.applicant.mobile && newMobile.length === 10) {
            CB_OTP_STATE.coapplicant.verified = true;
            CB_OTP_STATE.coapplicant.mobile = newMobile;
            CB_OTP_UI_UNLOCK.coapplicant = true;
            // Hide OTP UI
            $('#' + screenId + 'sendOtpBtn').addClass('sno');
            $('#' + screenId + 'otpSuccessRow').addClass('sno');
            // Show SAME MOBILE NOTE DIV
            $('#' + screenId + 'sameMobileInfoDiv').removeClass('sno');
            apz.app.CBcheck.toggleOtpProtectedSections();
            window.isVerified = "N";
            apz.app.CBcheck.createCBCheck();
            return;
        } else {
            // Hide note div if not same mobile
            $('#' + screenId + 'sameMobileInfoDiv').addClass('sno');
        }
        //  IF NUMBER WAS ALREADY VERIFIED BEFORE 
        if (verifiedCache.has(newMobile)) {
            state.verified = true;
            state.mobile = newMobile;
            $('#' + screenId + 'otpSuccessRow').removeClass('sno');
            $('#' + screenId + 'sendOtpBtn').addClass('sno');
            $('#' + screenId + 'sameMobileInfoDiv').addClass('sno');
            apz.app.CBcheck.toggleOtpProtectedSections();
            return;
        }
        // NEW NUMBER (NOT VERIFIED)
        if (state.mobile !== newMobile) {
            state.verified = false;
            state.mobile = null;
            $('#' + screenId + 'otpSuccessRow').addClass('sno');
            $('#' + screenId + 'sendOtpBtn').removeClass('sno');
            $('#' + screenId + 'sameMobileInfoDiv').addClass('sno');
            apz.app.CBcheck.toggleOtpProtectedSections();
        }
    });
    if (window.CBCHECK_TAB_SWITCH_TARGET) {
        let target = window.CBCHECK_TAB_SWITCH_TARGET;
        window.CBCHECK_TAB_SWITCH_TARGET = null;
        let tabs = $('.cbcheckSubMenu');
        if (target === 'CoApplicant' && tabs.length > 1) {
            apz.app.CBcheck.handletabSwitch(tabs.eq(1), 'CoApplicant', true);
            $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
            $(`#${kmbaseScr}CBcheck_hyp`).addClass('active');
            $(`#${kmbaseScr}CoAppCBcheck_hyp`).addClass('active');
        } else {
            apz.app.CBcheck.handletabSwitch(tabs.eq(0), 'Applicant');
            $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
            $(`#${kmbaseScr}CBcheck_hyp`).addClass('active');
            $(`#${kmbaseScr}AppCBcheck_hyp`).addClass('active');
        }
        window.shouldValidatePanDocs = false;
    }
    apz.app.CBcheck.toggleOtpProtectedSections();
    if (!apz.isNull(cbCallType)) {
        if (cbCallType.CB_TYPE === 'BOTH') {
            CBCALLTYPEFLAG = cbCallType.BRE_BRANCH.includes(gApzCOB.requestNodes.applicationMaster.branchId) ? 'BRE' : 'IRE';
        } else {
            CBCALLTYPEFLAG = cbCallType.CB_TYPE;
        }
    }
    apz.app.CBcheck.toggleNextButton();
    apz.app.Kmbase.paintSidebarStatus();
    let voterCfg = window.KM_DOC_VIEWER_CONFIG['PRIMARY_KYC'];
    let panCfg = window.KM_DOC_VIEWER_CONFIG['PAN_NUMBER_PHOTO'];
    $(`#${voterCfg.rowId}`).removeClass('km-doc-upload-row').addClass('sno');
    $(`#${voterCfg.captureBtnId}`).removeClass('sno');
    $(`#${panCfg.rowId}`).removeClass('km-doc-upload-row').addClass('sno');
    $(`#${panCfg.captureBtnId}`).removeClass('sno');
    apz.app.Kmbase.paintCBcheckKycDocsInScreen(gApzCOB.currentApplicant);
    let isCoApplicant = gApzCOB.currentApplicant === 2;
    if(isCoApplicant && CO_APP_ADDED_COUNT >= 2) {
        $("#KmSourc__CBcheck__editCoappNew").addClass("sno");
    }
    let isVerified = apz.app.Kmbase.getSrcVerifiedStatus(1, "C") === "Y";
    let validCoApp = inSessionStore.customerDetailsList?.find(c => c.customerType === "Co-App" && c?.payload?.isNewCustomer && c.payload.isNewCustomer !==
        "Create a new Co-Applicant");
    if (isCoApplicant) {
        if (isVerified) {
            $("#KmSourc__CBcheck__editCoappNew").addClass("sno");
            $("#KmSourc__CBcheck__el_txt_142").addClass("sno");
        }
        if (validCoApp) {
            $("#KmSourc__CBcheck__coAppName").text(
                `${validCoApp?.customerName || ""}${validCoApp?.payload?.relationShipWithApplicant ? ` (${validCoApp.payload.relationShipWithApplicant})` : ""}`);
            $("#KmSourc__CBcheck__newCoappRow").addClass("sno");
            $("#KmSourc__CBcheck__selCoAppRow").removeClass("sno");
        }
    }
};
apz.app.onShown_CBcheck = function() {
 try{    
    window.IS_WIP_REINITIATE = ApzCOB.getPayloadDatafromWrapper('oldReinitiate', 'Applicant', 'customerDetailsList') || false;
    ApzCOB.addApplicationTag();
    window.shouldValidatePanDocs = false;
    if (window.IS_REJECTED_APPLICATION && window.currentApplication === "InProgress") {
        $(`#${kmbaseScr}nxtBtn`).removeClass('sno');
        $(`#${kmbaseScr}SaveDraft`).removeClass('sno');
        $(`#${kmbaseScr}sidebarmenu`).removeClass('sno');
        $(`#${kmbaseScr}rejectButton`).removeClass('sno');
        $(`#${kmbaseScr}businessIconRow`).removeClass('rej');
        $(`#${kmbaseScr}reInitiateBtn`).addClass('sno');
    }
    $('input.hasDatepicker').datepicker("option", {
        maxDate: Date.parse(DATE_TODAY),
        yearRange: "-100:+0"
    });
    // SIDEBAR ACTIVE STATE — parent always active
    let errFields = ['LDQChecked', 'panQchecked', 'kycQChecked', 'custQChecked', 'coAppQChecked', 'RAQChecked'];
    errFields.forEach(field => {
        $(`#${CBcheckScr}${field}`).addClass("kmenacherr");
    });
    $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
    $(`#${kmbaseScr}CBcheck_hyp`).addClass('active');
    if (gApzCOB.currentApplicant === 2) {
        $(`#${kmbaseScr}CoAppCBcheck_hyp`).addClass('active');
        $(`#${CBcheckScr}el_btn_20`).addClass('active');
    } else {
        $(`#${kmbaseScr}AppCBcheck_hyp`).addClass('active');
        $(`#${CBcheckScr}el_btn_19`).addClass('active');
    }
    // Restore loan + customer details from session
    apz.app.CBcheck.paintLoanDetails();
    apz.app.CBcheck.paintDetails();
    // Restore OTP UI state
    apz.app.CBcheck.refreshOtpUI();
    // Restore CIBIL details if already fetched
    apz.app.CBcheck.restoreCibilFromSession();
    // Toggle initiate button
    apz.app.CBcheck.toggleInitiateRow();
    let isApplicant = gApzCOB.currentApplicant <= 1;
    let isOtpUnlocked = isApplicant ? CB_OTP_UI_UNLOCK.applicant : CB_OTP_UI_UNLOCK.coapplicant;
    // Reset address override flag
    window.CB_ADDRESS_OVERRIDE_TYPE = null;
    apz.app.CBcheck.toggleNextButton();
    $("#" + screenId + "modeOfSecur_option_MOSopt3").attr('checked', true);
    let branchState = apz.isNull(gApzCOB?.selLeadDtls?.glBranchState) ? '' : gApzCOB?.selLeadDtls?.glBranchState?.toUpperCase();
    for (var i = 0; i < rateOfInteres.length; i++) {
        if (rateOfInteres[i].key.toUpperCase() == branchState) {
            $(`#${screenId}rateOfIntrst`).val(rateOfInteres[i].value);
        }
    }
    if (window.CB_SCROLL_RESTORE > 0) {
        var _scrollTarget = window.CB_SCROLL_RESTORE;
        window.CB_SCROLL_RESTORE = 0;
        setTimeout(function() {
            $("#APZCBO__BaseScreens__baseRow").scrollTop(_scrollTarget);
        }, 200);
    }
    // $('#KmSourc__CBcheck__prdctTyp').addClass('aadhar-radio-disable');
    apz.app.Kmbase.bmRecommendation();
    apz.app.Kmbase.paintQueryResponsedata();
    if(!CB_OTP_STATE.applicant.verified){
        $(`#${kmbaseScr}SaveDraft`).addClass('sno');
    }
    // ── Disable Name Field in Fetch OCR Section  ───────────────────────
    $("#" + kmbaseScr + "ocrNameSection").addClass('disabled').prop('disabled', true);
    document.querySelector('label[for="KmSourc__Kmbase__ocrNameSection"]')
        ?.classList.remove('req');
    window.shouldValidatePanDocs = true;
    if(gApzCOB.productCode === '1003') {
     $("#KmSourc__CBcheck__unnatiDec_grp_lbl").text("Unnati Lite decision");
     $("#KmSourc__CBcheck__unnatiDecReason_grp_lbl").text("Unnati Lite decision reason");
     $("#KmSourc__CBcheck__unnatiApprovedAmt_grp_lbl").text("Unnati Lite approved amount");
    }
    ApzCOB.checkDeeplink();
 } catch(e){
   ApzCOB.traceFrontEndError(e,"");   
 }
};
//Save Draft and switch tab
apz.app.CBcheck.saveAndSwitch = function(pthis, CustType) {
    CB_STATUS  = ApzCOB.checkCbStatus();
    if (CustType === 'CoApplicant' && !CB_API_TRIGGERED.applicant) {
        ApzCOB.fnDisplayMsg("Please complete and initiate the credit check for the Applicant before proceeding.", "E");
        return;
    } else if (!CB_STATUS && CustType === 'CoApplicant'){
        ApzCOB.handleCBReject();
        return;
    }
    // Store the switch target so the CB callback can execute it
    window.CB_PENDING_TAB_SWITCH = {
        pthis: pthis,
        CustType: CustType
    };
    apz.app.Kmbase.saveDraft();
};
//   TAB SWITCH
apz.app.CBcheck.handletabSwitch = function(pthis, CustType, skipCheck = false) {
    window.shouldValidatePanDocs = false;
    let currentIsApplicant = gApzCOB.currentApplicant <= 1;
    if (!skipCheck && CustType === 'CoApplicant' && !CB_API_TRIGGERED.applicant) {
        ApzCOB.fnDisplayMsg("Please complete and initiate the credit check for the Applicant before proceeding.", "E");
        return;
    }
    if (!skipCheck && currentIsApplicant && !CB_API_TRIGGERED.applicant) {
        return;
    }
    clearAllTabErrors();
    // Mark the tab being LEFT as amber — skip if programmatic Next OR already verified
    if (!window.CBCHECK_NEXT_TAB_SWITCH) {
        try {
            var _leavingNo = gApzCOB.currentApplicant;
            var _leavingCode = (_leavingNo === 2) ? "C" : "A";
            var _leavingVerified = apz.app.Kmbase.getSrcVerifiedStatus(1, _leavingCode);
            if (_leavingVerified !== "Y") {
                apz.app.Kmbase.updateSrcVerifiedStages(1, _leavingCode, "N");
                apz.app.Kmbase.paintSidebarStatus();
            }
        } catch (e) {
            ApzCOB.traceFrontEndError(e,"");
        }
    }
    window.CBCHECK_NEXT_TAB_SWITCH = false;
    $('.cbcheckSubMenu').removeClass('active');
    $(pthis).addClass('active');
    //   TAB SWITCH
    if (CustType === 'Applicant') {
        gApzCOB.currentApplicant = 1;
        $('.src-coapp').addClass('sno');
        $('.src-app').removeClass('sno');
        $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
        $(`#${kmbaseScr}CBcheck_hyp`).addClass('active');
        $(`#${kmbaseScr}AppCBcheck_hyp`).addClass('active');
        $('#' + screenId + 'addrTitle').text('Residence (Present) Address');
    } else {
        gApzCOB.currentApplicant = 2;
        $('.src-app').addClass('sno');
        $('.src-coapp').removeClass('sno');
        if(CO_APP_ADDED_COUNT >= 2) {
            $("#KmSourc__CBcheck__editCoappNew").addClass("sno");
        }
        $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
        $(`#${kmbaseScr}CBcheck_hyp`).addClass('active');
        $(`#${kmbaseScr}CoAppCBcheck_hyp`).addClass('active');
        $('#' + screenId + 'addrTitle').text('Co-applicant Address');
        let coApp = inSessionStore.customerDetailsList?.find(c => c.customerType === "Co-App");
        if (inSessionStore?.applicationMaster?.productCode == '1002' && coApp?.payload?.isMobVerified !== 'Y' && inSessionStore.applicationMaster?.applicationStatus === 'INPROGRESS' && apz.app.Kmbase.getSrcVerifiedStatus(1,'C') === null && CO_APP_ADDED_COUNT < 2) {
            apz.app.CBcheck.coApplicantDetails();
        }
        // if (ApplicationType === 'NEW') {
        //     $('#KmSourc__CBcheck__sc_row_179').addClass('sno');
        // }
        // let coAppExists = inSessionStore.customerDetailsList?.some(c => c.customerType === "Co-App" && c.customerName);
        // if (!coAppExists && inSessionStore.applicationMaster?.productCode === '1002') {
        //     apz.app.CBcheck.coApplicantDetails();
        // }
    }
    let switchingToApplicant = CustType === 'Applicant';
    if (!CB_API_TRIGGERED.applicant && switchingToApplicant) {
        CB_API_ATTEMPTED.applicant = false;
    }
    if (!CB_API_TRIGGERED.coapplicant && !switchingToApplicant) {
        CB_API_ATTEMPTED.coapplicant = false;
    }
    ApzCOB.scrollTopKMSourcing();
    //   CLEAR FORM BEFORE PAINT
    apz.app.CBcheck.clearForm();
    apz.app.CBcheck.paintDetails();
    apz.app.CBcheck.paintLoanDetails();
    apz.app.CBcheck.toggleAddressFieldsState();
    // Filter relation dropdown only when switching to Co-Applicant tab
    if (CustType === 'CoApplicant') {
        apz.app.CBcheck.onChangeRelationWithApp();
        let coAppEntry = inSessionStore?.customerDetailsList?.find(c => c.customerType === "Co-App");
        let savedRelation = coAppEntry?.payload?.relationShipWithApplicant || "";
        let savedMaritalStatus = coAppEntry?.payload?.maritalStatus || "";
        if (savedRelation && savedRelation !== PleaseSelect) {
            $(`#${screenId}relationShipWithApplicant`).val(savedRelation);
            let relField = document.getElementById(`${screenId}relationShipWithApplicant`);
            // re-derive gender/marital from restored relation
            if (relField) apz.app.CBcheck.onRelationSelect(relField);
            if (savedMaritalStatus && savedMaritalStatus !== PleaseSelect) {
                $(`#${screenId}coApplicantMaritalStatus`).val(savedMaritalStatus);
            }
        }
    }
    //   OTP SECTION CHECK
    apz.app.CBcheck.refreshOtpUI();
    apz.app.CBcheck.restoreCibilFromSession();
    apz.app.CBcheck.toggleInitiateRow();
    apz.app.CBcheck.applyReadOnlyState();
    let isApplicant = gApzCOB.currentApplicant <= 1;
    apz.app.CBcheck.toggleNextButton();
    apz.app.Kmbase.paintCBcheckKycDocsInScreen(gApzCOB.currentApplicant);
    apz.app.Kmbase.bmRecommendation();
    setTimeout( () => apz.app.Kmbase.paintQueryResponsedata(), 1000);    
    if(lastBM)
    apz.app.Kmbase.paintQueryResponsedata(true);
    window.shouldValidatePanDocs = true;
};
//   BUILD SUB PURPOSE DROPDOWN
apz.app.CBcheck.buildSubPurposeDropdown = function(selectedPurpose) {
    if (selectedPurpose === PleaseSelect) {
        $(`#${CBcheckScr}subLoanPurpose`).val(PleaseSelect).attr('disabled', true);
        return;
    }
    let subPurposeList = loanSubPurpose?.[0]?.[selectedPurpose] || [];
    let formattedList = [...subPurposeList];
    if (!formattedList.includes(PleaseSelect)) {
        formattedList.unshift(ApzCOB.getDescfromLitCode("LIT_COMM_MSG_PLEASE_SELECT"));
    }
    apz.populateDropdown(document.getElementById(`${CBcheckScr}subLoanPurpose`), ApzCOB.formatDropDownforArray(formattedList));
    $(`#${CBcheckScr}subLoanPurpose`).attr('disabled', false);
};
//   ON CHANGE LOAN PURPOSE
apz.app.CBcheck.onChangeLoanPurpose = function(pthis) {
    let selectedPurpose = $(`#${CBcheckScr}loanPurpose`).val();
    apz.app.CBcheck.buildSubPurposeDropdown(selectedPurpose);
    ApzCOB.dropDownOnChange(pthis);
};
//   SLIDER
apz.app.CBcheck.showSlider = function() {
    $("#" + screenId + "loanSlider").slider({
        range: "min",
        value: parseInt(fdAmountMin),
        min: parseInt(fdAmountMin),
        max: parseInt(fdAmountMax),
        slide: function(event, ui) {
            ui.value = Math.round(ui.value / 1000) * 1000;
            $("#" + screenId + "loanAmount").val(ApzCOB.fn_FormatAmount(ui.value)).trigger("onchange");
        },
        change: function(event, ui) {
            ui.value = Math.round(ui.value / 1000) * 1000;
            $("#" + screenId + "loanAmount").val(ApzCOB.fn_FormatAmount(ui.value));
        },
        stop: function(event, ui) {
            ui.value = Math.round(ui.value / 1000) * 1000;
            $("#" + screenId + "loanAmount").val(ApzCOB.fn_FormatAmount(ui.value));
        }
    }).slider("pips", {
        rest: false,
    }).slider("float");
}
apz.app.CBcheck.setDefaultSliderValue = function() {
    $("#" + screenId + "loanSlider").slider("option", "value", fdDefaultLoanAmount);
    $("#" + screenId + "loanAmount").val(ApzCOB.fn_FormatAmount(fdDefaultLoanAmount));
};
apz.app.CBcheck.amountSliderControl = function() {
    var amount = $("#" + screenId + "loanAmount").val();
    var data = ApzCOB.fn_unFormatAmount(amount);
    if (!isNaN(data) && parseInt(data) >= fdAmountMin && parseInt(data) <= fdAmountMax) {
        $("#" + screenId + "loanSlider").slider("option", "value", data);
    }
};
///OTP
apz.app.CBcheck.openOtpModal = function() {
    window.isMobErr = false; // reset before validation
    let valid = apz.app.CBcheck.validateMobileForOtp();
    if (!valid) return;
    let mobile = $(`#${screenId}primaryMobile`).val();
    let maskedMobile = "*******" + mobile.slice(-3);
    $(`#${otpScreenId}otpInfoText`).text(`OTP is sent to your Mobile No. ${maskedMobile}`);
    if (!mobile) {
        ApzCOB.fnDisplayMsg("Mobile number not available", "E");
        return;
    }
    ApzCOB.OtpSmsService(mobile,otpLanguage);
    for (let i = 1; i <= 4; i++) {
        $('#' + otpScreenId + 'otp' + i).val('');
    }
    $('#' + screenId + 'otpSuccessRow').addClass('sno');
    ApzCOB.toggleModal(otpScreenId + "Otp_Modal");
    $(`#${kmbaseScr}Otp_Modal_content`).css('overflow', 'hidden');
    apz.app.CBcheck.initOtpInputs();
    window.CB_OTP_RESEND_COUNT = 0;
    $('#' + otpScreenId + 'resendOtpBtn').prop('disabled', true);
    apz.app.CBcheck.startOtpTimer();
    $('#' + otpScreenId + 'otp1').focus();
};
apz.app.CBcheck.initOtpInputs = function() {
    for (let i = 1; i <= 4; i++) {
        let fieldId = otpScreenId + 'otp' + i;
        $('#' + fieldId).off('input keydown');
        $('#' + fieldId).on('input', function() {
            this.value = this.value.replace(/[^0-9]/g, '');
            if (this.value.length === 1 && i < 4) $('#' + otpScreenId + 'otp' + (i + 1)).focus();
        });
        $('#' + fieldId).on('keydown', function(e) {
            if (e.key === "Backspace" && this.value === "" && i > 1) $('#' + otpScreenId + 'otp' + (i - 1)).focus();
        });
    }
};
apz.app.CBcheck.startOtpTimer = function() {
    if (window.CB_OTP_TIMER) clearInterval(window.CB_OTP_TIMER);
    window.CB_OTP_TIME_LEFT = 150;
    $('#' + otpScreenId + 'resendOtpBtn').addClass('sno'); // Disable resend button
    ApzCOB.addDisableToInput(otpScreenId + 'resendOtpBtn');
    $('#' + otpScreenId + 'otpTimer').removeClass('sno'); // Show timer UI
    window.CB_OTP_TIMER = setInterval(function() {
        let min = Math.floor(window.CB_OTP_TIME_LEFT / 60);
        let sec = window.CB_OTP_TIME_LEFT % 60;
        let formatted = `${min < 10 ? '0' + min : min}:${sec < 10 ? '0' + sec : sec}`;
        $('#' + otpScreenId + 'otpTimer').text("Time remaining " + formatted);
        window.CB_OTP_TIME_LEFT--;
        if (window.CB_OTP_TIME_LEFT <= 0) {
            clearInterval(window.CB_OTP_TIMER);
            window.CB_OTP_TIMER = null;
            $('#' + otpScreenId + 'otpTimer').addClass('sno'); // Hide timer UI
            if (window.CB_OTP_RESEND_COUNT < window.CB_OTP_MAX_RESEND) {
                for (let i = 1; i <= 4; i++) {
                    $(`#${otpScreenId}otp${i}`).val('');
                }
                $('#' + otpScreenId + 'resendOtpBtn').removeClass('sno'); // Enable resend button
                ApzCOB.removeDisableToInput(otpScreenId + 'resendOtpBtn');
            }
        }
    }, 1000);
};
apz.app.CBcheck.resendOtp = function() {
    if (window.CB_OTP_RESEND_COUNT >= window.CB_OTP_MAX_RESEND) {
        ApzCOB.fnDisplayMsg("Maximum resend attempts reached", "E");
        return;
    }
    let mobile = $(`#${screenId}primaryMobile`).val();
    if (apz.isNull(mobile) || mobile === "") {
        ApzCOB.fnDisplayMsg("Primary mobile number not available", "E");
        return;
    }
    window.CB_OTP_RESEND_COUNT++;
    ApzCOB.OtpSmsService(mobile);
    apz.app.CBcheck.startOtpTimer();
    ApzCOB.fnDisplayMsg("OTP resent successfully", "S");
    // ApzCOB.showNewCommonSuccessModal({
    //     text: "OTP resent successfully",
    //     Btn: {
    //         text: "OK",
    //         onClick: "ApzCOB.closeCommonModal(`newCommonSuccModal`)"
    //     }
    // });
};
apz.app.CBcheck.otpVerifiedSuccess = function() {
    let currentMobile = $(`#${screenId}primaryMobile`).val();
    let isApplicant = gApzCOB.currentApplicant <= 1;
    if (isApplicant) {
        CB_OTP_STATE.applicant.verified = true;
        CB_OTP_STATE.applicant.mobile = currentMobile;
        CB_OTP_UI_UNLOCK.applicant = true;
        CB_VERIFIED_MOBILES.applicant.add(currentMobile);
        $(`#${kmbaseScr}SaveDraft`).removeClass('sno');
    } else {
        CB_OTP_STATE.coapplicant.verified = true;
        CB_OTP_STATE.coapplicant.mobile = currentMobile;
        CB_OTP_UI_UNLOCK.coapplicant = true;
        CB_VERIFIED_MOBILES.coapplicant.add(currentMobile);
    }
    window.isVerified = "N";
    apz.app.CBcheck.createCBCheck();
    if (window.CB_OTP_TIMER) {
        clearInterval(window.CB_OTP_TIMER);
        window.CB_OTP_TIMER = null;
    }
    ApzCOB.toggleModal(otpScreenId + "Otp_Modal");
    $(`#${kmbaseScr}Otp_Modal_content`).css('overflow', 'hidden');
    $('#' + screenId + 'otpSuccessRow').removeClass('sno');
    $('#' + screenId + 'sendOtpBtn').addClass('sno');
    apz.app.CBcheck.toggleOtpProtectedSections();
    // ApzCOB.fnDisplayMsg("OTP Verified Successfully", "S");
    ApzCOB.showNewCommonSuccessModal({
        text: "OTP Verified Successfully",
        Btn: {
            text: "OK",
            onClick: "ApzCOB.closeCommonModal(`newCommonSuccModal`)"
        }
    });
};
apz.app.CBcheck.verifyOtp = function() {
    if (window.CB_OTP_TIME_LEFT <= 0 && window.CB_OTP_TIMER === null) {
        ApzCOB.fnDisplayMsg("OTP has expired. Please resend a new OTP.", "E");
        return;
    }
    let otp = '';
    for (let i = 1; i <= 4; i++) {
        otp += $('#' + otpScreenId + 'otp' + i).val();
    }
    if (otp.length !== 4) {
        ApzCOB.fnDisplayMsg("Please enter OTP", "E");
        return;
    }
    ApzCOB.verfyOtpService(otp);
};
apz.app.CBcheck.togglePanView = function() {
    let selectedVal = $('input[name="' + screenId + 'panVal_"]:checked').val();
    if (!selectedVal) selectedVal = 'Y';
    if (selectedVal === 'N') {
        const isApplicant = gApzCOB.currentApplicant === 1 ? true : false;
        const isPanDocsAvailable = inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList.filter(
            doc => doc.documentType === "PAN_NUMBER_PHOTO").filter(
                doc => doc.custType===(isApplicant ? "Applicant" : "Co-App")).length > 0;
        if(isPanDocsAvailable && shouldValidatePanDocs)
        {
            ApzCOB.fnDisplayMsg("Please delete the uploaded PAN Images!", "E");
            $("#KmSourc__CBcheck__panVal_option_Y").prop("checked", true);
            if (!$("#KmSourc__CBcheck__capturePanBtn").hasClass('sno')){
                $('#KmSourc__CBcheck__capturePanBtn button').click();
            } 
            return;
        }
        $('#' + screenId + 'panView').addClass('sno'); // Hide
    } else {
        $('#' + screenId + 'panView').removeClass('sno'); // Show
    }
};
apz.app.CBcheck.formValidator = function() {
    let isValid = true;
    let isApplicant = Number(gApzCOB.currentApplicant) === 1;
    let isVoterAddressAvailable = apz.app.CBcheck.getAddressForKYC(isApplicant ? "Applicant" : "Co-App");
    function check(result) {
        if (!result) isValid = false;
    }
    let primaryMobileId = screenId + "primaryMobile";
    check(CB_Validate.required(primaryMobileId, "Primary mobile number is required"));
    let secondaryMobileId = screenId + "sec_mobile";
    if($("#" + secondaryMobileId).val()) {
        window.isMobErr = false;
        window.gIsMinMaxErr = false;
        ApzCOB.fnValidateMobileNumber(secondaryMobileId);
        ApzCOB.fnCheckMaxMinLengthOnBlur(document.getElementById(secondaryMobileId));
        if (window.gIsMinMaxErr || window.isMobErr) {
            isValid = false;
        }
    }
    let otpState = isApplicant ? CB_OTP_STATE.applicant : CB_OTP_STATE.coapplicant;
    if (!otpState.verified) {
        showFieldError(primaryMobileId, "OTP verification is required");
        isValid = false;
    }
    if (isApplicant) {
        let loanAmountId = screenId + "loanAmount";
        check(CB_Validate.required(loanAmountId, "Loan amount is required"));
        let amountRaw = $("#" + loanAmountId).val();
        let amount = Number(ApzCOB.fn_unFormatAmount(amountRaw));
        if (!amountRaw || amount < Number(fdAmountMin) || amount > Number(fdAmountMax)) {
            showFieldError(loanAmountId, "Amount must be within allowed range");
            isValid = false;
        }
        check(CB_Validate.required(screenId + "loanPurpose", "Please select loan purpose"));
        check(CB_Validate.required(screenId + "subLoanPurpose", "Please select sub purpose"));
        check(CB_Validate.required(screenId + "frequencyOfRepayment", "Select repayment frequency"));
    }
    let dobId = isApplicant ? screenId + "dob" : screenId + "coDob";
    let ageId = isApplicant ? screenId + "age" : screenId + "coAge";
    let maritalStatus = isApplicant ? screenId + "applicantMaritalStatus" : screenId + "coApplicantMaritalStatus";
    check(CB_Validate.required(maritalStatus, "Please select Marital status"));
    check(CB_Validate.required(dobId, "Date of birth is required"));
    window.isDobDoneThisYear = false;
    let ageVal = ApzCOB.getAge($('#' + dobId).val());
    let age = Number(ageVal);
    if (!ageVal || age < minAge) {
        showFieldError(ageId, `Age must be ${minAge} or above`);
        isValid = false;
    } else if (age > maxAge || (age === maxAge && isDobDoneThisYear)) {
        showFieldError(ageId, `Age must be ${maxAge} or lesser`);
        isValid = false;
    }
    let address1Id = screenId + "addressLine1";
    let pincodeId = screenId + "pincode";
    clearFieldError(address1Id);
    check(CB_Validate.required(address1Id, "Address line 1 is required"));
    clearFieldError(pincodeId);
    check(CB_Validate.required(pincodeId, "Pincode is required"));
    //  VOTER VALIDATION 
    let voterNameId = screenId + "nameAsPerVoter";
    let voterNumId = screenId + "voterId";
    let custType = isApplicant ? "Applicant" : "Co-App";
    let custEntry = inSessionStore?.customerDetailsList?.find(c => c.customerType === custType);
    let sessionVoterVerified = (custEntry?.payload?.primaryKycIdValStatus === "Verified" || custEntry?.payload?.alternateVoterIdValStatus ===
        "Verified");
    clearFieldError(voterNameId);
    clearFieldError(voterNumId);
    check(CB_Validate.required(voterNameId, "Name as per Voter ID is required"));
    let voterFlagVerified = isApplicant ? (window.PRIMARY_KYC_VERIFICATION === true || window.ALTERNATE_KYC_VERIFICATION === true) : (window
        .CO_APPLICANT_PRIMARY_KYC_VERIFICATION === true || window.CO_APPLICANT_ALTERNATE_KYC_VERIFICATION === true);
    let isVoterVerified = voterFlagVerified || sessionVoterVerified;
    let mandVoter = docMaxAndMand.find(doc => doc.key === 'PRIMARY_KYC').value.split('~')[1];
    let custDtlId = (isApplicant ? ApzCOB.getCustDetailID('Applicant') : ApzCOB.getCustDetailID('Co-App'));
    let voterDocs = (inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList || []).filter(doc => doc.documentType === 'PRIMARY_KYC' && doc.custDtlId === custDtlId );
    if (!isVoterVerified || !isVoterAddressAvailable || (voterDocs.length < mandVoter)) {
        showFieldError(voterNumId, "Voter ID must be verified before proceeding");
        isValid = false;
    }
    // PAN VALIDATION (only when panVal = Y) 
    let panVal = $(`input[name="${screenId}panVal_"]:checked`).val() || "Y";
    if (panVal === "Y") {
        let panNameId = screenId + "panName";
        let panNumId = screenId + "panNum";
        clearFieldError(panNameId);
        clearFieldError(panNumId);
        check(CB_Validate.required(panNameId, "Name as per PAN is required"));
        check(CB_Validate.required(panNumId, "PAN number is required"));
        let custType = isApplicant ? "Applicant" : "Co-App";
        let custEntry = inSessionStore?.customerDetailsList?.find(c => c.customerType === custType);
        let sessionPanVerified = custEntry?.payload?.panNumberStatus === "Verified";
        let isPanVerified = isApplicant ? (window.applicant_pancheck === true || sessionPanVerified) : (window.coapplicant_pancheck === true ||
            sessionPanVerified);
        if (!isPanVerified) {
            showFieldError(panNumId, "PAN must be verified before proceeding");
            isValid = false;
        }
    }
    if (!isApplicant) {
        let coNameId = screenId + "coCustomerName";
        clearFieldError(coNameId);
        check(CB_Validate.required(coNameId, "Co-applicant name is required"));
        check(CB_Validate.required(screenId + "relationShipWithApplicant", "Select relationship"));
        check(CB_Validate.required(screenId + "coGender", "Gender is required"));
        check(CB_Validate.required(screenId + "coDob", "Date of birth is required"));
        if (!ageVal || age < 18) {
            showFieldError(ageId, "Co-applicant must be 18 or above");
            isValid = false;
        }
    }
    let hasErrors = $(".err-msg:visible ul[id*='el_txt']").filter(function() {
        return !$(this).hasClass("sno");
    }).length > 0;
    if (hasErrors) {
        return false;
    }
    return isValid;
};
apz.app.CBcheck.validateForm = function() {
    let valid = apz.app.CBcheck.formValidator();
    if (!valid) {
        ApzCOB.fnDisplayMsg("Please ensure all fields are properly filled before initiating the check.", "E");
        return false;
    }
    return true;
};
apz.app.CBcheck.refreshOtpUI = function() {
    apz.app.CBcheck.deriveOtpStateFromSession();
    let isApplicant = gApzCOB.currentApplicant <= 1;
    let state = isApplicant ? CB_OTP_STATE.applicant : CB_OTP_STATE.coapplicant;
    let verifiedCache = isApplicant ? CB_VERIFIED_MOBILES.applicant : CB_VERIFIED_MOBILES.coapplicant;
    let currentMobile = $(`#${screenId}primaryMobile`).val();
    //  CASE 1: CO-APPLICANT SAME AS APPLICANT VERIFIED MOBILE
    if (!isApplicant && CB_OTP_STATE.applicant.mobile && currentMobile === CB_OTP_STATE.applicant.mobile) {
        CB_OTP_STATE.coapplicant.verified = true;
        CB_OTP_STATE.coapplicant.mobile = currentMobile;
        CB_OTP_UI_UNLOCK.coapplicant = true;
        $('#' + screenId + 'sendOtpBtn').addClass('sno');
        $('#' + screenId + 'otpSuccessRow').addClass('sno');
        $('#' + screenId + 'sameMobileInfoDiv').removeClass('sno');
        apz.app.CBcheck.toggleOtpProtectedSections();
        return;
    }
    //  CASE 2: MOBILE EXISTS IN VERIFIED CACHE
    if (currentMobile && verifiedCache.has(currentMobile)) {
        state.verified = true;
        state.mobile = currentMobile;
        $('#' + screenId + 'otpSuccessRow').removeClass('sno');
        $('#' + screenId + 'sendOtpBtn').addClass('sno');
        $('#' + screenId + 'sameMobileInfoDiv').addClass('sno');
    } else {
        //  CASE 3: NOT VERIFIED
        $('#' + screenId + 'otpSuccessRow').addClass('sno');
        $('#' + screenId + 'sendOtpBtn').removeClass('sno');
        $('#' + screenId + 'sameMobileInfoDiv').addClass('sno');
    }
    apz.app.CBcheck.toggleOtpProtectedSections();
};
apz.app.CBcheck.validateMobileForOtp = function() {
    let isApplicant = Number(gApzCOB.currentApplicant) === 1;
    let mobileId = screenId + "primaryMobile";
    let mobile = $("#" + mobileId).val();
    clearFieldError(mobileId);
    if (!mobile || mobile.trim() === "") {
        showFieldError(mobileId, "Please enter a valid primary mobile number");
        return false;
    }
    // Call framework mobile validator before proceeding
    ApzCOB.fnValidateMobileNumber(mobileId);
    if (window.isMobErr === true) {
        return false;
    }
    // Co-applicant primary number matches LAST VERIFIED Applicant mobile
    if (!isApplicant) {
        let applicantVerifiedMobile = CB_OTP_STATE.applicant.mobile;
        if (applicantVerifiedMobile && mobile === applicantVerifiedMobile) {
            // Auto mark verified (NO OTP REQUIRED)
            CB_OTP_STATE.coapplicant.verified = true;
            CB_OTP_STATE.coapplicant.mobile = mobile;
            CB_OTP_UI_UNLOCK.coapplicant = true;
            CB_VERIFIED_MOBILES.coapplicant.add(mobile);
            // Hide OTP UI
            $('#' + screenId + 'sendOtpBtn').addClass('sno');
            $('#' + screenId + 'otpSuccessRow').addClass('sno');
            // Show SAME MOBILE NOTE DIV
            $('#' + screenId + 'sameMobileInfoDiv').removeClass('sno');
            apz.app.CBcheck.toggleOtpProtectedSections();
            return false; // Prevent OTP modal
        }
    }
    return true;
};
apz.app.CBcheck.ageCalculator = function(pthis) {
    // Get the ID of the field that triggered the event
    let id = pthis.id;
    // Calculate the age based on the selected date of birth
    window.isDobDoneThisYear = false;
    let age = ApzCOB.getAge($('#' + id).val());
    // Determine whether the current applicant is the main applicant or co-applicant
    let isApplicant = gApzCOB.currentApplicant === 1; // true if Applicant, false if Co-applicant
    // If age is valid, update the corresponding age field
    if (age > 0) {
        if (isApplicant) { // If the current applicant is the main applicant
            $('#' + screenId + 'age').val(age).change(); // Update applicant's age
            clearFieldError(screenId + 'age');
            clearFieldError(screenId + 'dob');
        } else { // If the current applicant is the co-applicant
            $('#' + screenId + 'coAge').val(age).change(); // Update co-applicant's age
            clearFieldError(screenId + 'coAge');
            clearFieldError(screenId + 'coDob');
        }
        // If age was previously set, clear the DOB field
        if (window.age) {
            $(`#${id}`).val('');
        }
    } else {
        // If age calculation fails (invalid DOB), show error and clear both DOB and age
        ApzCOB.fnDisplayMsg('Please select a valid date of birth', "E");
        $('#' + id).val(''); // Clear the DOB field
        if (isApplicant) {
            $('#' + screenId + 'age').val('');
        } else {
            $('#' + screenId + 'coAge').val('');
        }
    }
}

function clearAllTabErrors() {
    // Remove all inline error classes
    $(".error-inline").removeClass("error-inline");
    // Remove all cb-error-border classes
    $(".cb-error-border").removeClass("cb-error-border");
    // Remove all error message divs and slots
    $(".cb-error-msg").remove();
    $("[id$='_errorslot']").remove();
    document.querySelectorAll("ul").forEach(u => {
        const errBox = u.nextElementSibling;
        if (errBox && errBox.classList.contains("err-msg")) errBox.classList.add("sno");
    });
    document.querySelectorAll(".err").forEach(e => e.classList.remove("err"));
    window.gIsMinMaxErr = false;
}
apz.app.CBcheck.toggleOtpProtectedSections = function() {
    let isApplicant = gApzCOB.currentApplicant <= 1;
    let isUnlocked = isApplicant ? CB_OTP_UI_UNLOCK.applicant : CB_OTP_UI_UNLOCK.coapplicant;
    //  ALWAYS hide first
    $('.cb-otp-protected').addClass('sno');
    $('.cb-otp-common').addClass('sno');
    $('#' + screenId + 'panView').addClass('sno');
    // If OTP not verified → STOP
    if (!isUnlocked) return;
    // OTP verified → show common sections (PAN, Address, etc.)
    $('.cb-otp-common').removeClass('sno');
    // Show tab specific sections
    if (isApplicant) {
        $('.src-app.cb-otp-protected').removeClass('sno');
    } else {
        $('.src-coapp.cb-otp-protected').removeClass('sno');
    }
    $('#' + screenId + 'panView').addClass('sno');
    window.shouldValidatePanDocs = false;
    apz.app.CBcheck.togglePanView();
    window.shouldValidatePanDocs = true;
};
apz.app.CBcheck.togglePostValidationSections = function() {
    let isApplicant = gApzCOB.currentApplicant <= 1;
    let isFormValidated = isApplicant ? CB_FORM_STATE.applicant.validated : CB_FORM_STATE.coapplicant.validated;
    // Hide all post-validation sections first
    $('.cb-post-validated').addClass('sno');
    // If current tab form not validated, do nothing
    if (!isFormValidated) return;
    // Show common validated sections (for that tab only)
    $('.cb-common-validated').removeClass('sno');
    // Show tab specific validated sections
    if (isApplicant) {
        $('.src-app.cb-post-validated').removeClass('sno');
    } else {
        $('.src-coapp.cb-post-validated').removeClass('sno');
    }
};
apz.app.CBcheck.paintDetails = function() {
    let customerList = inSessionStore?.customerDetailsList || gApzCOB?.requestNodes?.customerDetailsWrapperList;
    let addressWrapperRoot = inSessionStore?.addressDetailsWrapperList || gApzCOB?.requestNodes?.addressDetailsWrapperList;
    // Check if both inSessionStore and gApzCOB.requestNodes are null/empty -> Fresh Case
    if ((apz.isNull(inSessionStore.customerDetailsList) || inSessionStore.customerDetailsList.length === 0) && (apz.isNull(gApzCOB.requestNodes
            .customerDetailsList) || gApzCOB.requestNodes.customerDetailsList.length === 0)) {
        // Fresh Case - Use gApzCOB.selLeadDtls like PersonalDetails
        if(!apz.isNull(gApzCOB.selLeadDtls) && !apz.isObjectEmpty(gApzCOB.selLeadDtls)){
            apz.app.CBcheck.paintFreshCaseDetails();
        }
        return;
    }
    //   EXISTING CASE - Continue with normal painting
    if (!customerList?.length) {
        return;
    }
    //   IDENTIFY CURRENT APPLICANT 
    let isApplicant = gApzCOB.currentApplicant === 1;
    let custType = isApplicant ? "Applicant" : "Co-App";
    let custWrapper = customerList.find(c => c.customerType === custType);
    if(custType === "Co-App" && inSessionStore?.cdhCoAppLeadDetails?.coDateOfBirth?.date && custWrapper?.payload?.dob !== null) {
        custWrapper.payload.dob = ApzCOB.formatDate(inSessionStore?.cdhCoAppLeadDetails?.coDateOfBirth?.date);
    }
    if (apz.isNull(custWrapper) || apz.isNull(custWrapper.payload)) {
        // restore UI state for the tab
        if (!isApplicant) {
            apz.app.CBcheck.paintApplicantAddressIntoFields();
            apz.app.CBcheck.toggleAddressFieldsState();
        }
        apz.app.CBcheck.refreshOtpUI();
        apz.app.CBcheck.toggleOtpProtectedSections();
        apz.app.CBcheck.togglePostValidationSections();
        return;
    }
    let custId = custWrapper.custDtlId;
    let payload = custWrapper.payload;
    if (ApplicationType === "OpenMarket") {
        payload.gender = {
            F: 'Female',
            M: 'Male'
        } [payload.gender] || payload.gender;
    }
    //   BASIC DETAILS
    if (isApplicant) {
        $('#' + screenId + 'customerName').val(custWrapper.customerName || "");
        $('#' + screenId + 'dob').val(payload.dob ? ApzCOB.convertDateFormat(payload.dob, 'dd/mm/yyyy') : "");
        $('#' + screenId + 'age').val(payload.age || "");
        $('#' + screenId + 'gender').val(payload.gender || "");
        $(`#${screenId}applicantMaritalStatus`).val(payload.maritalStatus || PleaseSelect);
    } else {
        $('#' + screenId + 'coCustomerName').val(custWrapper.customerName || "");
        $('#' + screenId + 'coDob').val(payload.dob ?  ApzCOB.convertDateFormat(payload.dob, 'dd/mm/yyyy') : "");
        $('#' + screenId + 'coAge').val(payload.age || "");
        $('#' + screenId + 'coGender').val(payload.gender || "");
        $('#' + screenId + 'relationShipWithApplicant').val(payload.relationShipWithApplicant || PleaseSelect);
        let relField = document.getElementById(`${screenId}relationShipWithApplicant`);
        if (relField) apz.app.CBcheck.onRelationSelect(relField);
        $(`#${screenId}coApplicantMaritalStatus`).val(payload.maritalStatus || PleaseSelect);
        if(ApplicationType === "OpenMarket" && gApzCOB.currentApplicant !== 1){
            $(`#${screenId}coApplicantMaritalStatus`).val("Married");
        } else if(ApplicationType === 'RENEWAL'){
          $('#' + screenId + 'memberId').val(inSessionStore.cdhCoAppLeadDetails?.coCustomerId || "");  
        }
    }
    //   KYC
    $('#' + screenId + 'nameAsPerVoter').val(payload.namePerKyc || "");
    $('#' + screenId + 'voterId').val(payload.primaryKycId || "");
    $('#' + screenId + 'alternateVoterId').val(payload.alternateVoterId || "");
    $('#' + screenId + 'ckycNumber').val(payload.ckyc || "");
    //   PAN
    $('#' + screenId + 'panName').val(payload.namePerPan || "");
    $('#' + screenId + 'panNum').val(payload.panNumber || "");
    let panVal = payload.panNumberValue || "Y";
    if(panVal.toLowerCase() === "yes"){
        panVal = "Y";
    } else if (panVal.toLowerCase() === "no"){
        panVal = "N";
    }
    $(`input[name="${screenId}panVal_"]`).prop("checked", false);
    // let $targetRadio = $(`input[name="${screenId}panVal_"][value="${panVal}"]`);
    let $targetRadio = $(`#${screenId}panVal_option_${panVal}`);
    $targetRadio.prop("checked", true).trigger("change");
    //   MOBILE
    let primaryMobile = custWrapper.mobileNumber || "";
    $('#' + screenId + 'primaryMobile').val(primaryMobile);
    $('#' + screenId + 'sec_mobile').val(payload.secMobileNo || "");
    /* ADDRESS */
    if (isApplicant && addressWrapperRoot?.length) {
        let wrappers = addressWrapperRoot?.[0]?.addressDetailsList || addressWrapperRoot;
        let addressWrapper = wrappers.find(w => w.addressType === "Personal" && w.custDtlId == custWrapper.custDtlId);
        if (!apz.isNull(addressWrapper) && !apz.isNull(addressWrapper.payload)) {
            let addrList = addressWrapper.payload?.addressList;
            if (addrList?.length) {
                let present = addrList.find(a => a.addressType === "Present");
                if (present) {
                    $('#' + screenId + 'addressLine1').val(present.addressLine1 || "");
                    $('#' + screenId + 'addressLine2').val(present.addressLine2 || "");
                    $('#' + screenId + 'addressLine3').val(present.addressLine3 || "");
                    $('#' + screenId + 'addPreCity').val(present.city || "");
                    $('#' + screenId + 'addPreDistrict').val(present.district || "");
                    $('#' + screenId + 'addPreState').val(present.state || "");
                    let $pin = $('#' + screenId + 'pincode');
                    $pin.val(present.pinCode || "");
                    if (present.pinCode) {
                        apz.app.Kmbase.onchangepincode($pin[0], "addPre");
                    }
                }
            }
        }
    }
    /* UI STATE RESTORE */
    if (!isApplicant) {
        apz.app.CBcheck.paintApplicantAddressIntoFields();
        //   FRESH CASE DETECTION
        if(ApzCOB.getPayloadDatafromWrapper("isNewCustomer", "Co-App", "customerDetailsList") === 'Create a new Co-Applicant') {
            $("#KmSourc__CBcheck__newCoappRow").removeClass('sno');
            $("#KmSourc__CBcheck__selCoAppRow").addClass('sno'); 
        } else {
            $("#KmSourc__CBcheck__newCoappRow").addClass('sno');
            $("#KmSourc__CBcheck__selCoAppRow").removeClass('sno'); 
        }
    }
    apz.app.CBcheck.refreshOtpUI();
    apz.app.CBcheck.toggleOtpProtectedSections();
    apz.app.CBcheck.togglePostValidationSections();
    apz.app.CBcheck.toggleAddressFieldsState();
    apz.app.CBcheck.paintVerificationTicks();
};
apz.app.CBcheck.paintFreshCaseDetails = function() {
    //   FRESH CASE PAINTING 
    try{
    if (gApzCOB.currentApplicant === 1) {
        var cstDtls = gApzCOB.selLeadDtls || {};
        if (ApplicationType === "OpenMarket") {
            cstDtls.gender = {
                F: 'Female',
                M: 'Male'
            } [cstDtls.gender] || cstDtls.gender;
        }
        // Paint applicant fields from selLeadDtls
        $('#' + screenId + 'customerName').val(cstDtls.fullName || "");
        $('#' + screenId + 'dob').val(cstDtls.dob ? ApzCOB.convertDateFormat(cstDtls.dob, 'dd/mm/yyyy') : "");
        $('#' + screenId + 'age').val(ApzCOB.getAge(cstDtls.dob) || "");
        $('#' + screenId + 'gender').val(cstDtls.gender || "");
        $(`#${screenId}applicantMaritalStatus`).val(ApzCOB.capitalize(cstDtls.maritalStatus || '') || PleaseSelect);
        // KYC Details
        $('#' + screenId + 'nameAsPerVoter').val(cstDtls.fullName || "");
        $('#' + screenId + 'voterId').val(cstDtls.primaryKyc || "");
        $('#' + screenId + 'alternateVoterId').val(cstDtls.alternateVoterId || "");
        $('#' + screenId + 'ckycNumber').val(cstDtls.applicantCkyc || "");
        // Mobile Details
        let primaryMobile = cstDtls.mobileNo || "";
        $('#' + screenId + 'primaryMobile').val(primaryMobile);
        // Address from selLeadDtls (if available)
        if (!apz.isNull(cstDtls.presLine1)) {
            $('#' + screenId + 'addressLine1').val(cstDtls.presLine1 || "");
            $('#' + screenId + 'addressLine2').val(cstDtls.presLine2 || "");
            $('#' + screenId + 'addressLine3').val(cstDtls.presLine3 || "");
            $('#' + screenId + 'addPreCity').val(cstDtls.presCity || "");
            $('#' + screenId + 'addPreDistrict').val(cstDtls.presDistrict || "");
            $('#' + screenId + 'addPreState').val(cstDtls.presState || "");
            let $pin = $('#' + screenId + 'pincode');
            $pin.val(cstDtls.presPincode || "");
            if (cstDtls.presPincode) {
                apz.app.Kmbase.onchangepincode($pin[0], "addPre");
            }
        }
        // Additional fields from selLeadDtls
        $('#' + screenId + 'relationShipWithApplicant').val(cstDtls.relationship || PleaseSelect);
        // PAN — fresh case always defaults to Y (no PAN data from lead)
        $(`input[name="${screenId}panVal_"]`).prop("checked", false);
        $(`input[name="${screenId}panVal_"][value="Y"]`).prop("checked", true).trigger("change");
    }
    if (gApzCOB.currentApplicant !== 1) {
        apz.app.CBcheck.paintApplicantAddressIntoFields();
    }
    // UI State Restore
    apz.app.CBcheck.refreshOtpUI();
    apz.app.CBcheck.toggleOtpProtectedSections();
    apz.app.CBcheck.togglePostValidationSections();
    apz.app.CBcheck.toggleAddressFieldsState();
    apz.app.CBcheck.paintVerificationTicks();
    } catch(e){
      ApzCOB.traceFrontEndError(e,"");  
    }
};
apz.app.CBcheck.clearForm = function() {
    let isApplicant = gApzCOB.currentApplicant <= 1;
    if (isApplicant) {
        $('#' + screenId + 'customerName').val("");
        $('#' + screenId + 'dob').val("");
        $('#' + screenId + 'age').val("");
        $(`#${screenId}applicantMaritalStatus`).val(PleaseSelect);
    } else {
        $('#' + screenId + 'coCustomerName').val("");
        $('#' + screenId + 'coAge').val("");
        $('#' + screenId + 'relationShipWithApplicant').val(PleaseSelect);
        $('#' + screenId + 'coGender').val(PleaseSelect);
        $('#' + screenId + 'coDob').val("");
        // $('#' + screenId + 'coDob').val(PleaseSelect);
        $(`#${screenId}coApplicantMaritalStatus`).val(PleaseSelect);
        $('#' + screenId + 'sameMobileInfoDiv').addClass('sno');
    }
    $('#' + screenId + 'primaryMobile').val("");
    $('#' + screenId + 'sec_mobile').val("");
    $('#' + screenId + 'ckycNumber').val("");
    $('#' + screenId + 'nameAsPerVoter').val("");
    $('#' + screenId + 'voterId').val("");
    $('#' + screenId + 'alternateVoterId').val("");
    $('#' + screenId + 'gender').val("");
    $('#' + screenId + 'addressLine1').val("");
    $('#' + screenId + 'addressLine2').val("");
    $('#' + screenId + 'addressLine3').val("");
    $('#' + screenId + 'addPreCity').val("");
    $('#' + screenId + 'addPreDistrict').val("");
    $('#' + screenId + 'addPreState').val("");
    $('#' + screenId + 'pincode').val("");
    $(`input[name="${screenId}panVal_"]`).prop("checked", false);
    $(`input[name="${screenId}panVal_"][value="Y"]`).prop("checked", true);
    let voterCfg = window.KM_DOC_VIEWER_CONFIG['PRIMARY_KYC'];
    let panCfg = window.KM_DOC_VIEWER_CONFIG['PAN_NUMBER_PHOTO'];
    $(`#${voterCfg.rowId}`).removeClass('km-doc-upload-row').addClass('sno');
    $(`#${voterCfg.captureBtnId}`).removeClass('sno');
    $(`#${panCfg.rowId}`).removeClass('km-doc-upload-row').addClass('sno');
    $(`#${panCfg.captureBtnId}`).removeClass('sno');
    $('#' + screenId + 'otpSuccessRow').addClass('sno');
    $('#' + screenId + 'sendOtpBtn').removeClass('sno');
    $('#' + screenId + 'panNum').val("");
    $('#' + screenId + 'panName').val("");
    /* Tenure */
    $(`#${screenId}loanTenureYr`).val(PleaseSelect);
    /* Mode of Disbursement */
    // apz.setElmValue(screenId + 'modeOfDisb', 'NEFT');
    /* Mode of Security — back to E-NACH */
    $("#" + screenId + "modeOfSecur_option_MOSopt3").attr('checked', true);
    /* Rate of Interest — re-derive */
    let branchState = apz.isNull(gApzCOB.selLeadDtls?.glBranchState) ? '' : gApzCOB.selLeadDtls.glBranchState.toUpperCase();
    for (var i = 0; i < rateOfInteres.length; i++) {
        if (rateOfInteres[i].key.toUpperCase() === branchState) {
            $(`#${screenId}rateOfIntrst`).val(rateOfInteres[i].value);
        }
    }
    apz.app.CBcheck.clearVerificationTicks();
};
apz.app.CBcheck.paintLoanDetails = function() {
    if (apz.isNull(inSessionStore.loanDetails)) return;
    let LOAN_OBJ = inSessionStore.loanDetails;
    // Only paint for applicant (currentApplicant === 1)
    if (gApzCOB.currentApplicant === 1 && !apz.isNull(LOAN_OBJ)) {
        //   Loan Amount
        let amount = LOAN_OBJ.loanAmount || fdDefaultLoanAmount;
        $('#' + screenId + 'loanAmount').val(ApzCOB.fn_FormatAmount(amount));
        // Sync slider
        $("#" + screenId + "loanSlider").slider("option", "value", amount);
        //   Loan Purpose
        let purpose = LOAN_OBJ.payload?.loanPurpose || PleaseSelect;
        $(`#${screenId}loanPurpose`).val(purpose);
        //   Sub Purpose
        apz.app.CBcheck.buildSubPurposeDropdown(purpose);
        let subPurpose = LOAN_OBJ.payload?.subCategory || PleaseSelect;
        $(`#${screenId}subLoanPurpose`).val(subPurpose);
        //   Frequency
        $(`#${screenId}frequencyOfRepayment`).val(LOAN_OBJ.payload?.frequencyOfRepayment || PleaseSelect);
        /* Tenure */
        if (!apz.isNull(LOAN_OBJ.tenure)) {
            $(`#${screenId}loanTenureYr`).val(LOAN_OBJ.tenure + ' months');
        }
        /* Mode of Disbursement */
        $(`#${screenId}modeOfDisb`).val(LOAN_OBJ.payload?.modeOfDisbursement ? LOAN_OBJ.payload.modeOfDisbursement : 'NEFT');
        /* Mode of Security */
        var MOSVal = LOAN_OBJ.payload?.modeOfSecurity || 'E-NACH';
        if (MOSVal === '3 Undated cheques') MOSVal = 'MOSopt1';
        else if (MOSVal === 'NACH Form') MOSVal = 'MOSopt2';
        else if (MOSVal === 'E-NACH') MOSVal = 'MOSopt3';
        apz.setElmValue(screenId + 'modeOfSecur', MOSVal);
        //  Rate of Interest 
        let branchState = apz.isNull(gApzCOB.selLeadDtls?.glBranchState) ? '' : gApzCOB.selLeadDtls.glBranchState.toUpperCase();
        for (var i = 0; i < rateOfInteres.length; i++) {
            if (rateOfInteres[i].key.toUpperCase() === branchState) {
                $(`#${screenId}rateOfIntrst`).val(rateOfInteres[i].value);
            }
        }
    }
};
apz.app.CBcheck.getCurrentCustId = function() {
    if (apz.isNull(gApzCOB.requestNodes?.customerDetailsList)) return null;
    let isApplicant = gApzCOB.currentApplicant === 1;
    let wrapper = gApzCOB.requestNodes.customerDetailsList.find(c => isApplicant ? c.customerType === "Applicant" : c.customerType === "Co-App");
    return wrapper?.custDtlId ?? null;
};
