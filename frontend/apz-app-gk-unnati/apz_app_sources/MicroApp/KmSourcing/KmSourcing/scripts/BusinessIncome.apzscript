        },
        totals: {
            monthly: 0,
            annually: 0
        }
    };
}
apz.app.BusinessIncome.viewIncomeSummary = function() {
    apz.app.BusinessIncome.resetBusinessObj();
    let OverAllNetIncome = 0;
    let TypesSelected = [];
    const typeMap = {
        businessTypeOption: "business",
        AgricultureTypeOption: "Agriculture",
        SalaryTypeOption: "Salary",
        WageTypeOption: "Wage",
        PensionTypeOption: "Pension",
        RentalincomeTypeOption: "Rentalincome"
    };
    const checkboxes = document.querySelectorAll(`#${kmScrId}sourceofincomesec input[type="checkbox"]:checked`);
    checkboxes.forEach(cb => {
        TypesSelected.push(cb.id.split("_")[4]);
    });
    TypesSelected.forEach(type => {
        const incType = typeMap[type];
        if (!incType) return;
        const totalNetInc = apz.app.BusinessIncome.getnetMonthlyIncome(incType) || 0;
        OverAllNetIncome += parseInt(totalNetInc);
    });
    $('.incSumm').addClass('sno');
    incomeSources.totals.monthly = ApzCOB.formatIndianRupees(OverAllNetIncome);
    incomeSources.totals.annually = ApzCOB.formatIndianRupees(OverAllNetIncome * 12);
    $(`#${kmScrId}totalHousehldIncValue`).text(ApzCOB.formatIndianRupees(OverAllNetIncome) ?? `₹ 0`);
    $(`#${kmScrId}totalDeclaredIncValue`).text(ApzCOB.formatIndianRupees(OverAllNetIncome * 12) ?? `₹ 0`);
    if(OverAllNetIncome > 0) {
        $('.incSumm').removeClass('sno');
        apz.app.BusinessIncome.paintIncomeSummaryData(incomeSources);
    }
    ApzCOB.toggleModal('KmSourc__BusinessIncome__incomeSummaryMdl');
};
apz.app.BusinessIncome.paintIncomeSummaryData = function(incomeSources) {
    /* ---------- BUSINESS INCOME ---------- */
    const businessTypes = ["Dairy", "Kirana", "Tailoring", "Other"];
    businessTypes.forEach((type, index) => {
        const data = incomeSources.business[type] || [];
        const row = index + 1;
        let totalIncome = 0;
        let owners = new Set();
        data.forEach(item => {
            totalIncome += item.income || 0;
            if (item.ownedBy) owners.add(item.ownedBy);
        });
        const ownedByText = owners.size ? [...owners].join(", ") : "None";
        // $(`#${kmScrId}el_txt_${296 + (index * 3)}`).text(`Business ${row} - ${type}`);
        $(`#${kmScrId}business${row}_ownedBy`).text(ownedByText);
        $(`#${kmScrId}business${row}_income`).text(`₹ ${totalIncome.toLocaleString()}`);
    });
    /* ---------- OTHER INCOME ---------- */
    const otherMap = {
        Agriculture: 1,
        Salary: 2,
        Wage: 3,
        Pension: 4,
        Rentalincome: 5
    };
    Object.keys(otherMap).forEach(type => {
        const idx = otherMap[type];
        const data = incomeSources.otherIncome[type] || {};
        const ownedBy = data.ownedBy || "None";
        const income = data.income || 0;
        $(`#${kmScrId}OtherInc${idx}_ownedBy`).text(ownedBy);
        $(`#${kmScrId}OtherInc${idx}_income`).text(`₹ ${income.toLocaleString()}`);
    });
    /* ---------- TOTALS ---------- */
    $(`#${kmScrId}totalMonthlyIncome`).text(incomeSources.totals.monthly);
    $(`#${kmScrId}totalAnnualIncome`).text(incomeSources.totals.annually);
};
apz.app.BusinessIncome.formatAndUnformat = function(amtVal) {
    if (apz.isNull(amtVal) || amtVal == 0) return '';
    let currNetIncome = ApzCOB.fn_FormatAmount(amtVal);
    currNetIncome = ApzCOB.unformatAmountWithDecimal(amtVal);
    return parseInt(currNetIncome);
};
apz.app.BusinessIncome.getnetMonthlyIncome = function(incType) {
    let netIncome = 0;
    if (incType == "business") {
        let totalBusiness = $("[id^='KmSourc__BusinessIncome__CloneRow_']:visible").length;
        for (i = 1; i <= totalBusiness; i++) {
            let owner = $(`#${kmScrId+i}_businessOwnedByOption input[type="radio"]:checked`).val();
            let bussName = $(`#${kmScrId+i}_businessTypeOption input[type="radio"]:checked`).val();
            let currNetIncome = apz.app.BusinessIncome.formatAndUnformat($(`#${kmScrId + i}_NetBusinessIncome`).val());
            netIncome = parseInt(netIncome) + currNetIncome;
            if (!apz.isNull(owner) && !apz.isNull(bussName)) {
                incObj = {
                    ownedBy: owner,
                    income: currNetIncome
                }
                incomeSources.business[bussName].push(incObj);
            }
        }
    } else {
        const config = incomeConfig[incType];
        if (!config) return 0;
        const owner = $(`#${kmScrId}${config.radio} input[type="radio"]:checked`).val();
        const getValue = (id) => apz.app.BusinessIncome.formatAndUnformat($(`#${kmScrId}${id}`).val());
        if (owner === "Applicant") {
            netIncome = getValue(config.applicant);
        } else if (owner === "Co-Applicant") {
            netIncome = getValue(config.coApplicant);
        } else if (owner === "Both") {
            netIncome = getValue(config.applicant) + getValue(config.coApplicant);
        }
        if (!apz.isNull(owner)) {
            incomeSources.otherIncome[incType] = {
                ownedBy: owner,
                income: netIncome
            };
        }
    }
    return netIncome;
}
apz.app.BusinessIncome.parseIncome = function(value) {
    return parseFloat(value.replace(/,/g, ""));
}
apz.app.BusinessIncome.paintAddressOptions = function(pIndex, selectedVal) {
    //addressSameAs - ApplicantVoter Co-AppVoter ApplicantSecondaryKyc Co-AppSecondaryKyc Other
    //Addresstype - Voter , SecondaryKyc
    let noAddrText = 'Data not available, please update the address details';
    let addrMap = [
        { id: 'AppVoterAddr_txtcnt', type: 'Voter', cust: 'Applicant' },
        { id: 'coAppVoterAddr_txtcnt', type: 'Voter', cust: 'Co-App' },
        { id: 'AppAadhaarAddr_txtcnt', type: 'SecondaryKyc', cust: 'Applicant' },
        { id: 'coAppAadhaarAddr_txtcnt', type: 'SecondaryKyc', cust: 'Co-App' }
    ];
    addrMap.forEach(item => {
        let addr = apz.app.BusinessIncome.getAddressStr(item.type, item.cust) || false;
        let elem = $(`#${kmScrId+pIndex}_${item.id}`);
        elem.text(addr ? addr : noAddrText);
        if (!addr) {
            elem.parent().addClass('aadhaar-fallback-text');
            $(`#${kmScrId+pIndex}_${item.cust+item.type}Rdo`).addClass('aadhar-radio-disable')
        }
    });
    if (selectedVal) {
        if (gApzCOB?.LoggedInUserDetails?.loginResponse?.addInfo1 == 'BM') {
            $(`#${kmScrId+pIndex}_addressList .bsaddr-body-row`).each((index, item) => {
                $('#' + item.id).addClass('sno');
            })
            $(`#${kmScrId+pIndex}_${selectedVal}Row`).removeClass('sno');
        }
        $(`#${kmScrId+pIndex}_${selectedVal}Rdo_option_${selectedVal}`).prop('checked', true);
        if (selectedVal === 'Other') {
            $(`#${kmScrId+pIndex}_${selectedVal}Rdo_option_${selectedVal}`).change();
            addrType = 'Occupation';
            subAddrType = 'Office';
            let OthOffAddr = inSessionStore.addressDetailsWrapperList[0].addressDetailsList.find(el => el.addressType === 'Occupation' && el.custDtlId === ApzCOB.getCustDetailID('Applicant'))?.payload?.addressList?.find(addr => addr.businessIndex == pIndex);
            if (OthOffAddr) {
                $(`#${kmScrId+pIndex}_${selectedVal}Rdo_option_${selectedVal}`).change();
                addrFields.forEach(el => {
                    $(`#${kmScrId+pIndex}_otherBussAddr${el}`).val(OthOffAddr[el] || "");
                });
                $(`#${kmScrId+pIndex}_otherBussAddrProof`).val(OthOffAddr.currentAddressProof || "");
                TempImageObject.Type = "BUSINESS_ADDRESS_PROOF";
                TempImageObject.docDesc = $(`#${kmScrId + pIndex}_otherBussAddrProof`).val();
                TempImageObject.index = pIndex;
                incomeTypeBulkDelete = "Business";
                custTypeIncomeDtls = $(`input[name="${kmScrId + pIndex}_businessOwnedByOption_"]:checked`).val();
                docNoImageUpload = TempImageObject.index;
                count = TempImageObject.index;
                apz.app.BusinessIncome.paintDocumentName("BUSINESS_ADDRESS_PROOF");
            } else {
                addrFields.forEach(el => {
                $(`#${kmScrId+pIndex}_otherBussAddr${el}`)
                    .val("")
                    .attr("placeholder", "Please type here");
                });

                $(`#${kmScrId+pIndex}_otherBussAddrProof`)
                    .prop('selectedIndex', 0);

                apz.app.BusinessIncome.paintDocumentName("");
            }
        }
    }
};
apz.app.BusinessIncome.getAddressStr = function(addrType, custType) {
    if (apz.isNull(inSessionStore.addressDetailsWrapperList)) return '';
    let custDetailID = ApzCOB.getCustDetailID(custType);
    let addrList = inSessionStore.addressDetailsWrapperList[0]?.addressDetailsList?.find(el => el.custDtlId === custDetailID && el.addressType === 'Personal')?.payload?.addressList || [];
    if (addrList.length === 0) return false;
    let Addr = addrList.find(a => a.addressType === addrType) || {};
    if (Addr && Addr.addressLine1) {
        return [Addr.addressLine1, Addr.addressLine2, Addr.addressLine3, Addr.district, Addr.city, Addr.pinCode, Addr.state, Addr.country].filter(Boolean).join(", ");
    }
}
apz.app.BusinessIncome.PaintData = function() {
    var data;
    const business = inSessionStore?.bcmpiIncomeDetails?.bcmpiIncomeDetailsWrapper?.business;
    const isBusinessEmpty =
        business &&
        ['dairy', 'Kirana', 'Tailoring', 'Other']
            .every(key => !business[key] || business[key].length < 1);
    if (!isBusinessEmpty &&!apz.isNull(inSessionStore?.bcmpiIncomeDetails)) {
        data = JSON.parse(inSessionStore?.bcmpiIncomeDetails?.payload);
        Object.keys(data).forEach(category => {
            switch (category) {
                case "business":
                    apz.app.BusinessIncome.BusinessData();
                    break;
                case "agriculture":
                    apz.app.BusinessIncome.AgriData();
                    break;
                case "salary":
                    apz.app.BusinessIncome.SalaryData();
                    break;
                case "wage":
                    apz.app.BusinessIncome.WageData();
                    break;
                case "pension":
                    apz.app.BusinessIncome.PaintPensionData();
                    break;
                case "rentalIncome":
                    apz.app.BusinessIncome.RentalIncomeData()
                    break;
                /*case "homeMaker":
                    apz.app.BusinessIncome.PaintHomeMakerData();
                    break;*/
                default:
                    // ("Unknown Category:", category);
            }
        });
    } else {
        obj = {
            TypeChecked: true,
            sectionName: "Business",
            id: String(1)
        };
        if(gApzCOB.SelectedProductName !== "Vishesh" && gApzCOB.productCode !== "1003"){
        apz.app.BusinessIncome.launchBusinessSection("", obj);
        $(`#${kmScrId}businessTypeOption`).prop('checked', true);
        }
        // ApzCOB.addDisableToInput('KmSourc__BusinessIncome__1_DeleteIcon');
        data = JSON.parse(inSessionStore?.bcmpiIncomeDetails?.payload ?? "[]");
        Object.keys(data).forEach(category => {
            switch (category) {
                case "agriculture":
                    apz.app.BusinessIncome.AgriData();
                    break;
                case "salary":
                    apz.app.BusinessIncome.SalaryData();
                    break;
                case "wage":
                    apz.app.BusinessIncome.WageData();
                    break;
                case "pension":
                    apz.app.BusinessIncome.PaintPensionData();
                    break;
                case "rentalIncome":
                    apz.app.BusinessIncome.RentalIncomeData()
                    break;
                /*case "homeMaker":
                    apz.app.BusinessIncome.PaintHomeMakerData();
                    break;*/
                default:
                    // ("Unknown Category:", category);
            }
        });
    }
};
apz.app.BusinessIncome.BusinessData = function () {
    if (!inSessionStore?.bcmpiIncomeDetails) return;
    const payload = JSON.parse(inSessionStore.bcmpiIncomeDetails.payload);
    const businessData = payload?.business;
    if (!businessData) {
        $(`#${kmScrId}businessTypeOption`).click();
        return;
    }
    let id = 0;
    const config = {
        dairy: {
            type: "Dairy",
            ownedKey: "DairyType",
            lbl: "Total No of Cows / Buffalo",
            val1: "totalCowsAndBuffalos",
            val2: "netMonthlyIncome",
            doc: "Dairy Doc"
        },
        Kirana: {
            type: "Kirana",
            ownedKey: "kiranaType",
            lbl: "Type of Shop",
            val1: "kiranaShopType",
            val2: "netMonthlyIncome",
            val3: "streetVendor",
            doc: "Kirana Doc"
        },
        Other: {
            type: "Other",
            ownedKey: "otherType",
            lbl: "Other line of business",
            val1: "lineOfOtherBusiness",
            val2: "netBusinessIncome",
            doc: "Other Doc"
        },
        Tailoring: {
            type: "Tailoring",
            ownedKey: "tailoringType",
            lbl: "Revenue per Month",
            val1: "totalMonthlyIncome",
            val2: "netMonthlyIncome",
            doc: "Tailoring Doc"
        }
    };
    const hasBusiness = businessData?.dairy?.length || businessData?.Kirana?.length || businessData?.Tailoring?.length || businessData?.Other?.length;
    if (hasBusiness) {
        $(`#${kmScrId}businessTypeOption`).prop("checked", true);
    }
    const combinedEntries = [];
    Object.keys(config).forEach(key => {
        const entries = businessData[key];
        if (!entries?.length) return;
        const cfg = config[key];
        entries.forEach(entry => {
            combinedEntries.push({ cfg, entry });
        });
    });
    combinedEntries.sort((a, b) => a.entry.businessIndex - b.entry.businessIndex);
    combinedEntries.forEach(item => {
        const entry = item.entry;
        const cfg = item.cfg;
        id++;
        const obj = {
            TypeChecked: true,
            sectionName: "Business",
            id: String(id)
        };
        apz.app.BusinessIncome.launchBusinessSection("", obj);
        const base = `${kmScrId}${id}`;
        $(`#${base}_businessOwnedByOption_option_${entry[cfg.ownedKey]}`).prop("checked", true);
        $(`#${base}_businessTypeOption_option_${cfg.type}`).prop("checked", true);
        $(`#${base}_businessOwnedByOption input[type="radio"]`).prop("disabled", true);
        $(`#${base}_businessTypeOption input[type="radio"]`).prop("disabled", true);
        $(`#${base}_businessTypeSec, #${base}_businessImgSec`).removeClass("sno");
        $(`#${base}_addBusinessDetails_ul`).addClass("sno");
        $(`#${base}_BusinessNoTxt`).text(`Business ${id}`);
        $(`#${base}_businessLbl1_grp_lbl`).text(cfg.lbl);
        let incomeVal = ApzCOB.fn_unFormatAmount(entry[cfg.val2]);
        let isValidIncome = !(
            incomeVal === 0 ||
            incomeVal === "0" ||
            incomeVal === "" ||
            incomeVal === null ||
            incomeVal === undefined
        );
        if (!isValidIncome) {
           $(`#${base}_businessLbl1`).val("").attr("placeholder", "Please type here");
            $(`#${base}_NetBusinessIncome`).val("").attr("placeholder", "Please type here");
        } else {
            let numericVal = String(incomeVal).replace(/[^\d]/g, "");
            $(`#${base}_businessLbl1`).val(numericVal);
            $(`#${base}_NetBusinessIncome`).val(numericVal);
            apz.app.BusinessIncome.customIndianRupeeFormat(
               document.getElementById(`${base}_NetBusinessIncome`)
           );
        }
        $(`#${base}_viewBusinessDetails_ul`).addClass("sno");
        $(`#${base}_bussAddrSection`).removeClass('sno');
        $(`#${base}_otherLineofBussRow, #${base}_streetVendorRow, #${base}_K-TypeofshopRow`).addClass('sno');
        $(`#${base}_addBusiness`).attr("disabled", false);
        if (gApzCOB?.LoggedInUserDetails?.loginResponse?.addInfo1 == 'BM') {
            let fld = [`${base}_NetBusinessIncome`, `${base}_K-Typeofshop`, `${base}_O_OthLineOfBus_drop`, `${base}_businessLbl1`,
                `${base}_otherBussAddraddressLine1`, `${base}_otherBussAddraddressLine2`, `${base}_otherBussAddraddressLine3`,
                `${base}_otherBussAddrpinCode`, `${base}_otherBussAddrcity`, `${base}_otherBussAddrdistrict`, `${base}_otherBussAddrarea`,
                `${base}_otherBussAddrlandMark`, `${base}_otherBussAddrstate`, `${base}_otherBussAddrcountry`, `${base}_otherBussAddrProof`
            ];
            fld.forEach(f => ApzCOB.addDisableToInput(f));
            ['ImageParentImage', 'adddeletIcn', 'busnsdeletIcn', 'DeleteIcon', 'ImageProofParentImage'].forEach(i => $(`#${base}_${i}`).addClass('sno'));
            ['bsnessQ_row'].forEach(i => $(`#${base}_${i}`).removeClass('sno'));
            $(`#${base}_streetVendor`).addClass('aadhar-radio-disable');
        }
        custTypeIncomeDtls = entry[cfg.ownedKey];
        TempImageObject = {
                index: id,
                Type: cfg.type
        };
        apz.app.BusinessIncome.paintDocumentName(cfg.doc);
        selectedVal = entry.addressSameAs;
        apz.app.BusinessIncome.paintAddressOptions(id, selectedVal);
        if (cfg.type === "Other") {
        $(`#${base}_otherLineofBussRow`).removeClass('sno');
        let otherVal = entry[cfg.val1];
            if (otherVal && otherVal !== "Please Select" && otherVal !== "Select") {
            $(`#${base}_O_OthLineOfBus_drop`).val(otherVal).change();
            } else {
                // Reset dropdown to default (like initial page load)
                $(`#${base}_O_OthLineOfBus_drop`).prop('selectedIndex', 0).change();
            }   
        } else if (cfg.type === "Kirana") {
            $(`#${base}_streetVendorRow, #${base}_K-TypeofshopRow`).removeClass('sno');
            let shopVal = entry[cfg.val1];
            if (shopVal && shopVal !== "Please Select" && shopVal !== "Select") {
                // Set only valid value
                $(`#${base}_K-Typeofshop`).val(shopVal).change();
            } else {
                // Reset dropdown to default
                $(`#${base}_K-Typeofshop`).prop('selectedIndex', 0).change();
            }
        }
        let sv = entry?.[cfg.val3];
        if (sv !== undefined && sv !== null && sv !== "") {
            let el = document.getElementById(`${base}_streetVendor_option_${sv}`);
            if (el) el.checked = true;
        } else {
            // Reset radio/checkbox selection (like initial state)
            $(`input[name="${base}_streetVendor"]`).prop('checked', false);
        }
    }
    );
    // apz.app.BusinessIncome.disableDeleteButtons();
    apz.app.BusinessIncome.getSelectedBusinessTypes();
    // Update numberOfBusinessCount to match the actual number of loaded businesses
    numberOfBusinessCount = id;
    for (let i = 1; i < numberOfBusinessCount; i++) {
        $(`#${kmScrId + i}_DeleteIcon_ul`).removeClass('sno');
        ApzCOB.addDisableToInput(`${kmScrId + i}_DeleteIcon`);
    }
    if (!FinalvaluesArr) return;
    Object.keys(config).forEach(key => {
        if (payload?.business?.[key]?.length > 0 && FinalvaluesArr?.[key]?.length === 0) {
            FinalvaluesArr[key] = payload.business[key];
        }
    });
    if (combinedEntries.length < 11) {
        $(`#${kmScrId}addBusinessRowForm`).removeClass("sno");
    }
    else {
        $(`#${kmScrId}addBusinessRowForm`).addClass("sno");
    }
};
apz.app.BusinessIncome.AgriData = function () {
    if (!inSessionStore?.bcmpiIncomeDetails) return;
    const payload = JSON.parse(inSessionStore.bcmpiIncomeDetails.payload);
    const agriData = payload?.agriculture;
    if (!agriData || Object.keys(agriData).length === 0) return;
    $(`#${kmScrId}AgricultureTypeOption`).prop("checked", true);
    $(`#${kmScrId}Agriculture`).removeClass("sno");
    const hasApplicant = !!agriData.applicant;
    const hasCoApplicant = !!agriData.coApplicant;
    const paintDoc = (role) => {
        TempImageObject = { index: role, Type: "Agriculture" };
        apz.app.BusinessIncome.paintDocumentName("Agriculture Doc");
    };
    if (hasApplicant && hasCoApplicant) {
        $(`#${kmScrId}Agri_Owned_option_Both`).prop("checked", true);
        $(`#${kmScrId}Agriculture #${kmScrId}Applicant, #${kmScrId}Agriculture #${kmScrId}Co-Applicant`).removeClass("sno");
        $(`#${kmScrId}Agri_DeclaredIncome`).val(agriData.applicant?.declaredIncome === "0" ? "" : agriData.applicant?.declaredIncome);
        apz.app.BusinessIncome.customIndianRupeeFormat($(`#${kmScrId}Agri_DeclaredIncome`)[0]);
        $(`#${kmScrId}Co_Agri_DeclaredIncome`).val(agriData.coApplicant?.declaredIncome === "0" ? "" : agriData.coApplicant?.declaredIncome);
        apz.app.BusinessIncome.customIndianRupeeFormat($(`#${kmScrId}Co_Agri_DeclaredIncome`)[0]);
        ["Applicant", "Co-Applicant"].forEach(paintDoc);
    } else if (hasApplicant) {
        $(`#${kmScrId}Agri_Owned_option_Applicant`).prop("checked", true);
        $(`#${kmScrId}Agriculture #${kmScrId}Applicant`).removeClass("sno");
        $(`#${kmScrId}Agri_DeclaredIncome`).val(agriData.applicant?.declaredIncome === "0" ? "" : agriData.applicant?.declaredIncome);
        apz.app.BusinessIncome.customIndianRupeeFormat($(`#${kmScrId}Agri_DeclaredIncome`)[0]);
        paintDoc("Applicant");
    } else if (hasCoApplicant) {
        $(`#${kmScrId}Agri_Owned_option_Co-Applicant`).prop("checked", true);
        $(`#${kmScrId}Agriculture #${kmScrId}Co-Applicant`).removeClass("sno");
        $(`#${kmScrId}Co_Agri_DeclaredIncome`).val(agriData.coApplicant?.declaredIncome === "0" ? "" : agriData.coApplicant?.declaredIncome);
        apz.app.BusinessIncome.customIndianRupeeFormat($(`#${kmScrId}Co_Agri_DeclaredIncome`)[0]);
        paintDoc("Co-Applicant");
    }
};
apz.app.BusinessIncome.SalaryData = function() {
    const salaryData = JSON.parse(inSessionStore.bcmpiIncomeDetails.payload).salary;
    if (!salaryData || Object.keys(salaryData).length === 0) return;
    $(`#${kmScrId}SalaryTypeOption`).prop("checked", true);
    $(`#${kmScrId}Salary`).removeClass('sno');

    function populateSalary(roleKey, roleLabel, fieldSuffix) {
        if (!salaryData.hasOwnProperty(roleKey)) return;
        $(`#${kmScrId}Salary #${kmScrId}${roleLabel}`).removeClass("sno");
        apz.setElmValue(kmScrId + fieldSuffix, salaryData[roleKey].netSalary === "0" ? "" : salaryData[roleKey].netSalary);
        apz.app.BusinessIncome.customIndianRupeeFormat($(`#${kmScrId}${fieldSuffix}`)[0]);
        TempImageObject = {
            index: roleLabel,
            Type: "Salary"
        };
        apz.app.BusinessIncome.paintDocumentName("Salary Doc");
    }
    if (salaryData.applicant && salaryData.coApplicant) {
        $(`#${kmScrId}Salary_Owned_option_Both`).prop("checked", true);
        populateSalary("applicant", "Applicant", "NetSal");
        populateSalary("coApplicant", "Co-Applicant", "NetSalCo");
    } else if (salaryData.applicant) {
        $(`#${kmScrId}Salary_Owned_option_Applicant`).prop("checked", true);
        populateSalary("applicant", "Applicant", "NetSal");
    } else if (salaryData.coApplicant) {
        $(`#${kmScrId}Salary_Owned_option_Co-Applicant`).prop("checked", true);
        populateSalary("coApplicant", "Co-Applicant", "NetSalCo");
    }
};
apz.app.BusinessIncome.WageData = function() {
    const applicantJobs = ['other'];
    const wageData = JSON.parse(inSessionStore.bcmpiIncomeDetails.payload).wage;
    if (apz.isNull(wageData) || Object.keys(wageData).length === 0) return;
    $(`#${kmScrId}WageTypeOption`).prop("checked", true);
    $(`#${kmScrId}Wage`).removeClass('sno');

    function populateWage(ownerKey, prefix, sectionName) {
        if (!wageData.hasOwnProperty(ownerKey)) return;
        $(`#${kmScrId}Wage #${kmScrId}${sectionName}`).removeClass("sno");
        applicantJobs.forEach(job => {
            if (!wageData[ownerKey].hasOwnProperty(job)) return;
            let activtyType = job.replace(/([a-z])([A-Z])/g, '$1_$2').replace(/^./, c => c.toUpperCase());
            activtyType = activtyType.charAt(0).toUpperCase() + activtyType.slice(1);
            activtyType = (activtyType === 'Other') ? '0' : activtyType;
            let val = prefix + activtyType;
            $(`#${kmScrId}ToTalWagePerMonth_${val}`).val(wageData[ownerKey][job].selfDeclaredWage === "0" ? "" : wageData[ownerKey][job].selfDeclaredWage);
            apz.app.BusinessIncome.customIndianRupeeFormat($(`#${kmScrId}ToTalWagePerMonth_${val}`)[0]);
        });
    }
    if (wageData.applicant && wageData.coApplicant) {
        $(`#${kmScrId}WageOwn_Owned_option_Both`).prop("checked", true);
        populateWage("applicant", "App_", "Applicant");
        populateWage("coApplicant", "Co_", "Co-Applicant");
    } else if (wageData.applicant) {
        $(`#${kmScrId}WageOwn_Owned_option_Applicant`).prop("checked", true);
        populateWage("applicant", "App_", "Applicant");
    } else if (wageData.coApplicant) {
        $(`#${kmScrId}WageOwn_Owned_option_Co-Applicant`).prop("checked", true);
        populateWage("coApplicant", "Co_", "Co-Applicant");
    }
};
