apz.app.BusinessIncome.ConvertToInt = function(Value) {
    return Value === "" ? 0 : parseInt(ApzCOB.fn_unFormatAmount(Value))
};
apz.app.BusinessIncome.validateEachIncomeSources = function(incType, showErrMsg, isSaveDraft) {
    const config = incomeConfig[incType];
    const owner = $(`#${kmScrId + config.radio} input:checked`).val();
    if (!owner) {
        if (!isSaveDraft && showErrMsg) {
            ApzCOB.fnDisplayMsg(`Please select ${incType} ${incType === "Agriculture" ? "Owned by!" : "Earned by"}`, "E");
        }
        return isSaveDraft ? true : false;
    }
    const getVal = (id) => apz.app.BusinessIncome.formatAndUnformat($(`#${kmScrId + id}`).val());
    const applicantIncome = getVal(config.applicant);
    const coApplicantIncome = getVal(config.coApplicant);
    const buildObj = (role, value) => {
        // if (!result[incType]) result[incType] = {};
        // if (!result[incType][role]) result[incType][role] = {};
        switch (incType) {
            case "Wage":
                if (!FinalvaluesArr.wage) FinalvaluesArr['wage'] = {};
                FinalvaluesArr['wage'][role] = {
                    other: {
                        selfDeclaredWage: value
                    }
                };
                break;
            case "agriculture":
            case "Agriculture":
                if (!FinalvaluesArr.agriculture) FinalvaluesArr['agriculture'] = {};
                FinalvaluesArr['agriculture'][role] = {
                    declaredIncome: value
                };
                break;
            case "Salary":
                if (!FinalvaluesArr.salary) FinalvaluesArr['salary'] = {};
                FinalvaluesArr['salary'][role] = {
                    netSalary: value
                };
                break;
            case "Rentalincome":
                if (!FinalvaluesArr.rentalIncome) FinalvaluesArr['rentalIncome'] = {};
                FinalvaluesArr['rentalIncome'][role] = {
                    monthlyRentalIncome: value
                };
                break;
            case "Pension":
                if (!FinalvaluesArr.pension) FinalvaluesArr['pension'] = {};
                FinalvaluesArr['pension'][role] = role === "applicant" ? {
                    applicantPensionIncome: value
                } : {
                    coApplicantPensionIncome: value
                };
                break;
        }
    };
    if (owner === "Applicant") {
        if (!isSaveDraft && !applicantIncome) {
            if (showErrMsg) ApzCOB.fnDisplayMsg(`Please enter Applicant ${incType} income`, "E");
            return false;
        }
        buildObj("applicant", applicantIncome || 0);
    } else if (owner === "Co-Applicant") {
        if (!isSaveDraft && !coApplicantIncome) {
            if (showErrMsg) ApzCOB.fnDisplayMsg(`Please enter Co-Applicant ${incType} income`, "E");
            return false;
        }
        buildObj("coApplicant", coApplicantIncome || 0);
    } else if (owner === "Both") {
        if (!isSaveDraft && !applicantIncome) {
            if (showErrMsg) ApzCOB.fnDisplayMsg(`Please enter Applicant ${incType} income`, "E");
            return false;
        }
        if (!isSaveDraft && !coApplicantIncome) {
            if (showErrMsg) ApzCOB.fnDisplayMsg(`Please enter Co-Applicant ${incType} income`, "E");
            return false;
        }
        buildObj("applicant", applicantIncome || 0);
        buildObj("coApplicant", coApplicantIncome || 0);
    }
    return true;
};
apz.app.BusinessIncome.validateIncomeSources = function(isSaveDraft,showErr) {
    let errlength = 0;
    let TypesSelected = [];
    const checkboxes = document.querySelectorAll(`#${kmScrId}sourceofincomesec input[type="checkbox"]:checked`);
     if (checkboxes.length === 0) {
        return -1; 
    }
    checkboxes.forEach(cb => {
        TypesSelected.push(cb.id.split("_")[4]);
    });
    TypesSelected.forEach(type => {
        type = type.replace('TypeOption', '');
        if (!type || type === 'business') return;
        const isValid = apz.app.BusinessIncome.validateEachIncomeSources(type, false, isSaveDraft);
        if (!isValid) {
            errlength++;
            $(`#${kmScrId + type}`).addClass('inc-err-highlight');
        }
    });
    return errlength;
}
apz.app.BusinessIncome.validateBusiness = function(Index) {
    let obj = {
        "netBusinessIncome": apz.app.BusinessIncome.ConvertToInt($("#" + kmScrId + "NetBusinessIncome").val())
    };
    var netIncome = $("#" + kmScrId + "O_NetBusInc").val();
    if (netIncome < 0) {
        ApzCOB.fnDisplayMsg("Net monthly income cannot be negative.", "E");
        return;
    }
    AllValues.Other.push(obj);
    let Radioval = apz.app.BusinessIncome.ValidateRadioButton("O_Bus_Pre", "OwnOther", "Other");
    AllValues.Other.push(Radioval);
    $("#" + kmScrId + FinalIndex + "_businessTypeSec").removeClass("sno");
    $("#" + kmScrId + FinalIndex + "_businessImgSec").removeClass("sno");
    $("#" + kmScrId + FinalIndex + "_addBusinessDetails_ul").addClass("sno");
    if (IsEditFlow) {
        let FinalIn = EditIndex - 1;
        FinalvaluesArr.Other[FinalIn] = Array.isArray(AllValues.Other) ? Object.assign({}, ...AllValues.Other) : AllValues.Other;
        AllValues.Other = Array.isArray(AllValues.Other) ? Object.assign({}, ...AllValues.Other) : AllValues.Other;
        IsEditFlow = false;
    } else {
        AllValues.Other = Array.isArray(AllValues.Other) ? Object.assign({}, ...AllValues.Other) : AllValues.Other;
        FinalvaluesArr.Other.push(AllValues.Other);
    }
    var index = FinalvaluesArr.Other.length;
    if ($('#KmSourc__BusinessIncome__' + FinalIndex + '_businessOwnedByOption_option_Applicant').prop('checked')) {
        FinalvaluesArr.Other[index - 1].otherType = 'Applicant'
    } else if ($('#KmSourc__BusinessIncome__' + FinalIndex + '_businessOwnedByOption_option_Co-Applicant').prop('checked')) {
        FinalvaluesArr.Other[index - 1].otherType = 'Co-Applicant'
    } else if ($('#KmSourc__BusinessIncome__' + FinalIndex + '_businessOwnedByOption_option_Both').prop('checked')) {
        FinalvaluesArr.Other[index - 1].otherType = 'Both'
    }
    $("#" + kmScrId + FinalIndex + "_businessLbl1").val(AllValues.Other.lineOfOtherBusiness);
    $("#" + kmScrId + FinalIndex + "_businessLbl2").val(AllValues.Other.netBusinessIncome);
    $("#" + kmScrId + FinalIndex + "_viewBusinessDetails_ul").removeClass("sno");
    // $("#" + kmScrId + FinalIndex + "_DeleteIcon_ul").removeClass("sno");
    // ApzCOB.toggleModal(`${kmScrId}${'Other'}`);
    // apz.app.BusinessIncome.disableDeleteButtons();
    apz.app.BusinessIncome.getSelectedBusinessTypes();
    $('#KmSourc__BusinessIncome__' + FinalIndex + '_businessOwnedByOption input[type="radio"]').prop('disabled', true);
    $('#KmSourc__BusinessIncome__' + FinalIndex + '_businessTypeOption input[type="radio"]').prop('disabled', true);
}
apz.app.BusinessIncome.ValidateDropDown = function(AllDropdowns, Type, index) {
    AllValues = {};
    AllValues[Type] = [];
    var kiranaIDMap = {
        "K-Typeofshop": "kiranaShopType"
    }
    var otherIDMap = {
        "O_OthLineOfBus_drop": "lineOfOtherBusiness",
    }
    if (Type === 'Kirana' || Type === 'Other') {
        for (var i = 0; i < AllDropdowns.length; i++) {
            var item = AllDropdowns[i];
            var $el = $("#" + item.id);
                var value = $('#' + item.id).val();
                let shortId = item.id.split("__")[2];
                if (!value || value === 'Please Select') {
                    ApzCOB.fnDisplayMsg(item.errorMsg, "E");
                    return false;
                } else {
                    let Id = shortId;
                    let key;
                    if (Type === "dairy") {
                        key = dairyIDMap[Id];
                    } else if (Type === "Kirana") {
                        key = kiranaIDMap[Id];
                    } else if (Type === "Tailoring") {
                        key = tailoringIDMap[Id];
                    } else if (Type === "Other") {
                        key = otherIDMap[Id];
                    }
                    let obj = {
                        [key]: value
                    };
                    AllValues[Type].push(obj);
                }
        }
    } else {
        for (var i = 0; i < AllDropdowns.length; i++) {
            var item = AllDropdowns[i];
            var $el = $("#" + item.id);
                var value = apz.getElmValue(item.id);
                if (!value || value === 'Please Select') {
                    ApzCOB.fnDisplayMsg(item.errorMsg, "E");
                    return false; // Stop at first invalid field
                } else {
                    let key = item.id.split("__")[2];
                    let obj = {
                        [
                            key
                        ]: value
                    };
                    AllValues[Type].push(obj);
                }
        }
    }
    //Add condition for Address proof type is selected
    return true; // All visible dropdowns are valid
};
apz.app.BusinessIncome.customIndianRupeeFormat = function(obj, decimalPoints = 2) {
    var value = obj.value;
    if (!value) return;
    // remove commas
    value = value.replace(/,/g, '');
    // validate number
    if (isNaN(value)) {
        obj.value = '';
        return;
    }
    var num = parseFloat(value);
    // format number with commas and decimals
    var formatted = num.toLocaleString('en-IN', {
        minimumFractionDigits: decimalPoints,
        maximumFractionDigits: decimalPoints
    });
    obj.value = formatted;
};
apz.app.BusinessIncome.validateOnclickNext = function(isSaveDraft) {
    let proceedWithBusiness = false;
    let bussCounts = $("[id^='KmSourc__BusinessIncome__CloneRow_']:visible").length;
    const isVisheshProduct =  (gApzCOB.SelectedProductName === "Vishesh" || gApzCOB.SelectedProductName === "Unnati Lite") && gApzCOB.productCode === "1003";
    if (bussCounts > 0) {
        proceedWithBusiness = apz.app.BusinessIncome.validatePreviousBusiness(bussCounts, true, isSaveDraft);
        /*if (!proceedWithBusiness) {
            return false;
        }*/
    } else if(bussCounts === 0 && !isSaveDraft && !isVisheshProduct) {
        ApzCOB.fnDisplayMsg("At least one applicant must own a business to proceed. Please add a business before continuing.", "E");
        isBusinessNextButton = false;
        return false;
    }
    if(isVisheshProduct){
        proceedWithBusiness = true;
    }
    let otherIncSrc = apz.app.BusinessIncome.validateIncomeSources(isSaveDraft);
    if (otherIncSrc > 0 && !isSaveDraft) {
        ApzCOB.fnDisplayMsg(`Please complete the details for the highlighted source(s) of income.`, "E");
        isBusinessNextButton = false;
        return false;
    } else if (!proceedWithBusiness && !isSaveDraft) {
        ApzCOB.fnDisplayMsg(`Please complete the details for the highlighted source(s) of income.`, "E");
        isBusinessNextButton = false;
        return false;
    } else if (!isSaveDraft && !apz.app.Kmbase.validateQueryResponse()){
        isBusinessNextButton = false;
        return false;
    }else if(otherIncSrc === -1 && isVisheshProduct){
        ApzCOB.fnDisplayMsg("Please select at least one source of income.", "E");
        isBusinessNextButton = false;
    return false;
    }
    if ((proceedWithBusiness && otherIncSrc === 0) || isSaveDraft) {
        apz.app.BusinessIncome.submitIncomeService(isSaveDraft);
    }
};
apz.app.BusinessIncome.submitIncomeService = function(isSaveDraft) {
    let bcmpiIncomeDetailsWrapper = {
        "business": {}
    };
    for (let key in FinalvaluesArr) {
        if (["dairy", "Tailoring", "Kirana", "Other"].includes(key)) {
            bcmpiIncomeDetailsWrapper.business[key] = FinalvaluesArr[key];
        } else {
            bcmpiIncomeDetailsWrapper[key] = FinalvaluesArr[key];
        }
    }
    incomeDetailsWrapper = bcmpiIncomeDetailsWrapper;
    // Store income details in inSessionStore for draft persistence
    inSessionStore.bcmpiIncomeDetails = {
        payload: JSON.stringify(bcmpiIncomeDetailsWrapper)
    };
    if (isSaveDraft) {
        apz.app.Kmbase.createLoan(KM_CURR_STAGE_NAME, KM_CURR_STAGE_NO);
        return;
    }
    // businessesSelectedInSourcing = apz.app.BusinessIncome.businessesSelectedInSourcing();
    // if (!businessesSelectedInSourcing) {
    //     return;
    // }
    validateIncome = true;
    validateSumOfAppCoAppIncome = true;
    apz.app.BusinessIncome.businessIncomeValidation();
    if (validateIncome && validateSumOfAppCoAppIncome) {
        /*$("#KmSourc__Kmbase__OtherInformation_hyp").removeClass("disabled-sidebar");
        $("#KmSourc__Kmbase__OtherInformation_hyp").attr("onclick", "apz.app.Kmbase.NavigateSidebar(4, this)");
        $("#KmSourc__Kmbase__OtherInformation_hyp").click();
        apz.app.Kmbase.addCompleteStatus('KmSourc__Kmbase__BusinessIncome_hyp');*/
        apz.app.Kmbase.createLoan(KM_CURR_STAGE_NAME, KM_CURR_STAGE_NO);
    }
};
apz.app.BusinessIncome.businessIncomeValidation = function() {
    validateIncome = false;
    validateSumOfAppCoAppIncome = false;
    sumOfBusiness = 0,sumOfSelfDeclBusiness=0,sumOfRentalPensionAgri = 0, sumOfDeclRentalPenionAgri = 0; rentalIncome = 0, declRentalIncome = 0,
        agriIncome = 0,
        declAgriIncome = 0,
        pensionIncome = 0,
        dairyIncome = 0,
        dairySelfDeclIncome =0,
        kiranaIncome = 0,
        kiranaSelfDeclIncome =0,
        tailoringIncome = 0,
        tailoringSelfDeclIncome =0,
        otherIncome = 0,
        salaryIncome = 0,
        wageIncome = 0,
        declWageIncome = 0;
    var rental, agri, pension, wage, salary, dairy, kirana, tailoring, other;
    const jobTypes = ['constructions', 'contractLabour', 'farmWorker', 'hotelWorker', 'maid', 'other'];
    if ($(`#KmSourc__BusinessIncome__RentalincomeTypeOption`).prop("checked")) {
        if (Object.keys(FinalvaluesArr?.rentalIncome || {}).length > 0) {
            rental = FinalvaluesArr.rentalIncome
        } else {
            rental = JSON.parse(inSessionStore?.bcmpiIncomeDetails?.payload || '{}')?.rentalIncome;
        }
    }
    if ($(`#KmSourc__BusinessIncome__AgricultureTypeOption`).prop("checked")) {
        if (Object.keys(FinalvaluesArr?.agriculture || {}).length > 0) {
            agri = FinalvaluesArr.agriculture
        } else {
            agri = JSON.parse(inSessionStore?.bcmpiIncomeDetails?.payload || '{}')?.agriculture;
        }
    }
    if ($(`#KmSourc__BusinessIncome__PensionTypeOption`).prop("checked")) {
        if (Object.keys(FinalvaluesArr?.pension || {}).length > 0) {
            pension = FinalvaluesArr.pension
        } else {
            pension = JSON.parse(inSessionStore?.bcmpiIncomeDetails?.payload || '{}')?.pension;
        }
    }
    if ($(`#KmSourc__BusinessIncome__WageTypeOption`).prop("checked")) {
        if (Object.keys(FinalvaluesArr?.wage || {}).length > 0) {
            wage = FinalvaluesArr.wage
        } else {
            wage = JSON.parse(inSessionStore?.bcmpiIncomeDetails?.payload || '{}')?.wage;
        }
    }
    if ($(`#KmSourc__BusinessIncome__SalaryTypeOption`).prop("checked")) {
        if (Object.keys(FinalvaluesArr?.salary || {}).length > 0) {
            salary = FinalvaluesArr.salary
        } else {
            salary = JSON.parse(inSessionStore?.bcmpiIncomeDetails?.payload || '{}')?.salary;
        }
    }
    if ($(`#KmSourc__BusinessIncome__businessTypeOption`).prop("checked")) {
        if (FinalvaluesArr?.dairy?.length > 0) {
            dairy = FinalvaluesArr.dairy
        } else if (!Object.values(deletedBusinessIndexes).includes("dairy")) {
            dairy = JSON.parse(inSessionStore?.bcmpiIncomeDetails?.payload || '{}')?.business?.dairy;
        }
        if (FinalvaluesArr?.Kirana?.length > 0) {
            kirana = FinalvaluesArr.Kirana
        } else if (!Object.values(deletedBusinessIndexes).includes("Kirana")) {
            kirana = JSON.parse(inSessionStore?.bcmpiIncomeDetails?.payload || '{}')?.business?.Kirana;
        }
        if (FinalvaluesArr?.Tailoring?.length > 0) {
            tailoring = FinalvaluesArr.Tailoring
        } else if (!Object.values(deletedBusinessIndexes).includes("Tailoring")) {
            tailoring = JSON.parse(inSessionStore?.bcmpiIncomeDetails?.payload || '{}')?.business?.Tailoring;
        }
        if (FinalvaluesArr?.Other?.length > 0) {
            other = FinalvaluesArr.Other
        } else if (!Object.values(deletedBusinessIndexes).includes("Other")) {
            other = JSON.parse(inSessionStore?.bcmpiIncomeDetails?.payload || '{}')?.business?.Other;
        }
    }
    /*if (rental?.applicant?.consideredMonthlyIncome) {
        rentalIncome += parseFloat(rental.applicant.consideredMonthlyIncome);
    }
    if (rental?.coApplicant?.consideredMonthlyIncome) {
        rentalIncome += parseFloat(rental.coApplicant.consideredMonthlyIncome);
    }*/
    if (rental?.applicant?.monthlyRentalIncome) {
        declRentalIncome += parseFloat(rental.applicant.monthlyRentalIncome);
    }
    if (rental?.coApplicant?.monthlyRentalIncome) {
        declRentalIncome += parseFloat(rental.coApplicant.monthlyRentalIncome);
    }
    if (pension?.applicant?.applicantPensionIncome) {
        pensionIncome += parseFloat(pension.applicant.applicantPensionIncome);
    }
    if (pension?.coApplicant?.coApplicantPensionIncome) {
        pensionIncome += parseFloat(pension.coApplicant.coApplicantPensionIncome);
    }
    /*if (agri?.applicant?.monthlyIncome) {
        agriIncome += parseFloat(agri.applicant.consideredIncome);
    }
    if (agri?.coApplicant?.monthlyIncome) {
        agriIncome += parseFloat(agri.coApplicant.consideredIncome);
    }*/
    if (agri?.applicant?.declaredIncome) {
        declAgriIncome += parseFloat(agri.applicant.declaredIncome);
    }
    if (agri?.coApplicant?.declaredIncome) {
        declAgriIncome += parseFloat(agri.coApplicant.declaredIncome);
    }
    /*if (wage?.applicant) {
        jobTypes.forEach(type => {
            const income = wage.applicant?.[type]?.totalWagePerMonth;
            if (income) {
                wageIncome += parseFloat(income);
            }
        });
    }
    if (wage?.coApplicant) {
        jobTypes.forEach(type => {
            const income = wage.coApplicant?.[type]?.totalWagePerMonth;
            if (income) {
                wageIncome += parseFloat(income);
            }
        });
    }*/
    if (wage?.applicant) {
        jobTypes.forEach(type => {
            const income = wage.applicant?.[type]?.selfDeclaredWage;
            if (income) {
                declWageIncome += parseFloat(income);
            }
        });
    }
    if (wage?.coApplicant) {
        jobTypes.forEach(type => {
            const income = wage.coApplicant?.[type]?.selfDeclaredWage;
            if (income) {
                declWageIncome += parseFloat(income);
            }
        });
    }
    if (salary?.applicant?.netSalary) {
        salaryIncome += parseFloat(salary.applicant.netSalary);
    }
    if (salary?.coApplicant?.netSalary) {
        salaryIncome += parseFloat(salary.coApplicant.netSalary);
    }
    /*if (dairy?.length > 0) {
        dairy.forEach(item => {
            dairyIncome += Number(item?.IncomeAssessmentChecknetBusinessIncome || 0);
        });
    }*/
    if (dairy?.length > 0) {
        dairy.forEach(item => {
            dairySelfDeclIncome += Number(item?.netMonthlyIncome || 0);
        });
    }
    /*if (kirana?.length > 0) {
        kirana.forEach(item => {
            kiranaIncome += Number(item?.finalNetIncome || 0);
        });
    }*/
    if (kirana?.length > 0) {
        kirana.forEach(item => {
            kiranaSelfDeclIncome += Number(item?.netMonthlyIncome || 0);
        });
    }
    /*if (tailoring?.length > 0) {
        tailoring.forEach(item => {
            tailoringIncome += Number(item?.netBusinessIncome || 0);
        });
    }*/
    if (tailoring?.length > 0) {
        tailoring.forEach(item => {
            tailoringSelfDeclIncome += Number(item?.netMonthlyIncome || 0);
        });
    }
    if (other?.length > 0) {
        other.forEach(item => {
            otherIncome += Number(item?.netBusinessIncome || 0);
        });
    }
    sumOfRentalPensionAgri = rentalIncome + pensionIncome + agriIncome;
    sumOfBusiness = dairyIncome + kiranaIncome + tailoringIncome + otherIncome;
    const maxAllowedIncome = sumOfBusiness * 0.5;
    /*if (sumOfRentalPensionAgri > maxAllowedIncome) {
        ApzCOB.fnDisplayMsg("The net calculated income from Rental, Pension, and Agriculture should not exceed 50% of the main business income.", "E");
        validateIncome = false;
    } else {
        validateIncome = true;
    }*/
   const isVisheshProduct =  (gApzCOB.SelectedProductName === "Vishesh" || gApzCOB.SelectedProductName === "Unnati Lite") && gApzCOB.productCode === "1003";
    sumOfSelfDeclBusiness = dairySelfDeclIncome + kiranaSelfDeclIncome + tailoringSelfDeclIncome + otherIncome + declWageIncome + salaryIncome;
    sumOfDeclRentalPenionAgri = declRentalIncome + pensionIncome + declAgriIncome;
    const maxAllowedSelfDeclIncome = sumOfSelfDeclBusiness * 0.5;
    if (sumOfDeclRentalPenionAgri > maxAllowedSelfDeclIncome && !isVisheshProduct) {
        ApzCOB.fnDisplayMsg("The self declared income from Rental, Pension, and Agriculture should not exceed 50% of the main business income.", "E");
        validateIncome = false;
    } else {
        validateIncome = true;
    }
    // var totalMonthlyIncome = dairyIncome + kiranaIncome + tailoringIncome + otherIncome + agriIncome + salaryIncome + wageIncome + pensionIncome + rentalIncome;
    var totalMonthlyIncome = dairySelfDeclIncome + kiranaSelfDeclIncome + tailoringSelfDeclIncome + otherIncome + declAgriIncome + salaryIncome + declWageIncome + pensionIncome + declRentalIncome;
    var annualIncome = totalMonthlyIncome * 12;
    if (annualIncome > 1200000) {
        validateSumOfAppCoAppIncome = false;
        ApzCOB.fnDisplayMsg("The net monthly income added is " + `Rs.${totalMonthlyIncome.toLocaleString('en-IN')}/-` +
            " Net monthly income must be less than Rs.1,00,000/- per month.", "E");
    } else if (annualIncome < 300001) {
        validateSumOfAppCoAppIncome = false;
        ApzCOB.fnDisplayMsg("The net monthly income added is " + `Rs.${totalMonthlyIncome.toLocaleString('en-IN')}/-` +
            " Net monthly income must be greater than Rs.25,000/- per month.", "E");
    } else {
        validateSumOfAppCoAppIncome = true;
    }
};

apz.app.BusinessIncome.getbcmpiIncomeDetailsWrapper = function() {
    let bcmpiIncomeDetailsWrapper = {
        "business": {}
    };
    for (let key in FinalvaluesArr) {
        if (["dairy", "Tailoring", "Kirana", "Other"].includes(key)) {
            bcmpiIncomeDetailsWrapper.business[key] = FinalvaluesArr[key];
        } else {
            bcmpiIncomeDetailsWrapper[key] = FinalvaluesArr[key];
        }
    }
    return bcmpiIncomeDetailsWrapper;
}
apz.app.BusinessIncome.addressDetailsWrapperList = function() {
    let getExistingOccAddr = inSessionStore.addressDetailsWrapperList[0].addressDetailsList.filter(el => el.addressType == 'Occupation') || [];
    if (getExistingOccAddr.length === 0) {
        let addressDetObj = {
            "appId": "APZCBO",
            "applicationId": inSessionStore.applicationMaster.applicationId,
            "addressDtlsId": '',
            "custDtlId": ApzCOB.getCustDetailID('Applicant'),
            "addressType": "Occupation",
            "payload": {
                "addressList": apz.app.BusinessIncome.getAddressList()
            }
        }
        inSessionStore.addressDetailsWrapperList[0].addressDetailsList.push(addressDetObj);
    } else {
        getIndex = inSessionStore.addressDetailsWrapperList[0].addressDetailsList.findIndex(el => el.addressType == 'Occupation' && el.custDtlId == ApzCOB.getCustDetailID('Applicant'));
        if (getIndex !== -1) {
            inSessionStore.addressDetailsWrapperList[0].addressDetailsList[getIndex].payload.addressList = apz.app.BusinessIncome.getAddressList();
        }
    }
    return inSessionStore.addressDetailsWrapperList;
};
apz.app.BusinessIncome.getAddressList = function() {
    var addressArr = [];
    let bussCounts = $("[id^='KmSourc__BusinessIncome__CloneRow_']:visible").length;
    if (bussCounts > 0) {
        for (let i = 1; i <= bussCounts; i++) {
            let addrSameAs = $(`#${kmScrId + i}_addressList .etb-rdio input[type="radio"]:checked`).val();
            if (!addrSameAs) continue;
            custType = addrSameAs.includes('Co-App') ? 'Co-App' : 'Applicant';
            addrType = 'Personal';
            subAddrType = addrSameAs.includes('Secondary') ? 'SecondaryKyc' : addrSameAs.replace(/Applicant|Co-App/g, '').trim();
            let addrProof = addrSameAs === 'Other' ? $(`#${kmScrId + i}_otherBussAddrProof`).val() : ApzCOB.getPayloadDatafromWrapper('currentAddressProof', custType, 'addressDetailsWrapperList');
            addrProof = (addrProof === PleaseSelect) ? '' : addrProof;
            addressArr.push({
                "businessIndex": i,
                "addressType": "Office",
                "addressSameAs": addrSameAs || '',
                "addressLine1": apz.app.BusinessIncome.getAddrNodeData(i, 'addressLine1', custType, addrSameAs),
                "addressLine2": apz.app.BusinessIncome.getAddrNodeData(i, 'addressLine2', custType, addrSameAs),
                "addressLine3": apz.app.BusinessIncome.getAddrNodeData(i, 'addressLine3', custType, addrSameAs),
                "pinCode": apz.app.BusinessIncome.getAddrNodeData(i, 'pinCode', custType, addrSameAs),
                "district": apz.app.BusinessIncome.getAddrNodeData(i, 'district', custType, addrSameAs),
                "city": apz.app.BusinessIncome.getAddrNodeData(i, 'city', custType, addrSameAs),
                "state": apz.app.BusinessIncome.getAddrNodeData(i, 'state', custType, addrSameAs),
                "country": apz.app.BusinessIncome.getAddrNodeData(i, 'country', custType, addrSameAs),
                "landMark": apz.app.BusinessIncome.getAddrNodeData(i, 'landMark', custType, addrSameAs),
                "area": apz.app.BusinessIncome.getAddrNodeData(i, 'area', custType, addrSameAs),
                "currentAddressProof": addrSameAs === 'Other' ? $(`#${kmScrId + i}_otherBussAddrProof`).val() : ApzCOB.getPayloadDatafromWrapper('currentAddressProof', custType, 'addressDetailsWrapperList'), //businessAddressProof
                "locateCoOrdinatesFor": '',
                "locateCoOrdinates": ''
            })
        }
    }
    return addressArr;
};
apz.app.BusinessIncome.getAddrNodeData = function(i, addrNode, custType, addrSameAs) {
    addrType = 'Personal';
    subAddrType = addrSameAs.includes('Secondary') ? 'SecondaryKyc' :addrSameAs.replace(/Applicant|Co-App/g, '').trim();
    let addrData = (addrSameAs === 'Other') ? $(`#${kmScrId + i}_otherBussAddr${addrNode}`).val() : ApzCOB.getPayloadDatafromWrapper(addrNode, custType, 'addressDetailsWrapperList');
    return addrData ?? '';
};
