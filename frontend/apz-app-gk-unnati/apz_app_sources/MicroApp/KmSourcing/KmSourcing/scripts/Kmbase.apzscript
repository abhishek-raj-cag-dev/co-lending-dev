apz.app.Kmbase.paintLoanDetails = function () {
    var existingLoanDtls = [];
    let existingLoansListSession = [];
    let existingLoansList = [];
    if (loanDtls.length > 0) {
        existingLoansList = loanDtls;
    } else {
        if (!apz.isNull(inSessionStore.existingLoanDetailsWrapperList) && inSessionStore.existingLoanDetailsWrapperList.length > 0) {
            if (inSessionStore.existingLoanDetailsWrapperList[0].hasOwnProperty("existingLoanDetailsList")) {
                existingLoansListSession = inSessionStore.existingLoanDetailsWrapperList[0].existingLoanDetailsList;
                if (existingLoansListSession.length > 0) {
                    existingLoansListSession.map(existLoan => {
                        let exObj = {};
                        exObj.loanType = JSON.parse(existLoan.payload).productType;
                        exObj.loanId = existLoan.existingLoanId;
                        exObj.loanAmt = "-";
                        exObj.outstandingAmt = JSON.parse(existLoan.payload).outstandingAmount;
                        existingLoansList.push(exObj);
                    });
                }
            }
        }
    }
    for (var i = 0; i < existingLoansList.length; i++) {
        if (existingLoansList[0].hasExistingLoans !== 'N') {
            var elem = {};
            let loanAmtVar = emptyValidation(existingLoansList[i].loanAmt);
            let outstandingAmtVar = emptyValidation(existingLoansList[i].outstandingAmt);
            elem.loanType = existingLoansList[i].loanType;
            elem.loanId = existingLoansList[i].loanId;
            elem.loanAmt = loanAmtVar == "-" ? "-" : '\u20B9' + ApzCOB.fn_FormatAmount(loanAmtVar ?? 0);
            elem.outstandingAmt = outstandingAmtVar == "-" ? "-" : '\u20B9' + ApzCOB.fn_FormatAmount(outstandingAmtVar ?? 0);
            existingLoanDtls.push(elem);
        }
    }

    exisLoanFlag = true;
    if (existingLoanDtls.length > 0) {
        apz.data.scrdata.KmSourc__IPaintLoanDetails_Res = existingLoanDtls;
        apz.data.loadData('IPaintLoanDetails', 'KmSourc');
        $(`#${kmbaseScr}existingLoans`).removeClass('sno');
        $(`#${kmbaseScr}noExistingLoans`).addClass('sno');
    } else {
        $(`#${kmbaseScr}existingLoans`).addClass('sno');
        $(`#${kmbaseScr}noExistingLoans`).removeClass('sno');
    }
};
apz.app.Kmbase.validateMaxDocs = function (parentSelector, childClass, pthis, docType) {
    TempImageObject.addressProofDesc = null;
    window._KM_ORIGINAL_DOC_TYPE = null;
    const docTypeMap = {
        "Aadhaar": {
            frontimg: "SECONDARY_KYC",
            backimg: "SECONDARY_KYC"
        },
        "Voter ID": {
            frontimg: "PRIMARY_KYC",
            backimg: "PRIMARY_KYC"
        },
        "PAN card": {
            frontimg: "PAN_NUMBER_PHOTO",
            backimg: "PAN_NUMBER_PHOTO"
        }
    };
    window.currentDocType = docType || docTypeMap?.[apz.app.docType]?.[childClass] || childClass;
    if (apz.childScr == 'OtherInformation') {
        window.othDoctyp = currentDocType
    }
    let p = AadhaarScrId;
    // ── ADDRESS_PROOF (present) ──
    if (currentDocType === "ADDRESS_PROOF") {
        let val = ($(`#${p}addressProof`).val() || "").trim();
        if (!val || val === PleaseSelect) {
            showFieldError(p + "addressProof", "Please select address Proof");
            $(`#${p}addressProof`)[0]?.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });
            return;
        }
        // Store desc prefix so saveDocument knows it's PRESENT
        TempImageObject.addressProofDesc = "PRESENT";
    }
    // ── ADDRESS_PROOF (permanent) — uses composite key internally ──
    if (currentDocType === "PERMANENT_ADDRESS_PROOF") {
        let val = ($(`#${p}permanentAddressProof`).val() || "").trim();
        if (!val || val === PleaseSelect) {
            showFieldError(p + "permanentAddressProof", "Please select address Proof");
            $(`#${p}permanentAddressProof`)[0]?.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });
            return;
        }
        window.currentDocType = "ADDRESS_PROOF";
        TempImageObject.addressProofDesc = "PERMANENT";
        window._KM_ORIGINAL_DOC_TYPE = "PERMANENT_ADDRESS_PROOF";
    }
    if (currentDocType === "RELATIONSHIP_PROOF") {
        let val = ($(`#${p}relationshipProof`).val() || "").trim();
        if (!val || val === PleaseSelect) {
            showFieldError(p + "relationshipProof", "Please select Relationship Proof document type before capturing");
            $(`#${p}relationshipProof`)[0]?.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });
            return;
        }
    }
    // ── Doc limit check ──
    // For ADDRESS_PROOF, filter by documentDesc (PRESENT / PERMANENT) to get correct count
    let max = '';
    if (currentDocType !== "ADDITIONAL_DOCS") {
        max = apz.app.Kmbase.getDocLimits(currentDocType);
    }
    let custDtlId = gApzCOB.currentApplicant === 1 ? gApzCOB.userDetails.custDtlId : gApzCOB.userDetails.CoApplicantCustomerId;
    let allDocs = (inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList || []);
    let docs;
    if (currentDocType === "ADDRESS_PROOF" && TempImageObject.addressProofDesc) {
        let descPrefix = TempImageObject.addressProofDesc; // "PRESENT" or "PERMANENT"
        docs = allDocs.filter(d => d.payload.documentType === "ADDRESS_PROOF" && parseInt(d.custDtlId) === parseInt(custDtlId) && (d.payload
            .documentDesc || "").toUpperCase() === descPrefix);
    } else {
        docs = allDocs.filter(d => d.payload.documentType === currentDocType && parseInt(d.custDtlId) === parseInt(custDtlId));
    }
    if (currentDocType === "SECONDARY_KYC") {
        let level = childClass === "backimg" ? "2" : "1";
        docs = docs.filter(d => d.payload.docLevel == level);
        max = 1;
    }
    if (currentDocType === "PAN_NUMBER_PHOTO") {
        let level = childClass === "backimg" ? "2" : "1";
        docs = docs.filter(d => d.payload.docLevel == level);
        max = 1;
    }
    if (currentDocType !== "ADDITIONAL_DOCS") {
        if (docs.length >= max.max) {
            // Only block if NOT a recapture attempt
            if (!window._KM_IS_RECAPTURE) {
                ApzCOB.fnDisplayMsg(`User allowed to upload maximum of ${max.max} documents`);
                return;
            }
        }
    }
    // Reset recapture flag after check
    window._KM_IS_RECAPTURE = false;
    TempImageObject.Type = currentDocType;
    TempImageObject.docSide = childClass === "backimg" ? "Back" : "Front";
    TempImageObject.docLevel = childClass === "backimg" ? "2" : "1";
    if (childClass === "COAPPLNT_CUST_NOMINEE_DOCS") {
        let nomineeDocs = allDocs.filter(d =>
            d.payload.documentType === currentDocType &&
            parseInt(d.custDtlId) === parseInt(custDtlId)
        );
        let hasFront = nomineeDocs.some(d => d.payload.docLevel == "1");
        let hasBack = nomineeDocs.some(d => d.payload.docLevel == "2");
        if (!hasFront) {
            TempImageObject.docSide = "Front";
            TempImageObject.docLevel = "1";
        } else if (!hasBack) {
            TempImageObject.docSide = "Back";
            TempImageObject.docLevel = "2";
        }
    }
    TempImageObject.index = "Applicant";
    apz.app.Kmbase.camera(pthis);
};
apz.app.Kmbase.camera = function (pthis) {
    var cameraObj = {
        "zoomLevel": "20",
        "targetWidth": "950",
        "targetHeight": "950",
        "crop": "Y",
        "cropBox": "rectangle",
        "flash": "N",
        "action": "base64_Save",
        "fileName": 'b',
        "quality": "75",
        "encodingType": "JPG",
        "sourceType": "camera"
    };
    cameraObj.id = "CAMERA_ID";
    cameraObj.callBack = apz.app.Kmbase.cameraCallback;
    cameraObj.callBack = ApzCOB.ImageClarity;
    window.cameraCBstr = apz.app.Kmbase.cameraCallback;
    window.cameraObj = cameraObj;
    apz.ns.openCamera(cameraObj);
    ApzCOB.getGeoCordinatesMobile();
};
apz.app.Kmbase.cameraCallback = function (params) {
    window.cameraCB = "";
    window.cameraObj = "";
    window.isApplicant = gApzCOB.currentApplicant === 1;
    window.window.custPrefix = isApplicant ? "Applicant" : "Co-applicant";
    window.docType = TempImageObject?.Type || "";
    window.docSide = TempImageObject?.docSide || "Front";
    window.kmfinalName = "Document";
    if (docType === "RESIDENCE_PREMISE_PHOTO") {
        kmfinalName = "Residence Photo";
    } else if (docType === "CUSTOMER_PHOTOGRAPH") {
        kmfinalName = `${custPrefix} Photo`;
    } else if (docType === "ADDRESS_PROOF") {
        // ── CHANGE: differentiate by TempImageObject.addressProofDesc ──
        let descPrefix = (TempImageObject.addressProofDesc || "").toUpperCase();
        if (descPrefix === "PERMANENT") {
            let selected = $("#" + AadhaarScrId + "permanentAddressProof").val()?.trim();
            kmfinalName = (selected && selected !== "Please Select") ? selected : "Permanent Address Proof";
        } else {
            // PRESENT (default)
            let selected = $("#" + AadhaarScrId + "addressProof").val()?.trim();
            kmfinalName = (selected && selected !== "Please Select") ? selected : "Address Proof";
        }
    } else if (docType === "RELATIONSHIP_PROOF") {
        let selected = $("#" + AadhaarScrId + "relationshipProof").val()?.trim();
        kmfinalName = (selected && selected !== "Please Select") ? selected : "Relationship Proof";
    } else if (docType === "SECONDARY_KYC") {
        kmfinalName = `Aadhaar ${docSide}`;
    } else if (docType === "PRIMARY_KYC") {
        kmfinalName = `Voter ${docSide}`;
    } else if (docType === "PAN_NUMBER_PHOTO") {
        kmfinalName = `PAN ${docSide}`;
    }
    //------------------------Swaroop KM sourcing Other Info----------------------
    else if (docType === "BANK_ACCOUNT_PROOF") {
        if (bankSelected === "Primary") { //16th june changes
            let selected = $("#" + kmScrId + "bankDetTypeOfDocument").val()?.trim();
            kmfinalName = (selected && selected !== "Please Select") ? selected : "Bank Proof";
        } else if (bankSelected === "Secondary") {
            let selected = $("#" + kmScrId + "changeBankTypeOfDoc").val()?.trim();
            kmfinalName = (selected && selected !== "Please Select") ? selected : "Bank Proof";
        }
    }
    // else if (docType === "CHANGED_BANK_DOCS") {
    //     let selected = $("#" + kmScrId + "changeBankTypeOfDoc").val()?.trim();
    //     kmfinalName = (selected && selected !== "Please Select") ? selected : "Bank Proof";
    else if (docType === "APPLNT_CUST_NOMINEE_DOCS") {
        kmfinalName = `KYC ${docSide}`;
    } else if (docType === "COAPPLNT_CUST_NOMINEE_DOCS") {
        kmfinalName = `KYC ${docSide}`;
    } else if (docType === "ADDITIONAL_DOCS") {
        window.isAdiDoc = 'Y'
        kmfinalName = $("#" + kmScrId + "nameOfAdditionalDoc").val()
    }
    if (clearScr > clarityThreshold || imgProceed) {
        apz.app.Kmbase.saveDocument(kmfinalName, imgClaritybase64);
    } else {
        ApzCOB.fnDisplayMsg("Clear score is not generated. Please upload the image again.", "E");
        return;
    }
};
apz.app.Kmbase.saveDocument = function (fileName, base64, originalPath) {
    if (!base64) return;
    if (!imgClearChk) return;
    let captureApplicant = (window.CAPTURE_FROM_APPLICANT != null) ? window.CAPTURE_FROM_APPLICANT : gApzCOB.currentApplicant;
    let captureCustDtlId = '';
    if (apz.childScr === 'OtherInformation') {
        captureCustDtlId = gApzCOB.userDetails.custDtlId;
    } else {
        captureCustDtlId = captureApplicant === 1 ? gApzCOB.userDetails.custDtlId : gApzCOB.userDetails.CoApplicantCustomerId;
    }
    let uniqueName = originalPath ? originalPath.split('/').pop() : (fileName + '_' + Date.now() + '.jpg');
    let fileNameWithExt = uniqueName.replace(' ', '_');
    let docLevel = "1",
        pusbackUpload = 'N',
        isAdiDoc = window.isAdiDoc;
    if (inSessionStore.applicationDocumentsWrapperList != null && inSessionStore.applicationDocumentsWrapperList.length > 0 && inSessionStore
        .applicationDocumentsWrapperList[0]?.applicationDocumentsList != null) {
        docLevel = ApzCOB.getNextDocLevel(`${TempImageObject?.Type}`, captureCustDtlId);
    }
    if (['IPUSHBACK', 'PUSHBACK'].includes(inSessionStore?.applicationMaster?.applicationStatus)) {
        pusbackUpload = "Y";
    }
    if (TempImageObject.docSide === "Front") {
        noOfAttempttriggered = FrontdocAttempt === 1 ? FrontdocAttempt : FrontdocAttempt - 1;
    } else {
        noOfAttempttriggered = BackdocAttempt === 1 ? BackdocAttempt : BackdocAttempt - 1;
    }
    let documentDesc = "";
    if (TempImageObject?.Type === "ADDRESS_PROOF") {
        documentDesc = (TempImageObject.addressProofDesc || "PRESENT").toUpperCase();
    }
    let docSide = TempImageObject?.docSide || "Front";
    var handleDocFileName = "";
    if (TempImageObject?.Type === 'ADDITIONAL_DOCS') {
        handleDocFileName = apz.app.OtherInformation.getUpdatedFileName(fileName?.replace(' ', '_') + '.jpeg', inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList)
    } else if (["PAN_NUMBER_PHOTO", "PRIMARY_KYC", "SECONDARY_KYC"].includes(docType)) {
        handleDocFileName = fileName?.replace(' ', '_') + '_' + (isApplicant ? "App" : "CoApp") + '.jpeg'
    } else {
        handleDocFileName = fileNameWithExt;
    }
    let uploadReq = {
        "appId": gApzCOB.userDetails.appId,
        "applicationId": gApzCOB.userDetails.applicationId,
        "versionNum": 1,
        "stageId": "UPLOADDOCS",
        "requestType": "Edit",
        "customerType": captureApplicant === 1 ? "Applicant" : "Co-App",
        "uploadDocumentRequestFields": {
            "versionNum": 1,
            "applicationId": gApzCOB.userDetails.applicationId,
            "appId": gApzCOB.userDetails.appId,
            "srcScreen": "UPLOADDOCS",
            "filePath": gApzCOB.userDetails.appId + /LOAN/ + gApzCOB.userDetails.applicationId,
            "fileName": handleDocFileName,
            "base64Value": base64,
            "productGroupCode": "LOAN",
            "isExistingCustomer": "N"
        },
        "applicationDocumentsWrapperList": [{
            "applicationDocumentsList": [{
                "appDocId": "",
                "applicationId": gApzCOB.userDetails.applicationId,
                "versionNum": 1,
                "appId": gApzCOB.userDetails.appId,
                "custDtlId": captureCustDtlId,
                "documentId": "",
                "status": "A",
                "payload": {
                    "docLevel": (TempImageObject?.Type === "SECONDARY_KYC" || TempImageObject?.Type ===
                        "PRIMARY_KYC" || TempImageObject?.Type === "PAN_NUMBER_PHOTO") ? (TempImageObject
                            ?.docLevel || "1") : docLevel,
                    "documentType": `${TempImageObject?.Type}`,
                    "documentDesc": documentDesc,
                    "documentLoc": gApzCOB.userDetails.appId + /LOAN/ + gApzCOB.userDetails.applicationId,
                    "screenId": "UploadDocuments",
                    "custType": captureApplicant === 1 ? "Applicant" : "Co-App",
                    "issueDate": "",
                    "expiryDate": "",
                    "docStatus": "A",
                    "docSide": docSide,
                    "docSize": ApzCOB.getBase64FileSizeInBytes(base64),
                    "documentFileName": handleDocFileName,
                    "documentFormat": "image/jpeg",
                    "documentName": fileName,
                    "isAdiDoc": isAdiDoc,
                    "isPushbackUpload": pusbackUpload,
                    "uploadedBy": "KM",
                    "latitude": window.currentGeoCords?.latitude || "",
                    "longitude": window.currentGeoCords?.longitude || "",
                    "blurScore": window.blurScr,
                    "clearScore": window.clearScr,
                    "noOfAttempts": window.noOfAttempttriggered,
                    "uploadedTs": new Date().toISOString()
                }
            }]
        }]
    };
    if (TempImageObject?.Type === "SECONDARY_KYC") {
        uploadReq.applicationDocumentsWrapperList[0].applicationDocumentsList[0].payload.manualUpload = !isAadhaarRedactEnabled;
    }
    if (TempImageObject?.Type === "SECONDARY_KYC" && isAadhaarRedactEnabled) {
        let requestObj = {
            uploadLoanRequestFields: uploadReq,
            adharRedactOcrRequestFields: {
                imageUrl: base64,
                isBlackWhiteCheck: "yes",
                docSide: docSide,
                clientRefId: "",
                returnMaskedImageAsBase64: "yes",
                outputmaskedAadhaar: "yes",
                maskAadhaarNumber: "yes"
            }
        }
        window.aadhaarRedactAttempt[docSide]++;
        window.aadhaarOcrAttempt = window.aadhaarRedactAttempt[docSide];
        ApzCOB.aadhaarRedactOcr(requestObj, apz.app.Kmbase.saveAadhaarDocumentCB);
    } else {
        let req = {
            apiRequest: {
                "requestObj": uploadReq,
                "userId": gApzCOB.LoggedInUserDetails.loginResponse.userDet.id,
                "appId": gApzCOB.userDetails.appId,
                "interfaceName": "UploadRPCLoanData"
            }
        };
        apz.startLoader();
        setTimeout(() => {
            ApzCOB.serverBuildParam(gAppId, "UploadRPCLoanData", "N", "N", req, false, apz.app.Kmbase.saveDocumentCB);
        }, 1000);
    }
};
apz.app.Kmbase.saveDocumentCB = function (params) {
    window._KM_IS_RECAPTURE = false;
    window.isAdiDoc = 'N'
    let applicationDocumentReq = params.ifaceName === "AdharRedactOcr" ?
        params.req.apiRequest.requestObj.uploadLoanRequestFields.applicationDocumentsWrapperList[0].applicationDocumentsList[0] : params.req.apiRequest.requestObj.applicationDocumentsWrapperList[0].applicationDocumentsList[0];
    const docType = applicationDocumentReq.payload.documentType;
    const docDesc = (applicationDocumentReq.payload.documentDesc || "")
        .toUpperCase();
    try {
        if (ApzCOB.handleServiceCallBacks(params)) {
            apz.stopLoader();
            let savedStages = (inSessionStore.srcVerifiedStages || []).slice();
            let savedCustomerDetailsList = window.KM_AADHAAR_SNAPSHOT?.customerDetailsList || JSON.parse(JSON.stringify(inSessionStore
                .customerDetailsList || []));
            let savedAddressDetailsWrapperList = window.KM_AADHAAR_SNAPSHOT?.addressDetailsWrapperList || JSON.parse(JSON.stringify(inSessionStore
                .addressDetailsWrapperList || []));
            window.KM_AADHAAR_SNAPSHOT = null;
            let savedCbCustomerDetailsList = window.KM_CBCHECK_SNAPSHOT?.customerDetailsList || null;
            let savedCbAddressDetailsWrapperList = window.KM_CBCHECK_SNAPSHOT?.addressDetailsWrapperList || null;
            let savedCbLoanDetails = window.KM_CBCHECK_SNAPSHOT?.loanDetails || null;
            let savedCbExistingLoanDetailsWrapperList = window.KM_CBCHECK_SNAPSHOT?.existingLoanDetailsWrapperList || null;
            let savedCbCibilDetails = window.KM_CBCHECK_SNAPSHOT?.cibilDetailsWrapperList || null;
            window.KM_CBCHECK_SNAPSHOT = null;
            let loanDetailsToRestore = savedCbLoanDetails || (inSessionStore.loanDetails && Object.keys(inSessionStore.loanDetails).length > 0 ?
                JSON.parse(JSON.stringify(inSessionStore.loanDetails)) : null);
            ApzCOB.updateInsessionData(params);
            if (loanDetailsToRestore && Object.keys(loanDetailsToRestore).length > 0) {
                inSessionStore.loanDetails = loanDetailsToRestore;
            }
            let patchApplicant = (window.CAPTURE_FROM_APPLICANT != null) ? window.CAPTURE_FROM_APPLICANT : gApzCOB.currentApplicant;
            let expectedCustDtlId = patchApplicant === 1 ? gApzCOB.userDetails.custDtlId : gApzCOB.userDetails.CoApplicantCustomerId;
            let docArray = inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList || [];
            docArray.forEach(function (doc) {
                if (!doc.custDtlId) doc.custDtlId = expectedCustDtlId;
            });
            apz.app.Kmbase.restoreSnapshotData(savedStages, savedCbCustomerDetailsList || savedCustomerDetailsList,
                savedCbAddressDetailsWrapperList || savedAddressDetailsWrapperList, loanDetailsToRestore,
                savedCbExistingLoanDetailsWrapperList, savedCbCibilDetails);
            apz.app.Kmbase.paintDocumentName(docType, docDesc);
            if (docType === "RELATIONSHIP_PROOF") {
                apz.app.AadhaarDetails.toggleRelationshipDropdown();
            }
            if (docType === "ADDRESS_PROOF") {
                apz.app.AadhaarDetails.toggleAddressProofDropdown();
            }
            if (apz.childScr === 'documentCapture') {
                if (apz.app.docType === 'Aadhaar') {
                    apz.app.documentCapture.checkAndShowOcrSection();
                } else if (apz.app.docType === 'PAN card') {
                    apz.app.documentCapture.checkAndShowPanOcrSection();
                } else if (apz.app.docType === 'Voter ID') {
                    apz.app.documentCapture.checkAndShowVoterIDOcrSection();
                } else {
                    $('.ocr-section').removeClass('sno');
                }
            }
            if ($('#' + BaseScrId + 'newCommonclarityChkModal').is(':visible')) {
                ApzCOB.closeCommonModal('newCommonclarityChkModal');
            }
            let captureApplicant = (window.CAPTURE_FROM_APPLICANT != null) ? window.CAPTURE_FROM_APPLICANT : gApzCOB.currentApplicant;
            if (docType === 'SECONDARY_KYC') {
                apz.app.Kmbase.paintDocInScreen('SECONDARY_KYC', captureApplicant);
            } else if (docType === 'PRIMARY_KYC') {
                apz.app.Kmbase.paintDocInScreen('PRIMARY_KYC', captureApplicant);
            } else if (docType === 'PAN_NUMBER_PHOTO') {
                apz.app.Kmbase.paintDocInScreen('PAN_NUMBER_PHOTO', captureApplicant);
            }
        } else {
            apz.stopLoader();
        }
    } catch (e) {
        ApzCOB.traceFrontEndError(e,"");
        apz.stopLoader();
        ApzCOB.fnDisplayMsg("Failed to save the data");
    }
};

apz.app.Kmbase.saveAadhaarDocumentCB = function (params) {
    if ($('#' + BaseScrId + 'newCommonclarityChkModal').is(':visible')) {
        ApzCOB.closeCommonModal('newCommonclarityChkModal');
    }
    if (ApzCOB.handleServiceCallBacks(params)) {
        apz.app.Kmbase.saveDocumentCB(params);
    } else {
        $("#KmSourc__Kmbase__manual_button_ul").addClass("sno");
        $("#KmSourc__Kmbase__button_form").addClass("suc-btns suc-btn1").removeClass("suc-btn-2 form-top mt2");
        if (params.res.APZCBO__AdharRedactOcr_Res.apiResponse?.ResponseHeader?.ResponseCode === "IV120") {
            window.aadhaarRedactAttempt[docSide]--;
            let err = params.res.APZCBO__AdharRedactOcr_Res.apiResponse.ResponseBody.responseObj;
            $("#KmSourc__Kmbase__ocr_failure_text").html(err);
            ApzCOB.toggleModal("KmSourc__Kmbase__OCR_failure_modal");
        } else {
            let msg = `Document Redact Failed (Attempt ${window.aadhaarOcrAttempt}).<br>Please try again.`;
            $("#KmSourc__Kmbase__ocr_failure_text").html(msg);
            ApzCOB.toggleModal("KmSourc__Kmbase__OCR_failure_modal");
            if (window.aadhaarOcrAttempt >= 3) {
                $("#KmSourc__Kmbase__manual_button_ul").removeClass("sno");
                $("#KmSourc__Kmbase__button_form").removeClass("suc-btns suc-btn1").addClass("suc-btn-2 form-top mt2");
                $("#KmSourc__Kmbase__ocr_failure_text").html(
                    `Document Redact Failed (Attempt ${window.aadhaarOcrAttempt}).<br>Please proceed with manual input.`);
            }
        }
        ApzCOB.hideLoader();
    }
}


apz.app.Kmbase.paintDocumentName = function (docType, docDesc) {
    let cloneDiv;
    let parentDiv;
    var AadhaarScrId = 'KmSourc__AadhaarDetails__';
    var documentCaptureScrId = 'KmSourc__documentCapture__';
    if (apz.isObjectEmpty(inSessionStore) || !inSessionStore.hasOwnProperty('applicationDocumentsWrapperList')) return;
    if (!inSessionStore.applicationDocumentsWrapperList || !inSessionStore.applicationDocumentsWrapperList[0] || !inSessionStore
        .applicationDocumentsWrapperList[0].applicationDocumentsList) return;
    let documentResp = inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList;
    let custDtlId = '';
    if (documentResp.length > 0) {
        if (apz.childScr === 'OtherInformation') {
            custDtlId = gApzCOB.userDetails.custDtlId;
        } else {
            custDtlId = gApzCOB.currentApplicant === 1 ? gApzCOB.userDetails.custDtlId : gApzCOB.userDetails.CoApplicantCustomerId;
        }
        // ── CHANGE: for ADDRESS_PROOF, filter also by documentDesc ──
        window.custimg = documentResp.filter(docs => {
            if (docs.payload.documentType !== docType) return false;
            if (parseInt(docs.custDtlId) !== parseInt(custDtlId) && docType !== 'ADDITIONAL_DOCS') return false;
            if (!docs.appDocId) return false;
            // ADDRESS_PROOF: match by desc prefix
            if (docType === "ADDRESS_PROOF" && docDesc) {
                let storedDesc = (docs.payload.documentDesc || "").toUpperCase();
                if (storedDesc !== docDesc.toUpperCase()) return false;
            }
            if (docType === "RELATIONSHIP_PROOF" && !docs.payload.documentFileName) return false;
            return true;
        });
        OcrImageBaseValue = {};
        if (docType === "CUSTOMER_PHOTOGRAPH") {
            cloneDiv = `${AadhaarScrId}custimg_1`;
            parentDiv = $(`#${AadhaarScrId}custImg`);
            apz.app.Kmbase.toggleCaptureSection("CUSTOMER_PHOTOGRAPH", [{
                captureBtn: AadhaarScrId + "custImgCaptureBtn"
            }]);
        } else if (docType === "RESIDENCE_PREMISE_PHOTO") {
            cloneDiv = `${AadhaarScrId}resImg_1`;
            parentDiv = $(`#${AadhaarScrId}resImg`);
            let $templateRes = $(`#${cloneDiv}`).clone(true);
            parentDiv.html('');
            $templateRes.attr('id', cloneDiv).addClass('sno');
            parentDiv.append($templateRes);
            custimg.forEach((doc, index) => {
                let newId = ApzCOB.cloneDashboardDivs(cloneDiv, parentDiv, index + 2);
                if (gApzCOB?.LoggedInUserDetails?.loginResponse?.addInfo1 == 'BM') {
                    $(`#${newId} .icon-ca-trash`).addClass('sno')
                }
                let baseName = doc.payload.documentFileName.replace(/\.(jpg|jpeg|png)$/i, '').replace(/_\d+$/, '').trim();
                paintClonedDoc(newId, baseName, index, doc, docType);
                apz.app.Kmbase.paintDocSize(newId, doc.payload.docSize);
                let dateTimeStr = ApzCOB.formatDateTimeObject(doc.payload.uploadedTs);
                let lat = (doc.payload.latitude || '').toString().trim();
                let lng = (doc.payload.longitude || '').toString().trim();
                let locationStr = (lat && lat !== '0' && lng && lng !== '0') ? `${lat}, ${lng}` : 'Not available';
                $("#" + newId).after(`<div class="res-img-meta mb16">` +
                    `<span><span class="res-meta-title">Date / Time: </span><span class="res-meta-value">${dateTimeStr}</span></span>` +
                    `<span><span class="res-meta-title">Location: </span><span class="res-meta-value">${locationStr}</span></span>` +
                    `</div>`);
            });
            return;
        } else if (docType === "ADDRESS_PROOF" && (docDesc || "").toUpperCase() !== "PERMANENT") {
            cloneDiv = `${AadhaarScrId}presentAddrImg_1`;
            parentDiv = $(`#${AadhaarScrId}presentAddrImg`);
            let $templatePresent = $(`#${cloneDiv}`).clone(true);
            parentDiv.html('');
            $templatePresent.attr('id', cloneDiv).addClass('sno');
            parentDiv.append($templatePresent);
            let presentVal = ($(`#${AadhaarScrId}addressProof`).val() || "").trim();
            if (!custimg.length && (!presentVal || presentVal === PleaseSelect)) return;
            custimg.forEach((doc, index) => {
                let newId = ApzCOB.cloneDashboardDivs(cloneDiv, parentDiv, index + 2);
                let baseName = doc.payload.documentFileName.replace(/\.(jpg|jpeg|png)$/i, '').replace(/_\d+$/, '').trim();
                paintClonedDoc(newId, baseName, index, doc, docType);
                apz.app.Kmbase.paintDocSize(newId, doc.payload.docSize);
            });
            return;
        } else if (docType === "ADDRESS_PROOF" && (docDesc || "").toUpperCase() === "PERMANENT") {
            cloneDiv = `${AadhaarScrId}permanentAddrImg_1`;
            parentDiv = $(`#${AadhaarScrId}permanentAddrImg`);
            let $templatePermanent = $(`#${cloneDiv}`).clone(true);
            parentDiv.html('');
            $templatePermanent.attr('id', cloneDiv).addClass('sno');
            parentDiv.append($templatePermanent);
            let permanentVal = ($(`#${AadhaarScrId}permanentAddressProof`).val() || "").trim();
            if (!custimg.length && (!permanentVal || permanentVal === PleaseSelect)) return;
            custimg.forEach((doc, index) => {
                let newId = ApzCOB.cloneDashboardDivs(cloneDiv, parentDiv, index + 2);
                let baseName = doc.payload.documentFileName.replace(/\.(jpg|jpeg|png)$/i, '').replace(/_\d+$/, '').trim();
                paintClonedDoc(newId, baseName, index, doc, docType);
                apz.app.Kmbase.paintDocSize(newId, doc.payload.docSize);
            });
            return;
        } else if (docType === "RELATIONSHIP_PROOF") {
            cloneDiv = `${AadhaarScrId}relImg_1`;
            parentDiv = $(`#${AadhaarScrId}relImg`);
            let $templateRel = $(`#${cloneDiv}`).clone(true);
            parentDiv.html('');
            $templateRel.attr('id', cloneDiv).addClass('sno');
            parentDiv.append($templateRel);
            custimg.forEach((doc, index) => {
                let newId = ApzCOB.cloneDashboardDivs(cloneDiv, parentDiv, index + 2);
                let rawName = doc.payload.documentFileName || doc.payload.documentName || doc.payload.documentDesc ||
                    "Relationship Proof";
                let baseName = rawName.replace(/\.(jpg|jpeg|png)$/i, '').replace(/_\d+$/, '').trim();
                paintClonedDoc(newId, baseName, index, doc, docType);
            });
            return;
        } else if (docType === "SECONDARY_KYC") {
            let frontDocs = custimg.filter(d => d.payload?.docLevel == "1");
            let backDocs = custimg.filter(d => d.payload?.docLevel == "2");
            cloneDiv = `${documentCaptureScrId}frontImg_1`;
            parentDiv = $(`#${documentCaptureScrId}frontImg`);
            parentDiv.html('');
            frontDocs.forEach((doc, index) => {
                let newId = ApzCOB.cloneDashboardDivs(cloneDiv, parentDiv, index + 1);
                let baseName = doc.payload.documentFileName.replace(/\.(jpg|jpeg|png)$/i, '').replace(/_\d+$/, '').trim();
                paintClonedDoc(newId, baseName, index, doc, docType);
            });
            cloneDiv = `${documentCaptureScrId}backImg_1`;
            parentDiv = $(`#${documentCaptureScrId}backImg`);
            parentDiv.html('');
            backDocs.forEach((doc, index) => {
                let newId = ApzCOB.cloneDashboardDivs(cloneDiv, parentDiv, index + 1);
                let baseName = doc.payload.documentFileName.replace(/\.(jpg|jpeg|png)$/i, '').replace(/_\d+$/, '').trim();
                paintClonedDoc(newId, baseName, index, doc, docType);
            });
            apz.app.Kmbase.toggleCaptureSection("SECONDARY_KYC", [{
                captureBtn: documentCaptureScrId + "frontCaptureBtn",
                side: "Front"
            }, {
                captureBtn: documentCaptureScrId + "backCaptureBtn",
                side: "Back"
            }]);
            return;
        } else if (docType === "PRIMARY_KYC") {
            let frontDocs = custimg.filter(d => d.payload?.docLevel == "1");
            let backDocs = custimg.filter(d => d.payload?.docLevel == "2");
            cloneDiv = `${documentCaptureScrId}frontImg_1`;
            parentDiv = $(`#${documentCaptureScrId}frontImg`);
            parentDiv.html('');
            frontDocs.forEach((doc, index) => {
                let newId = ApzCOB.cloneDashboardDivs(cloneDiv, parentDiv, index + 1);
                let baseName = doc.payload.documentFileName.replace(/\.(jpg|jpeg|png)$/i, '').replace(/_\d+$/, '').trim();
                paintClonedDoc(newId, baseName, index, doc, docType);
            });
            cloneDiv = `${documentCaptureScrId}backImg_1`;
            parentDiv = $(`#${documentCaptureScrId}backImg`);
            parentDiv.html('');
            backDocs.forEach((doc, index) => {
                let newId = ApzCOB.cloneDashboardDivs(cloneDiv, parentDiv, index + 1);
                let baseName = doc.payload.documentFileName.replace(/\.(jpg|jpeg|png)$/i, '').replace(/_\d+$/, '').trim();
                paintClonedDoc(newId, baseName, index, doc, docType);
            });
            apz.app.Kmbase.toggleCaptureSection("PRIMARY_KYC", [{
                captureBtn: documentCaptureScrId + "frontCaptureBtn",
                side: "Front"
            }, {
                captureBtn: documentCaptureScrId + "backCaptureBtn",
                side: "Back"
            }]);
            return;
        } else if (docType === "PAN_NUMBER_PHOTO") {
            let frontDocs = custimg.filter(d => d.payload?.docLevel == "1");
            let backDocs = custimg.filter(d => d.payload?.docLevel == "2");
            cloneDiv = `${documentCaptureScrId}frontImg_1`;
            parentDiv = $(`#${documentCaptureScrId}frontImg`);
            parentDiv.html('');
            frontDocs.forEach((doc, index) => {
                let newId = ApzCOB.cloneDashboardDivs(cloneDiv, parentDiv, index + 1);
                let baseName = doc.payload.documentFileName.replace(/\.(jpg|jpeg|png)$/i, '').replace(/_\d+$/, '').trim();
                paintClonedDoc(newId, baseName, index, doc, docType);
            });
            cloneDiv = `${documentCaptureScrId}backImg_1`;
            parentDiv = $(`#${documentCaptureScrId}backImg`);
            parentDiv.html('');
            backDocs.forEach((doc, index) => {
                let newId = ApzCOB.cloneDashboardDivs(cloneDiv, parentDiv, index + 1);
                let baseName = doc.payload.documentFileName.replace(/\.(jpg|jpeg|png)$/i, '').replace(/_\d+$/, '').trim();
                paintClonedDoc(newId, baseName, index, doc, docType);
            });
            apz.app.Kmbase.toggleCaptureSection("PAN_NUMBER_PHOTO", [{
                captureBtn: documentCaptureScrId + "frontCaptureBtn",
                side: "Front"
            }, {
                captureBtn: documentCaptureScrId + "backCaptureBtn",
                side: "Back"
            }]);
            return;
            // OTHER INFORMATION (Swaroop changes)    
        } else if (docType === "BANK_ACCOUNT_PROOF" && custimg.length > 0) {
            let otherInfoScrnId = 'KmSourc__OtherInformation__';
            let changeBankDetailsStatus = inSessionStore?.bankDetailsWrapperList?.[0]?.bankDetails?.payload?.editBankDetails;
            if (apz.isNull(changeBankDetailsStatus) && gApzCOB.productCode == "1001") {
                changeBankDetailsStatus = 'Yes'; //Open Market JIRA - UAU-1344
            }
            if (changeBankDetailsStatus === "Yes" && bankSelected !== "Primary") {
                bankSelected = "Secondary"
            } else if (changeBankDetailsStatus === "No" && bankSelected !== "Secondary") {
                bankSelected = "Primary"
            }
            if (bankSelected === "Primary") { //16 june changes
                cloneDiv = `${otherInfoScrnId}pennyCheckDocName_1`;
                parentDiv = $(`#${otherInfoScrnId}pennyCheckDocName`);
            } else if (bankSelected === "Secondary") {
                cloneDiv = `${otherInfoScrnId}changDocImg_1`;
                parentDiv = $(`#${otherInfoScrnId}changDocImg`);

            } else { }
            let $templateRes = $(`#${cloneDiv}`).clone(true);
            parentDiv.html('');
            $templateRes.attr('id', cloneDiv).addClass('sno');
            parentDiv.append($templateRes);
            custimg.forEach((doc, index) => {
                let newId = ApzCOB.cloneDashboardDivs(cloneDiv, parentDiv, index + 2);
                let baseName = doc.payload.documentFileName.replace(/\.(jpg|jpeg|png)$/i, '').replace(/_\d+$/, '').trim();
                paintClonedDoc(newId, baseName, index, doc, docType);
            });
            if (bankSelected === "Primary") { //16 june changes
                ApzCOB.AddOrRemoveDisableFields([`${kmScrId}bankDetTypeOfDocument`], true);
            } else if (bankSelected === "Secondary") {
                ApzCOB.AddOrRemoveDisableFields([`${kmScrId}changeBankTypeOfDoc`], true);
            }
            return;
        }
        // else if (docType === "CHANGED_BANK_DOCS" && custimg.length > 0) {
        //     let otherInfoScrnId = 'KmSourc__OtherInformation__';
        //     cloneDiv = `${otherInfoScrnId}changDocImg_1`;
        //     parentDiv = $(`#${otherInfoScrnId}changDocImg`);
        //     let $templateRes = $(`#${cloneDiv}`).clone(true);
        //     parentDiv.html('');
        //     $templateRes.attr('id', cloneDiv).addClass('sno');
        //     parentDiv.append($templateRes);
        //     custimg.forEach((doc, index) => {
        //         let newId = ApzCOB.cloneDashboardDivs(cloneDiv, parentDiv, index + 2);
        //         let baseName = doc.payload.documentFileName.replace(/\.(jpg|jpeg|png)$/i, '').replace(/_\d+$/, '').trim();
        //         paintClonedDoc(newId, baseName, index, doc, docType);
        //         //     let rawTs = doc.payload.uploadedTs || '';
        //         //     let dateTimeStr = '--';
        //         //     if (rawTs) {
        //         //         let d = new Date(rawTs);
        //         //         let day = String(d.getDate()).padStart(2, '0');
        //         //         let month = String(d.getMonth() + 1).padStart(2, '0');
        //         //         let year = d.getFullYear();
        //         //         let hrs = String(d.getHours()).padStart(2, '0');
        //         //         let mins = String(d.getMinutes()).padStart(2, '0');
        //         //         let secs = String(d.getSeconds()).padStart(2, '0');
        //         //         dateTimeStr = `${day}/${month}/${year} / ${hrs}:${mins}:${secs}`;
        //         //     }
        //         //     let lat = (doc.payload.latitude || '').toString().trim();
        //         //     let lng = (doc.payload.longitude || '').toString().trim();
        //         //     let locationStr = (lat && lat !== '0' && lng && lng !== '0') ? `${lat}, ${lng}` : 'Not available';
        //         //     $("#" + newId).after(`<div class="res-img-meta">` + `<span><span class="res-meta-title">Date / Time: </span>` +
        //         //         `<span class="res-meta-value">${dateTimeStr}</span></span>` +
        //         //         `<span><span class="res-meta-title">Location: </span>` +
        //         //         `<span class="res-meta-value">${locationStr}</span></span>` + `</div>`);
        //     });
        //     ApzCOB.AddOrRemoveDisableFields([`${kmScrId}changeBankTypeOfDoc`], true);
        //     return;
        // } 
        else if (docType === "APPLNT_CUST_NOMINEE_DOCS" && custimg.length > 0) {
            let otherInfoScrnId = 'KmSourc__OtherInformation__';
            cloneDiv = `${otherInfoScrnId}custAppDocUpload_1`;
            parentDiv = $(`#${otherInfoScrnId}custAppDocUpload`);
            let $templateRes = $(`#${cloneDiv}`).clone(true);
            parentDiv.html('');
            $templateRes.attr('id', cloneDiv).addClass('sno');
            parentDiv.append($templateRes);
            custimg.forEach((doc, index) => {
                let newId = ApzCOB.cloneDashboardDivs(cloneDiv, parentDiv, index + 2);
                let baseName = doc.payload.documentFileName.replace(/\.(jpg|jpeg|png)$/i, '').replace(/_\d+$/, '').trim();
                paintClonedDoc(newId, baseName, index, doc, docType);
            });
            return;
        } else if (docType === "COAPPLNT_CUST_NOMINEE_DOCS" && custimg.length > 0) {
            let otherInfoScrnId = 'KmSourc__OtherInformation__';
            cloneDiv = `${otherInfoScrnId}custCoAppDocUpload_1`;
            parentDiv = $(`#${otherInfoScrnId}custCoAppDocUpload`);
            let $templateRes = $(`#${cloneDiv}`).clone(true);
            parentDiv.html('');
            $templateRes.attr('id', cloneDiv).addClass('sno');
            parentDiv.append($templateRes);
            custimg.forEach((doc, index) => {
                let newId = ApzCOB.cloneDashboardDivs(cloneDiv, parentDiv, index + 2);
                let baseName = doc.payload.documentFileName.replace(/\.(jpg|jpeg|png)$/i, '').replace(/_\d+$/, '').trim();
                paintClonedDoc(newId, baseName, index, doc, docType);
            });
            return;
        } else if (docType === "ADDITIONAL_DOCS" && custimg.length > 0) {
            let otherInfoScrnId = 'KmSourc__OtherInformation__';
            cloneDiv = `${otherInfoScrnId}additionalDoc_1`;
            parentDiv = $(`#${otherInfoScrnId}additionalDoc`);
            let $templateRes = $(`#${cloneDiv}`).clone(true);
            parentDiv.html('');
            $templateRes.attr('id', cloneDiv).addClass('sno');
            parentDiv.append($templateRes);
            apz.app.OtherInformation.sortAdditionalDocs(custimg).forEach((doc, index) => {
                let newId = ApzCOB.cloneDashboardDivs(cloneDiv, parentDiv, index + 2);
                let baseName = doc.payload.documentFileName.replace(/\.(jpg|jpeg|png)$/i, '').trim();
                paintClonedDoc(newId, baseName, index, doc, docType);
            });
            ApzCOB.AddOrRemoveDisableFields([`${kmScrId}nameOfAdditionalDoc`], true);
            return;
        } else {
            return;
        }
        // ── CUSTOMER_PHOTOGRAPH falls through to here ──
        parentDiv.html('');
        custimg.forEach((doc, index) => {
            let newId = ApzCOB.cloneDashboardDivs(cloneDiv, parentDiv, index + 1);
            let baseName = doc.payload.documentFileName.replace(/\.(jpg|jpeg|png)$/i, '').replace(/_\d+$/, '').trim();
            paintClonedDoc(newId, baseName, index, doc, docType);
        });
    }
};
apz.app.Kmbase.paintAllDocuments = function () {
    if (apz.childScr === "CBcheck") return;
    if (apz.childScr === "documentCapture") {
        if (apz.app.docType === "Voter ID") {
            apz.app.Kmbase.paintDocumentName("PRIMARY_KYC");
        } else if (apz.app.docType === "Aadhaar") {
            apz.app.Kmbase.paintDocumentName("SECONDARY_KYC");
        } else if (apz.app.docType === "PAN card") {
            apz.app.Kmbase.paintDocumentName("PAN_NUMBER_PHOTO");
            apz.app.documentCapture.checkAndShowPanOcrSection();
        }
        return;
    }
    // ── CHANGE: ADDRESS_PROOF painted twice — once for PRESENT, once for PERMANENT ──
    const docTypes = ["CUSTOMER_PHOTOGRAPH", "RESIDENCE_PREMISE_PHOTO", "RELATIONSHIP_PROOF"];
    docTypes.forEach(docType => apz.app.Kmbase.paintDocumentName(docType));
    apz.app.Kmbase.paintDocumentName("ADDRESS_PROOF", "PRESENT");
    apz.app.Kmbase.paintDocumentName("ADDRESS_PROOF", "PERMANENT");
    let aadhaarCfg = window.KM_DOC_VIEWER_CONFIG['SECONDARY_KYC'];
    $(`#${aadhaarCfg.rowId}`).removeClass('km-doc-upload-row').addClass('sno');
    $(`#${aadhaarCfg.captureBtnId}`).removeClass('sno');
    apz.app.Kmbase.paintAadhaarKycDocsInScreen(gApzCOB.currentApplicant);
};
apz.app.Kmbase.viewDocument = function (pthis) {
    let $uploadDiv = $(pthis).closest('.uploadimg');
    let documentId = $uploadDiv.attr('data-id');
    if (!documentId) {
        ApzCOB.fnDisplayMsg("Document is not available");
        return;
    }
    window._aadhaarDocIds = [];
    window._aadhaarDocIdx = 0;
    $(`#${kmbaseScr}docNavRow`).addClass('sno');
    let docDetails = inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList.find(doc => parseInt(doc.appDocId) === parseInt(
        documentId));
    if (!apz.isObjectEmpty(docDetails)) {
        window.paintDocType = docDetails?.documentType;
        // window.paintFileName = docDetails?.payload?.documentFormat || (docDetails?.payload?.documentFileName + ".jpg");
        window.paintFileName = docDetails?.payload?.documentFileName;
        window.ImageLocationDetails = {
            latitude: docDetails?.payload?.latitude || "",
            longitude: docDetails?.payload?.longitude || "",
            uploadedTs: docDetails?.payload?.uploadedTs || "",
            documentFileName: docDetails?.payload?.documentFileName || ""
        };
        ApzCOB.downloadFileFromServer(paintFileName, apz.app.Kmbase.viewDocumentCB);
    } else {
        ApzCOB.fnDisplayMsg("Document is not available");
    }
};
apz.app.Kmbase.viewDocumentCB = function (params) {
    apz.stopLoader();
    if (!apz.isNull(params.base64)) {
        let $imgView = $(`#${kmbaseScr}imgView`);
        if ($imgView.guillotine('instance')) {
            $imgView.guillotine('remove'); 
        }
        $imgView = $(`#${kmbaseScr}imgView`);
        $imgView.off('load.reinitGuillotine').one('load.reinitGuillotine', function () {
            $imgView.guillotine({
                width: 300,   
                height: 300
            });
        });
        $imgView.attr('src', 'data:image/png;base64,' + params.base64);
        if (Object.keys(window.ImageLocationDetails).length > 0) {
            apz.app.BaseScreens.paintImageLocationDetails(`#${kmbaseScr}imgView`, window.ImageLocationDetails);
        }
        let fileName = window.ImageLocationDetails?.documentFileName || "Document";
        let title = fileName.replace(/\.[^/.]+$/, "");
        $(`#${kmbaseScr}docViewModal .modal-header h1`).text(title);
        window._aadhaarDocIds = [];
        window._aadhaarDocIdx = 0;
        $(`#${kmbaseScr}docNavRow`).addClass('sno');
        $(`#${kmbaseScr}frontView_Img`).prop('disabled', true);
        $(`#${kmbaseScr}backView_Img`).prop('disabled', true);
        if (!$(`#${kmbaseScr}docViewModal`).is(':visible')) {
            ApzCOB.toggleModal(`${kmbaseScr}docViewModal`);
        }
        $(`#${kmbaseScr}docViewModal_content`).css('overflow', 'hidden');
    } else {
        ApzCOB.fnDisplayMsg("Document is not available");
    }
};
apz.app.Kmbase.deleteDocument = function (pthis) {
    let $uploadDiv = $(pthis).closest('.uploadimg');
    let documentId = $uploadDiv.attr('data-id');
    docDeleteType = $uploadDiv.attr('data-doc-type');
    if (!documentId) return;
    let popUpObj = {
        text: "Do you want to delete this document?",
        Btn1: {
            text: "Yes",
            onClick: `apz.app.Kmbase.deleteDocumentCnfm(${documentId})`
        },
        Btn2: {
            text: "No",
            onClick: "ApzCOB.closeCommonModal(`newCommonConfModal`)"
        }
    };
    ApzCOB.showNewCommonConfirmationModal(popUpObj);
};
apz.app.Kmbase.deleteDocumentCnfm = function (docId) {
    gApzCOB.userDetails.versionNum = window.versionNum || 1;
    ApzCOB.closeCommonModal(`newCommonConfModal`);
    ApzCOB.deleteDocument('', '', '', docId, apz.app.Kmbase.deleteDocumentCnfmCB);
};
apz.app.Kmbase.deleteDocumentCnfmCB = function (params) {
    apz.stopLoader();
    try {
        const isSuccess = ApzCOB.handleServiceCallBacks(params);
        if (isSuccess && params.res.APZCBO__DeleteDocument_Res.apiResponse.ResponseBody.responseObj === 'Success') {
            let deletedDocId = params?.req?.apiRequest?.requestObj?.appDocId || "";
            let documentArray = inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList;
            if (!apz.isNull(deletedDocId) && documentArray.length > 0) {
                let updatedDocs = documentArray.filter(item => Number(item.appDocId) !== Number(deletedDocId));
                inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList = structuredClone(updatedDocs);
            }
            $(`.km-doc-upload-row[data-id="${deletedDocId}"]`).remove();
        }
        // ── CHANGE: for ADDRESS_PROOF, read desc from deleted doc to repaint correct section ──
        if (docDeleteType === "ADDRESS_PROOF") {
            let deletedDocId = params?.req?.apiRequest?.requestObj?.appDocId || "";
            // Find desc from the removed doc (already removed above, so look in original array before removal)
            // We stored it on the element before delete — read from a stored window variable
            let descToRepaint = window._KM_LAST_DELETED_ADDR_DESC || "PRESENT";
            apz.app.Kmbase.paintDocumentName("ADDRESS_PROOF", "PRESENT");
            apz.app.Kmbase.paintDocumentName("ADDRESS_PROOF", "PERMANENT");
            apz.app.AadhaarDetails.toggleAddressProofDropdown();
        } else {
            apz.app.Kmbase.paintDocumentName(docDeleteType);
        }
        if (docDeleteType === "RELATIONSHIP_PROOF") {
            apz.app.AadhaarDetails.toggleRelationshipDropdown();
        }
        //Swaroop changes (Other Info screen)
        if (docDeleteType === "ADDITIONAL_DOCS") {
            let docList = inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList;
            let AddDocExists = docList.some(function (item) {
                return item.payload.documentType === 'ADDITIONAL_DOCS';
            });
            if (!AddDocExists) {
                ApzCOB.AddOrRemoveDisableFields([`${kmScrId}nameOfAdditionalDoc`], false); //MUI-195
                $(`#${kmScrId}nameOfAdditionalDoc`).val('');
            }
        }
        if (docDeleteType === "BANK_ACCOUNT_PROOF") {
            let docList = inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList;
            let AddDocExists = docList.some(function (item) {
                return item.payload.documentType === 'BANK_ACCOUNT_PROOF';
            });
            if ((!AddDocExists) && bankSelected === "Primary") {
                ApzCOB.AddOrRemoveDisableFields([`${kmScrId}bankDetTypeOfDocument`], false);
                apz.setElmValue(kmScrId + "bankDetTypeOfDocument", "Please Select");
            } else if ((!AddDocExists) && bankSelected === "Secondary") {
                ApzCOB.AddOrRemoveDisableFields([`${kmScrId}changeBankTypeOfDoc`], false);
                apz.setElmValue(kmScrId + "changeBankTypeOfDoc", "Please Select");
            }
        }
        apz.app.Kmbase.toggleCaptureSection(docDeleteType, apz.app.Kmbase.getCaptureConfig(docDeleteType));
        if (apz.childScr === 'documentCapture') {
            if (apz.app.docType === 'Aadhaar') {
                apz.app.documentCapture.checkAndShowOcrSection();
            } else if (apz.app.docType === 'PAN card') {
                let custDtlId = gApzCOB.currentApplicant === 1 ? gApzCOB.userDetails.custDtlId : gApzCOB.userDetails.CoApplicantCustomerId;
                apz.app.Kmbase.paintDocumentName("PAN_NUMBER_PHOTO");
                let allPanDocs = (inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList || []).filter(d => d.payload
                    .documentType === 'PAN_NUMBER_PHOTO' && parseInt(d.custDtlId) === parseInt(custDtlId));
                let hasFront = allPanDocs.some(d => d.payload.docLevel == "1");
                let hasBack = allPanDocs.some(d => d.payload.docLevel == "2");
                if (!hasFront || !hasBack) {
                    apz.app.documentCapture.checkAndShowPanOcrSection();
                    $(`#${kmbaseScr}nxtBtn`).prop('disabled', true);
                    window.VERIFIED_PAN_VALUE = null;
                    if (gApzCOB.currentApplicant > 1) {
                        window.coapplicant_pancheck = false;
                    } else {
                        window.applicant_pancheck = false;
                    }
                    let $btn = $(`#${docScrId}verifyBtn`);
                    $btn.removeClass('pan-verified-btn').html('Verify').prop('disabled', false).off('click').on('click', function () {
                        apz.app.documentCapture.PanVerification();
                    });
                }
            } else {
                let custDtlId = gApzCOB.currentApplicant === 1 ? gApzCOB.userDetails.custDtlId : gApzCOB.userDetails.CoApplicantCustomerId;
                let remainingDocs = (inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList || []).filter(d => d.payload
                    .documentType === 'PRIMARY_KYC' && parseInt(d.custDtlId) === parseInt(custDtlId));
                if (remainingDocs.length === 2) {
                    $('.ocr-section').removeClass('sno');
                } else {
                    $('.ocr-section').addClass('sno');
                }
                if ($("#KmSourc__documentCapture__sc_row_134").hasClass("sno")) {
                    $("#KmSourc__documentCapture__sc_row_134").removeClass("sno");
                }
                if (!$("#KmSourc__documentCapture__ocr_heading").hasClass("sno")) {
                    $("#KmSourc__documentCapture__ocr_heading").addClass("sno");
                }
                if (!$("#KmSourc__documentCapture__ocr_details").hasClass("sno")) {
                    $("#KmSourc__documentCapture__ocr_details").addClass("sno");
                }
                if (!$("#KmSourc__documentCapture__ocrNote").hasClass("sno")) {
                    $("#KmSourc__documentCapture__ocrNote").addClass("sno");
                }
                if (!$("#KmSourc__documentCapture__ocrEdit").hasClass("sno")) {
                    $("#KmSourc__documentCapture__ocrEdit").addClass("sno");
                }
                window.VERIFIED_VOTER_VALUE = null;
                window.VERIFIED_VOTER_NAME = null;
                $("#" + kmbaseScr + "nxtBtn").prop("disabled", true);
                let $btn = $("#" + docScrId + "verifyBtn");
                // $btn.removeClass("pan-verified-btn").html("Verify").prop("disabled", false);
                $btn.removeClass("pan-verified-btn").html("Verify").prop("disabled", false).off('click').on('click', function() {
                    apz.app.documentCapture.primaryKycVerification();
                });
                if (gApzCOB.currentApplicant > 1) {
                    window.CO_APPLICANT_PRIMARY_KYC_VERIFICATION = false;
                    window.CO_APPLICANT_ALTERNATE_KYC_VERIFICATION = false;
                } else {
                    window.PRIMARY_KYC_VERIFICATION = false;
                    window.ALTERNATE_KYC_VERIFICATION = false;
                }
            }
        }
        const modalOptions = {
            text: isSuccess ? "Document Deleted.!" : "Document Delete Failed.!",
            Btn: {
                text: "OK",
                onClick: isSuccess ? "ApzCOB.closeCommonModal(`newCommonSuccModal`)" : "ApzCOB.closeCommonModal(`newCommonErrModal`)"
            }
        };
        isSuccess ? ApzCOB.showNewCommonSuccessModal(modalOptions) : ApzCOB.showNewCommonErrorModal(modalOptions);
    } catch (e) {
        ApzCOB.traceFrontEndError(e,"");
        ApzCOB.showNewCommonErrorModal({
            text: technicalErrMsg,
            Btn: {
                text: "OK",
                onClick: "ApzCOB.closeCommonModal(`newCommonErrModal`)"
            }
        });
    }
};
var _originalDeleteDocument = apz.app.Kmbase.deleteDocument;
apz.app.Kmbase.deleteDocument = function (pthis) {
    let $uploadDiv = $(pthis).closest('.uploadimg');
    let documentId = $uploadDiv.attr('data-id');
    docDeleteType = $uploadDiv.attr('data-doc-type');
    // ── CHANGE: capture addressProofDesc before deletion for repaint ──
    if (docDeleteType === "ADDRESS_PROOF") {
        let deletedDoc = (inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList || []).find(d => d.appDocId ==
            documentId);
        window._KM_LAST_DELETED_ADDR_DESC = (deletedDoc?.payload?.documentDesc || "PRESENT").toUpperCase();
    }
    if (!documentId) return;
    let popUpObj = {
        text: "Do you want to delete this document?",
        Btn1: {
            text: "Yes",
            onClick: `apz.app.Kmbase.deleteDocumentCnfm(${documentId})`
        },
        Btn2: {
            text: "No",
            onClick: "ApzCOB.closeCommonModal(`newCommonConfModal`)"
        }
    };
    ApzCOB.showNewCommonConfirmationModal(popUpObj);
};
