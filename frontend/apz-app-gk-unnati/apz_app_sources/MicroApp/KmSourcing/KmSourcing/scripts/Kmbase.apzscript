            window._KM_AFTER_SUBMIT_REFRESH = false;
            // Second delay after navigation so dashboard is fully loaded before refresh
            setTimeout(function () {
                ApzCOB.fetchDashboard();
            }, 800);
        }
    }, 200);
};
