window.lastBM = undefined;
apz.app.onLoad_Kmbase = function () {
    $(document).ready(function () {
        $("#KmSourc__Kmbase__Otp_Modal_window").addClass("otp-modal");
    });
    $("#scr__" + kmbaseScr + "main").on("mousedown", "input, select", function () {
        clearFieldError(this.id);
    });
    $("#scr__" + kmbaseScr + "main").on("change", "input[type=radio]", function () {
        clearFieldError(this.id);
    });
    window.picture = $('#KmSourc__Kmbase__imgView');
    ApzCOB.intializeGuillotine(picture);
    $('input.hasDatepicker').datepicker("option", {
        maxDate: Date.parse(DATE_TODAY),
        yearRange: "-100:+0"
    });
};
//MUI-289
window.PhotoKycQuery="";
apz.app.onShown_Kmbase = function () {
try {    
    window.IS_WIP_REINITIATE = ApzCOB.getPayloadDatafromWrapper('oldReinitiate', 'Applicant', 'customerDetailsList') || false;
    $(`#${kmbaseScr}sendback`).addClass("sno");
    window.leadNode = productTypeBasedleadNode[ApplicationType];
    if (!apz.isNull(inSessionStore[leadNode])) {
      if (gApzCOB.productCode === '1001') {
        gApzCOB.selLeadDtls = inSessionStore[leadNode];
      } else {
        gApzCOB.selLeadDtls = ApzCOB.convertMaitriToUnnati(inSessionStore[leadNode]);
        gApzCOB.selLeadDtls.pid = inSessionStore['cdhLeadDetails'].referenceId;
      }
    }
    if(!apz.isNull(inSessionStore['cdhLeadDetails'])){
       gApzCOB.selLeadDtls = ApzCOB.convertMaitriToUnnati(inSessionStore['cdhLeadDetails']);
       gApzCOB.selLeadDtls.pid = inSessionStore['cdhLeadDetails'].referenceId;
    }
    window.lastWorkFlw = {};
    window.timeLineSrcStat = [];
    branchState = apz.isNull(gApzCOB?.selLeadDtls?.glBranchState) ? '' : gApzCOB?.selLeadDtls?.glBranchState?.toUpperCase();
    otpLanguage = language.find(el => el.key?.split('~')?.[1]?.toUpperCase() == branchState)?.value ?? "";
    window.ApplicationStatus = inSessionStore?.applicationMaster?.applicationStatus;
    let timelineDetails = inSessionStore?.applicationTimelineDtl || [];
    let timeLineLength = timelineDetails?.length || 0;
    if (timeLineLength > 0) {
        window.lastWorkFlw = timelineDetails[timeLineLength - 1] || {};
        if (window.lastWorkFlw.caStatDetails) {
            window.timeLineSrcStat = apz.app.Kmbase.normalizeCAStatDetails(window.lastWorkFlw.caStatDetails);
        } else {
            window.timeLineSrcStat = window.lastWorkFlw.srcStatRemarks || window.lastWorkFlw.rpcStatRemaks || [];
        }
    }
    if (timeLineLength > 1 && inSessionStore?.applicationMaster?.applicationStatus === 'PENDING' && timelineDetails[timeLineLength - 2]?.stage === "BM Recommendation") {
        window.lastBM = timelineDetails[timeLineLength - 2];
        window.timeLineSrcStat = lastBM.srcStatRemarks || [];
    }
    apz.app.Kmbase.setMinMaxLength();
    $("#sidebar").addClass("sno");
    $(`#${kmbaseScr}CBcheck_hyp`).addClass("active");
    $(`#${kmbaseScr}AppCBcheck_hyp`).addClass("active");
    $('body').addClass('unati crdas LoginBase');
    $('.stageDiv').removeClass('stageDiv');
    let LoginDtls = LoggedInUserDetails.loginResponse.userDet;
    $(`#${kmbaseScr}KMloggedInUserName_txtcnt`).text(`${LoginDtls.name} (${LoginDtls.id})`);
    $(`#${kmbaseScr}KMloggedInRole_txtcnt`).text(LoggedInUserDetails.loginResponse.addInfo1);
    let leadDtls = gApzCOB.selLeadDtls || {};
    // let applicantData = inSessionStore?.customerDetailsList.find(cust => cust.customerType === "Applicant");
    ApzCOB.addApplicationTag();
    let leadName = leadDtls.fullName || '';
    $(`#${kmbaseScr}Cust_Name_txtcnt`).html(`${leadName}`);
    $(`#${kmbaseScr}cust_ID_txtcnt`).text(leadDtls.customerId || '');
    $(`#${kmbaseScr}application_ID_txtcnt`).text(apz.isNull(inSessionStore.applicationId) ? '' : inSessionStore.applicationId);
    $(`#${kmbaseScr}ProductName_Val_txtcnt`).text(gApzCOB.SelectedProductName === 'Vishesh' ? 'Unnati Lite' : gApzCOB.SelectedProductName || '');
    $(`#${kmbaseScr}kendraID_Nameval_txtcnt`).text(
        (leadDtls.kendraId && leadDtls.kendraName) ? `${leadDtls.kendraId} / ${leadDtls.kendraName}` : '');
    $(`#${kmbaseScr}BranchInfo_Val_txtcnt`).text(
        (leadDtls.glBranchId && leadDtls.glBranchName) ? `${leadDtls.glBranchId} / ${leadDtls.glBranchName}` : '');
    if (!apz.isObjectEmpty(inSessionStore)) {
        apz.app.Kmbase.storeWindowData();
    }
    apz.app.Kmbase.paintLoanDetails();
    apz.app.Kmbase.initSrcVerifiedStages();
    apz.app.Kmbase.navigateToFirstPendingStage();
    apz.app.Kmbase.toggleReviewConfirmSidebar();
    if (ALL_eNACH_BANKS.length === 0) {
        ApzCOB.fetcheNachBankData();
    }
 } catch(e){
    ApzCOB.traceFrontEndError(e,"");
 }
};
apz.app.Kmbase.back = function () {
    window.isVerified = "N";
    $(`#${kmbaseScr}sendback`).addClass('sno');
    if (apz.childScr === "AadhaarDetails") {
        apz.app.Kmbase.confirmNavigate(function () {
            window.AADHAAR_SAVE_DRAFT = false;
            window.AADHAAR_EXPLICIT_DRAFT = false;
            window.AADHAAR_BACK_NAV = true;
            window.AADHAAR_BACK_FROM_APPLICANT = gApzCOB.currentApplicant;
            apz.app.AadhaarDetails.saveAadhaarDetails(true);
        });
        return;
    }
    if (apz.childScr === 'documentCapture') {
        let capturedFrom = window.CAPTURE_FROM_APPLICANT;
        if (apz.app.docType === 'Aadhaar') {
            window.AADHAAR_TAB_SWITCH_TARGET = (capturedFrom === 2) ? 'CoApplicant' : 'Applicant';
            window.CAPTURE_FROM_APPLICANT = null;
            ApzCOB.launchSubScreen("AadhaarDetails", "KmSourc__Kmbase__KMLaunchCol", "");
            $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
            $(`#${kmbaseScr}AadhaarDetails_hyp`).addClass('active');
        } else if (apz.app.docType === 'Voter ID' || apz.app.docType === 'PAN card') {
            window.KM_CBCHECK_SNAPSHOT = null;
            window.CBCHECK_TAB_SWITCH_TARGET = (capturedFrom === 2) ? 'CoApplicant' : 'Applicant';
            window.CAPTURE_FROM_APPLICANT = null;
            ApzCOB.launchSubScreen("CBcheck", "KmSourc__Kmbase__KMLaunchCol", "");
            $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
            $(`#${kmbaseScr}CBcheck_hyp`).addClass('active');
            if (window.CBCHECK_TAB_SWITCH_TARGET === 'CoApplicant') {
                $(`#${kmbaseScr}CoAppCBcheck_hyp`).addClass('active');
            } else {
                $(`#${kmbaseScr}AppCBcheck_hyp`).addClass('active');
            }
        }
        $('.btn-saveDraft, .btn-reject, .btn-back, .btn-next').show();
        return;
    }
    if (apz.childScr === "CBcheck") {
        if (gApzCOB.currentApplicant === 2) {
            if (apz.app.Kmbase.getSrcVerifiedStatus(1, "C") !== "Y") {
                apz.app.Kmbase.updateSrcVerifiedStages(1, "C", "N");
                apz.app.Kmbase.paintSidebarStatus();
            }
            let tabs = $('.cbcheckSubMenu');
            if (tabs.length > 1) {
                window.CB_PENDING_TAB_SWITCH = {
                    pthis: tabs.eq(0)[0],
                    CustType: 'Applicant'
                };
                apz.app.Kmbase.saveDraft();
            }
        } else {
            if (apz.app.Kmbase.getSrcVerifiedStatus(1, "A") !== "Y") {
                apz.app.Kmbase.updateSrcVerifiedStages(1, "A", "N");
                apz.app.Kmbase.paintSidebarStatus();
            }
            if(window.deepLink){
                apz.app.Dashboard.LaunchDashboard();
            }else{
            apz.app.Kmbase.gotoHome();
            }
        }
        return;
    }
    if (apz.childScr === "BusinessIncome") {
        $('#KmSourc__Kmbase__CoAppAadhaarDetails_hyp').click();
        // apz.app.Kmbase.NavigateSidebar(2, this);
        return;
    }
    // OTHER INFORMATION (Swaroop changes)
    if (apz.childScr === "OtherInformation") {
        // apz.app.Kmbase.updateSrcVerifiedStages(4, "A", "N");
        isOtherInfoBack = true;
        isOtherInfoSideBarDraft = '';
        isOtherInfoSaveDraft = '';
        apz.app.Kmbase.NavigateSidebar(3, this);
        apz.app.OtherInformation.paintSideBar();
        return;
    }
    if (apz.childScr === "KMReviewConfirm") {
        if (IS_REJECTED_APPLICATION && window.currentApplication === "Rejected") {
            ApzCOB.backNavigation();
            return;
        }
        // $(`#${kmbaseScr}nxtBtn`).removeClass('sno');//
        // $(`#${kmbaseScr}SaveDraft`).removeClass('sno');
        // $(`#${kmbaseScr}confirmBtn`).addClass('sno');
        apz.app.Kmbase.NavigateSidebar(4, this);
        return;
    }
};
apz.app.Kmbase.next = function () {
    let CB_STATUS = true;
    if (apz.childScr !== "documentCapture") {
        CB_STATUS = ApzCOB.checkCbStatus();
    }
    if (CB_STATUS) {
        window.isVerified = "Y";
        $(`#${kmbaseScr}sendback`).addClass('sno');
        if (apz.childScr === "BusinessIncome") {
            isBusinessNextButton = true;
            window.BUSINESS_EXPLICIT_DRAFT = false;
            apz.app.BusinessIncome.validateOnclickNext();
            return;
        }
        if (apz.childScr === "AadhaarDetails") {
            if (!apz.app.AadhaarDetails.validateForm() || !apz.app.Kmbase.validateQueryResponse()) return;
            window.AADHAAR_SAVE_DRAFT = false;
            window.AADHAAR_EXPLICIT_DRAFT = false;
            window.AADHAAR_TAB_SWITCH_SAVING = false;
            window.AADHAAR_TAB_SWITCH_TARGET = null;
            window._AFTER_DRAFT_SAVE = null;
            try {
                apz.app.AadhaarDetails.rebuildAddressTable && apz.app.AadhaarDetails.rebuildAddressTable();
            } catch (e) {
                ApzCOB.traceFrontEndError(e,"");
                console.warn("Address table rebuild skipped:", e.message);
            }
            apz.app.AadhaarDetails.saveAadhaarDetails();
            return;
        }
        if (apz.childScr === 'documentCapture') {
            let capturedFrom = window.CAPTURE_FROM_APPLICANT;
            if (apz.app.docType === 'Aadhaar') {
                apz.app.documentCapture.mapOcrToAadhaarFields();
                window.AADHAAR_TAB_SWITCH_TARGET = (capturedFrom === 2) ? 'CoApplicant' : 'Applicant';
                window.CAPTURE_FROM_APPLICANT = undefined;
                window.AADHAAR_NEXT_TAB_SWITCH = true;
                window.AADHAAR_FROM_DOC_NEXT = true;
                window.AADHAAR_FROM_DOC_NEXT_FOR = capturedFrom;
                window.AADHAAR_SKIP_SAVE = true;
                window.AADHAAR_PAINT_DOC_ON_LOAD = capturedFrom;
                window.AADHAAR_PAINT_DOC_FOR_CUSTTYPE = capturedFrom;
                $(`#${kmbaseScr}nxtBtn`).prop('disabled', false);
                ApzCOB.launchSubScreen("AadhaarDetails", "KmSourc__Kmbase__KMLaunchCol", "");
                $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
                $(`#${kmbaseScr}AadhaarDetails_hyp`).addClass('active');
            } else if (apz.app.docType === 'Voter ID') {
                if (!apz.app.documentCapture.validateVoterAddressBeforeNext()) return;
                window.KM_CBCHECK_SNAPSHOT = null;
                apz.app.documentCapture.mapOcrToCBFields();
                window.CB_ADDRESS_OVERRIDE_TYPE = "Voter";
                window.CBCHECK_TAB_SWITCH_TARGET = (capturedFrom === 2) ? 'CoApplicant' : 'Applicant';
                window.CAPTURE_FROM_APPLICANT = null;
                ApzCOB.launchSubScreen("CBcheck", "KmSourc__Kmbase__KMLaunchCol", "");
                $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
                $(`#${kmbaseScr}CBcheck_hyp`).addClass('active');
            } else if (apz.app.docType === 'PAN card') {
                window.KM_CBCHECK_SNAPSHOT = null;
                apz.app.documentCapture.mapPanToSession();
                window.CBCHECK_TAB_SWITCH_TARGET = (capturedFrom === 2) ? 'CoApplicant' : 'Applicant';
                window.CAPTURE_FROM_APPLICANT = null;
                ApzCOB.launchSubScreen("CBcheck", "KmSourc__Kmbase__KMLaunchCol", "");
                $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
                $(`#${kmbaseScr}CBcheck_hyp`).addClass('active');
            }
            $('.btn-saveDraft, .btn-reject, .btn-back, .btn-next').show();
            return;
        }
        if (apz.childScr === "CBcheck") {
            if (!apz.app.CBcheck.validateForm() || !apz.app.Kmbase.validateQueryResponse()) return;
            apz.app.CBcheck.createCBCheck();
            return;
        }
        // OTHER INFORMATION (Swaroop changes)
        if (apz.childScr === "OtherInformation") {
            if (apz.app.OtherInformation.fnValidateOtherInformation()) {
                isOtherInfoSaveDraft = '';
                isOtherInfoBack = '';
                isOtherInfoSideBarDraft = false;
                apz.app.Kmbase.NavigateSidebar(5, this);
                apz.app.OtherInformation.fnSaveDraftOrNext(false)
                apz.app.Kmbase.updateSrcVerifiedStages(4, "A", "Y");
                apz.app.Kmbase.addCompleteStatus('KmSourc__Kmbase__OtherInformation_hyp');
                //apz.app.OtherInformation.paintSideBar();
                apz.app.Kmbase.paintSidebarStatus();
                isOtherInfoSideBarDraft = "";
            }
            return;
        }
    } else {
        ApzCOB.handleCBReject();
        //   ApzCOB.fnDisplayMsg(`CB is failed, please reject the application`); 
        return;
    }
};
apz.app.Kmbase.saveDraft = function () {
    window.isVerified = "N";
    if (apz.childScr === "AadhaarDetails") {
        try {
            var _draftAadNo = gApzCOB.currentApplicant;
            var _draftAadCode = (_draftAadNo === 2) ? "C" : "A";
            apz.app.Kmbase.updateSrcVerifiedStages(2, _draftAadCode, "N");
            apz.app.Kmbase.paintSidebarStatus();
        } catch (e) { 
            ApzCOB.traceFrontEndError(e,"");
        }
        window.AADHAAR_SAVE_DRAFT = false;
        window.AADHAAR_EXPLICIT_DRAFT = true;
        window.AADHAAR_TAB_SWITCH_SAVING = false;
        window.AADHAAR_TAB_SWITCH_TARGET = null;
        window._AFTER_DRAFT_SAVE = null;
        apz.app.AadhaarDetails.saveAadhaarDetails(true);
        return;
    }
    if (apz.childScr === "CBcheck") {
        try {
            var _draftCbNo = gApzCOB.currentApplicant;
            var _draftCbCode = (_draftCbNo === 2) ? "C" : "A";
            if (apz.app.Kmbase.getSrcVerifiedStatus(1, _draftCbCode) !== "Y") {
                apz.app.Kmbase.updateSrcVerifiedStages(1, _draftCbCode, "N");
                apz.app.Kmbase.paintSidebarStatus();
            }
        } catch (e) {
            ApzCOB.traceFrontEndError(e,"");
         }
        window.CBCHECK_EXPLICIT_DRAFT = true;
        apz.app.CBcheck.createCBCheck();
        return;
    }
    if (apz.childScr === "BusinessIncome") {
        isBusinessNextButton = false;
        try {
            apz.app.Kmbase.updateSrcVerifiedStages(3, "A", "N");
            apz.app.Kmbase.paintSidebarStatus();
        } catch (e) {
            ApzCOB.traceFrontEndError(e,"");
         }
        window.BUSINESS_EXPLICIT_DRAFT = true;
        apz.app.BusinessIncome.validateOnclickNext(true);
        return;
    }
    if (apz.childScr === "OtherInformation") { // chinna updated this
        //chinna changes start
        // try {
        //     var _draftOtherNo = gApzCOB.currentApplicant;
        //     var _draftOtherCode = (_draftOtherNo === 2) ? "C" : "A";
        //     if (window.isVerified === "N") {
        //         apz.app.Kmbase.updateSrcVerifiedStages(4, _draftOtherCode, "N");
        //     } else {
        //         apz.app.Kmbase.updateSrcVerifiedStages(4, _draftOtherCode, "Y");
        //     }
        //     apz.app.Kmbase.paintSidebarStatus();
        // } catch (e) { }

        // chinna changes 
        isOtherInfoSaveDraft = true;
        isOtherInfoBack = '';
        isOtherInfoSideBarDraft = '';
        apz.app.OtherInformation.fnSaveDraftOrNext(true);
        return;
    }
};
