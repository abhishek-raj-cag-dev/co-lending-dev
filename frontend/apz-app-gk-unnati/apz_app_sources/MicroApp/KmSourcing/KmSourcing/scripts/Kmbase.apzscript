};
apz.app.Kmbase.downloadShownImg = function () {
    let imgScr = kmbaseScr;
    if (apz.childScr === 'BusinessIncome') {
        paintFileName = $(`#${kmScrId}viewUploadedModal .modal-header h1`).text();
        imgScr = 'KmSourc__BusinessIncome__';
    }
    let mergeDocType = ['PRIMARY_KYC', 'SECONDARY_KYC', 'PAN_NUMBER_PHOTO'];
    if (mergeDocType.includes(paintDocType)) {
        let request = {};
        let custType = gApzCOB.currentApplicant === 1 ? 'Applicant' : 'Co-App';
        let params = {};
        request.applicationId = inSessionStore.applicationId;
        request.applicantType = custType;
        request.documentType = paintDocType;
        params.callBackObj = this;
        params.buildReq = "N";
        params.paintResp = "N";
        params.req = request;
        params.appId = gAppId;
        params.ifaceName = "MergeAndDownloadPDF";
        params.async = true;
        params.callBack = apz.app.Kmbase.downloadDocumentCB;
        apz.startLoader();
        apz.server.callServer(params);
    } else {
        ApzCOB.downloadCurrImage(`${imgScr}imgView`, paintFileName);
    }
};
apz.app.Kmbase.downloadDocumentCB = function (params) {
    apz.stopLoader();
    if (ApzCOB.handleServiceCallBacks(params)) {
        try {
            let response = params.res.APZCBO__MergeAndDownloadPDF_Res.apiResponse.ResponseBody.responseObj;
            const base64Response = JSON.parse(response);
            ApzCOB.convertBase64ToPDF(base64Response.base64, params.req.documentType);
        } catch (e) {
            ApzCOB.traceFrontEndError(e,"");
            ApzCOB.showNewCommonErrorModal(technicalErrMsg)
        }
    } else {
        ApzCOB.showNewCommonErrorModal(technicalErrMsg);
    }
};
apz.app.Kmbase.onchangepincode = function (pthis, addressType, callbackFn) {
    if (apz.childScr === 'BusinessIncome') {
        index = pthis.id.split("_")[4];
    }
    let pincode_temp = $(pthis).val();
    if (pincode_temp && pincode_temp.length > 5) {
        window.pincodeAddresstype = addressType;
        window.pincodeAddressElement = pthis.id;
        ApzCOB.fetchpincodeDtls(pincode_temp, addressType, callbackFn);
    }
};
apz.app.Kmbase.paint_pincode = function (params, addressType) {
    let resolvedAddressType = addressType || window.pincodeAddresstype || "";
    let scrId = apz.childScr === "documentCapture" && $('#KmSourc__Kmbase__Edit_OCR_Modal').is(':visible') ? kmbaseScr : `KmSourc__${apz.childScr}__`;
    $(`#${scrId}${resolvedAddressType}City`).val(params.city).trigger("change");
    $(`#${scrId}${resolvedAddressType}District`).val(params.district).trigger("change");
    $(`#${scrId}${resolvedAddressType}State`).val(params.state).trigger("change");
    $(`#${scrId}${resolvedAddressType}Country`).val(params.country).trigger("change");
    $(`#${scrId}${resolvedAddressType}Area`).val(params.area).trigger("change");
    $(`#${scrId}${resolvedAddressType}Landmark`).val(params.landMark).trigger("change");
    if (resolvedAddressType === 'addPre') {
        $(`#${scrId}pincode`).val(params?.pincode ?? '');
    }
};
apz.app.otpMoveForward = function (current, nextId) {
    if (current.value && current.value.length === 1 && nextId) {
        document.getElementById(`${kmbaseScr + nextId}`)?.focus();
    }
};
apz.app.otpMoveBackward = function (event, current, prevId) {
    if (event.key === 'Backspace' && current.value === '' && prevId) {
        document.getElementById(`${kmbaseScr + prevId}`)?.focus();
    }
};
apz.app.Kmbase.populateDropdown = function (allOptions, Id) {
    let TempArr = allOptions.map(o => ({
        "desc": o,
        "val": o
    }));
    apz.populateDropdown(document.getElementById(Id), TempArr);
};
apz.app.Kmbase.getDocLimits = function (docType) {
    if (docType === "CHANGED_BANK_DOCS") {
        docType = "BANK_ACCOUNT_PROOF";
    }
    let config = docMaxAndMand.find(d => d.key === docType);
    if (!config) return {
        max: 2,
        min: 1
    };
    let parts = config.value.split('~');
    return {
        max: parseInt(parts[0]),
        min: parseInt(parts[1])
    };
};
apz.app.Kmbase.toggleCaptureSection = function (docType, containerIds) {
    const STRICT_DOC_TYPES = ["SECONDARY_KYC", "CUSTOMER_PHOTOGRAPH", "PRIMARY_KYC", "PAN_NUMBER_PHOTO"];
    if (!STRICT_DOC_TYPES.includes(docType)) {
        containerIds.forEach(({
            captureBtn
        }) => $(`#${captureBtn}`).removeClass('sno'));
        return;
    }
    let custDtlId = gApzCOB.currentApplicant === 1 ? gApzCOB.userDetails.custDtlId : gApzCOB.userDetails.CoApplicantCustomerId;
    let docs = (inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList || []).filter(d => d.payload.documentType ===
        docType && parseInt(d.custDtlId) === parseInt(custDtlId));
    let {
        max
    } = apz.app.Kmbase.getDocLimits(docType);
    containerIds.forEach(({
        captureBtn,
        side
    }) => {
        let relevantDocs = docs;
        if ((docType === "SECONDARY_KYC" || docType === "PRIMARY_KYC" || docType === "PAN_NUMBER_PHOTO") && side) {
            relevantDocs = docs.filter(d => d.payload.docLevel == (side === "Front" ? "1" : "2"));
            max = 1;
        }
        if (relevantDocs.length >= max) {
            $(`#${captureBtn}`).addClass('sno');
        } else {
            $(`#${captureBtn}`).removeClass('sno');
        }
    });
};
apz.app.Kmbase.getCaptureConfig = function (docType) {
    var AadhaarScrId = 'KmSourc__AadhaarDetails__';
    var documentCaptureScrId = 'KmSourc__documentCapture__';
    const map = {
        "CUSTOMER_PHOTOGRAPH": [{
            captureBtn: AadhaarScrId + "custImgCaptureBtn"
        }],
        "RESIDENCE_PREMISE_PHOTO": [{
            captureBtn: AadhaarScrId + "resImgCaptureBtn"
        }],
        "ADDRESS_PROOF": [{
            captureBtn: AadhaarScrId + "addrImgCaptureBtn"
        }],
        "RELATIONSHIP_PROOF": [{
            captureBtn: AadhaarScrId + "relImgCaptureBtn"
        }],
        "SECONDARY_KYC": [{
            captureBtn: documentCaptureScrId + "frontCaptureBtn",
            side: "Front"
        }, {
            captureBtn: documentCaptureScrId + "backCaptureBtn",
            side: "Back"
        }],
        "PRIMARY_KYC": [{
            captureBtn: documentCaptureScrId + "frontCaptureBtn",
            side: "Front"
        }, {
            captureBtn: documentCaptureScrId + "backCaptureBtn",
            side: "Back"
        }],
        "PAN_NUMBER_PHOTO": [{
            captureBtn: documentCaptureScrId + "frontCaptureBtn",
            side: "Front"
        }, {
            captureBtn: documentCaptureScrId + "backCaptureBtn",
            side: "Back"
        }]
    };
    return map[docType] || [];
};

function paintClonedDoc(newId, baseName, index, doc, docType) {
    if (!newId) return;
    let $row = $("#" + newId);
    if (!$row.length) return;
    if (!doc.appDocId) return;
    if (!doc.payload || !doc.payload.documentFileName || doc.payload.documentFileName.trim() === '') return;
    if (newId === 'KmSourc__AadhaarDetails__aadhaarImg_1') return;
    // $row.find(".docName a.ett-hypl span").text(`${baseName}_${index + 1}.jpg`);
    $row.find(".docName a.ett-hypl span").text(`${baseName.replace('_', ' ')}`);
    $row.attr('data-id', doc.appDocId);
    $row.attr('data-doc-type', docType);
    if (docType === "ADDRESS_PROOF") {
        $row.attr('data-doc-desc', (doc.payload.documentDesc || "PRESENT").toUpperCase());
    }
    $row.addClass('km-doc-upload-row');
    $row.removeClass('sno');
}
apz.app.Kmbase.NavigateSidebar = function (pstageId, pthis) {
    if (apz.childScr === "OtherInformation" && isOtherInfoSideBarDraft !== false) {
        isOtherInfoSideBarDraft = true;
    }
    window.picture = $('#KmSourc__Kmbase__imgView');
    ApzCOB.intializeGuillotine(picture);
    var stage = parseInt(pstageId);
    $(`#${kmbaseScr}sendback`).addClass('sno');
    if (LoggedInUserDetails.loginResponse.addInfo1 == 'KM') {
        if ([21, 22, 2, 3, 4, 5].includes(stage) && (apz.app.Kmbase.getSrcVerifiedStatus(1, "A") !== 'Y' || apz.app.Kmbase.getSrcVerifiedStatus(1, "C") !== 'Y')) {
            ApzCOB.fnDisplayMsg("Please complete the CB check stage verification.", "E");
            if ($('#KmSourc__Kmbase__sidebar_col').hasClass('sideon')) {
                apz.app.Kmbase.toggleSidebar();
            } //close sidebar
            return;
        }
    }
    if (LoggedInUserDetails.loginResponse.addInfo1 == 'BM' && stage == 6) {
        window.previousScreenId = apz.childScr;
        window.previousMicroAppId = apz.currAppId;
        if (['BusinessIncome', 'OtherInformation'].includes(apz.childScr)) window.previousKmScrId = kmScrId;
        iskmPreview = true;
        let previewrow = BaseScrId + "preview_row";
        ApzCOB.toggleModal("APZCBO__BaseScreens__preview_modal")
        ApzCOB.launchSubScreen("KMReviewConfirm", "APZCBO__BaseScreens__preview_modal_content", "");
        // apz.app.Kmbase.toggleSidebar();
        return;
    }
    function doNavigate() {
        $("#" + kmbaseScr + "sidebarForm a").removeClass("active");
        $(pthis).addClass("active");
        if (apz.childScr === "KMReviewConfirm") {
            $("#" + kmbaseScr + "nxtBtn").removeClass("sno");
            $("#" + kmbaseScr + "SaveDraft").removeClass("sno");
            $("#" + kmbaseScr + "confirmBtn").addClass("sno");
        }
        if ($('#KmSourc__Kmbase__sidebar_col').hasClass('sideon')) {
            apz.app.Kmbase.toggleSidebar();
        }
        if (stage === 11 || stage === 12) {
            $("#" + kmbaseScr + "sidebarForm a").removeClass("active");
            $("#" + kmbaseScr + "CBcheck_hyp").addClass("active");
            $(pthis).addClass("active");
            window.CBCHECK_TAB_SWITCH_TARGET = (stage === 11) ? "Applicant" : "CoApplicant";
            if (apz.childScr === "documentCapture") {
                $(".btn-saveDraft, .btn-reject, .btn-back, .btn-next").show();
            }
            // apz.app.Kmbase.toggleSidebar();
            if (apz.childScr !== "CBcheck") {
                ApzCOB.launchSubScreen("CBcheck", kmbaseScr + "KMLaunchCol");
            } else {
                var cbTabs = $(".cbcheckSubMenu");
                if (stage === 12 && cbTabs.length > 1) {
                    apz.app.CBcheck.handletabSwitch(cbTabs.eq(1), "CoApplicant");
                } else {
                    apz.app.CBcheck.handletabSwitch(cbTabs.eq(0), "Applicant");
                }
            }
            return;
        }
        if (stage === 21 || stage === 22) {
            $("#" + kmbaseScr + "sidebarForm a").removeClass("active");
            $("[id*='AadhaarDetails_hyp']").addClass("active");
            $(pthis).addClass("active");
            window.AADHAAR_TAB_SWITCH_TARGET = (stage === 21) ? "Applicant" : "CoApplicant";
            if (apz.childScr === "documentCapture") {
                $(".btn-saveDraft, .btn-reject, .btn-back, .btn-next").show();
            }
            // apz.app.Kmbase.toggleSidebar();
            if (apz.childScr !== "AadhaarDetails") {
                ApzCOB.launchSubScreen("AadhaarDetails", kmbaseScr + "KMLaunchCol");
            } else {
                var target = window.AADHAAR_TAB_SWITCH_TARGET;
                window.AADHAAR_TAB_SWITCH_TARGET = null;
                var aadhTabs = $(".aadhaarSubMenu");
                if (target === "CoApplicant" && aadhTabs.length > 1) {
                    apz.app.AadhaarDetails._doTabSwitch(aadhTabs.eq(1), "CoApplicant");
                } else {
                    apz.app.AadhaarDetails._doTabSwitch(aadhTabs.eq(0), "Applicant");
                }
            }
            return;
        }
        var scrName = Object.keys(window.KM_NEWTAGES || {}).find(function (key) {
            return window.KM_NEWTAGES[key].id === stage;
        });
        if (!apz.isNull(scrName)) {
            if (apz.childScr === "documentCapture") {
                $(".btn-saveDraft, .btn-reject, .btn-back, .btn-next").show();
            }
            // apz.app.Kmbase.toggleSidebar();
            if (scrName === "AadhaarDetails") {
                gApzCOB.currentApplicant = 1;
                window.AADHAAR_TAB_SWITCH_TARGET = "Applicant";
            }
            ApzCOB.launchSubScreen(scrName, kmbaseScr + "KMLaunchCol");
        }
    }
    apz.app.Kmbase.confirmNavigateOnly(doNavigate, pstageId);
};
apz.app.Kmbase.confirmNavigateOnly = function (onYes, pstageId) {
    window._CONFIRM_NAV_ONLY_CALLBACK = onYes;
    const currentScreen = apz.childScr || "";
    ApzCOB.showNewCommonConfirmationModal({
        text: "Are you sure you want to move to a different section?",
        Btn1: {
            text: "Yes",
            onClick: `apz.app.Kmbase._confirmNavOnlyYes("${currentScreen}", ${pstageId})`
        },
        Btn2: {
            text: "No",
            onClick: "apz.app.Kmbase._confirmNavOnlyNo()"
        }
    });
};
apz.app.Kmbase._confirmNavOnlyYes = function (currentScreen, pstageId) {
    if (currentScreen === 'OtherInformation') { //new navigation fixes 10th june
        if (isOtherInfoBack === true) {
            //apz.app.Kmbase.saveDraft();
            //apz.app.OtherInformation.fnSaveDraftOrNext(true);
            apz.app.OtherInformation.paintSideBar();
        } else if (isOtherInfoSideBarDraft === true) {
            isOtherInfoSaveDraft = "";
            apz.app.OtherInformation.fnSaveDraftOrNext(true); // 9th july bank doc fixes
        }
    }
    if (currentScreen === 'BusinessIncome') {
        const scrName = Object.keys(window.KM_NEWTAGES || {}).find(function (key) {
            return window.KM_NEWTAGES[key].id === parseInt(pstageId);
        });
        if (currentScreen !== scrName) {
            BUSINESS_EXPLICIT_DRAFT_SKIP_POPUP = true;
            if (!isBusinessNextButton) {
                apz.app.Kmbase.saveDraft();
            }
        }
    }
    if(currentScreen === 'KMReviewConfirm'){
        $(`#${kmbaseScr}nxtBtn`).removeClass('sno');
        $(`#${kmbaseScr}confirmBtn`).addClass('sno');
    }
    ApzCOB.closeCommonModal(`newCommonConfModal`);
    if (typeof window._CONFIRM_NAV_ONLY_CALLBACK === "function") {
        var fn = window._CONFIRM_NAV_ONLY_CALLBACK;
        window._CONFIRM_NAV_ONLY_CALLBACK = null;
        fn();
    }
};
apz.app.Kmbase._confirmNavOnlyNo = function () {
    if ($('#KmSourc__Kmbase__sidebar_col').hasClass('sideon')) {
    apz.app.Kmbase.toggleSidebar();
    }
    ApzCOB.closeCommonModal(`newCommonConfModal`);
    window._CONFIRM_NAV_ONLY_CALLBACK = null;
};
apz.app.Kmbase.confirmNavigate = function (onYes) {
    window._CONFIRM_NAV_CALLBACK = onYes;
    ApzCOB.showNewCommonConfirmationModal({
        text: "Are you sure you want to move to a different section?",
        Btn1: {
            text: "Yes",
            onClick: "apz.app.Kmbase._confirmNavYes()"
        },
        Btn2: {
            text: "No",
            onClick: "apz.app.Kmbase._confirmNavNo()"
        }
    });
};
apz.app.Kmbase._confirmNavYes = function () {
    ApzCOB.closeCommonModal(`newCommonConfModal`);
    if (typeof window._CONFIRM_NAV_CALLBACK === "function") {
        let fn = window._CONFIRM_NAV_CALLBACK;
        window._CONFIRM_NAV_CALLBACK = null;
        fn();
    }
};
apz.app.Kmbase._confirmNavNo = function () {
    ApzCOB.closeCommonModal(`newCommonConfModal`);
    window._CONFIRM_NAV_CALLBACK = null;
};
apz.app.Kmbase.getStageNoForScreen = function (screenName) {
    return (window.KMScrIdMapping && window.KMScrIdMapping[screenName]) || null;
};
apz.app.Kmbase.updateSrcVerifiedStages = function (stageNo, custCode, status) {
    if (!stageNo || !custCode || !status) return;
    if (!inSessionStore.srcVerifiedStages) inSessionStore.srcVerifiedStages = [];
    var keyBase = stageNo + "_" + custCode;
    var key = keyBase + "_" + status;
    inSessionStore.srcVerifiedStages = inSessionStore.srcVerifiedStages.filter(function (s) {
        return s.indexOf(keyBase + "_") !== 0;
    });
    inSessionStore.srcVerifiedStages.push(key);
};
apz.app.Kmbase.getSrcVerifiedStatus = function (stageNo, custCode) {
    var stages = inSessionStore.srcVerifiedStages || [];
    var keyBase = stageNo + "_" + custCode + "_";
    for (var i = 0; i < stages.length; i++) {
        if (stages[i].indexOf(keyBase) === 0) {
            return stages[i].split("_")[2];
        }
    }
    return null;
};
apz.app.Kmbase.paintSidebarStatus = function () {
    var tabStages = [{
        stageNo: 1,
        parent: "CBcheck_hyp",
        app: "AppCBcheck_hyp",
        coapp: "CoAppCBcheck_hyp"
    }, {
        stageNo: 2,
        parent: "AadhaarDetails_hyp",
        app: "AppAadhaarDetails_hyp",
        coapp: "CoAppAadhaarDetails_hyp"
    }];
    var singleStages = [{
        stageNo: 3,
        parent: "BusinessIncome_hyp"
    }, {
        stageNo: 4,
        parent: "OtherInformation_hyp"
    }];
    tabStages.forEach(function (s) {
        var appStatus = apz.app.Kmbase.getSrcVerifiedStatus(s.stageNo, "A");
        var coappStatus = apz.app.Kmbase.getSrcVerifiedStatus(s.stageNo, "C");
        apz.app.Kmbase._paintHyp(s.app, appStatus);
        apz.app.Kmbase._paintHyp(s.coapp, coappStatus);
        var parentStatus;
        if (appStatus === "Y" && coappStatus === "Y") {
            parentStatus = "Y";
        } else if (appStatus === "N" || coappStatus === "N") {
            parentStatus = "N";
        } else if (appStatus === "Y" && coappStatus === null) {
            parentStatus = "N";
        } else {
            parentStatus = null;
        }
        apz.app.Kmbase._paintHyp(s.parent, parentStatus);
    });
    singleStages.forEach(function (s) {
        var status = apz.app.Kmbase.getSrcVerifiedStatus(s.stageNo, "A");
        apz.app.Kmbase._paintHyp(s.parent, status);
    });
    let { srcStatDetails } = inSessionStore;
    if (["BMPUSHBACK", "IPUSHBACK", "CAPUSHBACK"].includes(window.ApplicationStatus)) {
        srcStatDetails = timeLineSrcStat;
    }
    if (srcStatDetails?.length > 0) {
        apz.app.Kmbase.addErrorStatusQueried();
    }
    apz.app.Kmbase.toggleReviewConfirmSidebar();
};
apz.app.Kmbase._paintHyp = function (hypId, status) {
    var fullId = kmbaseScr + hypId;
    var el = document.getElementById(fullId);
    if (!el) return;
    var childHypSuffixes = ["AppCBcheck_hyp", "CoAppCBcheck_hyp", "AppAadhaarDetails_hyp", "CoAppAadhaarDetails_hyp"];
    var isChildHyp = childHypSuffixes.includes(hypId);
    var wasActive = $(el).hasClass('active');
    if (status === "Y") {
        apz.app.Kmbase.addCompleteStatus(fullId);
    } else if (status === "N") {
        if (isChildHyp) {
            $(`#${fullId} svg`).removeClass('error suc inprg').addClass('inprg');
            $(`#${fullId} use`).attr("xlink:href", "#icon-sideprg");
        } else {
            apz.app.Kmbase.addInprogressStatus(fullId);
        }
    } else {
        if (isChildHyp) {
            $(`#${fullId} svg`).removeClass('error suc inprg');
            $(`#${fullId} use`).attr("xlink:href", "#icon-sidechldopt");
        } else {
            apz.app.Kmbase.clearIcons(fullId);
        }
    }
    if (wasActive) {
        $(el).addClass('active');
    }
};
apz.app.Kmbase.markStageStatus = function (screenName, applicantNo, isVerified) {
    var stageNo = apz.app.Kmbase.getStageNoForScreen(screenName);
    var custCode = (applicantNo === 2) ? "C" : "A";
    var status = isVerified ? "Y" : "N";
    if (stageNo) {
        apz.app.Kmbase.updateSrcVerifiedStages(stageNo, custCode, status);
        apz.app.Kmbase.paintSidebarStatus();
    }
};
apz.app.Kmbase.initSrcVerifiedStages = function () {
    if (!inSessionStore.srcVerifiedStages) {
        inSessionStore.srcVerifiedStages = [];
    }
    apz.app.Kmbase.paintSidebarStatus();
};
apz.app.Kmbase.toggleReviewConfirmSidebar = function () {
    var reviewHypId = kmbaseScr + "KMReviewConfirm_hyp";
    var cbApp = apz.app.Kmbase.getSrcVerifiedStatus(1, "A");
    var cbCoApp = apz.app.Kmbase.getSrcVerifiedStatus(1, "C");
    var aadhaarApp = apz.app.Kmbase.getSrcVerifiedStatus(2, "A");
    var aadhaarCoApp = apz.app.Kmbase.getSrcVerifiedStatus(2, "C");
    var business = apz.app.Kmbase.getSrcVerifiedStatus(3, "A");
    var otherInfo = apz.app.Kmbase.getSrcVerifiedStatus(4, "A");

    var allVerified = (cbApp === "Y" && cbCoApp === "Y" && aadhaarApp === "Y" && aadhaarCoApp === "Y" && business === "Y" && otherInfo === "Y");
    var isQueryResponsePending = ApplicationStatus !== 'PENDING' && $('.ett-hypl svg').hasClass('error')
    if (allVerified && !isQueryResponsePending) {
        $("#" + reviewHypId).removeClass("disabled-sidebar");
        $("#" + reviewHypId).attr("onclick", "apz.app.Kmbase.NavigateSidebar(5, this)");
    } else {
        $("#" + reviewHypId).addClass("disabled-sidebar");
    }
};
apz.app.Kmbase.toggleSidebarItemsVisibility = function () {
    var cbApp = apz.app.Kmbase.getSrcVerifiedStatus(1, "A");
    var cbCoApp = apz.app.Kmbase.getSrcVerifiedStatus(1, "C");
    var $coAppCB = $(`#${kmbaseScr}CoAppCBcheck_hyp`);
    if (cbApp === "Y") {
        $coAppCB.removeClass("disabled-sidebar").attr("onclick", "apz.app.Kmbase.NavigateSidebar(12, this)");
    } else {
        $coAppCB.addClass("disabled-sidebar");
    }
    var bothCBDone = (cbApp === "Y" && cbCoApp === "Y");
    var laterStages = [{
        id: "AppAadhaarDetails_hyp",
        nav: 21
    }, {
        id: "CoAppAadhaarDetails_hyp",
        nav: 22
    }, {
        id: "AadhaarDetails_hyp",
        nav: 2
    }, {
        id: "BusinessIncome_hyp",
        nav: 3
    }, {
        id: "OtherInformation_hyp",
        nav: 4
    }];
    laterStages.forEach(function (s) {
        var $el = $(`#${kmbaseScr}${s.id}`);
        if (!$el.length) return;
        if (bothCBDone) {
            $el.removeClass("disabled-sidebar").attr("onclick", `apz.app.Kmbase.NavigateSidebar(${s.nav}, this)`);
        } else {
            $el.addClass("disabled-sidebar");
        }
    });
};
apz.app.Kmbase.restoreSnapshotData = function (savedStages, savedCustomerDetailsList, savedAddressDetailsWrapperList, savedCbLoanDetails,
    savedCbExistingLoanDetailsWrapperList, savedCbCibilDetails) {
    let serverStages = inSessionStore.srcVerifiedStages || [];
    let mergedStages = savedStages.slice();
    serverStages.forEach(function (serverEntry) {
        let keyBase = serverEntry.split('_').slice(0, 2).join('_') + '_';
        let alreadyHave = mergedStages.some(function (s) {
            return s.indexOf(keyBase) === 0;
        });
        if (!alreadyHave) mergedStages.push(serverEntry);
    });
    inSessionStore.srcVerifiedStages = mergedStages;
    if (savedCustomerDetailsList && savedCustomerDetailsList.length > 0) {
        let updatedList = inSessionStore.customerDetailsList || [];
        savedCustomerDetailsList.forEach(function (savedEntry) {
            let match = updatedList.find(function (e) {
                return String(e.custDtlId) === String(savedEntry.custDtlId);
            });
            if (!match || !match.payload || Object.keys(match.payload).length === 0) {
                if (match) {
                    match.payload = savedEntry.payload;
                } else {
                    updatedList.push(savedEntry);
                }
            } else {
                match.payload = Object.assign({}, match.payload, savedEntry.payload);
                match.mobileNumber = savedEntry.mobileNumber || match.mobileNumber;
                match.customerName = savedEntry.customerName || match.customerName;
            }
        });
        inSessionStore.customerDetailsList = updatedList;
    }
    if (savedAddressDetailsWrapperList && savedAddressDetailsWrapperList.length > 0) {
        if (!inSessionStore.addressDetailsWrapperList || inSessionStore.addressDetailsWrapperList.length === 0) {
            inSessionStore.addressDetailsWrapperList = savedAddressDetailsWrapperList;
        } else {
            let savedAddrList = savedAddressDetailsWrapperList[0]?.addressDetailsList || [];
            let updatedAddrList = inSessionStore.addressDetailsWrapperList[0].addressDetailsList || [];
            savedAddrList.forEach(function (savedWrapper) {
                let match = updatedAddrList.find(function (w) {
                    return String(w.custDtlId) === String(savedWrapper.custDtlId) && w.addressType === savedWrapper.addressType;
                });
                if (!match || !match.payload || !match.payload.addressList || match.payload.addressList.length === 0) {
                    if (match) {
                        match.payload = savedWrapper.payload;
                    } else {
                        updatedAddrList.push(savedWrapper);
                    }
                } else {
                    let serverAddrList = match.payload.addressList;
                    let savedAddrEntries = savedWrapper.payload.addressList || [];
                    savedAddrEntries.forEach(function (savedAddr) {
                        let serverMatch = serverAddrList.find(function (a) {
                            return a.addressType === savedAddr.addressType;
                        });
                        if (serverMatch) {
                            Object.assign(serverMatch, savedAddr);
                        } else {
                            serverAddrList.push(savedAddr);
                        }
                    });
                }
            });
            inSessionStore.addressDetailsWrapperList[0].addressDetailsList = updatedAddrList;
        }
    }
    if (savedCbLoanDetails) {
        inSessionStore.loanDetails = savedCbLoanDetails;
    }
    if (savedCbExistingLoanDetailsWrapperList && savedCbExistingLoanDetailsWrapperList.length > 0) {
        inSessionStore.existingLoanDetailsWrapperList = savedCbExistingLoanDetailsWrapperList;
    }
    if (savedCbCibilDetails && savedCbCibilDetails.length > 0) {
        if (apz.isNull(inSessionStore.cibilDetailsWrapperList) || inSessionStore.cibilDetailsWrapperList.length === 0) {
            inSessionStore.cibilDetailsWrapperList = savedCbCibilDetails;
        } else {
            savedCbCibilDetails.forEach(function (savedCb) {
                let idx = inSessionStore.cibilDetailsWrapperList.findIndex(function (item) {
                    return parseInt(item.cibilDetails.custDtlId) === parseInt(savedCb.cibilDetails.custDtlId);
                });
                if (idx < 0) {
                    inSessionStore.cibilDetailsWrapperList.push(savedCb);
                }
            });
        }
    }
};
apz.app.Kmbase.navigateToFirstPendingStage = function () {
    if (window.currentApplication === 'Rejected') {
        ApzCOB.launchSubScreen("KMReviewConfirm", `${kmbaseScr}KMLaunchCol`);
        $(`#${kmbaseScr}nxtBtn`).addClass('sno');
        $(`#${kmbaseScr}SaveDraft`).addClass('sno');
        $(`#${kmbaseScr}sidebarmenu`).addClass('sno');
        $(`#${kmbaseScr}rejectButton`).addClass('sno');
        $(`#${kmbaseScr}businessIconRow`).addClass('rej');
        $(`#${kmbaseScr}reInitiateBtn`).removeClass('sno');
        return;
    } else {
        $(`#${kmbaseScr}nxtBtn`).removeClass('sno');
        $(`#${kmbaseScr}SaveDraft`).removeClass('sno');
        $(`#${kmbaseScr}sidebarmenu`).removeClass('sno');
        $(`#${kmbaseScr}rejectButton`).removeClass('sno');
        $(`#${kmbaseScr}businessIconRow`).removeClass('rej');
        $(`#${kmbaseScr}reInitiateBtn`).addClass('sno');
    }
    if (FIRST_QRY_STAGE) {
        if(FIRST_QRY_STAGE.scrnName == 'CBcheck'){
            window.CBCHECK_TAB_SWITCH_TARGET = FIRST_QRY_STAGE.custType === 'app' ?'Applicant': 'CoApplicant';
        } else if(FIRST_QRY_STAGE.scrnName == 'AadhaarDetails') {
            window.AADHAAR_TAB_SWITCH_TARGET = FIRST_QRY_STAGE.custType === 'app' ?'Applicant': 'CoApplicant';
        }
        ApzCOB.launchSubScreen(FIRST_QRY_STAGE.scrnName, `${kmbaseScr}KMLaunchCol`);
        return;
    }
    var cbApp = apz.app.Kmbase.getSrcVerifiedStatus(1, "A");
    var cbCoApp = apz.app.Kmbase.getSrcVerifiedStatus(1, "C");
    var aadApp = apz.app.Kmbase.getSrcVerifiedStatus(2, "A");
    var aadCoApp = apz.app.Kmbase.getSrcVerifiedStatus(2, "C");
    var business = apz.app.Kmbase.getSrcVerifiedStatus(3, "A");
    var otherInfo = apz.app.Kmbase.getSrcVerifiedStatus(4, "A");
    if (cbApp !== "Y") {
        window.CBCHECK_TAB_SWITCH_TARGET = 'Applicant';
        ApzCOB.launchSubScreen("CBcheck", `${kmbaseScr}KMLaunchCol`);
        $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
        $(`#${kmbaseScr}CBcheck_hyp`).addClass('active');
        $(`#${kmbaseScr}AppCBcheck_hyp`).addClass('active');
        return;
    }
    if (cbCoApp !== "Y") {
        window.CBCHECK_TAB_SWITCH_TARGET = 'CoApplicant';
        ApzCOB.launchSubScreen("CBcheck", `${kmbaseScr}KMLaunchCol`);
        $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
        $(`#${kmbaseScr}CBcheck_hyp`).addClass('active');
        $(`#${kmbaseScr}CoAppCBcheck_hyp`).addClass('active');
        return;
    }
    if (aadApp !== "Y") {
        window.AADHAAR_TAB_SWITCH_TARGET = 'Applicant';
        ApzCOB.launchSubScreen("AadhaarDetails", `${kmbaseScr}KMLaunchCol`);
        $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
        $(`#${kmbaseScr}AadhaarDetails_hyp`).addClass('active');
        $(`#${kmbaseScr}AppAadhaarDetails_hyp`).addClass('active');
        return;
    }
    if (aadCoApp !== "Y") {
        window.AADHAAR_TAB_SWITCH_TARGET = 'CoApplicant';
        ApzCOB.launchSubScreen("AadhaarDetails", `${kmbaseScr}KMLaunchCol`);
        $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
        $(`#${kmbaseScr}AadhaarDetails_hyp`).addClass('active');
        $(`#${kmbaseScr}CoAppAadhaarDetails_hyp`).addClass('active');
        return;
    }
    if (business !== "Y") {
        ApzCOB.launchSubScreen("BusinessIncome", `${kmbaseScr}KMLaunchCol`);
        $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
        $(`#${kmbaseScr}BusinessIncome_hyp`).addClass('active');
        return;
    }
    if (otherInfo !== "Y") {
        ApzCOB.launchSubScreen("OtherInformation", `${kmbaseScr}KMLaunchCol`);
        $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
        $(`#${kmbaseScr}OtherInformation_hyp`).addClass('active');
        return;
    }
    let sentBackBy = window.lastWorkFlw?.stage;
    if (ApplicationStatus === 'CAPUSHBACK' || (sentBackBy && sentBackBy.includes('Credit Assessment'))) {
        window.CBCHECK_TAB_SWITCH_TARGET = 'Applicant';
        ApzCOB.launchSubScreen("CBcheck", `${kmbaseScr}KMLaunchCol`);
        $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
        $(`#${kmbaseScr}CBcheck_hyp`).addClass('active');
        $(`#${kmbaseScr}AppCBcheck_hyp`).addClass('active');
        return;
    }
    let curStageName = (typeof KM_CURR_STAGE_NAME == 'undefined' || apz.isNull(KM_CURR_STAGE_NAME)) ? apz.childScr : KM_CURR_STAGE_NAME;
    if (curStageName !== 'KMReviewConfirm') {
        ApzCOB.launchSubScreen("KMReviewConfirm", `${kmbaseScr}KMLaunchCol`);
    }
    $(`#${kmbaseScr}sidebarForm a`).removeClass('active');
    $(`#${kmbaseScr}KMReviewConfirm_hyp`).addClass('active');
    $(`#${kmbaseScr}nxtBtn`).addClass('sno');
    $(`#${kmbaseScr}SaveDraft`).addClass('sno');
    if (apz.childScr == "KMReviewConfirm") {
        $(`#${kmbaseScr}confirmBtn`).removeClass('sno');
    }
};
apz.app.Kmbase.closeCnfmMdl = function () {
    $(`#${kmbaseScr}conFormation_mdl_close`).click();
};
apz.app.Kmbase.createLoan = function (currentScreenId, currentStageNo) {
    let {
        createTs,
        updateTs,
        applicationDate,
        lockTs,
        ...filteredData
    } = inSessionStore.applicationMaster;
    inSessionStore.applicationMaster = filteredData;
    let role = '';
    if (gApzCOB.LoggedInUserDetails.loginResponse.addInfo1 == 'BM') {
        role = gApzCOB.LoggedInUserDetails.loginResponse.addInfo1;
    }
    let req = {
        apiRequest: {
            interfaceName: "CreateLoan",
            appId: gAppId,
            userId: gApzCOB.LoggedInUserDetails.loginResponse.userDet.id,
            requestObj: {
                isNewSourcing: "Y",
                isStageVerified: isVerified,
                appId: gApzCOB.userDetails.appId,
                applicationId: gApzCOB.userDetails.applicationId,
                versionNum: window.versionNum,
                isExistingCustomer: "",
                applicationMaster: {
                    ...inSessionStore.applicationMaster,
                    currentScreenId: currentScreenId,
                    currentStageNo: parseInt(currentStageNo)
                },
                workflow: {
                    currentRole: role
                }
            }
        }
    };
    if (["BMPUSHBACK", "IPUSHBACK", "CAPUSHBACK"].includes(window.ApplicationStatus))
        req.apiRequest.requestObj.queryResponse = apz.app.Kmbase.prepareQueryResponse();
    if (parseInt(currentStageNo) === 3) {
        bcmpiIncomeDetailsWrapper = apz.app.BusinessIncome.getbcmpiIncomeDetailsWrapper();
        addressDetailsWrapperList = apz.app.BusinessIncome.addressDetailsWrapperList();
        req.apiRequest.requestObj = {
            ...req.apiRequest.requestObj,
            "bcmpiIncomeDetailsWrapper": bcmpiIncomeDetailsWrapper,
            "addressDetailsWrapperList": addressDetailsWrapperList
        }
    }
    apz.startLoader();
    setTimeout(() => {
        ApzCOB.serverBuildParam(gAppId, "CreateLoan", "N", "N", req, false, apz.app.Kmbase.createLoanCB);
    }, 1000);
};
apz.app.Kmbase.createLoanCB = function (params) {
    try {
        apz.stopLoader();
        if (ApzCOB.handleServiceCallBacks(params)) {
            ApzCOB.updateInsessionData(params);
            if (BUSINESS_EXPLICIT_DRAFT_SKIP_POPUP) {
                BUSINESS_EXPLICIT_DRAFT_SKIP_POPUP = false;
                return;
            }
            if (window.BUSINESS_EXPLICIT_DRAFT) {
                window.BUSINESS_EXPLICIT_DRAFT = false;
                ApzCOB.showNewCommonSuccessModal({
                    text: "Draft saved successfully",
                    Btn: {
                        text: "OK",
                        onClick: "ApzCOB.closeCommonModal(`newCommonSuccModal`)"
                    }
                });
                return;
            }
            isBusinessNextButton = false;
            if (KM_CURR_STAGE_NO === 3) {
                $("#KmSourc__Kmbase__OtherInformation_hyp").removeClass("disabled-sidebar");
                $("#KmSourc__Kmbase__OtherInformation_hyp").attr("onclick", "apz.app.Kmbase.NavigateSidebar(4, this)");
                apz.app.Kmbase.paintSidebarStatus();
                ApzCOB.launchSubScreen("OtherInformation", kmbaseScr + "KMLaunchCol");
                // $("#KmSourc__Kmbase__OtherInformation_hyp").click();
            }
        } else {
            isBusinessNextButton = false;
            ApzCOB.fnDisplayMsg("Failed to save Income details", "E");
        }
    } catch (e) {
        ApzCOB.traceFrontEndError(e,"");
        apz.stopLoader();
        ApzCOB.fnDisplayMsg(ApzCOB.getDescfromLitCode("LIT_COMM_ERR_TXT_TECHNICAL"), "E");
    }
}
apz.app.Kmbase.paintDocInScreen = function (docKey, forceApplicantNo) {
    let cfg = window.KM_DOC_VIEWER_CONFIG[docKey];
    if (!cfg) return;
    let applicantNo = forceApplicantNo || gApzCOB.currentApplicant;
    let isApplicant = (applicantNo === 1);
    let custDtlId = isApplicant ? gApzCOB.userDetails.custDtlId : gApzCOB.userDetails.CoApplicantCustomerId;
    let docList = inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList || [];
    let docs = docList.filter(d => d.payload.documentType === cfg.docType && parseInt(d.custDtlId) === parseInt(custDtlId));
    let frontDoc = docs.find(d => d.payload.docLevel == cfg.frontLevel);
    let backDoc = docs.find(d => d.payload.docLevel == cfg.backLevel);
    let $row = $(`#${cfg.rowId}`);
    let $captureBtn = $(`#${cfg.captureBtnId}`);

    function hideDocRow() {
        $row.removeClass('km-doc-upload-row').addClass('sno');
        $captureBtn.removeClass('sno');
    }

    function showDocRow() {
        $row.addClass('km-doc-upload-row').removeClass('sno');
        $captureBtn.addClass('sno');
    }
    let bothDocsExist = !!(frontDoc?.appDocId && backDoc?.appDocId);
    if (!bothDocsExist) {
        hideDocRow();
        if(docKey === 'SECONDARY_KYC') {
            $(`#${window.AadhaarScrId}aadharDetails`).addClass('sno');      
        }
        return;
    }
    if (docKey === 'PRIMARY_KYC') {
        let isVoterAddressAvailable = apz.app.CBcheck.getAddressForKYC(isApplicant ? "Applicant" : "Co-App");
        let custType = isApplicant ? "Applicant" : "Co-App";
        let custList = inSessionStore?.customerDetailsList || [];
        let custEntry = custList.find(c => c.customerType === custType) || custList.find(c => String(c.custDtlId) === String(custDtlId));
        let sessionVerified = (custEntry?.payload?.primaryKycIdValStatus === "Verified" || custEntry?.payload?.alternateVoterIdValStatus ===
            "Verified") && isVoterAddressAvailable;
        let flagVerified = isApplicant ? (window.PRIMARY_KYC_VERIFICATION === true || window.ALTERNATE_KYC_VERIFICATION === true) : (window
            .CO_APPLICANT_PRIMARY_KYC_VERIFICATION === true || window.CO_APPLICANT_ALTERNATE_KYC_VERIFICATION === true);
        let inDocCapture = (apz.childScr === 'documentCapture' && apz.app.docType === 'Voter ID');
        // if ((!sessionVerified || !flagVerified) && !inDocCapture) {
        if (!sessionVerified && !flagVerified && !inDocCapture) {
            hideDocRow();
            return;
        }
        let hasName = !!(custEntry?.payload?.namePerKyc || '').trim();
        let hasId = !!(custEntry?.payload?.primaryKycId || custEntry?.payload?.alternateVoterId || '').trim();
        if (inDocCapture) {
            if (!hasName) hasName = !!($(`#${docScrId}ocrName`).val() || '').trim();
            if (!hasId) hasId = !!($(`#${docScrId}ocrVoterNumber`).val() || '').trim();
        }
        if (!hasName || !hasId) {
            hideDocRow();
            return;
        }
        $row.attr('data-front-id', frontDoc.appDocId);
        $row.attr('data-back-id', backDoc.appDocId);
        $row.attr('data-doc-type', cfg.docType);
        $row.attr('data-doc-key', docKey);
        let personLabel = isApplicant ? 'Applicant' : 'Co-Applicant';
        $row.find('a.ett-hypl span').text(`${personLabel} ${cfg.personLabelPrefix}`);
        showDocRow();
        return;
    }
    let custList = inSessionStore?.customerDetailsList || [];
    let custEntry = custList.find(c => String(c.custDtlId) === String(custDtlId));
    let hasName = !!(custEntry?.payload?.[cfg.nameSessionKey] || '').trim();
    let hasId = !!(custEntry?.payload?.[cfg.idSessionKey] || '').trim();
    if (gApzCOB.currentApplicant === applicantNo) {
        if (docKey === 'SECONDARY_KYC') {
            let AadhaarScrId = 'KmSourc__AadhaarDetails__';
            if (!hasName) hasName = !!($(`#${AadhaarScrId}aadharname`).val() || '').trim();
            if (!hasId) hasId = !!($(`#${AadhaarScrId}aadharnum`).val() || '').trim();
        }
        if (docKey === 'PAN_NUMBER_PHOTO') {
            let CBcheckScrId = 'KmSourc__CBcheck__';
            if (!hasName) hasName = !!($(`#${CBcheckScrId}panName`).val() || '').trim();
            if (!hasId) hasId = !!($(`#${CBcheckScrId}panNum`).val() || '').trim();
        }
    }
    if (!hasName || !hasId) {
        hideDocRow();
        if(docKey === 'SECONDARY_KYC'){
            $(`#${window.AadhaarScrId}aadharDetails`).addClass('sno');
        }
        return;
    }
    $row.attr('data-front-id', frontDoc.appDocId);
    $row.attr('data-back-id', backDoc.appDocId);
    $row.attr('data-doc-type', cfg.docType);
    $row.attr('data-doc-key', docKey);
    let personLabel = isApplicant ? 'Applicant' : 'Co-Applicant';
    $row.find('a.ett-hypl span').text(`${personLabel} ${cfg.personLabelPrefix}`);
    showDocRow();
};
apz.app.Kmbase.paintAadhaarKycDocsInScreen = function (forceApplicantNo) {
    apz.app.Kmbase.paintDocInScreen('SECONDARY_KYC', forceApplicantNo);
};
apz.app.Kmbase.paintCBcheckKycDocsInScreen = function (forceApplicantNo) {
    apz.app.Kmbase.paintDocInScreen('PRIMARY_KYC', forceApplicantNo);
    apz.app.Kmbase.paintDocInScreen('PAN_NUMBER_PHOTO', forceApplicantNo);
};
apz.app.Kmbase.viewDoc = function (pthis) {
    let $row = $(pthis).closest('[data-doc-type]');
    let docKey = $row.attr('data-doc-key') || 'SECONDARY_KYC';
    window.paintDocType = docKey;
    let frontId = $row.attr('data-front-id');
    let backId = $row.attr('data-back-id');
    window._KM_DOC_IDS = [];
    window._KM_ACTIVE_DOC_KEY = docKey;
    if (frontId) window._KM_DOC_IDS.push(frontId);
    if (backId) window._KM_DOC_IDS.push(backId);
    window._KM_DOC_IDX = 0;
    let kmbaseScr = 'KmSourc__Kmbase__';
    $(`#${kmbaseScr}docNavRow`).addClass('sno');
    if (window._KM_DOC_IDS.length > 1) {
        $(`#${kmbaseScr}docNavRow`).removeClass('sno');
    }
    apz.app.Kmbase._loadDocModal(0);
};
apz.app.Kmbase._loadDocModal = function (idx) {
    let kmbaseScr = 'KmSourc__Kmbase__';
    let cfg = window.KM_DOC_VIEWER_CONFIG[window._KM_ACTIVE_DOC_KEY] || window.KM_DOC_VIEWER_CONFIG['SECONDARY_KYC'];
    let docId = window._KM_DOC_IDS[idx];
    if (!docId) return;
    let docList = inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList || [];
    let docDetails = docList.find(doc => doc.appDocId == docId);
    if (!docDetails) {
        ApzCOB.fnDisplayMsg("Document is not available");
        return;
    }
    // window.paintFileName = docDetails?.payload?.documentFormat || (docDetails?.payload?.documentFileName + ".jpg");
    window.paintFileName = docDetails?.payload?.documentFileName;
    window.ImageLocationDetails = {
        latitude: docDetails?.payload?.latitude || "",
        longitude: docDetails?.payload?.longitude || "",
        uploadedTs: docDetails?.payload?.uploadedTs || "",
        documentFileName: docDetails?.payload?.documentFileName || ""
    };
    let title = (idx === 0) ? cfg.frontTitle : cfg.backTitle;
    let custType = (gApzCOB.currentApplicant === 2) ? 'Co-App' : 'Applicant';
    if (docDetails?.documentType === "PRIMARY_KYC" && ApzCOB.getPayloadDatafromWrapper('alternateVoterIdValStatus', custType, 'customerDetailsList') === 'Verified') {
        title = 'Alternate ' + title;
    }
    $(`#${kmbaseScr}docViewModal .modal-header h1`).text(title);
    let total = window._KM_DOC_IDS.length;
    ApzCOB.removeDisableToInput(`${kmbaseScr}frontView_Img`);
    ApzCOB.removeDisableToInput(`${kmbaseScr}backView_Img`)  
    if(idx === 0){
     ApzCOB.addDisableToInput(`${kmbaseScr}frontView_Img`)   
    }
    if(idx === total - 1){
      ApzCOB.addDisableToInput(`${kmbaseScr}backView_Img`)      
    }
    // $(`#${kmbaseScr}frontView_Img`).prop('disabled', idx === 0);
    // $(`#${kmbaseScr}backView_Img`).prop('disabled', idx === total - 1);
    ApzCOB.downloadFileFromServer(window.paintFileName, function (params) {
        apz.stopLoader();
        if (!apz.isNull(params.base64)) {
            let $imgView = $(`#${kmbaseScr}imgView`);
        if ($imgView.guillotine('instance')) {
            $imgView.guillotine('remove'); 
        }
        $imgView = $(`#${kmbaseScr}imgView`);
        $imgView.off('load.reinitGuillotine').one('load.reinitGuillotine', function () {
            $imgView.guillotine({
                width: 300,   
                height: 300
            });
        });
        $imgView.attr('src', 'data:image/png;base64,' + params.base64);
            if (Object.keys(window.ImageLocationDetails).length > 0) {
                apz.app.BaseScreens.paintImageLocationDetails(`#${kmbaseScr}imgView`, window.ImageLocationDetails);
            }
            if (!$(`#${kmbaseScr}docViewModal`).is(':visible')) {
                ApzCOB.toggleModal(`${kmbaseScr}docViewModal`);
                $(`#${kmbaseScr}docViewModal_content`).css('overflow', 'hidden');
            }
        } else {
            ApzCOB.fnDisplayMsg("Document is not available");
        }
    });
};
apz.app.Kmbase.docNavigation = function (direction) {
    if (!window._KM_DOC_IDS || !window._KM_DOC_IDS.length) return;
    let total = window._KM_DOC_IDS.length;
    if (direction === 'Prev' && window._KM_DOC_IDX > 0) {
        window._KM_DOC_IDX--;
    } else if (direction === 'Next' && window._KM_DOC_IDX < total - 1) {
        window._KM_DOC_IDX++;
    }
    apz.app.Kmbase._loadDocModal(window._KM_DOC_IDX);
};
apz.app.Kmbase.deleteDoc = function (pthis) {
    let $row = $(pthis).closest('[data-doc-type]');
    let docKey = $row.attr('data-doc-key') || 'SECONDARY_KYC';
    let frontId = $row.attr('data-front-id');
    let backId = $row.attr('data-back-id');
    window._KM_DOC_PENDING_DELETE_IDS = [frontId, backId].filter(Boolean).map(Number);
    if (!window._KM_DOC_PENDING_DELETE_IDS.length) return;
    window._KM_DOC_DELETED_FOR = gApzCOB.currentApplicant;
    window._KM_ACTIVE_DOC_KEY = docKey;
    let popUpObj = {
        text: "Do you want to delete this document?",
        Btn1: {
            text: "Yes",
            onClick: "apz.app.Kmbase._deleteDocCnfm()"
        },
        Btn2: {
            text: "No",
            onClick: "ApzCOB.closeCommonModal(`newCommonConfModal`)"
        }
    };
    ApzCOB.showNewCommonConfirmationModal(popUpObj);
};
apz.app.Kmbase._deleteDocCnfm = function () {
    window._KM_DOC_PENDING_DELETES = (window._KM_DOC_PENDING_DELETE_IDS || []).slice();
    ApzCOB.closeCommonModal(`newCommonConfModal`);
    apz.app.Kmbase._deleteNextDoc();
};
apz.app.Kmbase._deleteNextDoc = function () {
    if (!window._KM_DOC_PENDING_DELETES || !window._KM_DOC_PENDING_DELETES.length) {
        let cfg = window.KM_DOC_VIEWER_CONFIG[window._KM_ACTIVE_DOC_KEY] || window.KM_DOC_VIEWER_CONFIG['SECONDARY_KYC'];
        let AadhaarScrId = 'KmSourc__AadhaarDetails__';
        let CBcheckScrId = 'KmSourc__CBcheck__';
        let docScrId = 'KmSourc__documentCapture__';
        let capturedFor = window._KM_DOC_DELETED_FOR;
        let isApplicant = (capturedFor === 1);
        let custDtlId = isApplicant ? gApzCOB.userDetails.custDtlId : gApzCOB.userDetails.CoApplicantCustomerId;
        $(`#${cfg.rowId}`).removeClass('km-doc-upload-row').addClass('sno');
        $(`#${cfg.captureBtnId}`).removeClass('sno');
        if (window._KM_ACTIVE_DOC_KEY === 'SECONDARY_KYC') {
            $(`#${AadhaarScrId}aadharDetails`).addClass('sno');
            $(`#${AadhaarScrId}captureAadhaar`).addClass('btm-seperator');
            $(`#${AadhaarScrId}aadharname`).val('');
            $(`#${AadhaarScrId}aadharnum`).val('');
            $(`#${AadhaarScrId}aadhardob`).val('');
            $(`#${AadhaarScrId}addline1`).val('');
            $(`#${AadhaarScrId}addline2`).val('');
            $(`#${AadhaarScrId}addline3`).val('');
            $(`#${AadhaarScrId}addpin`).val('');
            $(`#${AadhaarScrId}aadCity`).val('').trigger('change');
            $(`#${AadhaarScrId}aadDistrict`).val('').trigger('change');
            $(`#${AadhaarScrId}aadState`).val('').trigger('change');
            $(`#${AadhaarScrId}aadCountry`).val('').trigger('change');
            $(`#${AadhaarScrId}aadArea`).val('');
            $(`#${AadhaarScrId}aadLandmark`).val('');
        }
        if (window._KM_ACTIVE_DOC_KEY === 'PRIMARY_KYC') {
            $(`#${CBcheckScrId}nameAsPerVoter`).val('');
            if (isApplicant) {
                window.PRIMARY_KYC_VERIFICATION = false;
                window.ALTERNATE_KYC_VERIFICATION = false;
                $(`#${CBcheckScrId}alternateVoterId`).val('');
            } else {
                if (!$(`#${CBcheckScrId}alternateVoterId`).val()) {
                    $(`#${CBcheckScrId}voterId`).val('');
                }
                $(`#${CBcheckScrId}alternateVoterId`).val('');
                window.CO_APPLICANT_PRIMARY_KYC_VERIFICATION = false;
                window.CO_APPLICANT_ALTERNATE_KYC_VERIFICATION = false;
            }
            apz.app.CBcheck.clearVerificationTicks();
        }
        if (window._KM_ACTIVE_DOC_KEY === 'PAN_NUMBER_PHOTO') {
            $(`#${CBcheckScrId}panName`).val('');
            $(`#${CBcheckScrId}panNum`).val('');
            window.VERIFIED_PAN_VALUE = null;
            if (isApplicant) {
                window.applicant_pancheck = false;
            } else {
                window.coapplicant_pancheck = false;
            }
            apz.app.CBcheck.clearVerificationTicks();
        }
        try {
            let custList = inSessionStore?.customerDetailsList || [];
            let custEntry = custList.find(c => String(c.custDtlId) === String(custDtlId));
            if (custEntry?.payload) {
                custEntry.payload[cfg.nameSessionKey] = '';
                custEntry.payload[cfg.idSessionKey] = '';
                if (window._KM_ACTIVE_DOC_KEY === 'SECONDARY_KYC') {
                    custEntry.payload.secondaryKycDob = '';
                    custEntry.payload.namePerAdhr = '';
                    custEntry.payload.aadhaarNumber = '';
                }
                if (window._KM_ACTIVE_DOC_KEY === 'PRIMARY_KYC') {
                    custEntry.payload.primaryKycIdValStatus = 'Pending';
                    custEntry.payload.alternateVoterIdValStatus = 'Pending';
                    custEntry.payload.kycStatus = 'Pending';
                }
                if (window._KM_ACTIVE_DOC_KEY === 'PAN_NUMBER_PHOTO') {
                    custEntry.payload.panNumberStatus = 'Pending';
                    custEntry.payload.panNumberValue = 'Y';
                }
            }
        } catch (e) {
            ApzCOB.traceFrontEndError(e,"");
            console.error('Clear session payload error:', e);
        }
        if (window._KM_ACTIVE_DOC_KEY === 'SECONDARY_KYC') {
            try {
                let addrRoot = inSessionStore?.addressDetailsWrapperList?.[0]?.addressDetailsList || [];
                let personalWrapper = addrRoot.find(w => w.addressType === 'Personal' && String(w.custDtlId) === String(custDtlId));
                if (personalWrapper?.payload?.addressList) {
                    let secIdx = personalWrapper.payload.addressList.findIndex(a => a.addressType === 'SecondaryKyc');
                    if (secIdx >= 0) {
                        personalWrapper.payload.addressList[secIdx] = {
                            addressType: 'SecondaryKyc',
                            addressLine1: '',
                            addressLine2: '',
                            addressLine3: '',
                            pinCode: '',
                            city: '',
                            district: '',
                            state: '',
                            country: '',
                            area: '',
                            landMark: ''
                        };
                    }
                }
            } catch (e) {
                ApzCOB.traceFrontEndError(e,"");
                console.error('Clear session addr error:', e);
            }
        }
        if (window._KM_ACTIVE_DOC_KEY === 'PRIMARY_KYC') {
            try {
                let addrRoot = inSessionStore?.addressDetailsWrapperList?.[0]?.addressDetailsList || [];
                let personalWrapper = addrRoot.find(w => w.addressType === 'Personal' && String(w.custDtlId) === String(custDtlId));
                if (personalWrapper?.payload?.addressList) {
                    let voterIdx = personalWrapper.payload.addressList.findIndex(a => a.addressType === 'Voter');
                    if (voterIdx >= 0) {
                        personalWrapper.payload.addressList[voterIdx] = {
                            addressType: 'Voter',
                            addressLine1: '',
                            addressLine2: '',
                            addressLine3: '',
                            pinCode: '',
                            city: '',
                            district: '',
                            state: '',
                            country: '',
                            area: '',
                            landMark: ''
                        };
                    }
                }
            } catch (e) {
                ApzCOB.traceFrontEndError(e,"");
                console.error('Clear voter addr error:', e);
            }
        }
        try {
            let $frontParent = $(`#${docScrId}frontImg`);
            let $backParent = $(`#${docScrId}backImg`);
            $frontParent.find('.km-doc-upload-row').remove();
            $backParent.find('.km-doc-upload-row').remove();
            $frontParent.children().not(`#${docScrId}frontImg_1`).remove();
            $backParent.children().not(`#${docScrId}backImg_1`).remove();
            $(`#${docScrId}frontImg_1`).addClass('sno');
            $(`#${docScrId}backImg_1`).addClass('sno');
            $(`#${docScrId}frontCaptureBtn`).removeClass('sno');
            $(`#${docScrId}backCaptureBtn`).removeClass('sno');
            $('.ocr-section').addClass('sno');
        } catch (e) {
            ApzCOB.traceFrontEndError(e,"");
            console.error('Clear doc capture DOM error:', e);
        }
        window._KM_DOC_IDS = [];
        window._KM_DOC_IDX = 0;
        window._KM_DOC_DELETED_FOR = null;
        window._KM_ACTIVE_DOC_KEY = null;
        window.KM_AADHAAR_SNAPSHOT = null;
        window.AADHAAR_FROM_DOC_NEXT = false;
        window.AADHAAR_FROM_DOC_NEXT_FOR = null;
        let kmbaseScr = 'KmSourc__Kmbase__';
        $(`#${kmbaseScr}docNavRow`).addClass('sno');
        $(`#${kmbaseScr}frontView_Img`).prop('disabled', true);
        $(`#${kmbaseScr}backView_Img`).prop('disabled', true);
        try {
            if (typeof apz.app.AadhaarDetails.paintAddressTable === "function") {
                 apz.app.AadhaarDetails.paintAddressTable();
            }
        } catch (e) {
            ApzCOB.traceFrontEndError(e,"");
         }
        ApzCOB.showNewCommonSuccessModal({
            text: "Document Deleted.!",
            Btn: {
                text: "OK",
                onClick: "ApzCOB.closeCommonModal(`newCommonSuccModal`)"
            }
        });
        return;
    }
    let docId = window._KM_DOC_PENDING_DELETES.shift();
    let docArr = inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList || [];
    let docInSession = docArr.find(d => d.appDocId == docId);
    if (!docInSession) {
        apz.app.Kmbase._deleteNextDoc();
        return;
    }
    ApzCOB.deleteDocument(gApzCOB.userDetails.appId, gApzCOB.userDetails.applicationId, window.versionNum || 1, docInSession.appDocId, function (
        params) {
        apz.stopLoader();
        try {
            if (ApzCOB.handleServiceCallBacks(params)) {
                let arr = inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList || [];
                inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList = arr.filter(d => d.appDocId != docId);
            }
        } catch (e) {
            ApzCOB.traceFrontEndError(e,"");
            console.error("Doc delete error:", e);
        }
        apz.app.Kmbase._deleteNextDoc();
    });
};
apz.app.Kmbase.toUpperCaseOnBlur = function (pthis) {
    if (!pthis) return;
    let val = $(pthis).val() || "";
    $(pthis).val(val.toUpperCase().trim());
};
apz.app.Kmbase.reject = function (pthis) {
    if ($(`#${kmbaseScr}queryModal_window`).is(':visible')) return;
    window._KM_REJECT_PTHIS = pthis;
    apz.app.Kmbase.fetchKMRejectReasons();
};
apz.app.Kmbase.fetchKMRejectReasons = function () {
    if (window.KM_rejectReasonsArray && window.KM_rejectReasonsArray.length > 0) {
        apz.app.Kmbase.openRejectModal();
        return;
    }
    var _originalCB = ApzCOB.FetchDBKITMasterDataCB;
    ApzCOB.FetchDBKITMasterDataCB = function (params) {
        ApzCOB.FetchDBKITMasterDataCB = _originalCB;
        try {
            _originalCB(params);
        } catch (e) {
            ApzCOB.traceFrontEndError(e,"");
         }
        try {
            let kmRejectStage = (DBKIT_MASTERDATA || []).find(s => s.stageName === "KMREJECT" && s.appId === "ALL");
            if (kmRejectStage && kmRejectStage.rejectReasons) {
                let parsed = JSON.parse(kmRejectStage.rejectReasons);
                window.KM_rejectReasonsArray = parsed.rejectReason || [];
            }
        } catch (e) {
            ApzCOB.traceFrontEndError(e,"");
            console.error("KM reject reasons parse error:", e);
        }
        apz.app.Kmbase.openRejectModal();
    };
    ApzCOB.FetchDBKITMasterData("KMSOURCING");
};
apz.app.Kmbase.openRejectModal = function () {
    if (!window.KM_rejectReasonsArray || window.KM_rejectReasonsArray.length === 0) {
        ApzCOB.fnDisplayMsg("Reject reasons not available.", "E");
        return;
    }
    window.KM_checkedRejectReasons = [];
    window.KM_updatedRejectString = "";
    window.KM_othReasonId = "";
    window.KM_othReasonSelected = false;
    let arr = [...window.KM_rejectReasonsArray, {
        id: "oth",
        value: "Other"
    }];
    window.KM_QueriesPainted = arr;
    apz.data.scrdata.KmSourc__KMQueries_Res = JSON.parse(JSON.stringify(arr));
    apz.data.loadData("KMQueries", "KmSourc");
    $(`#${kmbaseScr}searchQueryInput`).val("");
    $(`#${kmbaseScr}otherQueryReasonForm`).addClass("sno");
    $(`#${kmbaseScr}Query_Err_Row`).addClass("sno");
    $(`#${kmbaseScr}noResult_row`).addClass("sno");
    $(`#${kmbaseScr}queryList`).removeClass("sno").addClass("pb-70");
    $(`#${kmbaseScr}queryList li`).attr('onclick', '');
    for (let i = 0; i < window.KM_QueriesPainted.length; i++) {
        $(`#${kmQueriesIntfId}id_${i}`).prop("checked", false);
    }
    let headerEl = document.querySelector("#KmSourc__Kmbase__queryModal_window .modal-header li h1");
    if (headerEl) headerEl.textContent = "Reject Reason";
    $(`#${kmbaseScr}el_btn_reject_submit`).text("Submit").attr("onclick", "apz.app.Kmbase.onClickKMRejectModalSubmit()");
    // setTimeout(function() {
    $(`#${kmbaseScr}queryList`).find("p").filter(function (el) {
        let valEl = document.getElementById(`${kmQueriesIntfId}value_${el}_txtcnt`);
        if (valEl && valEl.textContent === "Other") {
            window.KM_othReasonId = `#${kmQueriesIntfId}id_${el}`;
            $(`#${kmQueriesIntfId}id_${el}`).attr("onchange",
                "apz.app.Kmbase.onSelectKMOtherReason(); apz.app.Kmbase.kmQueryCheckBoxCount();");
        } else {
            $(`#${kmQueriesIntfId}id_${el}`).attr("onchange", "apz.app.Kmbase.kmQueryCheckBoxCount();");
        }
    });
    // }, 300);
    ApzCOB.toggleModal(`${kmbaseScr}queryModal`);
};
apz.app.Kmbase.onSelectKMOtherReason = function () {
    let isChecked = $(window.KM_othReasonId).prop("checked");
    if (isChecked) {
        $(`#${kmbaseScr}queryList`).removeClass("pb-70");
        window.KM_othReasonSelected = true;
        $(`#${kmbaseScr}otherQueryReasonForm`).removeClass("sno");
    } else {
        $(`#${kmbaseScr}queryList`).addClass("pb-70");
        window.KM_othReasonSelected = false;
        $(`#${kmbaseScr}otherQueryReasonForm`).addClass("sno");
    }
    $(`#${kmbaseScr}otherQueryReasonInp`).val("");
    ApzCOB.removeErrMessgae(`${kmbaseScr}otherQueryReasonInp`, "element");
};
apz.app.Kmbase.kmQueryCheckBoxCount = function () {
    let checkedCount = 0;
    for (let i = 0; i < window.KM_QueriesPainted.length; i++) {
        if ($(`#${kmQueriesIntfId}id_${i}`).prop("checked")) checkedCount++;
    }
    if (checkedCount > 0) $(`#${kmbaseScr}Query_Err_Row`).addClass("sno");
};
apz.app.Kmbase.validateKMRejectInput = function () {
    let val = $(`#${kmbaseScr}otherQueryReasonInp`).val();
    if (val && val.trim() !== "") {
        ApzCOB.removeErrMessgae(`${kmbaseScr}otherQueryReasonInp`, "element");
    }
};
apz.app.Kmbase.searchInKMRejectQueryMdl = function () {
    $(`#${kmbaseScr}Query_Err_Row`).addClass("sno");
    let query = $(`#${kmbaseScr}searchQueryInput`).val() || "";
    let results = window.KM_QueriesPainted.filter(lead => Object.values(lead).some(val => String(val).toLowerCase().includes(query
        .toLowerCase())));
    if (results.length > 0) {
        apz.data.scrdata.KmSourc__KMQueries_Res = [];
        apz.data.scrdata.KmSourc__KMQueries_Res = results;
        apz.data.loadData("KMQueries", "KmSourc");
        $(`#${kmbaseScr}queryList`).find("p").filter(function (el) {
            let valEl = document.getElementById(`${kmQueriesIntfId}value_${el}_txtcnt`);
            if (valEl && valEl.textContent === "Other") {
                window.KM_othReasonId = `#${kmQueriesIntfId}id_${el}`;
                $(`#${kmQueriesIntfId}id_${el}`).attr("onchange",
                    "apz.app.Kmbase.onSelectKMOtherReason(); apz.app.Kmbase.kmQueryCheckBoxCount();");
            }
        });
        $(`#${kmbaseScr}noResult_row`).addClass("sno");
        $(`#${kmbaseScr}queryList`).removeClass("sno");
    } else {
        $(`#${kmbaseScr}noResult_row`).removeClass("sno");
        $(`#${kmbaseScr}queryList`).addClass("sno");
        $(`#${kmbaseScr}otherQueryReasonForm`).addClass("sno");
    }
};
apz.app.Kmbase.onClickKMRejectModalCancel = function () {
    checkedQueries = [];
    $(`#${kmbaseScr}queryList`).addClass("pb-70");
    $(KM_othReasonId).prop("checked", false)
    $(`#${kmbaseScr}otherQueryReasonForm`).addClass("sno");
    $(`#${kmbaseScr}otherQueryReasonInp`).val("");
    ApzCOB.removeErrMessgae(`${kmbaseScr}otherQueryReasonInp`, "element");
    ApzCOB.toggleModal(kmbaseScr + "queryModal");
};
apz.app.Kmbase.onclicksubmit = function () {
    const isQueryheader = $(`#${kmbaseScr}queryModal_window .modal-header li h1`).text() === 'Query';
    if (isQueryheader) {
        apz.app.Kmbase.onClickQueryMdlSave();
    } else {
        apz.app.Kmbase.onClickKMRejectModalSubmit();
    }
};
apz.app.Kmbase.onClickKMRejectModalSubmit = function () {
    $(`#${kmbaseScr}Query_Err_Row`).addClass("sno");
    window.KM_checkedRejectReasons = [];
    window.KM_QueriesPainted.forEach(function (item, index) {
        if ($(`#${kmQueriesIntfId}id_${index}`).prop("checked")) {
            let reasonId = window.KM_QueriesPainted[index].id;
            if (window.KM_othReasonId === `#${kmQueriesIntfId}id_${index}`) {
                let otherText = $(`#${kmbaseScr}otherQueryReasonInp`).val() || "";
                reasonId = reasonId + "?" + otherText;
            }
            window.KM_checkedRejectReasons.push(reasonId);
        }
    });
    if (window.KM_checkedRejectReasons.length === 0) {
        $(`#${kmbaseScr}Query_Err_Row`).removeClass("sno");
        return;
    }
    if (window.KM_othReasonSelected) {
        let otherVal = $(`#${kmbaseScr}otherQueryReasonInp`).val();
        if (apz.isNull(otherVal) || otherVal.trim() === "") {
            ApzCOB.addErrMessage(`${kmbaseScr}otherQueryReasonInp`, "element");
            window.KM_checkedRejectReasons = [];
            return;
        }
    }
    window.KM_updatedRejectString = window.KM_checkedRejectReasons.join("|");
    ApzCOB.toggleModal(`${kmbaseScr}queryModal`);
    $(`#${kmbaseScr}searchQueryInput`).val("");
    window.KM_othReasonSelected = false;
    apz.app.Kmbase.showKMRejectConfirmation();
};
apz.app.Kmbase.showKMRejectConfirmation = function () {
    ApzCOB.showNewCommonConfirmationModal({
        text: "Are you sure you want to reject the application?",
        Btn1: {
            text: "Yes",
            onClick: "apz.app.Kmbase.onKMRejectConfirmYes()"
        },
        Btn2: {
            text: "No",
            onClick: "ApzCOB.closeCommonModal(`newCommonConfModal`)"
        }
    });
};
apz.app.Kmbase.onKMRejectConfirmYes = function () {
    ApzCOB.closeCommonModal("newCommonConfModal");
    apz.app.Kmbase.kmApproveReject("REJECTED");
};
apz.app.Kmbase.kmApproveReject = function (gaction) {
    apz.startLoader();
    window.KM_approveRejectAction = gaction;
    if (gaction === "REJECTED") {
        window._KM_REJECT_PTHIS = $('#KmSourc__Kmbase__rejectButton');
    }
    if (!apz.isNull(inSessionStore.customerDetailsList) && inSessionStore.customerDetailsList.length > 0) {
        inSessionStore.customerDetailsList.forEach(function (cust) {
            if (cust.customerType === "Applicant") gApzCOB.userDetails.custDtlId = cust.custDtlId;
            else gApzCOB.userDetails.CoApplicantCustomerId = cust.custDtlId;
        });
    }
    apz.app.BaseScreens.stageBasedOnAction(window._KM_REJECT_PTHIS, gaction);
    window._KM_REJECT_PTHIS = null;
    if (!ApzCOB.checkCbStatus() && !KM_updatedRejectString) {
        if (gApzCOB.currentApplicant <= 1) {
            if (!APPLICANT_CIBIL_STATUS) {
                window.isBRERejected = true;
                KM_updatedRejectString = `Applicant CB Decision Failed. Reason: ${selectedCbDetails?.payload?.rejectionReason}`;
            }
        } else {
            if (!CO_APPLICANT_CIBIL_STATUS) {
                window.isBRERejected = true;
                KM_updatedRejectString = `Co-Applicant(C0${CO_APP_ADDED_COUNT}) CB Decision Failed. Reason: ${selectedCbDetails?.payload?.rejectionReason}`;
            }
        }
    }
    var req = {
        "apiRequest": {
            "interfaceName": "",
            "appId": gAppId,
            "requestObj": {
                "appId": gApzCOB.userDetails.appId,
                "status": window.KM_approveRejectAction,
                "userId": gApzCOB.LoggedInUserDetails.loginResponse.userDet.id,
                "applicationId": gApzCOB.userDetails.applicationId,
                "versionNum": gApzCOB.userDetails.versionNum || window.versionNum,
                "custDtlId": gApzCOB.userDetails.custDtlId,
                "remarks": window.KM_updatedRejectString,
                "workflow": {
                    "currentRole": gApzCOB.workflow.currentRole,
                    "action": gApzCOB.workflow.action,
                    "workflowId": gApzCOB.workflow.workflowId,
                    "stage": gApzCOB.workflow.stage
                }
            }
        }
    };
    let lcallBack = '';
    if (gaction == 'APPROVED' || gaction == 'BMPUSHBACK' || gaction === "CONTINUE" || gaction == 'PENDING' || gaction == 'RPCVERIFIED') {
        lcallBack = apz.app.Kmbase.bmStagemomentCB
    } else if (gaction == "REJECTED") {
        lcallBack = apz.app.Kmbase.kmApproveRejectCB
    }
    setTimeout(() => {
        ApzCOB.serverBuildParam("Dashbo", "ApproveRejectApplication", "N", "N", req, false, lcallBack);
    }, 1000);

};
apz.app.Kmbase.kmApproveRejectCB = function (params) {// 
    try {
        if (ApzCOB.handleServiceCallBacks(params)) {
            let IsMaitriCase = ApzCOB.checkIsMaitriCase();
            let maitriText = '';
            if(IsMaitriCase){
               maitriText = `${maitriMovementText}`;
            }
            if(window.isBRERejected && (APPLICANT_CIBIL_STATUS === false || CO_APPLICANT_CIBIL_STATUS === false)){
                maitriText = '';
            }
            if (window.KM_approveRejectAction === "REJECTED") {
                ApzCOB.showNewCommonSuccessModal({
                    text: `Application rejected successfully. ${maitriText}`,
                    Btn: {
                        text: "OK",
                        onClick: "ApzCOB.closeCommonModal(`newCommonSuccModal`); apz.app.Kmbase.gotoHome();"
                    }
                });
            }
        } else {
            apz.stopLoader();
            let errMsg = "";
            try {
                errMsg = params.res.Dashbo__ApproveRejectApplication_Res.apiResponse.ResponseHeader.ResponseMessage;
            } catch (e) {
                ApzCOB.traceFrontEndError(e,"");
                errMsg = ApzCOB.getDescfromLitCode("LIT_TECHNICALDIFF");
            }
            ApzCOB.fnDisplayMsg(errMsg, "E");
        }
    } catch (e) {
        ApzCOB.traceFrontEndError(e,"");
        apz.stopLoader();
        ApzCOB.fnDisplayMsg(ApzCOB.getDescfromLitCode("LIT_TECHNICALDIFF"), "E");
    }
    apz.stopLoader();
};
apz.app.Kmbase.bmStagemomentCB = function (params) {
    try {
        if (!ApzCOB.handleServiceCallBacks(params)) {
            let ifaceName = ApzCOB.GetInterfaceResMap(params);
            apz.stopLoader();
            let errMsg = "Error occurred while submitting the case.! Please try again later.";
            try {
                errMsg = params.res[ifaceName]?.apiResponse?.ResponseBody?.responseObj || params.res[ifaceName]?.apiResponse?.ResponseHeader?.ResponseMessage;
            } catch (e) {
                ApzCOB.traceFrontEndError(e,"");
                errMsg = ApzCOB.getDescfromLitCode("LIT_TECHNICALDIFF");
            }
            ApzCOB.fnDisplayMsg(errMsg, "E");
            if ($('#' + kmbaseScr + 'conFormation_mdl').is(':visible')) {
                ApzCOB.toggleModal(kmbaseScr + "conFormation_mdl");
            }
            return;
        }
        let resObj = params?.res?.Dashbo__ApproveRejectApplication_Res?.apiResponse?.ResponseBody?.responseObj;
        let resParams = resObj ? JSON.parse(resObj) : null;
        if ($('#' + kmbaseScr + 'conFormation_mdl').is(':visible')) {
            ApzCOB.toggleModal(kmbaseScr + "conFormation_mdl");
        }
        if (resParams?.versionNum === 1) {
            if (params.req.apiRequest.requestObj.status == 'APPROVED') {
                $("#KmSourc__Kmbase__successText").text(`Application no ${inSessionStore.applicationId} submitted to RPC successfully.`);
            } else if (params.req.apiRequest.requestObj.status == 'BMPUSHBACK') {
                ApzCOB.toggleModal(kmbaseScr + "sendbackconfmdl")
                $("#KmSourc__Kmbase__successText").text(`Application sent back successfully`);
            } else {
                $("#KmSourc__Kmbase__successText").text(`Application no ${inSessionStore.applicationId} submitted to BM successfully.`);
            }
            ApzCOB.toggleModal(kmbaseScr + "Succ_modal");
        } else {
            let errMsg = params?.res?.Dashbo__ApproveRejectApplication_Res?.apiResponse?.ResponseHeader?.ResponseMessage || ApzCOB
                .getDescfromLitCode("LIT_TECHNICALDIFF");
            ApzCOB.fnDisplayMsg(errMsg, "E");
            apz.stopLoader();
            return;
        }
    } catch (e) {
        ApzCOB.traceFrontEndError(e,"");
        ApzCOB.fnDisplayMsg(ApzCOB.getDescfromLitCode("LIT_TECHNICALDIFF"), "E");
        apz.stopLoader();
        return;
    }
    apz.stopLoader();
};
apz.app.Kmbase.paintDocSize = function (newId, docSize) {
    $(`#${newId} .updel .scb-col85 .ett-para span`).text('').css('display', 'none');
    $(`#${newId} .updel .scb-col15 span:not([id])`).remove();
    $(`#${newId} .updel .scb-col15`).addClass('km-doc-size-col').prepend(
        `<span class="km-doc-size-kb">${Math.floor((docSize || 0) / 1024)} KB</span>`);
};
function clearFieldError(fieldId) {
    let field = document.getElementById(fieldId);
    if (!field) return;
    let parent = field.parentElement;
    while (parent) {
        if (parent.classList.contains("error-inline")) {
            parent.classList.remove("error-inline");
            break;
        }
        parent = parent.parentElement;
    }
    let errorEl = document.getElementById(fieldId + "_error");
    if (errorEl) {
        errorEl.remove();
    }
}

function showFieldError(fieldId, message) {
    let field = document.getElementById(fieldId);
    if (!field) return;
    clearFieldError(fieldId);
    let wrapper;
    if (field.closest(".etb-slct")) {
        wrapper = field.closest(".etb-slct").parentElement;
    } else if (field.closest(".ett-inpt")) {
        wrapper = field.closest(".ett-inpt").parentElement;
    } else {
        wrapper = field.parentElement;
    }
    if (wrapper) {
        wrapper.classList.add("error-inline");
    }
    let error = document.createElement("div");
    error.className = "cb-error-msg";
    error.id = fieldId + "_error";
    error.innerText = message;
    wrapper.appendChild(error);
}

apz.app.Kmbase.bmRecommendation = function () {
    if (gApzCOB?.LoggedInUserDetails?.loginResponse?.addInfo1 !== 'BM') return;
    const isApplicant = gApzCOB.currentApplicant <= 1;
    const getEl = (scrID, field) => $(`#${scrID}${field}`);
    const disableFields = (scrID, fields) => {
        fields.forEach(f => {
            const el = getEl(scrID, f);
            if (el.length) {
                el.addClass('disabled').prop('disabled', true);
                ApzCOB.addDisableToInput(`${scrID}${f}`);
            }
        });
    };
    const disableDropdowns = (scrID, fields, locked = true) => {
        fields.forEach(f => {
            const el = getEl(scrID, f);
            if (el.length) {
                el.prop('disabled', locked);
                ApzCOB.addDisableToInput(`${scrID}${f}`);
            }
        });
    };
    const hide = (scrID, arr) => {
        const getEl = (field) =>
            $(`[id='${scrID}${field}'], [id='${scrID}${field}'] *`);
        arr.forEach(f => {
            getEl(f).addClass('sno');
        });
    };
    const show = (scrID, arr) => arr.forEach(f => getEl(scrID, f).removeClass('sno'));
    const addErr = (scrID, arr) => arr.forEach(f => getEl(scrID, f).addClass('kmenacherr'));
    const disableRadio = ids => ids.forEach(id => $(id).addClass('aadhar-radio-disable'));
    $('#KmSourc__Kmbase__SaveDraft').addClass('sno');
    if (!isApplicant) {
        $('#KmSourc__CBcheck__lndtlssaprerator').addClass('sno');
    }
    $('#KmSourc__Kmbase__kmPreviewRow').removeClass('sno');
    $('#KmSourc__Kmbase__kmSourcingDtls_Row').removeClass('sno');
    $(`#${kmbaseScr}scrDtls`).removeClass('disabled-sidebar');
    if (apz.childScr === 'CBcheck') {
        const scrID = window.CBcheckScr;
        const key = isApplicant ? 'applicant' : 'coapplicant';
        const isLocked = window.CB_UI_LOCKED?.[key];
        disableFields(scrID, ['primaryMobile', 'sec_mobile', 'loanAmount', 'loanSlider', 'ckycNumber', 'addressLine1', 'addressLine2',
            'addressLine3', 'pincode', 'coCustomerName', 'coApplicantMaritalStatus'
        ]);
        disableDropdowns(scrID, ['loanPurpose', 'subLoanPurpose', 'frequencyOfRepayment', 'coGender', 'relationShipWithApplicant',
            'applicantMaritalStatus', 'coApplicantMaritalStatus'
        ], isLocked);
        hide(scrID, ['sendOtpBtn', 'retryRow', 'retryCount', 'captureVoterBtn', 'capturePanBtn', 'initiateRow', 'cbNote']);
        show(scrID, ['loanQuery_row', 'kycQuery_Row', 'CustQuery_row', 'coAppQuery_Row', 'ResidenceQuery_Row', 'PanQuery_Row', 'selCoAppRow']);
        addErr(scrID, ['loanDtlsQBtnChecked', 'kycDtlsQChecked', 'CustDtlsQChecked', 'coAppDtlsQChecked', 'ResidenceQChecked', 'PanQChecked']);
        disableRadio([`#${scrID}panVal`]);
        const coApp = inSessionStore?.customerDetailsList?.find(c => c.customerType === 'Co-App');
        if (coApp) {
            $('#KmSourc__CBcheck__coAppName').text(coApp.customerName);
            if (ApzCOB.getPayloadDatafromWrapper("isNewCustomer", "Co-App", "customerDetailsList") === 'Create a new Co-Applicant') {
                $("#KmSourc__CBcheck__newCoappRow").removeClass('sno');
                $("#KmSourc__CBcheck__selCoAppRow").addClass('sno');
            } else {
                $("#KmSourc__CBcheck__newCoappRow").addClass('sno');
                $("#KmSourc__CBcheck__selCoAppRow").removeClass('sno');
            }
            $('#KmSourc__CBcheck__dltIcn').addClass('sno');
        }
        let custType = isApplicant ? "Applicant" : "Co-App";
        let custEntry = inSessionStore?.customerDetailsList?.find(c => c.customerType === custType);
        if (custEntry?.payload?.panNumberValue === 'N') {
            $("#KmSourc__CBcheck__PanQueryBtn").addClass('sno');
        }
    } else if (apz.childScr === 'AadhaarDetails') {
        const scrID = window.AadhaarScrId;
        disableFields(scrID, ['fathersName', 'spouseName']);
        disableDropdowns(scrID, ['education', 'religion', 'caste', 'A_residence_stability_present_city_ext', 'A_residence_stability',
            'relationshipProof', 'A_residence_stabilit_present_city', 'presentAddrLine1', 'presentAddrLine2', 'presentAddrLine3', 'presentPincode', 'addressProof', 'permanentAddrLine1', 'permanentAddrLine2', 'permanentAddrLine3', 'permanentPincode', 'permanentAddressProof'
        ]);
        hide(scrID, ['captureAadhaarBtn', 'resImgCaptureBtn', 'custImgCaptureBtn', 'relImgCaptureBtn', 'aadardeleteIconRow',
            'custphtdeleteIconrow', 'prmntAdddeleteIcnRow', 'rltnprfdeleteIcnRow', 'addrImgCaptureBtn', 'permAddrImgCaptureBtn', 'RES_img_del', 'RES_addr_img_del', 'PER_addr_img_del'
        ]);
        show(scrID, ['AadharaddQ_Row', 'AprsnlDtlsQuery_Row', 'communicationQ_Row', 'TypofouseQ_row', 'rltnQ_row']);
        addErr(scrID, ['AadharaddQChecked', 'prsnlDtlsQChecked', 'comnictionQChecked', 'TOHQChecked', 'rltnQChecked']);
        disableRadio([`#${scrID}typeHouse`, `#${scrID}residentialStatus`, `#${scrID}communicationAddress`]);
    } else if (apz.childScr === 'OtherInformation') {
        const scrID = window.kmothInfoScr;
        disableFields(scrID, ['changeBankIFSCCode', 'nameOfAdditionalDoc']);
        disableDropdowns(scrID, ['changeBankAccountType', 'changeBankTypeOfDoc', 'insuranceNotOptingReasons', 'bankDetTypeOfDocument']);
        show(scrID, ['bnkQfrm', 'InsTypQ_frm', 'AmlQ_frm', 'BankDtlsQuery_Row', 'amlQuery_Row', 'Insrow', 'InstypQuery_Row',
            'additionalDocumentDiv'
        ]);
        addErr(scrID, ['bankDtlsQChecked', 'amlQChecked', 'InstypQChecked']);
        disableRadio([`#${scrID}changeBankRadioBtn`, `#${scrID}insuranceTypeRadioBtn`]);
        hide(scrID, ['applicantEditbtn', 'coApplicantEditbtn', 'adddocUpld', 'cocstmnomneeDoc', 'appcustnomneeDoc', 'appdiffnomneRow',
            'coappdiffnomneRow', 'checkRow', 'typdocimgupld', 'typdocdeletIcnRow', 'appcustnomneeDIcnRow', 'cocstmnomneeDIcnRow',
            'adddocDIcnRow', 'bankDetTypeDIconRow', 'upldaddocNav1', 'upldaddocNav', 'dltBtnaddappNav', 'addDocFrm', 'uploadImageRowPrimary'
        ]);
        ['KmSourc__IPaintCustAppInsDetails__o__custAppInsDetails__custAppDob',
            'KmSourc__IPaintCustCoAppInsDetails__o__custCoAppInsDetails__custCoAppDob'
        ].forEach(id => {
            $(`#${id}`)?.datepicker("disable");
            ApzCOB.addDisableToInput(id);
        });
        ApzCOB.addDisableToInput("KmSourc__IPaintCoAppInsuranceDetails__o__coAppInsuranceDetails__coAppRelationWithNom")
        ApzCOB.addDisableToInput("KmSourc__IPaintCustomNomineeDetails__o__customNomineeDetails__customNomineeForIns")
        ApzCOB.addDisableToInput("KmSourc__IPaintCustomNomineeDetails__o__customNomineeDetails__customGender")
        ApzCOB.addDisableToInput("KmSourc__IPaintCustomNomineeDetails__o__customNomineeDetails__customDob")
        ApzCOB.addDisableToInput("KmSourc__IPaintCustomNomineeDetails__o__customNomineeDetails__customRelationWithNom")
        ApzCOB.addDisableToInput("KmSourc__IPaintCustomNomineeDetails__o__customNomineeDetails__customNomContactNumber")
        ApzCOB.addDisableToInput("KmSourc__IPaintInsuranceDetails__o__insuranceDetails__nameOfInsurerInput");
        ApzCOB.addDisableToInput("KmSourc__OtherInformation__amlCheckBox");
        $("#KmSourc__OtherInformation__customNomDeleteBtnRow").addClass("sno");
        $("#KmSourc__OtherInformation__accountVerifyBtn").addClass('sno');
        document.querySelectorAll("#KmSourc__OtherInformation__amlQuestionList input[type='radio']")
            .forEach(radio => radio.disabled = true);
        const s = inSessionStore;
        const docs = s?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList ?? [];
        const hasAdditionalDocs = docs?.some(doc => doc?.documentType === "ADDITIONAL_DOCS");
        if (!hasAdditionalDocs) {
            $("#KmSourc__OtherInformation__additionalDocumentDiv").addClass("sno");
        }
    } else if (apz.childScr === 'BusinessIncome') {
        const scrID = window.kmIncomeScr;
        disableFields(scrID, ['addBusiness', 'sourceofincomesec', 'Agri_DeclaredIncome', 'Co_Agri_DeclaredIncome', 'NetSal', 'NetSalCo', 'ToTalWagePerMonth_App_0',
            'ToTalWagePerMonth_Co_0', 'RentalIncomeMonth_App', 'RentalIncomeMonth_Co', 'App_PenIn', 'Co_PenIn'
        ]);
        disableRadio([`#${scrID}Agri_Owned`, `#${scrID}Salary_Owned`, `#${scrID}WageOwn_Owned`, `#${scrID}PensionOwn_Owned`, `#${scrID}RentalincomeOwn_Owned`, `#${scrID}sourceofincomesec`,
        ...$(`[id$='_businessOwnedByOption']`).map(function () {
            return `#${this.id}`;
        }).get(),
        ...$(`[id$='_businessTypeOption']`).map(function () {
            return `#${this.id}`;
        }).get(),
        ...$("[id$='Rdo']").map(function () {
            return `#${this.id}`;
        }).get(),
        ...$("[id$='ImageProofParentImage']").map(function () {
            return `#${this.id}`;
        }).get()
        ]);
        show(scrID, ['bsnessQ_row']);
        addErr(scrID, ['businessQchecked']);
    }
};

function emptyValidation(value) {

    if (typeof value === "string") {
        value = value
            .replace(/\u20B9/g, "")
            .replace(/,/g, "")
            .trim();
    }

    let res = value;

    if (res === undefined || res === null || res === "" || res === " " || res === "-" || isNaN(Number(res))) {
        value = "-"
    }

    return value;
};
apz.app.Kmbase.fetchbmQueryData = function () {
    ApzCOB.FetchDBKITMasterData('ALL')
    try {
        return window.bmQuerydata = JSON.parse(DBKIT_MASTERDATA.find(el => el.category === "BMRECOMMENDATION" && el.stageName.trim() === ({
            CBcheck: "BMCbcheck",
            AadhaarDetails: "BMAadhaarAddress",
            BusinessIncome: "BMIncomeDetails",
            OtherInformation: "BMOtherInformation"
        }[apz.childScr]))?.queries || "{}");
    } catch(e) {
        ApzCOB.traceFrontEndError(e,"");
        return window.bmQuerydata = {};
    }
}
apz.app.Kmbase.launchQuery = function (substage, pthis) {
    $("#KmSourc__Kmbase__Query_Err_Row").addClass("sno");
    if (apz.childScr == 'BusinessIncome') {
        window.busID = pthis.id.match(/\d+/)?.[0];
    }
    apz.app.Kmbase.fetchbmQueryData();
    let isApplicant = gApzCOB.currentApplicant <= 1;
    let custType = isApplicant ? "Applicant" : "CoApp";
    let screenKeyMap = {
        AadhaarDetails: "AadhaarAddress"
    };
    window.sub_Stage = substage;
    window.childScr = screenKeyMap[apz.childScr] || apz.childScr;
    if (bmQuerydata?.[childScr]?.[substage]) {
        let data = bmQuerydata[childScr][substage];
        if (data) {
            window.filteredQdta = ['OtherInformation', 'BusinessIncome'].includes(childScr) ? data : (data?.[custType] || []);
        } else {
            window.filteredQdta = [];
        }
    }
    window.KM_othReasonId = "";
    window.KM_othReasonSelected = false;
    let arr = [...window.filteredQdta, {
        id: "oth",
        value: "Other"
    }];
    window.KM_QueriesPainted = arr;
    apz.data.scrdata.KmSourc__KMQueries_Res = JSON.parse(JSON.stringify(arr));
    apz.data.loadData("KMQueries", "KmSourc");
    $(`#${kmbaseScr}searchQueryInput`).val("");
    $(`#${kmbaseScr}otherQueryReasonForm`).addClass("sno");
    $(`#${kmbaseScr}Query_Err_Row`).addClass("sno");
    $(`#${kmbaseScr}noResult_row`).addClass("sno");
    $(`#${kmbaseScr}queryList`).removeClass("sno").addClass("pb-70");
    $(`#${kmbaseScr}queryList li`).attr('onclick', '');
    $(`#${kmbaseScr}save`).text("Save");
    for (let i = 0; i < window.KM_QueriesPainted.length; i++) {
        $(`#${kmQueriesIntfId}id_${i}`).prop("checked", false);
    }
    let headerEl = document.querySelector("#KmSourc__Kmbase__queryModal_window .modal-header li h1");
    if (headerEl) headerEl.textContent = "Query";
    $(`#${kmbaseScr}queryList`).find("p").filter(function (el) {
        let valEl = document.getElementById(`${kmQueriesIntfId}value_${el}_txtcnt`);
        if (valEl && valEl.textContent === "Other") {
            window.KM_othReasonId = `#${kmQueriesIntfId}id_${el}`;
            $(`#${kmQueriesIntfId}id_${el}`).attr("onchange",
                "apz.app.Kmbase.onSelectKMOtherReason(); apz.app.Kmbase.kmQueryCheckBoxCount();");
        } else {
            $(`#${kmQueriesIntfId}id_${el}`).attr("onchange", "apz.app.Kmbase.kmQueryCheckBoxCount();");
        }
    });
    apz.app.Kmbase.queryChckdByDflt(sub_Stage)
    ApzCOB.toggleModal(`${kmbaseScr}queryModal`);
}
apz.app.Kmbase.onClickQueryMdlSave = function () {
    var checkedLength = -1;
    if (KM_othReasonSelected) {
        otherVal = $(`#${kmbaseScr}otherQueryReasonInp`).val();
        if (apz.isNull(otherVal)) {
            ApzCOB.addErrMessage(`${kmbaseScr}otherQueryReasonInp`, "element");
            document.getElementById('APZCBO__BaseScreens__el_txt_44_txtcnt').scrollIntoView();
            return;
        }
    }
    KM_QueriesPainted.forEach(function (item, index) {
        if ($(`#${kmQueriesIntfId}id_${index}`).prop("checked")) {
            checkedLength++;
            checkedQueries.push(KM_QueriesPainted[index]?.id);
            if (KM_othReasonId === `#${kmQueriesIntfId}id_${index}`) {
                checkedQueries[checkedQueries?.length - 1] = checkedQueries?.[checkedQueries?.length - 1] + "?" + $(
                    `#${kmbaseScr}otherQueryReasonInp`).val();
            }
        }
    });
    apz.app.Kmbase.kmQuerySave(checkedQueries)
};
apz.app.Kmbase.kmQuerySave = function (checkedQueries) {
    let stage = `${apz.childScr}_${sub_Stage}`;
    if (apz.childScr == 'BusinessIncome') {
        stage = `${stage}_${busID}`;
    }
    let req = {
        apiRequest: {
            interfaceName: "CreateLoan",
            appId: gAppId,
            requestType: "query",
            userId: gApzCOB.LoggedInUserDetails.loginResponse.userDet.id,
            requestObj: {
                isNewSourcing: "Y",
                queries: checkedQueries,
                appId: gApzCOB.userDetails.appId,
                applicationId: gApzCOB.userDetails.applicationId,
                versionNum: window.versionNum,
                applicationMaster: {
                    appId: gApzCOB.userDetails.appId,
                    applicationId: gApzCOB.userDetails.applicationId,
                    applicationType: "online",
                    createdBy: gApzCOB.LoggedInUserDetails.loginResponse.userDet.id,
                    productCode: apz.isNull(gApzCOB.productCode) ? "1009" : gApzCOB.productCode,
                    productGroupCode: gApzCOB.product,
                    searchCode1: gApzCOB.selLeadDtls.kendraId,
                    searchCode2: gApzCOB.selLeadDtls.customerId,
                    currentScreenId: stage,
                    custDtlSlNum: gApzCOB.currentApplicant,
                    applicantsCount: gApzCOB.noOfApplicants,
                    workitemNo: ProductData[0].productCode === "1001"
                        ? String(gApzCOB.selLeadDtls.referenceId || gApzCOB.selLeadDtls.openMarketId)
                        : gApzCOB.selLeadDtls.pid
                },
                workflow: {
                    currentRole: gApzCOB.LoggedInUserDetails.loginResponse.addInfo1
                }
            }
        }
    };
    apz.startLoader();
    setTimeout(() => {
        ApzCOB.serverBuildParam(gAppId, "CreateLoan", "N", "N", req, false, apz.app.Kmbase.kmQuerySaveCB);
    }, 1000);
};
apz.app.Kmbase.kmQuerySaveCB = function (params) {
    checkedQueries = [];
    ApzCOB.toggleModal(`${kmbaseScr}queryModal`);
    apz.stopLoader();
    try {
        if (ApzCOB.handleServiceCallBacks(params)) {
            ApzCOB.updateInsessionData(params);
            apz.app.Kmbase.paintingQuery();
            apz.app.Kmbase.paintSidebarStatus();
        }
    } catch (error) {
        ApzCOB.traceFrontEndError(error,"");
        ApzCOB.showCommonErrRPCModal();
    }
}
apz.app.Kmbase.paintingQuery = function () {
    let isApplicant = gApzCOB.currentApplicant <= 1;
    let applType = isApplicant ? "A" : "C";
    let allowedScreens = [
        'CBcheck',
        'AadhaarDetails',
        'BusinessIncome',
        'OtherInformation'
    ];

    let currScrn = allowedScreens.includes(apz.childScr) ? apz.childScr : '';
    let custType = isApplicant ? 'Applicant' : 'CoApp';
    let screenIdMap = {
        CBcheck: window.CBcheckScr,
        AadhaarDetails: window.AadhaarScrId,
        BusinessIncome: `${window.kmIncomeScr}${busID}_`,
        OtherInformation: window.kmothInfoScr
    };
    let scrID = screenIdMap[apz.childScr];
    let queryDtls = '';
    const getEl = (scrID, field) => $(`#${scrID}${field}`);
    const hide = (scrID, arr) => arr.forEach(f => getEl(scrID, f).addClass('sno'));
    const show = (scrID, arr) => arr.forEach(f => getEl(scrID, f).removeClass('sno'));
    if (apz.childScr == 'AadhaarDetails') {
        currScrn = "AadhaarAddress";
    }
    let data = bmQuerydata?.[currScrn]?.[sub_Stage];
    let { srcStatDetails } = inSessionStore;
    if (["BMPUSHBACK", "IPUSHBACK", "CAPUSHBACK"].includes(window.ApplicationStatus)) {
        srcStatDetails = timeLineSrcStat;
    }
    let masterQueries = ['OtherInformation', 'BusinessIncome'].includes(currScrn) ? data : (data?.[custType] || []);
    if (apz.childScr == 'BusinessIncome') {
        queryDtls = srcStatDetails?.find(item => item.stageID == KM_CURR_STAGE_NO && item.subStageId == `${sub_Stage}_${busID}` && item
            .custType == applType);
        window.businessIndex = window.busID;
        if (queryDtls)
            queryDtls.query = queryDtls?.query?.filter(q => !q.startsWith('BIndex')) || [];
    } else {
        queryDtls = srcStatDetails?.find(item => item.stageID == KM_CURR_STAGE_NO && item.subStageId == sub_Stage && item
            .custType == applType);
    }
    let queryConfig = queryUIMap?.[apz.childScr]?.[sub_Stage];
    if (queryDtls) {
        window.finalQueries = queryDtls.query.map((q, index) => {
            let queryText = apz.app.Kmbase.getQueryText(q, queryDtls, masterQueries);
            return `${index + 1}. ${queryText}`;
        });
        if (queryConfig) {
            show(scrID, queryConfig.show);
            hide(scrID, queryConfig.hide);
            getEl(scrID, queryConfig.data).html(finalQueries.join('<br>'));
            if (apz.childScr == 'BusinessIncome') {
                $(`#${scrID}businessQchecked`).addClass('kmenacherr');
            }
            apz.app.Kmbase.paintQueryTimeStamp(sub_Stage);
        }
        return finalQueries.map(query => ({
            query
        }));
    } else {
        if (queryConfig) {
            hide(scrID, queryConfig.show);
            show(scrID, queryConfig.hide);
            getEl(scrID, queryConfig.data).html(finalQueries.join('<br>'));
            if (apz.childScr == 'BusinessIncome') {
                $(`#${scrID}businessQchecked`).addClass('kmenacherr');
            }
            apz.app.Kmbase.paintQueryTimeStamp(sub_Stage);
        }
    }
};
apz.app.Kmbase.queryChckdByDflt = function (sub_Stage) {
    let isApplicant = gApzCOB.currentApplicant <= 1;
    let applType = isApplicant ? "A" : "C";
    let queryDtls = '';
    let { srcStatDetails } = inSessionStore;
    if (["BMPUSHBACK", "IPUSHBACK", "CAPUSHBACK"].includes(window.ApplicationStatus)) {
        srcStatDetails = timeLineSrcStat;
    }
    if (apz.childScr == 'BusinessIncome') {
        queryDtls = srcStatDetails?.find(item => item.stageID == KM_CURR_STAGE_NO && item.subStageId == `${sub_Stage}_${busID}`);
        if (!queryDtls?.query?.length) return;
        window.businessIndex = busID;
    } else {
        queryDtls = srcStatDetails?.find(item => item.stageID == KM_CURR_STAGE_NO && item.subStageId == sub_Stage && item
            .custType == applType);
    }
    if (!queryDtls?.query?.length) {
        return;
    }
    let chkdQueriesBYDyDflt = queryDtls.query;
    if (!Array.isArray(window.KM_QueriesPainted) || !window.KM_QueriesPainted.length) {
        return;
    }
    const othEntry = chkdQueriesBYDyDflt.find(item => item.startsWith("oth?"));
    if (othEntry) {
        const [, othValue] = othEntry.split("?");
        const othIndex = window.KM_QueriesPainted.findIndex(entry => entry.id.toLowerCase() === "oth");
        if (othIndex !== -1) {
            $(`#${kmQueriesIntfId}id_${othIndex}`).prop("checked", true);
            $(`#${kmbaseScr}otherQueryReasonForm`).removeClass("sno");
            $(`#${kmbaseScr}otherQueryReasonInp`).val(othValue);
            window.othReasonSelected = true;
        }
    }
    window.KM_QueriesPainted.forEach((entry, index) => {
        if (chkdQueriesBYDyDflt.includes(entry.id)) {
            $(`#${kmQueriesIntfId}id_${index}`).prop("checked", true);
        }
    });
};
apz.app.Kmbase.fecthsubStage = function () {
    let { srcStatDetails } = inSessionStore;
    if (["BMPUSHBACK", "IPUSHBACK", "CAPUSHBACK"].includes(window.ApplicationStatus)) {
        srcStatDetails = timeLineSrcStat;
    }
    window.sub_Stage = KM_SUBSTAGES?.[apz.childScr]?.filter(stage => !srcStatDetails?.length || srcStatDetails
        .some(item => item.subStageId === stage)) || [];
}
apz.app.Kmbase.paintQueryTimeStamp = function (sub_Stage, isOldQuery) {
try {    
    let screenIdMap = {
        CBcheck: window.CBcheckScr,
        AadhaarDetails: window.AadhaarScrId,
        BusinessIncome: `${window.kmIncomeScr}${busID}_`,
        OtherInformation: window.kmothInfoScr
    };
    let queryTSmapId = {
        LoanDetails: 'LDqueryDisplay',
        KYCDetails: 'KYCqueryDisplay',
        CustomerDetails: 'CustqueryDisplay',
        ResidencePresentAddress: 'resqueryDisplay',
        PanCardDetails: 'PCustqueryDisplay',
        CoApplicantAadharDetails: 'COqueryDisplay',
        AadharDetails: 'aadqueryDisplay',
        PersonalDetails: 'psnlqueryDisplay',
        PermanentAddress: 'comqueryDisplay',
        RedidenceDetails: 'resdqueryDisplay',
        RelationshipProof: 'relqueryDisplay',
        Business: 'busqueryDisplay',
        BankDetails: 'bnkqueryDisplay',
        AMLQuestionaire: 'amlqueryDisplay',
        InsuranceDetails: 'InsqueryDisplay',
    };
    let queryDtls = '';
    let { srcStatDetails } = inSessionStore;
    if (window.ApplicationStatus !== "PENDING" || isOldQuery) {
        srcStatDetails = timeLineSrcStat;
    }
    if (lastWorkFlw?.stage?.includes('RPC') || (lastWorkFlw?.stage?.includes('Credit Assessment') && (window.ApplicationStatus === 'IPUSHBACK' || window.ApplicationStatus === 'CAPUSHBACK'))) {
        let scrID = screenIdMap[apz.childScr] || '';
        let field = apz.childScr == 'BusinessIncome' ? queryTSmapId["Business"] : queryTSmapId[sub_Stage];
        if (scrID && field) {
            if (["IPUSHBACK", "CAPUSHBACK"].includes(window.ApplicationStatus)) {
                $(`#${scrID}${field}`).text(`Sent Back Reasons (${lastWorkFlw.userId}, ${lastWorkFlw.stage}, ${lastWorkFlw.timeStamp})`);
            } else {
                $(`#${scrID}${field}`).text(`Queries (${formattedDate})`);
            }
            return;
        }
    } else if (apz.childScr == 'BusinessIncome') {
        queryDtls = srcStatDetails?.find(item => item.subStageId === `Business_${window.businessIndex}`);
    } else {
        queryDtls = srcStatDetails?.find(item => item.subStageId === sub_Stage);
    }
    if (!queryDtls?.timeStamp?.[0]) return;
    let ts = queryDtls?.timeStamp[0];
    let formattedDate = "";
    if (ts && ts.date && ts.time) {
        formattedDate = `${String(ts.date.day).padStart(2, '0')}/` + `${String(ts.date.month).padStart(2, '0')}/` + `${ts.date.year} - ` +
            `${String(ts.time.hour).padStart(2, '0')}:` + `${String(ts.time.minute).padStart(2, '0')}:` +
            `${String(ts.time.second).padStart(2, '0')}`;
    }
    let scrID = screenIdMap[apz.childScr] || '';
    let field = apz.childScr == 'BusinessIncome' ? queryTSmapId["Business"] : queryTSmapId[queryDtls.subStageId];
    field = isOldQuery ? `${field}Old_txtcnt` : `${field}_txtcnt`
    if (scrID && field) {
        let sentBackBy = lastWorkFlw?.stage;
        if (["BMPUSHBACK", "CAPUSHBACK"].includes(window.ApplicationStatus) || (sentBackBy && sentBackBy.includes('Credit Assessment'))) {
            formattedDate = ApzCOB.dateformatter(lastWorkFlw.timeStamp.replace(' ', 'T'), "date", "d/m/Y");
            $(`#${scrID}${field}`).text(`Sent Back Reasons (${lastWorkFlw.userId}, ${lastWorkFlw.stage}, ${formattedDate})`);
        } else {
            $(`#${scrID}${field}`).text(`Queries (${formattedDate})`);
        }
        if (isOldQuery) {
            formattedDate = ApzCOB.dateformatter(lastWorkFlw.timeStamp.replace(' ', 'T'), "date", "d/m/Y");
            field = field.replace('queryDisplay', 'ResponseDisplay')
            $(`#${scrID}${field}`).text(`Feedback from Sourcing (${formattedDate})`);
        }
    }
} catch(e){
     ApzCOB.traceFrontEndError(e,"");
}
};
apz.app.Kmbase.paintQueryResponsedata = function (isOldQuery) {
try {
    let applicationStatus = inSessionStore.applicationMaster?.applicationStatus;
    if (!applicationStatus || applicationStatus === "INPROGRESS")
        return;
    let sentBackBy = lastWorkFlw?.stage;
    if (applicationStatus === 'CAPUSHBACK' || (sentBackBy && sentBackBy.includes('Credit Assessment'))) {
        if (window.CA_ALL_STAGE_FIELDS.length === 0) {
            ApzCOB.fetchCAMaster();
            return;
        }
    } else if (sentBackBy && sentBackBy.includes('RPC') && applicationStatus === 'IPUSHBACK') {
        window.lastWorkFlw = inSessionStore.applicationTimelineDtl.at(-1);
        window.timeLineSrcStat = lastWorkFlw.rpcStatRemaks || [];
        window.rpcstageIDmapping = { "1": ["1~KYCDetails", "3~PanCardDetails"], "2": ["2~AadharDetails", "4~RelationshipProof", "5~PermanentAddress", "6~RedidenceDetails"], "3": ["7~Business"], "4": ["8~BankDetails", "9~InsuranceDetails"] };
        if (RPC_ALL_STAGE_QUERIES.length == 0) {
            ISDATAFETCH = true;
            ApzCOB.fetchStageWiseQueries('RPC');
            return;
        }
    } else {
        apz.app.Kmbase.fetchbmQueryData();
    }
    let isKM = gApzCOB?.LoggedInUserDetails?.loginResponse?.addInfo1 === 'KM';
    let isApplicant = gApzCOB.currentApplicant <= 1;
    let applType = isApplicant ? "A" : "C";
    let custType = isApplicant ? "Applicant" : "CoApp";
    const stageMap = {
        CBcheck: 1,
        AadhaarDetails: 2,
        BusinessIncome: 3,
        OtherInformation: 4
    };
    const screenIdMap = {
        CBcheck: window.CBcheckScr,
        AadhaarDetails: window.AadhaarScrId,
        OtherInformation: window.kmothInfoScr
    };
    const responseRowMap = {
        LoanDetails: 'LDResponseRow',
        KYCDetails: 'KycResponseRow',
        CustomerDetails: 'custResponseRow',
        CoApplicantAadharDetails: 'COResponseRow',
        ResidencePresentAddress: 'resResponseRow',
        PanCardDetails: 'PResponseRow',
        AadharDetails: 'aadResponseRow',
        PersonalDetails: 'psnlResponseRow',
        PermanentAddress: 'comResponseRow',
        RedidenceDetails: 'rsdResponseRow',
        RelationshipProof: 'relResponseRow',
        BankDetails: 'bnkResponseRow',
        AMLQuestionaire: 'AMLResponseRow',
        InsuranceDetails: 'InsResponseRow'
    };
    const responseFieldMap = {
        LoanDetails: 'LDRestext',
        KYCDetails: 'KycRestext',
        CustomerDetails: 'custRestext',
        CoApplicantAadharDetails: 'CORestext',
        ResidencePresentAddress: 'resRestext',
        PanCardDetails: 'PRestext',
        AadharDetails: 'aadRestext',
        PersonalDetails: 'psnlRestext',
        PermanentAddress: 'comRestext',
        RedidenceDetails: 'rsdRestext',
        RelationshipProof: 'relRestext',
        BankDetails: 'bnkRestext',
        AMLQuestionaire: 'AMLRestext',
        InsuranceDetails: 'InsRestext'
    };
    window.current_response_fields = {};
    let KM_CURR_STAGE_NO = stageMap[apz.childScr];
    let queryList = [];
    let finalQueries = '';
    let scrID = screenIdMap[apz.childScr] || '';
    let { srcStatDetails } = inSessionStore;
    let queryResponse = inSessionStore?.sourcingQueryResponse?.response ?
        JSON.parse(inSessionStore?.sourcingQueryResponse?.response) : {};
    if (isOldQuery) {
        try {
            queryResponse = lastWorkFlw?.remarks ? JSON.parse(lastWorkFlw.remarks) : {};
        } catch (e) {
            ApzCOB.traceFrontEndError(e,"");
            console.error("Invalid JSON:", e);
            queryResponse = {};
        }
        srcStatDetails = timeLineSrcStat;
    } else if (window.ApplicationStatus !== "PENDING") {
        srcStatDetails = timeLineSrcStat;
    }
    // MUI-289
    if ((applicationStatus === 'IPUSHBACK' || applicationStatus === 'CAPUSHBACK') && lastWorkFlw?.stage?.includes('Credit Assessment')) {
        (srcStatDetails || []).forEach(item => {
            //MUI-289
            if ((String(item.stageID) === '2') || (String(item.stageID) === '1') )  {
                item.stageID=1;
                if(item.custType==="R"){
                    item.stageID=4;
                }
                if(applicationStatus==='IPUSHBACK'){
                window.PhotoKycQuery = "KYCDetails";}
            }
        });
    }
    if (isKM) {
        $(`.pushBackReadonly button`).prop({ 'disabled': true })
        $(`.pushBackReadonly input:is([type="radio"], [type="button"], [type="checkbox"], [type="text"], [type="tel"])`)?.prop({ 'readOnly': true, 'disabled': true });
        $(`.pushBackHide`)?.addClass("sno");
    }

    // ---------- BUSINESS INCOME ----------
    if (apz.childScr === 'BusinessIncome') {

        //Making all sections disabled for pushback
        let bussCounts = $("[id^='KmSourc__BusinessIncome__CloneRow_']:visible").length;
        for (i = 0; i <= bussCounts; i++) {
            apz.app.Kmbase.enableOnlyQuerySubStage(i, true)
        }

        if (sentBackBy.includes('RPC') || (sentBackBy.includes('Credit Assessment') && (applicationStatus === 'IPUSHBACK' || applicationStatus === 'CAPUSHBACK'))) {
            // Ensure rpcstageIDmapping is defined; fallback to empty mapping if not set
            const mappingObj = window.rpcstageIDmapping || {};
            const stageArray = mappingObj[KM_CURR_STAGE_NO] || [];
            rpcStages = stageArray.map(el => el.split('~')[0]);
            queryList = (srcStatDetails || []).filter(el => (rpcStages.includes(el.stageID.toString()) || (!sentBackBy.includes('RPC') && el.stageID === KM_CURR_STAGE_NO)/* && (el.custType == applType || el.custType === '')*/));
        } else {
            queryList = (srcStatDetails || []).filter(item => item.stageID === KM_CURR_STAGE_NO && item.subStageId.startsWith("Business"));
        }
        if (!queryList.length) return [];
        queryList.forEach(queryDtls => {
            let subStgMap = queryDtls.subStageId ? queryDtls.subStageId : queryDtls.custType;
            let businessIndex = subStgMap.split('_')[1] || queryDtls.custType;
            busID = businessIndex.replace(/\D/g, '') || "1";
            if (busID === "0") busID = "1";
            scrID = `${window.kmIncomeScr}${busID}_`;
            let filteredQueries = queryDtls.query;
            if (sentBackBy.includes('RPC') || (sentBackBy.includes('Credit Assessment') && (applicationStatus === 'IPUSHBACK' || applicationStatus === 'CAPUSHBACK'))) {
                data = (window.RPC_ALL_STAGE_QUERIES || []).find(el => el.stageID == queryDtls.stageID && el.custType === applType)?.query;
                //Sorting RPC Business Queries
                if(sentBackBy.includes('RPC')){
                let qryOrd = data.map(qry => qry.id)
                queryDtls.query = queryDtls.query.sort((a,b) => {
                    return qryOrd.indexOf(a) - qryOrd.indexOf(b)
                })
            }
            } else {
                data = bmQuerydata?.BusinessIncome?.Business || [];
            }
            finalQueries = filteredQueries.map((q, i) => {
                let text = apz.app.Kmbase.getQueryText(q, queryDtls, data);
                return `${i + 1}. ${text}`;
            });
            let queryConfig = window.queryUIMap?.BusinessIncome?.Business;
            if (queryConfig) {
                window.businessIndex = busID;
                if (isOldQuery) {
                    queryConfig.showOld.forEach(id => $(`#${scrID}${id}`).removeClass('sno'));
                    apz.app.Kmbase.paintQueryTimeStamp(sub_Stage, isOldQuery);
                    $(`#${scrID}${queryConfig.data}Old`).html(finalQueries.join('<br>'));
                    let responseVal = [queryResponse[apz.childScr]?.[`Business_${busID}`]?.[custType]];
                    $(`#${scrID}${queryConfig.resData}`).html(responseVal.join('<br>'));
                    return;
                }
                queryConfig.show.forEach(id => $(`#${scrID}${id}`).removeClass('sno'));
                queryConfig.hide.forEach(id => $(`#${scrID}${id}`).addClass('sno'));
                $(`#${scrID}${queryConfig.data}`).html(finalQueries.join('<br>'));
                $(`#${scrID}businessQchecked`).addClass('kmenacherr');
                if (isKM) {
                    let responseVal = queryResponse[apz.childScr]?.[`Business_${busID}`]?.[custType];
                    $(`#${scrID}busRestext`).val(responseVal)
                    apz.app.Kmbase.enableOnlyQuerySubStage(busID, false);
                    current_response_fields[`Business_${busID}`] = `#${scrID}busRestext`;
                    $(`#${scrID}busRestext`).on('input', function (e) { 
                        ApzCOB.fnValidatealphanumericWithspace(this);
                        ApzCOB.fnValidateOtherInput(this);
                        ApzCOB.restrictWhiteSpace(this);
                    });
                    $(`#${scrID}busResponseRow`).removeClass('sno');
                }
                apz.app.Kmbase.paintQueryTimeStamp(sub_Stage);
            }
        });
        return;
    }
    if (lastWorkFlw?.stage?.includes('RPC')) {
        // RPC uses sub-stageIDs — map them back to the current main stage
        const mappingObj = window.rpcstageIDmapping || { "1": ["1~KYCDetails", "3~PanCardDetails"], "2": ["2~AadharDetails", "4~RelationshipProof", "5~PermanentAddress", "6~RedidenceDetails"], "3": ["7~Business"], "4": ["8~BankDetails", "9~InsuranceDetails"] };
        const stageArray = mappingObj[KM_CURR_STAGE_NO] || [];
        rpcStages = stageArray.map(el => el.split('~')[0]);
        queryList = (srcStatDetails || []).filter(el => rpcStages.includes(el.stageID.toString()) && el.custType == applType);
    } else if (apz.childScr === 'OtherInformation') {
        queryList = srcStatDetails?.filter(item => item.stageID == KM_CURR_STAGE_NO) || [];
    } else if (lastWorkFlw?.stage?.includes('Credit Assessment') && (applicationStatus === 'IPUSHBACK' || applicationStatus === 'CAPUSHBACK')) {
        if (lastWorkFlw.caStatDetails) {
            queryList = (srcStatDetails || []).filter(el => el.stageID == KM_CURR_STAGE_NO && (el.custType == applType || el.custType === ''));
        } else {
            const mappingObj = window.rpcstageIDmapping || { "1": ["1~KYCDetails", "3~PanCardDetails"], "2": ["2~AadharDetails", "4~RelationshipProof", "5~PermanentAddress", "6~RedidenceDetails"], "3": ["7~Business"], "4": ["8~BankDetails", "9~InsuranceDetails"] };
            const stageArray = mappingObj[KM_CURR_STAGE_NO] || [];
            rpcStages = stageArray.map(el => el.split('~')[0]);
            // Filter by applType; also keep 'R' (relationship/address) entries that don't match A/C
            queryList = (srcStatDetails || []).filter(el => rpcStages.includes(el.stageID.toString()) && (el.custType === applType || el.custType === 'R' || el.custType === ''));
        }
    } else {
        queryList = srcStatDetails?.filter(item => item.stageID == KM_CURR_STAGE_NO && item.custType == applType) || [];
    }
    //Clearing previous queries
    const getEl = (scrID, field) => $(`#${scrID}${field}`);
    const hide = (scrID, arr) => arr.forEach(f => getEl(scrID, f).addClass('sno'));
    const show = (scrID, arr) => arr.forEach(f => getEl(scrID, f).removeClass('sno'));
    if (typeof window.queryUIMap?.[apz.childScr] == 'undefined') return;
    Object.values(window.queryUIMap?.[apz.childScr]).forEach(queryConfig => {
        if (isOldQuery) {
            hide(scrID, queryConfig.showOld)
        } else {
            hide(scrID, queryConfig.show);
            show(scrID, queryConfig.hide);
        }
    })
     let customerTyp = isApplicant ? "Applicant" : "Co-App";
    let custEntry = inSessionStore?.customerDetailsList?.find(c => c.customerType === customerTyp);
    if (custEntry?.payload?.panNumberValue === 'N') {
        $("#KmSourc__CBcheck__PanQueryBtn").addClass('sno');
    }

    //Clearing Query Response of previous screens
    Object.keys(window.queryUIMap?.[apz.childScr]).forEach(subStage => {
        apz.app.Kmbase.enableOnlyQuerySubStage(subStage, true);
        hide(scrID, [responseRowMap[subStage]])
    })

    //Displaying the Other Information scrn queries
    if (apz.childScr === 'OtherInformation') {
        show(scrID, ['bnkQfrm', 'InsTypQ_frm', 'AmlQ_frm', 'Insrow']);
    }

    if (!queryList.length) return [];

    // Map from CA main stageID to the default subStageId for each KM screen
    const caStageToSubStage = {
        1: 'LoanDetails',
        2: 'AadharDetails',
        3: 'Business',
        4: 'InsuranceDetails'
    };
    queryList.forEach(queryDtls => {
        let sub_Stage = queryDtls.subStageId;
        if (lastWorkFlw?.stage?.includes('RPC')) {
            const mappingObj = window.rpcstageIDmapping || { "1": ["1~KYCDetails", "3~PanCardDetails"], "2": ["2~AadharDetails", "4~RelationshipProof", "5~PermanentAddress", "6~RedidenceDetails"], "3": ["7~Business"], "4": ["8~BankDetails", "9~InsuranceDetails"] };
            const stageArray = mappingObj[KM_CURR_STAGE_NO] || [];
            rpcStages = stageArray.map(el => el.split('~')[0]);
            queryList = (srcStatDetails || []).filter(el => rpcStages.includes(el.stageID.toString()) && el.custType == applType);
            sub_Stage = (mappingObj[KM_CURR_STAGE_NO] || []).find(el => el.split('~')[0] == queryDtls.stageID)?.split('~')[1] || queryDtls.subStageId;
        } else if (lastWorkFlw?.stage?.includes('Credit Assessment') && (applicationStatus === 'IPUSHBACK' || applicationStatus === 'CAPUSHBACK')) {
            if (lastWorkFlw.caStatDetails || lastWorkFlw?.rpcStatRemaks) {
                if (!sub_Stage) {
                    sub_Stage = caStageToSubStage[queryDtls.stageID] || queryDtls.subStageId;
                    // MUI-289
                    if ((applicationStatus === 'IPUSHBACK' || applicationStatus === 'CAPUSHBACK') && lastWorkFlw?.stage?.includes('Credit Assessment')) {
                        let stageId = lastWorkFlw?.rpcStatRemaks?.find(item => item?.stageID != null)?.stageID ?? null;
                        if ((stageId == '1')&&(apz.childScr==="CBcheck")) { 

                            sub_Stage = "KYCDetails"
                        }
                        if((stageId == '1')&&(apz.childScr==='AadhaarDetails')){
                            sub_Stage = "RelationshipProof"
                            PhotoKycQuery="RelationshipProof"
                        }
                    }
                }
            } else {
                const mappingObj = window.rpcstageIDmapping || { "1": ["1~KYCDetails", "3~PanCardDetails"], "2": ["2~AadharDetails", "4~RelationshipProof", "5~PermanentAddress", "6~RedidenceDetails"], "3": ["7~Business"], "4": ["8~BankDetails", "9~InsuranceDetails"] };
                sub_Stage = (mappingObj[KM_CURR_STAGE_NO] || []).find(el => el.split('~')[0] == queryDtls.stageID)?.split('~')[1] || queryDtls.subStageId;
            }
        }
        let screenIdMap = {
            CBcheck: window.CBcheckScr,
            AadhaarDetails: window.AadhaarScrId,
            OtherInformation: window.kmothInfoScr
        };
        let dataKey = apz.childScr === 'AadhaarDetails' ? 'AadhaarAddress' : apz.childScr;
        if (lastWorkFlw?.stage?.includes('RPC') || (lastWorkFlw?.stage?.includes('Credit Assessment') && !lastWorkFlw.caStatDetails)) {
            masterQueries = (RPC_ALL_STAGE_QUERIES.find(el => el.stageID == queryDtls.stageID && el.custType === applType) || { query: [] }).query;
            //Sorting RPC queries in order
            if(lastWorkFlw?.stage?.includes('RPC')){
                let qryOrd = masterQueries.map(qry => qry.id)
                queryDtls.query = queryDtls.query.sort((a,b) => {
                    return qryOrd.indexOf(a) - qryOrd.indexOf(b)
                })
            }
        } else {
            data = bmQuerydata?.[dataKey]?.[sub_Stage];
            masterQueries = ['OtherInformation'].includes(apz.childScr) ? (data || []) : (data?.[custType] || []);
        }
        finalQueries = queryDtls.query.map((q, i) => {
            let text = apz.app.Kmbase.getQueryText(q, queryDtls, masterQueries);
            return `${i + 1}. ${text}`;
        });
        let queryConfig = window.queryUIMap?.[apz.childScr]?.[sub_Stage];
        if (!queryConfig) return;
        if (isOldQuery) {
            queryConfig.showOld.forEach(id => $(`#${scrID}${id}`).removeClass('sno'));
            apz.app.Kmbase.paintQueryTimeStamp(sub_Stage, isOldQuery);
            $(`#${scrID}${queryConfig.data}Old`).html(finalQueries.join('<br>'));
            let responseVal = [queryResponse[apz.childScr]?.[sub_Stage]?.[custType]];
            $(`#${scrID}${queryConfig.resData}`).html(responseVal.join('<br>'));
            return;
        }
        queryConfig.show.forEach(id => $(`#${scrID}${id}`).removeClass('sno'));
        queryConfig.hide.forEach(id => $(`#${scrID}${id}`).addClass('sno'));
        $(`#${scrID}${queryConfig.data}`).html(finalQueries.join('<br>'));
        const isRpcStatSource = lastWorkFlw.stage?.includes('Credit Assessment') && !lastWorkFlw.caStatDetails && lastWorkFlw.rpcStatRemaks;
        if (isKM && responseRowMap[sub_Stage] && (queryDtls.custType === applType || queryDtls.custType === '' || isRpcStatSource)) {
            let responseVal = queryResponse[apz.childScr]?.[sub_Stage]?.[custType];
            $(`#${scrID}${responseFieldMap[sub_Stage]}`).val(responseVal)
            current_response_fields[sub_Stage] = `#${scrID}${responseFieldMap[sub_Stage]}`;
            $(`#${scrID}${responseFieldMap[sub_Stage]}`).on('input', function (e) { 
                ApzCOB.fnValidatealphanumericWithspace(this);
                ApzCOB.fnValidateOtherInput(this);
                ApzCOB.restrictWhiteSpace(this);
            });
            $(`#${scrID}${responseRowMap[sub_Stage]}`).removeClass('sno');
            apz.app.Kmbase.enableOnlyQuerySubStage(sub_Stage, false);
        }
        apz.app.Kmbase.paintQueryTimeStamp(sub_Stage);
    });
    return finalQueries;
} catch(e){
     ApzCOB.traceFrontEndError(e,"");
}
};
apz.app.Kmbase.addErrorStatusQueried = function () {
    let { srcStatDetails } = inSessionStore;
    if (["BMPUSHBACK", "IPUSHBACK", "CAPUSHBACK"].includes(window.ApplicationStatus)) {
        sentBackBy = lastWorkFlw?.stage;
        if (sentBackBy.includes('RPC') || (sentBackBy.includes('Credit Assessment') && (window.ApplicationStatus === 'IPUSHBACK' || window.ApplicationStatus === 'CAPUSHBACK'))) {
            window.lastWorkFlw = inSessionStore.applicationTimelineDtl.at(-1);
            window.timeLineSrcStat = lastWorkFlw.rpcStatRemaks ||
                (lastWorkFlw.caStatDetails ? apz.app.Kmbase.normalizeCAStatDetails(lastWorkFlw.caStatDetails) : []);
        } else if (sentBackBy.includes('Credit Assessment') || window.ApplicationStatus === "CAPUSHBACK") {
            srcStatDetails = timeLineSrcStat;
        }
        srcStatDetails = timeLineSrcStat;
    }
    let stageIdMap = {
        1: 'CBcheck',
        2: 'AadhaarDetails',
        3: 'BusinessIncome',
        4: 'OtherInformation'
    }
    let queryResponse = inSessionStore?.sourcingQueryResponse?.response ?
        JSON.parse(inSessionStore?.sourcingQueryResponse?.response) : {};
    if (!srcStatDetails)
        return;
    srcStatDetails.sort((a, b) => (a.stageID - b.stageID) || a.custType.localeCompare(b.custType)).forEach(item => {
        //MUI-289
        if ((window.ApplicationStatus === 'IPUSHBACK' || window.ApplicationStatus === 'CAPUSHBACK') && lastWorkFlw.stage?.includes('Credit Assessment') && String(item.stageID) === '2') {
            item.stageID = 1;
        }
        let config = checkstageMap[item.stageID];
        let rpcStage = '', rpcsubStage = '';
        if (lastWorkFlw.stage?.includes('RPC')) {
            // RPC uses sub-stageIDs — resolve back to main stage via rpcstageIDmapping
            window.rpcstageIDmapping = { "1": ["1~KYCDetails", "3~PanCardDetails"], "2": ["2~AadharDetails", "4~RelationshipProof", "5~PermanentAddress", "6~RedidenceDetails"], "3": ["7~Business"], "4": ["8~BankDetails", "9~InsuranceDetails"] };
            rpcStage = Object.keys(window.rpcstageIDmapping).find(key =>
                window.rpcstageIDmapping[key].some(mapping => mapping.split('~')[0] === String(item.stageID))
            );
            rpcsubStage = Object.values(window.rpcstageIDmapping)
                .flat()
                .find(mapping => mapping.startsWith(`${item.stageID}~`))
                ?.split('~')[1];
            config = checkstageMap[parseInt(rpcStage || item.stageID)]
        } else if (lastWorkFlw.stage?.includes('Credit Assessment') && (window.ApplicationStatus === 'IPUSHBACK' || window.ApplicationStatus === 'CAPUSHBACK')) {
            if (lastWorkFlw.caStatDetails) {
                const caStageToSubStage = { 1: 'LoanDetails', 2: 'AadharDetails', 3: 'Business', 4: 'InsuranceDetails' };
                rpcsubStage = item.subStageId || caStageToSubStage[item.stageID] || '';
            } else {
                window.rpcstageIDmapping = { "1": ["1~KYCDetails", "3~PanCardDetails"], "2": ["2~AadharDetails", "4~RelationshipProof", "5~PermanentAddress", "6~RedidenceDetails"], "3": ["7~Business"], "4": ["8~BankDetails", "9~InsuranceDetails"] };
                rpcStage = Object.keys(window.rpcstageIDmapping).find(key =>
                    window.rpcstageIDmapping[key].some(mapping => mapping.split('~')[0] === String(item.stageID))
                );
                rpcsubStage = Object.values(window.rpcstageIDmapping)
                    .flat()
                    .find(mapping => mapping.startsWith(`${item.stageID}~`))
                    ?.split('~')[1];
                config = checkstageMap[parseInt(rpcStage || item.stageID)];
            }
        }
        let custType = item.custType === 'A' ? 'app' : 'coapp';
        let applnType = item.custType === 'A' ? 'Applicant' : 'CoApp';
        if (item.stageID == 7) {
            custType = 'app';
            applnType = 'Applicant';
            rpcsubStage = rpcsubStage.includes('Business') ? `Business_${item.custType}` : rpcsubStage;
        }
        let scrnName = stageIdMap[rpcStage || item.stageID]
        if (!config) return;
        let responseVal = queryResponse[scrnName]?.[rpcsubStage || item.subStageId]?.[applnType];
        ['common', custType].forEach(key => {
            if (!responseVal) {
                if(["BMPUSHBACK", "IPUSHBACK", "CAPUSHBACK"].includes(window.ApplicationStatus)) {
                    window.FIRST_QRY_STAGE = window.FIRST_QRY_STAGE || {custType, scrnName}
                }
                config[key] && apz.app.Kmbase.addErrorStatus(config[key]);
            }
        });
    });
};
apz.app.Kmbase.sendback = function () {
    ApzCOB.toggleModal(kmbaseScr + "sendbackconfmdl")
}
apz.app.Kmbase.approveSendback = function () {
    apz.app.Kmbase.kmApproveReject('BMPUSHBACK')
}
apz.app.Kmbase.checkpendingstage = function () {
    let hasPendingStage = false;
    let hasErrorStage = false;
    apz.app.Kmbase.addErrorStatusQueried()
    Object.values(checkstageMap).forEach(stage => {
        ['app', 'coapp', 'common'].forEach(type => {
            let id = stage[type];
            if (!id) return;
            let $svg = $(`#${id} svg`);
            let icon = $(`#${id} use`).attr('xlink:href');
            if ($svg.hasClass('inprg') && icon === '#icon-sideprg') {
                hasPendingStage = true;
            }
            if ($svg.hasClass('error') && icon === '#icon-fail-filled') {
                hasErrorStage = true;
            }
        });
    });
    if (hasPendingStage) {
        ApzCOB.fnDisplayMsg("Please complete pending stages", "E");
        return;
    }
    if (hasErrorStage) {
        $(`#${kmbaseScr}confirmBtn`).prop('disabled', true);
        $(`#${kmbaseScr}sendback`).prop('disabled', false);
    } else {
        $(`#${kmbaseScr}confirmBtn`).prop('disabled', false);
        $(`#${kmbaseScr}sendback`).prop('disabled', true);
    }
}
apz.app.Kmbase.prepareQueryResponse = function () {
    let queryResponse = inSessionStore?.sourcingQueryResponse?.response ?
        JSON.parse(inSessionStore?.sourcingQueryResponse?.response) : {};
    let currScrResponse = { [apz.childScr]: queryResponse[apz.childScr] || {} }
    let custType = gApzCOB.currentApplicant === 1 ? "Applicant" : "CoApp";
    Object.entries(current_response_fields).forEach(([key, value]) => {
        if (!currScrResponse[apz.childScr][key]) {
            currScrResponse[apz.childScr][key] = { [custType]: $(value).val() }
        } else {
            currScrResponse[apz.childScr][key][custType] = $(value).val();
        }
    });
    if (["IPUSHBACK"].includes(window.ApplicationStatus) && apz.childScr === "OtherInformation") {
        //Handel RPC Other Information Co-APP sendback
    }
    return { ...queryResponse, ...currScrResponse }
}

apz.app.Kmbase.enableOnlyQuerySubStage = function (subStage, readOnly) {
    if (!["BMPUSHBACK", "IPUSHBACK", "CAPUSHBACK"].includes(window.ApplicationStatus))
        return;
    if (apz.childScr === "BusinessIncome") {
        $(`#KmSourc__BusinessIncome__${subStage}_expandRow input:is([type="radio"], [type="text"], [type="tel"]):not(.disabled)`)?.prop({ 'readOnly': readOnly, 'disabled': readOnly });
        if (readOnly) {
            $(`#KmSourc__BusinessIncome__${subStage}_expandRow .BusinessHide`)?.addClass("sno");
        } else {
            $(`#KmSourc__BusinessIncome__${subStage}_expandRow  .busReadOnly input:is([type="radio"])`).prop({ 'readOnly': true, 'disabled': true })
            $(`#KmSourc__BusinessIncome__${subStage}_expandRow .BusinessHide`)?.removeClass("sno");
        }

    } else {
        $(`.${subStage} input:is([type="radio"], [type="text"], [type="tel"], [type="checkbox"]):not(.disabled,.${subStage}Disable)`)?.prop({ 'readOnly': readOnly, 'disabled': readOnly })
        $(`.${subStage} input[type=text]:not(.disabled)`)?.datepicker(readOnly ? 'disable' : 'enable')
        $(`.${subStage} .customSlider`).slider(readOnly ? 'disable' : 'enable');
        if (readOnly) {
            $(`.${subStage}Icon`)?.addClass("sno");
        } else {
            $(`.${subStage}Icon`)?.removeClass("sno");
        }
    }
}
apz.app.Kmbase.validateQueryResponse = function () {
    const isQueryFilled = Object.values(current_response_fields).reduce(
        (isValid, responseField) => {
            if (!$(responseField).val() || !$(responseField).val().trim()) {
                showFieldError(responseField.substring(1), "Please Enter Query Response");
                return false;
            } else if ($(responseField).val().length < 2) {
                showFieldError(responseField.substring(1), "Min character length must be 2");
                return false;
            }
            return isValid;
        }, true);
    if (!isQueryFilled) {
        ApzCOB.fnDisplayMsg("Please Fill All Query Response", "E");
    }
    return isQueryFilled;
}
apz.app.Kmbase.hideNshowBtns = function () {
    $(`#${kmbaseScr}kmFooterROW`).addClass("sno");
    $(`#${kmbaseScr}viewLog_nav`).addClass("sno");
    $('#KmSourc__KMReviewConfirm__gr_row_2').addClass('sno');
    $(`#KmSourc__KMReviewConfirm__kmexistingloans`).addClass("sno");
};

apz.app.Kmbase.normalizeCAStatDetails = function (caStatDetails) {
    let normalized = [];
    (caStatDetails || []).forEach(item => {
        let caStageID = Number(item.stageID);
        let queries = item.query || [];

        const addNormalized = (kmStageID, subStageId, custType, filteredQueries) => {
            if (filteredQueries.length > 0) {
                normalized.push({
                    ...item,
                    stageID: kmStageID,
                    caStageID: caStageID,
                    subStageId: subStageId,
                    custType: custType,
                    query: filteredQueries,
                    timeStamp: ['dummy']
                });
            }
        };

        if (caStageID === 1) {
            addNormalized(1, 'LoanDetails', 'A', queries);
        } else if (caStageID === 2) {
            if (item.custType === 'A') {
                addNormalized(1, 'KYCDetails', 'A', queries);
            } else if (item.custType === 'C') {
                addNormalized(1, 'KYCDetails', 'C', queries);
            } else if (item.custType === 'R') {
                addNormalized(4, 'RelationshipProof', 'R', queries);
            }
        } else if (caStageID === 3) {
            addNormalized(1, 'ResidencePresentAddress', 'A', queries);
        } else if (caStageID === 4) {
            addNormalized(4, 'InsuranceDetails', 'A', queries);
        } else if (caStageID === 5 || caStageID === 6) {
            if (lastWorkFlw.caStatDetails) {
                let businessCount = Object.values(
                    inSessionStore?.bcmpiIncomeDetails?.bcmpiIncomeDetailsWrapper?.business ?? {}
                ).reduce((count, arr) => count + (Array.isArray(arr) ? arr.length : 0), 0);
                let bIndex = businessCount > 0 ? businessCount : 1;
                addNormalized(3, `Business_${bIndex}`, 'A', queries);
            } else {
                addNormalized(3, 'Business', 'A', queries);
            }
        } else if (caStageID === 7) {
            addNormalized(3, 'Business', 'A', queries);
        } else if (caStageID === 8) {
            let bankQueries = queries.filter(q => q === 'Q1' || q.startsWith('oth'));
            let bizQueries = queries.filter(q => ['Q2', 'Q3', 'Q4', 'Q5'].includes(q));
            addNormalized(4, 'BankDetails', 'A', bankQueries);
            addNormalized(3, 'Business', 'A', bizQueries);
        }
    });
    return normalized;
};

apz.app.Kmbase.getCAQueryValue = function (stageID, queryID, custType) {
    if (!window.CA_ALL_STAGE_FIELDS || window.CA_ALL_STAGE_FIELDS.length === 0) {
        return queryID;
    }
    const stage = window.CA_ALL_STAGE_FIELDS.find(f => Number(f.id) === Number(stageID));
    if (!stage || !stage.queries) {
        return queryID;
    }
    try {
        const parsed = JSON.parse(stage.queries);
        const sendbackReason = parsed.sendbackReason || [];
        if (Number(stageID) === 2) {
            let targetID = queryID;
            if (!queryID.includes('_')) {
                let prefix = custType === 'C' ? 'C' : custType === 'R' ? 'R' : 'A';
                targetID = `${prefix}_${queryID}`;
            }
            const match = sendbackReason.find(q => q.id === targetID);
            return match ? match.value : queryID;
        } else {
            const match = sendbackReason.find(q => q.id === queryID);
            return match ? match.value : queryID;
        }
    } catch (e) {
        ApzCOB.traceFrontEndError(e,"");
        console.error("Error parsing CA queries for stage " + stageID, e);
        return queryID;
    }
};

apz.app.Kmbase.getQueryText = function (q, queryDtls, masterQueries) {
    if (q.startsWith("oth?")) {
        return q.split("?")[1] || "";
    }
    let sentBackBy = lastWorkFlw?.stage;
    //MUI-289
    if ((window.ApplicationStatus === 'IPUSHBACK' || window.ApplicationStatus === 'CAPUSHBACK') && lastWorkFlw?.stage?.includes('Credit Assessment') &&(masterQueries?.length > 0)&& (apz.childScr!=='CBcheck' && apz.childScr!=='AadhaarDetails')){
        let stageId = lastWorkFlw?.rpcStatRemaks?.find(item => item?.stageID != null)?.stageID ?? null;
        if (stageId == '1') {
            return masterQueries?.find(item => item.id === q)?.value || q;
        }
    }
    if (window.ApplicationStatus === "CAPUSHBACK" || (sentBackBy && sentBackBy.includes('Credit Assessment'))) {
        let caStageID = queryDtls.caStageID || queryDtls.stageID;
        //MUI-289
        if(((caStageID===1)||(caStageID===4)) && window.ApplicationStatus === 'IPUSHBACK' && (window.PhotoKycQuery ==="KYCDetails" || window.PhotoKycQuery==="RelationshipProof") &&((queryDtls.stageID=="1")||(queryDtls.custType=="R"))){
            return apz.app.Kmbase.getCAQueryValue(2, q, queryDtls.custType);
        }
        return apz.app.Kmbase.getCAQueryValue(caStageID, q, queryDtls.custType);
    }
    return masterQueries?.find(item => item.id === q)?.value || q;
};
