apz.app.documentCapture.openEditModal = function() {
    window.ORIGINAL_VOTER_VALUE = $("#" + docScrId + "ocrVoterNumber").val()?.toUpperCase().trim();
    apz.app.documentCapture.copyOcrValuesToModal();
    ApzCOB.toggleModal('KmSourc__Kmbase__Edit_OCR_Modal');
    const modal = $("#KmSourc__Kmbase__Edit_OCR_Modal");
    modal.find(".error-inline").removeClass("error-inline");
    modal.find(".err").removeClass("err");
    modal.find(".err-msg").removeAttr("style").addClass("sno");
    modal.find(".cb-error-msg").removeAttr("style").addClass("sno");
    modal.find("input, textarea").off("input").on("input", function() {
        let id = $(this).attr("id");
        if (!id) return;
        $("#" + id + "_li").removeClass("error-inline");
        $(this).removeClass("err");
    });
};
apz.app.documentCapture.clearModalFields = function() {
    const p = kmbaseScr;
    const fields = ["ocrNameSection", "ocrDob", "ocrAadhaar", "ocrVoter", "ocrPan", "ocrAddressLine1", "ocrAddressLine2", "ocrAddressLine3",
        "ocrPincode"
    ];
    fields.forEach(f => {
        $("#" + p + f).val('');
    });
};
apz.app.documentCapture.ageCalculator = function(pthis) {
    var $dob = pthis ? $(pthis) : $("#" + kmbaseScr + "ocrDob");
    var dobVal = $dob.val();
    if (dobVal.includes("-")) {
        let parts = dobVal.split("-");
        dobVal = `${parts[2]}/${parts[1]}/${parts[0]}`;
    }
    var age = ApzCOB.getAge(dobVal);
    if (!age || age < 0) {
        ApzCOB.fnDisplayMsg("Please select a valid date of birth", "E");
        $dob.val('');
        return false;
    } else {
        minAge = apz.isNull(minAge) ? 22 : minAge;
        maxAge = apz.isNull(maxAge) ? 60 : maxAge;
        if (!(parseInt(age) >= minAge && parseInt(age) < maxAge)) {
            let msg = `Please select valid age(min:${minAge},max:${maxAge})`;
            hasDob = false;
            $dob.addClass("err");
            $("#" + $dob.attr('id') + "_ul").next().removeClass("sno");
            let errTxtFieldId = $("#" + $dob.attr('id') + "_ul").next()?.find('.icon-Error')?.next() ?? $('#dummyid');
            errTxtFieldId?.text(msg);
            let wrapper;
            if ($dob.closest(".etb-slct").length) {
                wrapper = $dob.closest(".etb-slct").parent().parent();
            } else if ($dob.closest(".ett-inpt").length) {
                wrapper = $dob.closest(".ett-inpt").parent().parent();
            } else if ($dob.closest("ul").length) {
                wrapper = $$dob.closest("ul").parent().parent();
    }
            wrapper?.addClass("error-inline");
            return false;
        }
    }
    return true;
};
apz.app.documentCapture.PanVerification = function() {
    let isValidPanType = ApzCOB.validateEachInputField(panNumberTag);
    let isValidPanId = ApzCOB.validateEachInputField(panNumberTag);
    let isValidNumber = apz.app.documentCapture.PannumberVerCheck();
    if (isValidPanType && isValidPanId && isValidNumber) {
        var PanObj = {};
        PanObj.kycType = 'pan';
        PanObj.kycId = $('#' + panNumberTag).val().toUpperCase().trim();
        ApzCOB.PanVerificationCheck(PanObj, apz.app.documentCapture.panVerificationCallback);
    } else {
        console.log("PAN verification blocked due to validation failure");
    }
};
apz.app.documentCapture.PannumberVerCheck = function() {
    let isNotSame = true;
    if (apz.isNull(inSessionStore.customerDetailsList)) {
        isNotSame = true;
    } else {
        let currentType = gApzCOB.currentApplicant === 1 ? "Applicant" : "Co-App";
        let otherCustomer = inSessionStore.customerDetailsList.find(c => c.customerType !== currentType);
        let enteredPan = $('#' + panNumberTag).val().toUpperCase().trim();
        let otherPan = otherCustomer?.payload?.panNumber?.toUpperCase().trim();
        if (otherPan && enteredPan === otherPan) {
            isNotSame = false;
            ApzCOB.fnDisplayMsg(ApzCOB.getDescfromLitCode("LIT_PERDTLS_PANDTLS_ERR_TXT_SAMEPAN"), "E");
        }
    }
    return isNotSame;
};
apz.app.documentCapture.panValidationCheck = function() {
    let isValid = false;
    let errmsg;
    let verifyPanVisible = $(`#${docScrId}el_hpl_3`).is(':visible');
    let inValidPanVisible = $(`#${docScrId}el_txt_142`).is(':visible');
    if (verifyPanVisible || inValidPanVisible) {
        window.applicant_pancheck = false;
    } else {
        window.applicant_pancheck = true;
    }
    if (gApzCOB.currentApplicant <= 1) {
        if (window.applicant_pancheck === false) {
            isValid = false;
            errmsg = "LIT_PERDTLS_PANDTLS_ERR_TXT_VERIFYPAN";
        } else {
            isValid = true;
        }
    } else {
        if (window.coapplicant_pancheck === false) {
            isValid = false;
            errmsg = "LIT_PERDTLS_PANDTLS_ERR_TXT_VERIFYPAN";
        } else {
            isValid = true;
        }
    }
    if (!isValid) {
        ApzCOB.fnDisplayMsg(ApzCOB.getDescfromLitCode(errmsg), "E");
    }
    return isValid;
};
apz.app.documentCapture.paintpanDetails = function(params) {
    if (!params || !params.payload) return;
    let currentPan = $('#' + panNumberTag).val().toUpperCase().trim();
    if (params.payload.panNumberStatus !== "Verified" || window.VERIFIED_PAN_VALUE !== currentPan) {
        return;
    }
    // Keep field disabled
    // ApzCOB.AddOrRemoveDisableFields([panNumberTag], true);
    // $("#" + docScrId + "el_hpl_3_ul").addClass("sno");
    // $("#" + docScrId + "el_txt_141_ul").removeClass("sno");
    // $("#" + docScrId + "el_txt_142_ul").addClass("sno");
    if (gApzCOB.currentApplicant > 1) {
        window.coapplicant_pancheck = true;
    } else {
        window.applicant_pancheck = true;
    }
};
apz.app.documentCapture.reinitiate_panstatus = function(data) {
    if ((data.payload.panNumberStatus !== "Verified") && (window.IS_REINITIATE_APPLICATION || window.IS_REJECTED_APPLICATION)) {
        window.REINITIATE_PAN_CHECKED = false;
    } else {
        window.REINITIATE_PAN_CHECKED = true;
    }
    if (window.IS_REJECTED_APPLICATION && window.REINITIATE_PAN_CHECKED) {
        window.applicant_pancheck = false;
        window.coapplicant_pancheck = false;
        if (data.payload.panNumberStatus === 'Verified') {
            $("#" + docScrId + "el_hpl_3_ul").removeClass("sno");
            $("#" + docScrId + "el_txt_141_ul").addClass("sno");
        } else {
            $("#" + docScrId + "el_hpl_3_ul").addClass("sno");
            $("#" + docScrId + "el_txt_141_ul").removeClass("sno");
        }
        $("#" + docScrId + "el_txt_142_ul").addClass("sno");
        $("#" + panNumberTag).val((data.payload.panNumber || '').toUpperCase());
        // ApzCOB.AddOrRemoveDisableFields([panNumberTag], false);
    }
};
apz.app.documentCapture.panVerificationCallback = function(params) {
    ApzCOB.hideLoader();
    try {
        if (!ApzCOB.handleServiceCallBacks(params)) return;
        let responseObj = JSON.parse(params.res.APZCBO__ValidateVoterID_Res.apiResponse.ResponseBody.responseObj);
        let $verifyBtn = $("#" + docScrId + "verifyBtn");
        let $nextBtn = $('#' + kmbaseScr + 'nxtBtn');
        if (responseObj.result_code === 101) {
            let verifiedPan = (responseObj.result?.pan || "").toUpperCase().trim();
            let verifiedName = (responseObj.result?.name || "").toUpperCase().trim();
            window.VERIFIED_PAN_VALUE = verifiedPan;
            $("#" + panNumberTag).removeClass("err");
            clearFieldError(panNumberTag);
            $("#" + panNumberTag).val(verifiedPan);
            // ApzCOB.AddOrRemoveDisableFields([panNumberTag], true);
            var screenId = 'KmSourc__CBcheck__';
            $("#" + screenId + "panNum").val(verifiedPan);
            $("#" + screenId + "panName").val(verifiedName);
            $("#KmSourc__documentCapture__ocrName").val(verifiedName);
            // $nextBtn.prop("disabled", false);
            apz.app.documentCapture.checkAndEnableNext();
            // Update Verify Button UI
            $verifyBtn.addClass("pan-verified-btn").html(`<span>Verified</span>${window.VERIFIED_TICK_SVG}`).off('click').prop("disabled", false);
            // Set flags
            if (gApzCOB.currentApplicant > 1) {
                window.coapplicant_pancheck = true;
            } else {
                window.applicant_pancheck = true;
            }
        } else {
            window.VERIFIED_PAN_VALUE = null;
            $nextBtn.prop("disabled", true);
            $verifyBtn.removeClass("pan-verified-btn").html("Verify").prop("disabled", false);
            $("#" + panNumberTag).addClass("err");
            showFieldError(panNumberTag, "PAN verification failed. Please enter a valid PAN.");
            if (gApzCOB.currentApplicant > 1) {
                window.coapplicant_pancheck = false;
            } else {
                window.applicant_pancheck = false;
            }
        }
    } catch (e) {
        ApzCOB.traceFrontEndError(e,"");
        console.log("PAN CALLBACK ERROR:", e);
    }
};
apz.app.documentCapture.mapOcrToCBFields = function() {
    var src = docScrId;
    var tgt = CBcheckScr;
    var isApplicant = gApzCOB.currentApplicant === 1;
    var custDtlId = isApplicant ? gApzCOB.userDetails.custDtlId : gApzCOB.userDetails.CoApplicantCustomerId;
    var addressDtlsId = isApplicant ? gApzCOB.userDetails.addressDtlsId : gApzCOB.userDetails.CoApplicantAddressDtlsId;
    var mapping = [{
        from: "ocrAddr1",
        to: "addressLine1",
        key: "addressLine1"
    }, {
        from: "ocrAddr2",
        to: "addressLine",
        key: "addressLine2"
    }, {
        from: "ocrAddr3",
        to: "addressLine3",
        key: "addressLine3"
    }, {
        from: "ocr-pincode",
        to: "pincode",
        key: "pinCode"
    }, {
        from: "ocrCity",
        to: "addPreCity",
        key: "city"
    }, {
        from: "ocrDistrict",
        to: "addPreDistrict",
        key: "district"
    }, {
        from: "ocrState",
        to: "addPreState",
        key: "state"
    }, {
        from: "ocrCountry",
        to: "addPreCountry",
        key: "country"
    }, {
        from: "ocrArea",
        to: "addPreArea",
        key: "area"
    }, {
        from: "ocrLandmark",
        to: "addPreLandmark",
        key: "landMark"
    }];
    var ocrName = ($("#" + src + "ocrName").val() || "").trim();
    var ocrVoterNumber = ($("#" + src + "ocrVoterNumber").val() || "").toUpperCase().trim();
    var customerType = gApzCOB.currentApplicant == 1 ? 'Applicant' : 'Co-App';
    var customerVoter = inSessionStore?.customerDetailsList?.find(cust => cust.customerType === customerType)?.payload?.primaryKycId;
    var leadPrimaryKycId = (customerVoter || gApzCOB?.selLeadDtls?.primaryKyc || "").toUpperCase().trim();
    var isMatchingPrimary = (ocrVoterNumber === leadPrimaryKycId);
    if (gApzCOB.currentApplicant > 1 && 
        (ApplicationType !== 'RENEWAL' || ApzCOB.getPayloadDatafromWrapper("isNewCustomer", "Co-App", "customerDetailsList") === "Create a new Co-Applicant") ) {
        isMatchingPrimary = true;
    }
    var primaryKyc = {
        addressType: "Voter"
    };
    mapping.forEach(function(pair) {
        primaryKyc[pair.key] = ($("#" + src + pair.from).val() || "").trim();
    });
    if (!inSessionStore.addressDetailsWrapperList) {
        inSessionStore.addressDetailsWrapperList = [{
            addressDetailsList: []
        }];
    }
    if (!inSessionStore.addressDetailsWrapperList[0].addressDetailsList) {
        inSessionStore.addressDetailsWrapperList[0].addressDetailsList = [];
    }
    var addrDetailsList = inSessionStore.addressDetailsWrapperList[0].addressDetailsList;
    var personalWrapper = addrDetailsList.find(function(w) {
        return w.addressType === "Personal" && String(w.custDtlId) === String(custDtlId);
    });
    if (!personalWrapper) {
        personalWrapper = {
            addressDtlsId: addressDtlsId || "",
            custDtlId: parseInt(custDtlId),
            addressType: "Personal",
            payload: {
                addressList: []
            }
        };
        addrDetailsList.push(personalWrapper);
    }
    var addrList = personalWrapper.payload.addressList;
    // Upsert Voter address
    var voterIndex = addrList.findIndex(function(a) {
        return a.addressType === "Voter";
    });
    if (voterIndex >= 0) {
        addrList[voterIndex] = primaryKyc;
    } else {
        addrList.push(primaryKyc);
    }
    // Also mirror as Present address for applicant
    if (isApplicant) {
        var presentAddress = Object.assign({}, primaryKyc, {
            addressType: "Present"
        });
        var presentIndex = addrList.findIndex(function(a) {
            return a.addressType === "Present";
        });
        if (presentIndex >= 0) {
            addrList[presentIndex] = presentAddress;
        } else {
            addrList.push(presentAddress);
        }
    }
    if (!inSessionStore.customerDetailsList) inSessionStore.customerDetailsList = [];
    var custList = inSessionStore.customerDetailsList;
    var custIdx = custList.findIndex(function(c) {
        return String(c.custDtlId) === String(custDtlId);
    });
    var existingPayload = custIdx >= 0 ? (custList[custIdx].payload || {}) : {};
    var updatedPayload;
    if (isMatchingPrimary) {
        /* ── CASE 1: Matches lead primary → save as primaryKycId ─────── */
        updatedPayload = Object.assign({}, existingPayload, {
            namePerKyc: ocrName,
            primaryKycId: ocrVoterNumber,
            kycStatus: "Verified",
            primaryKycIdValStatus: "Verified",
        });
        // Set primary verification flag
        if (isApplicant) {
            window.PRIMARY_KYC_VERIFICATION = true;
            window.ALTERNATE_KYC_VERIFICATION = false;
        } else {
            window.CO_APPLICANT_PRIMARY_KYC_VERIFICATION = true;
            window.CO_APPLICANT_ALTERNATE_KYC_VERIFICATION = false;
        }
        console.log("Voter matched lead primary — saved as primaryKycId");
    } else {
        /* ── CASE 2: Does NOT match → save as alternateVoterId ───────── */
        updatedPayload = Object.assign({}, existingPayload, {
            namePerKyc: ocrName,
            alternateVoterId: ocrVoterNumber,
            alternateVoterIdValStatus: "Verified",
            kycStatus: "Pending",
        });
        // Set ALTERNATE verification flag
        if (isApplicant) {
            window.ALTERNATE_KYC_VERIFICATION = true;
            window.PRIMARY_KYC_VERIFICATION = false;
        } else {
            window.CO_APPLICANT_ALTERNATE_KYC_VERIFICATION = true;
            window.CO_APPLICANT_PRIMARY_KYC_VERIFICATION = false;
        }
        console.log("Voter did NOT match lead primary — saved as alternateVoterId");
    }
    /* ─── UPSERT customerDetailsList ─────────────────────────────────── */
    if (custIdx >= 0) {
        custList[custIdx].payload = updatedPayload;
        custList[custIdx].customerName = custList[custIdx].customerName;
        custList[custIdx].mobileNumber = custList[custIdx].mobileNumber;
        if (!isApplicant) {
            custList[custIdx].customerName = ocrName;
        }
    } else {
        if (isApplicant) {
        custList.push({
            custDtlId: custDtlId,
            customerType: isApplicant ? "Applicant" : "Co-App",
            payload: updatedPayload
        });
        } else {
            custList.push({
                custDtlId: custDtlId,
                customerType: isApplicant ? "Applicant" : "Co-App",
                customerName: ocrName,
                payload: updatedPayload
            });
        }
    }
    /* ─── DOM — paint CB screen fields (only for active tab) ─────────── */
    // var activeTabMatchesCaptured = (isApplicant && gApzCOB.currentApplicant === 1) || (!isApplicant && gApzCOB.currentApplicant === 2);
    // if (activeTabMatchesCaptured) {
    //     mapping.forEach(function(pair) {
    //         var $field = $("#" + tgt + pair.to);
    //         if ($field.length) {
    //             $field.val(secondaryKyc[pair.key]).trigger("change");
    //         }
    //     });
    // }
};
apz.app.documentCapture.mapPanToSession = function() {
    var src = docScrId;
    var isApplicant = gApzCOB.currentApplicant === 1;
    var custDtlId = isApplicant ? gApzCOB.userDetails.custDtlId : gApzCOB.userDetails.CoApplicantCustomerId;
    var panNumber = ($("#" + src + "ocrPanNumber").val() || "").toUpperCase().trim();
    var panName = ($("#" + src + "ocrName").val() || "").trim();
    var panStatus = (window.VERIFIED_PAN_VALUE && window.VERIFIED_PAN_VALUE === panNumber) ? "Verified" : "Pending";
    if (!inSessionStore.customerDetailsList) inSessionStore.customerDetailsList = [];
    var custList = inSessionStore.customerDetailsList;
    var custIndex = custList.findIndex(function(c) {
        return String(c.custDtlId) === String(custDtlId);
    });
    var existingPayload = custIndex >= 0 ? (custList[custIndex].payload || {}) : {};
    var updatedPayload = Object.assign({}, existingPayload, {
        panNumber: panNumber,
        namePerPan: panName,
        panNumberStatus: panStatus
    });
    if (custIndex >= 0) {
        custList[custIndex].payload = updatedPayload;
    } else {
        custList.push({
            custDtlId: custDtlId,
            customerType: isApplicant ? "Applicant" : "Co-App",
            payload: updatedPayload
        });
    }
};
apz.app.documentCapture.checkAndShowOcrSection = function() {
    let custDtlId = (window.CAPTURE_FROM_APPLICANT != null) ? (window.CAPTURE_FROM_APPLICANT === 1 ? gApzCOB.userDetails.custDtlId : gApzCOB
        .userDetails.CoApplicantCustomerId) : (gApzCOB.currentApplicant === 1 ? gApzCOB.userDetails.custDtlId : gApzCOB.userDetails
        .CoApplicantCustomerId);
    let allDocs = (inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList || []).filter(d => d.payload.documentType ===
        'SECONDARY_KYC' && parseInt(d.custDtlId) === parseInt(custDtlId));
    let hasFront = allDocs.some(d => d.payload.docLevel == "1");
    let hasBack = allDocs.some(d => d.payload.docLevel == "2");
    window.isAadhaarRedactEnabled = allDocs.every(d => d.payload.manualUpload === false);
    if(!window.isAadhaarRedactEnabled){
        $('.ocr-section').removeClass('sno');
        apz.app.documentCapture.manualEntry();
    } else if ((hasFront && hasBack)) {
        $('.ocr-section').removeClass('sno');
    } else {
        $('.ocr-section').addClass('sno');
        $(`#${kmbaseScr}nxtBtn`).prop('disabled', true);
    }
    apz.app.documentCapture.checkAndEnableNext();
};
apz.app.documentCapture.checkAndEnableNext = function() {
    function check(id, errMsg) {
        let result = !!($("#" + id).val() || "").trim()
        if (!result){
            showFieldError(id, errMsg);
            return false;
        } else {
            clearFieldError(id);
            return true;
        }
    }
    let custDtlId = gApzCOB.currentApplicant === 1 ? gApzCOB.userDetails.custDtlId : gApzCOB.userDetails.CoApplicantCustomerId;
    let isMinMaxVal = true;
    if (apz.app.docType === 'Aadhaar') {
        let allDocs = (inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList || []).filter(d => d.payload
            .documentType === 'SECONDARY_KYC' && parseInt(d.custDtlId) === parseInt(custDtlId));
        let hasFront = allDocs.some(d => d.payload.docLevel == "1");
        let hasBack = allDocs.some(d => d.payload.docLevel == "2");
        if (!hasFront || !hasBack) {
            $(`#${kmbaseScr}nxtBtn`).prop('disabled', true);
            // Wipe stale OCR session data so user must re-confirm after re-capture
            let custList = inSessionStore?.customerDetailsList || [];
            let custEntry = custList.find(c => String(c.custDtlId) === String(custDtlId));
            if (custEntry?.payload) {
                custEntry.payload.secondaryKycName = '';
                custEntry.payload.secondaryKycId = '';
            }
            let addrDetailsList = inSessionStore?.addressDetailsWrapperList?.[0]?.addressDetailsList || [];
            let personalWrapper = addrDetailsList.find(w => w.addressType === 'Personal' && String(w.custDtlId) === String(custDtlId));
            let addrList = personalWrapper?.payload?.addressList || [];
            let secKycIdx = addrList.findIndex(a => a.addressType === 'SecondaryKyc');
            if (secKycIdx >= 0) addrList[secKycIdx].addressLine1 = '';
            return;
        }
        let hasName = check(docScrId + "ocrName", "Please enter Name");
        let hasAadNum = check(docScrId + "ocrAadhaarNumber", "Please enter Aadhaar number");
        let hasAddr = check(docScrId + "ocrAddr1", "Please enter Address line 1");
        let hasPincode = check(docScrId + "ocr-pincode","Please enter Pincode");
        let hasDob = check(docScrId + "ocr-dob","Please select DOB");
        Object.entries(window.ValfieldMap).forEach(([fieldId]) => {
            isMinMaxVal = window.documentCapture_Validate.fnCheckMaxMinLengthOnBlur(
                        document.getElementById(docScrId + fieldId)) && isMinMaxVal;
        });
        $(`#${kmbaseScr}nxtBtn`).prop('disabled', !(isMinMaxVal && hasName && hasAadNum && hasAddr && hasPincode && hasDob));
        return;
    }
    if (apz.app.docType === 'PAN card') {
        let allDocs = (inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList || []).filter(d => d.payload
            .documentType === 'PAN_NUMBER_PHOTO' && parseInt(d.custDtlId) === parseInt(custDtlId));
        let hasFront = allDocs.some(d => d.payload.docLevel == "1");
        let hasBack = allDocs.some(d => d.payload.docLevel == "2");
        if (!hasFront || !hasBack) {
            $(`#${kmbaseScr}nxtBtn`).prop('disabled', true);
            return;
        }
        let hasName = !!($("#" +docScrId + "ocrName").val() || "").trim()
        let hasPanNum = check(docScrId + "ocrPanNumber", "Please enter PAN number");
        let currentPan = ($("#" + docScrId + "ocrPanNumber").val() || "").toUpperCase().trim();
        let isVerified = !!(window.VERIFIED_PAN_VALUE && window.VERIFIED_PAN_VALUE === currentPan);
        if(hasPanNum && !isVerified){
            showFieldError(docScrId + "ocrPanNumber", "Please verify the Pan Number")
        } else if (hasPanNum) {
            clearFieldError(docScrId + "ocrPanNumber")
        }
        Object.entries(window.ValfieldMap).forEach(([fieldId]) => {
            isMinMaxVal = window.documentCapture_Validate.fnCheckMaxMinLengthOnBlur(
                        document.getElementById(docScrId + fieldId)) && isMinMaxVal;
        });
        $(`#${kmbaseScr}nxtBtn`).prop('disabled', !(isMinMaxVal &&hasName && hasPanNum && isVerified));
        return;
    }
    if (apz.app.docType === 'Voter ID') {
        let allDocs = (inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList || []).filter(d => d.payload
            .documentType === 'PRIMARY_KYC' && parseInt(d.custDtlId) === parseInt(custDtlId));
        let hasFront = allDocs.some(d => d.payload.docLevel == "1");
        let hasBack = allDocs.some(d => d.payload.docLevel == "2");
        if (!hasFront || !hasBack) {
            $(`#${kmbaseScr}nxtBtn`).prop('disabled', true);
            return;
        }
        let hasName = !!($("#" +docScrId + "ocrName").val() || "").trim()
        let hasVoterId = check(docScrId + "ocrVoterNumber", "Please enter Voter ID Number");
        let hasAddr = check(docScrId + "ocrAddr1", "Please enter Address Line 1");
        let hasPincode = check(docScrId + "ocr-pincode", "Please enter Pincode");;
        let currentVoter = ($("#" + docScrId + "ocrVoterNumber").val() || "").toUpperCase().trim();
        let isVerified = !!(window.VERIFIED_VOTER_VALUE && window.VERIFIED_VOTER_VALUE === currentVoter);
        let isVerifybtnvisible = $("#KmSourc__documentCapture__verifyBtn").text().trim() == 'Verify';
        if(hasVoterId && !isVerified){
            showFieldError(docScrId + "ocrVoterNumber", "Please Verify the Voter ID")
        } else if (hasVoterId) {
            clearFieldError(docScrId + "ocrVoterNumber")
        }
        Object.entries(window.ValfieldMap).forEach(([fieldId]) => {
            isMinMaxVal = window.documentCapture_Validate.fnCheckMaxMinLengthOnBlur(
                        document.getElementById(docScrId + fieldId)) && isMinMaxVal;
        });
        $(`#${kmbaseScr}nxtBtn`).prop('disabled', !(isMinMaxVal && hasName && hasVoterId && hasAddr && hasPincode && isVerified));
        if(isVerified && isVerifybtnvisible){
             $(`#${kmbaseScr}nxtBtn`).prop('disabled',true)
        }
        return;
    }
};
