apz.app.documentCapture.primaryKycVerification = function() {
    IS_CO_APPLICANT_PRIMARY_DEDUPE = false;
    IS_CO_APPLICANT_SECONDARY_DEDUPE = false;
    IS_CO_APPLICANT_ALTERNATE_DEDUPE = false;
    IS_APPLICANT_PRIMARY_DEDUPE = false;
    IS_ALTERNATE_DEDUPE = false;
    window.IS_APP_PRIMARY_CHECK_FAILED = false;
    window.IS_COAPP_PRIMARY_CHECK_FAILED = false;
    primaryKycScrId  = kmbaseScr
    ApzCOB.checkVoterExist($(`#${docScrId}ocrVoterNumber`), "primary")
    let isValid = ApzCOB.validateEachInputField(docScrId + 'ocrVoterNumber');
    if (isValid) {
        window.kycVerificationType = "primary";
        var kycObj = {};
        kycObj.kycType = "voter";
        kycObj.kycId = $('#' + docScrId + 'ocrVoterNumber').val().trim().toLocaleUpperCase();
        if (gApzCOB.currentApplicant > 1) {
            IS_CO_APPLICANT_PRIMARY_DEDUPE = true;
        } else {
            IS_APPLICANT_PRIMARY_DEDUPE = true;
        }
        ApzCOB.KycDedupeCheck(kycObj.kycId, apz.app.documentCapture.KycDedupeCheckCB);
    }
};
apz.app.documentCapture.KycDedupeCheckCB = function(params) {
    let voterTag = docScrId + "ocrVoterNumber";
    let responseObj = {};
    if (!apz.isNull(params.res.APZCBO__DedupeVoterID_Res.apiResponse)) {
        responseObj = params.res.APZCBO__DedupeVoterID_Res.apiResponse.ResponseHeader;
    }
    try {
        ApzCOB.hideLoader();
        if (ApzCOB.handleServiceCallBacks(params)) {
            // Dedupe passed
            if (gApzCOB.currentApplicant <= 1) {
                if (IS_ALTERNATE_DEDUPE) {
                    ALTERNATE_DEDUPE_STATUS = true;
                } else {
                    PRIMARY_DEDUPE_STATUS = true;
                }
            } else {
                if (IS_CO_APPLICANT_ALTERNATE_DEDUPE) {
                    CO_APPLICANT_ALTERNATE_DEDUPE_STATUS = true;
                } else {
                    CO_APPLICANT_PRIMARY_DEDUPE_STATUS = true;
                }
            }
        } else {
            // Dedupe failed
            if (gApzCOB.currentApplicant <= 1) {
                if (IS_ALTERNATE_DEDUPE) {
                    ALTERNATE_DEDUPE_STATUS = false;
                } else {
                    PRIMARY_DEDUPE_STATUS = false;
                }
            } else {
                if (IS_CO_APPLICANT_ALTERNATE_DEDUPE) {
                    CO_APPLICANT_ALTERNATE_DEDUPE_STATUS = false;
                } else {
                    CO_APPLICANT_PRIMARY_DEDUPE_STATUS = false;
                }
            }
        }
    } catch (e) {
        ApzCOB.traceFrontEndError(e,"");
        ApzCOB.hideLoader();
        // ← same as original — show error message on catch
        ApzCOB.fnDisplayMsg(responseObj.ResponseMessage, "E");
        return;
    }
    if (gApzCOB.currentApplicant <= 1) {
        // ── EXACT same rejectMsg pattern as original ─────────────────────
        let rejectMsg = ". " + ApzCOB.getDescfromLitCode("LIT_COMM_APPLICANT_CONF_TXT_DEDUPE_FAILED_DO_WANT_TO_CONTINUE");
        if (!IS_ALTERNATE_DEDUPE) {
            if (!PRIMARY_DEDUPE_STATUS) {
                // ← "C" type = confirm modal, same as original
                ApzCOB.fnDisplayMsg(responseObj.ResponseMessage + rejectMsg, "C", apz.app.documentCapture.dedupeServiceConfirmApplicantCB);
                return; // ← return after confirm, same as original
            }
        } else {
            if (!ALTERNATE_DEDUPE_STATUS) {
                // ← "C" type = confirm modal, no return — fall through
                ApzCOB.fnDisplayMsg(responseObj.ResponseMessage + rejectMsg, "C", apz.app.documentCapture.dedupeServiceConfirmApplicantCB);
            }
        }
        // Proceed to KYC validation after dedupe pass
        if (IS_ALTERNATE_DEDUPE && ALTERNATE_DEDUPE_STATUS) {
            let kycObj = {};
            kycObj.kycType = "voter";
            kycObj.kycId = $("#" + docScrId + "ocrVoterNumber").val().trim();
            ApzCOB.kycVerificationCheck(kycObj, apz.app.documentCapture.kycVerificationCheckCB);
        } else if (IS_APPLICANT_PRIMARY_DEDUPE && PRIMARY_DEDUPE_STATUS) {
            let kycObj = {};
            kycObj.kycType = "voter";
            kycObj.kycId = $("#" + docScrId + "ocrVoterNumber").val().trim();
            ApzCOB.kycVerificationCheck(kycObj, apz.app.documentCapture.kycVerificationCheckCB);
        }
    } else {
        // ── Co-applicant dedupe logic — same as original ─────────────────
        let coAppDedupeStatus = true;
        if (!IS_CO_APPLICANT_ALTERNATE_DEDUPE) {
            if (!CO_APPLICANT_PRIMARY_DEDUPE_STATUS) {
                coAppDedupeStatus = false;
            }
        } else {
            if (!CO_APPLICANT_ALTERNATE_DEDUPE_STATUS) {
                coAppDedupeStatus = false;
            }
        }
        if (!coAppDedupeStatus) {            
            let rejectMsg = ". " + ApzCOB.getDescfromLitCode("LIT_COMM_APPLICANT_CONF_TXT_DEDUPE_FAILED_DO_WANT_TO_CONTINUE");
            ApzCOB.fnDisplayMsg(responseObj.ResponseMessage + rejectMsg, "C", apz.app.documentCapture.dedupeServiceConfirmApplicantCB);
            return;
        }
        if (IS_CO_APPLICANT_ALTERNATE_DEDUPE && CO_APPLICANT_ALTERNATE_DEDUPE_STATUS) {
            let kycObj = {};
            kycObj.kycType = "voter";
            kycObj.kycId = $("#" + docScrId + "ocrVoterNumber").val().trim();
            ApzCOB.kycVerificationCheck(kycObj, apz.app.documentCapture.kycVerificationCheckCB);
        } else if (IS_CO_APPLICANT_PRIMARY_DEDUPE && CO_APPLICANT_PRIMARY_DEDUPE_STATUS) {
            let kycObj = {};
            kycObj.kycType = "voter";
            kycObj.kycId = $("#" + docScrId + "ocrVoterNumber").val().trim();
            ApzCOB.kycVerificationCheck(kycObj, apz.app.documentCapture.kycVerificationCheckCB);
        }
    }
};

apz.app.documentCapture.aadhaarDedupe = function() {
    let aadhaarObj = {
        applicationId: inSessionStore.applicationId,
        customerId: gApzCOB.currentApplicant > 1 ? (gApzCOB.userDetails.CoApplicantCustomerId || "") : gApzCOB.userDetails.custDtlId,
        kycType: 'aadhaar',
        kycId: $(`#${kmbaseScr}ocrAadhaar`).val(),
        customerName: $(`#${kmbaseScr}ocrNameSection`).val(),
        dob:  $(`#${kmbaseScr}ocrDob`).val(),
        productType: ApplicationType
    }
    ApzCOB.aadhaarDedupe(aadhaarObj);
};

apz.app.documentCapture.AadhaarDedupeCB = function(params) {
    if(ApzCOB.handleServiceCallBacks(params)){
        apz.app.documentCapture.copyOcrValuesFromModal();
        apz.app.documentCapture.clearModalFields();
        ApzCOB.toggleModal('KmSourc__Kmbase__Edit_OCR_Modal');
        apz.app.documentCapture.checkAndEnableNext();
    } else {
         let errormsg = params.res?.APZCBO__DedupeVoterID_Res.apiResponse?.ResponseHeader?.ResponseMessage
            ApzCOB.fnDisplayMsg(errormsg);
    }
    ApzCOB.hideLoader();
}
apz.app.documentCapture.dedupeServiceConfirmApplicantCB = function(params) {
    if (params.choice === true) {
        // User clicked OK — reject the application
        window.RejectReason = "Applicant Dedupe Check Failed.";
        ApzCOB.applicantKycFailedRejectService();
    } else {
        // User clicked No — clear the voter field so they enter a different one
        $("#" + docScrId + "ocrVoterNumber").val('');
        $("#" + docScrId + "ocrName").val('');
        clearFieldError(docScrId + "ocrVoterNumber");
        let $verifyBtn = $("#" + docScrId + "verifyBtn");
        $verifyBtn.removeClass("pan-verified-btn").html("Verify").prop("disabled", false).off('click').on('click', function() {
            apz.app.documentCapture.primaryKycVerification();
        });
        $("#" + kmbaseScr + "nxtBtn").prop("disabled", true);
    }
};
apz.app.documentCapture.kycVerificationCheckCB = function(params) {
    ApzCOB.hideLoader();
    let voterTag = docScrId + "ocrVoterNumber";
    let $verifyBtn = $("#" + docScrId + "verifyBtn");
    let $nextBtn = $('#' + kmbaseScr + 'nxtBtn');
    clearFieldError(docScrId + "ocrName");
    let errMsg = "";
    if (!apz.isNull(params.resFull.appzillonBody.APZCBO__ValidateVoterID_Res)) {
        if (!apz.isNull(params.resFull.appzillonBody.APZCBO__ValidateVoterID_Res.apiResponse.ResponseHeader.ResponseMessage)) {
            errMsg = ApzCOB.getDescfromLitCode("LIT_KYC_VERIFICATION_SERVICE_FAILED") + "<br/>" + params.resFull.appzillonBody
                .APZCBO__ValidateVoterID_Res.apiResponse.ResponseHeader.ResponseMessage;
        }
    } else {
        errMsg = ApzCOB.getDescfromLitCode("LIT_KYC_VERIFICATION_SERVICE_FAILED");
    }
    try {
        if (ApzCOB.handleServiceCallBacks(params)) {
            let responseObj = JSON.parse(params.res.APZCBO__ValidateVoterID_Res.apiResponse.ResponseBody.responseObj);
            if (responseObj.hasOwnProperty("result_code") && responseObj.result_code === 101) {
                // ── NAME UPDATE — direct assignment, no getSubstrValue ───
                let verifiedName = responseObj.result?.name ?? "";
                window.VERIFIED_VOTER_NAME = verifiedName;
                // Paint name into both fields
                $("#" + docScrId + "ocrName").val(verifiedName);
                $("#" + kmbaseScr + "ocrNameSection").val(verifiedName);
                $("#" + docScrId + "ocrName").removeClass("err");
                clearFieldError(docScrId + "ocrName");
                // ── VOTER ID FIELD ───────────────────────────────────────
                let verifiedVoterId = ($("#" + voterTag).val() || "").toUpperCase().trim();
                window.VERIFIED_VOTER_VALUE = verifiedVoterId;
                $("#" + voterTag).removeClass("err");
                clearFieldError(voterTag);
                // ── VERIFY BUTTON → Verified state ───────────────────────
                $verifyBtn.addClass("pan-verified-btn").html(`<span>Verified</span>${window.VERIFIED_TICK_SVG}`).off('click').prop("disabled",
                    false);
                // ── COMPARE WITH LEAD primaryKycId ───────────────────────
                var customerType = gApzCOB.currentApplicant <= 1 ? 'Applicant' : 'Co-App';
                var customerVoter = inSessionStore?.customerDetailsList?.find(cust => cust.customerType === customerType)?.payload?.primaryKycId;
                var leadPrimaryKycId = (customerVoter || gApzCOB?.selLeadDtls?.primaryKyc || "").toUpperCase().trim();
                var isMatchingPrimary = (verifiedVoterId === leadPrimaryKycId);
                if (window.kycVerificationType === "primary") {
                    if (isMatchingPrimary) {
                        if (gApzCOB.currentApplicant <= 1) {
                            window.PRIMARY_KYC_VERIFICATION = true;
                            window.ALTERNATE_KYC_VERIFICATION = false;
                        } else {
                            window.CO_APPLICANT_PRIMARY_KYC_VERIFICATION = true;
                            window.CO_APPLICANT_ALTERNATE_KYC_VERIFICATION = false;
                        }
                    } else {
                        if (gApzCOB.currentApplicant <= 1) {
                            window.ALTERNATE_KYC_VERIFICATION = true;
                            window.PRIMARY_KYC_VERIFICATION = false;
                        } else {
                            window.CO_APPLICANT_ALTERNATE_KYC_VERIFICATION = true;
                            window.CO_APPLICANT_PRIMARY_KYC_VERIFICATION = false;
                        }
                    }
                }
                // ── ENABLE NEXT ──────────────────────────────────────────
                // $nextBtn.prop("disabled", false);
                apz.app.documentCapture.checkAndEnableNext();
                /// Check and update
                // apz.app.documentCapture.mapOcrToCBFields();
            } else {
                // ── KYC VALIDATION FAILED ────────────────────────────────
                let invalidKyc = false;
                if (responseObj.hasOwnProperty("error")) {
                    if (responseObj.error.message === ApzCOB.getDescfromLitCode("LIT_EPICNUMBER")) {
                        invalidKyc = true;
                    } else {
                        invalidKyc = false;
                    }
                } else {
                    invalidKyc = true;
                }
                if (invalidKyc) {
                    // Clear name field on failure
                    $("#" + docScrId + "ocrName").val("");
                    $("#" + kmbaseScr + "ocrNameSection").val("");
                    $("#" + voterTag).addClass("err");
                    showFieldError(voterTag, ApzCOB.getDescfromLitCode("LIT_INVALID_KYC_ID") || "Invalid Voter ID.");
                    $verifyBtn.removeClass("pan-verified-btn").html("Verify").prop("disabled", false).off('click').on('click', function() {
                        apz.app.documentCapture.primaryKycVerification();
                    });
                    $nextBtn.prop("disabled", true);
                    if (gApzCOB.currentApplicant <= 1) {
                        window.PRIMARY_KYC_VERIFICATION = false;
                        window.IS_APP_PRIMARY_CHECK_FAILED = true;
                        if (window.IS_APP_PRIMARY_CHECK_FAILED && window.IS_APP_ALTERNATE_CHECK_FAILED) {
                            window.RejectReason = "Applicant KYC Verification Failed.";
                            if (apz.isNull(gApzCOB.requestNodes.applicationId)) {
                                ApzCOB.fnDisplayMsg(ApzCOB.getDescfromLitCode("LIT_COMM_CONF_TXT_APP_KYC_VERIFICATION_FAILED_REJ_CONFRM"), "E",
                                    ApzCOB.applicantKycFailedRejectService);
                            } else {
                                // ApzCOB.toggleModal(PerDetScrId + "rejectmodel");
                                $("#" + kmbaseScr + "rejectLabel").text(ApzCOB.getDescfromLitCode(
                                    "LIT_COMM_CONF_TXT_APP_KYC_VERIFICATION_FAILED_REJ_CONFRM"));
                                ApzCOB.toggleModal(kmbaseScr + "rejectmodel");
                            }
                        } else {
                            ApzCOB.fnDisplayMsg(ApzCOB.getDescfromLitCode("LIT_INVALID_KYC_ID"), "E");
                        }
                    } else {
                        window.CO_APPLICANT_PRIMARY_KYC_VERIFICATION = false;
                        window.IS_COAPP_PRIMARY_CHECK_FAILED = true;
                        if (window.IS_COAPP_PRIMARY_CHECK_FAILED && window.IS_COAPP_ALTERNATE_CHECK_FAILED) {
                            window.RejectReason = `Co-Applicant(C0${CO_APP_ADDED_COUNT}) KYC Verification Failed.`;
                            if (CO_APP_ADDED_COUNT >= gApzCOB.noOfApplicants) {
                                // ApzCOB.toggleModal(PerDetScrId + "rejectmodel");
                                $("#" + kmbaseScr + "rejectLabel").text(ApzCOB.getDescfromLitCode(
                                    "LIT_COMM_CONF_TXT_CO_APP_KYC_VERIFICATION_FAILED_REJ_CONFRM"));
                                ApzCOB.toggleModal(kmbaseScr + "rejectmodel");
                            } else {
                                // ApzCOB.toggleModal(PerDetScrId + "dedupeRejectOrAddmodel");
                                $("#" + kmbaseScr + "dedupeRejectLabel").text(ApzCOB.getDescfromLitCode(
                                    "LIT_COMM_CONF_TXT_PRIMARY_ALTERNATE_VERIFICATION_FAILED"));
                                ApzCOB.toggleModal(kmbaseScr + "dedupeRejectOrAddmodel");
                            }
                        } else {
                            ApzCOB.fnDisplayMsg(ApzCOB.getDescfromLitCode("LIT_INVALID_KYC_ID"), "E");
                        }
                    }
                } else {
                    // Service error with description
                    if (responseObj.hasOwnProperty("errorDescription")) {
                        errMsg = errMsg + "<br>" + responseObj.errorDescription;
                    } else if (responseObj.error?.hasOwnProperty("message")) {
                        errMsg = errMsg + "<br>" + responseObj.error.message;
                    }
                    ApzCOB.fnDisplayMsg(errMsg, "E");
                }
            }
        } else {
            ApzCOB.hideLoader();
            ApzCOB.fnDisplayMsg(errMsg, "E");
        }
    } catch (e) {
        ApzCOB.traceFrontEndError(e,"");
        ApzCOB.hideLoader();
        ApzCOB.fnDisplayMsg(errMsg, "E");
    }
};
apz.app.documentCapture.initiateOCR = function() {
    let docType = (apz.app.docType || "").toLowerCase().trim();
    $("#KmSourc__documentCapture__sc_row_134").addClass("sno");
    if (docType !== 'voter id') {
        $("#KmSourc__documentCapture__el_icn_2").addClass("sno");
        $("#KmSourc__documentCapture__el_icn_4").addClass("sno");
    }
    window.backMisMatch = false;
    window.frontMisMatch = false;
    window.invalidVoter = false;
    window.invalidPan = false;
    if (docType === 'aadhaar') {
        let frontDocs = window.custimg.find(d => d.payload?.docLevel == "1");
        let backDocs = window.custimg.find(d => d.payload?.docLevel == "2");
        if (!OcrImageBaseValue['Aadhaar Front'] && frontDocs) {
            window.currentOCRSide = "AadhaarFront";
            // window.paintFileName = frontDocs?.payload?.documentFormat || (frontDocs?.payload?.documentFileName + ".jpg");
            window.paintFileName = frontDocs?.payload?.documentFileName;
            ApzCOB.downloadFileFromServer(paintFileName, apz.app.documentCapture.ocrDownloadCB);
            return;
        }
        if (!OcrImageBaseValue['Aadhaar Back'] && backDocs) {
            window.currentOCRSide = "AadhaarBack";
            // window.paintFileName = backDocs?.payload?.documentFormat || (backDocs?.payload?.documentFileName + ".jpg");
            window.paintFileName = backDocs?.payload?.documentFileName;
            ApzCOB.downloadFileFromServer(paintFileName, apz.app.documentCapture.ocrDownloadCB);
            return;
        }
        apz.app.documentCapture.initiateAadhaarOCR();
        // $("#KmSourc__documentCapture__ocr_heading").removeClass("sno");
        // $("#KmSourc__documentCapture__ocr_details").removeClass("sno");
        // $("#KmSourc__documentCapture__ocrNote").removeClass("sno");
        // $("#KmSourc__documentCapture__ocrEdit").removeClass("sno");
        return;
    }
    let frontDocs = window.custimg.find(d => d.payload?.docLevel == "1");
    if (docType === 'pan card') {
        if (!OcrImageBaseValue['PAN Front'] && frontDocs) {
            window.currentOCRSide = "PAN";
            // window.paintFileName = frontDocs?.payload?.documentFormat || (frontDocs?.payload?.documentFileName + ".jpg");
            window.paintFileName = frontDocs?.payload?.documentFileName;
            ApzCOB.downloadFileFromServer(paintFileName, apz.app.documentCapture.ocrDownloadCB);
            return;
        }
        apz.app.documentCapture.initiatePanOCR();
        return;
    }
    let backDocs = window.custimg.find(d => d.payload?.docLevel == "2");
    if (!OcrImageBaseValue['Voter Front'] && frontDocs) {
        window.currentOCRSide = "Front";
        // window.paintFileName = frontDocs?.payload?.documentFormat || (frontDocs?.payload?.documentFileName + ".jpg");
        window.paintFileName = frontDocs?.payload?.documentFileName;
        ApzCOB.downloadFileFromServer(paintFileName, apz.app.documentCapture.ocrDownloadCB);
        return;
    }
    if (!OcrImageBaseValue['Voter Back'] && backDocs) {
        window.currentOCRSide = "Back";
        // window.paintFileName = backDocs?.payload?.documentFormat || (backDocs?.payload?.documentFileName + ".jpg");
        window.paintFileName = backDocs?.payload?.documentFileName;
        ApzCOB.downloadFileFromServer(paintFileName, apz.app.documentCapture.ocrDownloadCB);
        return;
    }
    if (docType === 'voter id') {
        apz.app.documentCapture.initiateVoterOCR();
    }
};
apz.app.documentCapture.ocrDownloadCB = function(params) {
    apz.stopLoader();
    if (!apz.isNull(params.base64)) {
        OcrImageBaseValue = OcrImageBaseValue || {};
        if (window.currentOCRSide === "Front") {
            OcrImageBaseValue["Voter Front"] = params.base64;
        }
        if (window.currentOCRSide === "Back") {
            OcrImageBaseValue["Voter Back"] = params.base64;
        }
        if (window.currentOCRSide === "PAN") {
            OcrImageBaseValue["PAN Front"] = params.base64;
        }
        if (window.currentOCRSide === "AadhaarFront") OcrImageBaseValue["Aadhaar Front"] = params.base64;
        if (window.currentOCRSide === "AadhaarBack") OcrImageBaseValue["Aadhaar Back"] = params.base64;
        apz.app.documentCapture.initiateOCR();
    }
};
apz.app.documentCapture.initiateVoterOCR = function() {
    window.ocrFailed = false;
    window.ocrResponseCount = 0;
    let frontDocs = window.custimg.find(d => d.payload?.docLevel == "1");
    let backDocs = window.custimg.find(d => d.payload?.docLevel == "2");
    let voterFrontObj = {
        imageUrl: OcrImageBaseValue['Voter Front'],
        RequestID: frontDocs.documentId + "",
        isBlackWhiteCheck: "yes",
        confidence: "yes",
        fraudCheck: "yes",
        doctype: "Voter ID",
        isCompleteImageCheck: "yes"
    }
    let voterBackObj = {
        imageUrl: OcrImageBaseValue['Voter Back'],
        RequestID: backDocs.documentId + "",
        isBlackWhiteCheck: "yes",
        confidence: "yes",
        fraudCheck: "yes",
        doctype: "Voter ID",
        isCompleteImageCheck: "yes"
    }
    ApzCOB.voterFrontOcr(voterFrontObj, apz.app.documentCapture.voterFrontOcrCB);
    ApzCOB.voterBackOcr(voterBackObj, apz.app.documentCapture.voterBackOcrCB);
}
apz.app.documentCapture.initiatePanOCR = function() {
    apz.startLoader();
    let frontDocs = window.custimg.find(d => d.payload?.docLevel == "1");
    let panObj = {
        imageUrl: OcrImageBaseValue['PAN Front'],
        RequestID: frontDocs.documentId + "",
        isBlackWhiteCheck: "yes",
        confidence: "yes",
        fraudCheck: "yes",
        doctype: "PAN",
        isCompleteImageCheck: "yes"
    };
    ApzCOB.panCheckOcr(panObj, apz.app.documentCapture.panOcrCB);
};
apz.app.documentCapture.voterFrontBackOcrCB = function(params) {
    try {
        let interfaceName = `APZCBO__${params.ifaceName}_Res`;
        let responseStr = params.res[interfaceName].apiResponse.ResponseBody.responseObj;
        let parsed = JSON.parse(responseStr);
        let details = parsed.result?.[0]?.details;
        if (parsed.status === "success" && details) {
            if (parsed?.result?.length > 0) {
                const type = parsed.result[0]?.type;
                if (type === 'voterid_front_old') {
                    $("#KmSourc__documentCapture__ocrVoterNumber").val(details?.voterid?.value || "");
                    $("#KmSourc__documentCapture__ocrName").val(details?.name?.value || "");
                } else if (type === 'voterid_back_old') {
                    $("#KmSourc__documentCapture__ocrAddr1").val(details?.address?.line1 || "");
                    $("#KmSourc__documentCapture__ocrAddr2").val(details?.address?.line2 || "");
                    $("#KmSourc__documentCapture__ocrAddr3").val(details?.address?.district || "");
                    $("#KmSourc__documentCapture__ocr-pincode").val(details?.address?.pin || "").change();
                }
            }
        } else {
            window.ocrFailed = true;
        }
    } catch (e) {
        ApzCOB.traceFrontEndError(e,"");
        window.ocrFailed = true;
    }
    apz.app.documentCapture.finishOcrCheck();
};
apz.app.documentCapture.voterFrontOcrCB = function(params) {
    try {
        const resNode = params?.res?.APZCBO__VoterFrontOcr_Res;
        if (!resNode?.apiResponse?.ResponseBody) {
            window.ocrFailed = true;
        } else {
            let responseStr = resNode.apiResponse.ResponseBody.responseObj;
            let parsed = JSON.parse(responseStr);
            let details = parsed.result?.[0]?.details;
            if(parsed.statusCode === "501"){
                window.invalidVoter = true;
            } else if (parsed.status === "success" && details) {
                //  Check document type
                if (parsed?.result?.[0]?.type === "voterid_back_new" || parsed?.result?.[0]?.type === "voterid_back_old" || parsed?.result?.[0]?.type === "voterid_pvc_back") {
                    window.frontMisMatch = true;
                } else if (!details.voterid?.value && !details.name?.value){
                    window.ocrFailed = true;
                } else {
                    $("#KmSourc__documentCapture__ocrVoterNumber").val(details.voterid?.value || "");
                    $("#KmSourc__documentCapture__ocrName").val(details.name?.value || "");
                }
            } else {
                window.ocrFailed = true;
            }
        }
    } catch (e) {
        ApzCOB.traceFrontEndError(e,"");
        window.ocrFailed = true;
    }
    apz.app.documentCapture.finishOcrCheck();
};

apz.app.documentCapture.voterBackOcrCB = function(params) {
    try {
        const resNode = params?.res?.APZCBO__VoterBackOcr_Res;
        if (!resNode?.apiResponse?.ResponseBody) {
                window.ocrFailed = true;
        } else {
                let responseStr = resNode.apiResponse.ResponseBody.responseObj;
                let parsed = JSON.parse(responseStr);
                let details = parsed.result?.[0]?.details;
                if(parsed.statusCode === "501") {
                    window.invalidVoter = true;
                } else if (parsed.status === "success" && details) {
                    // Check document type
                    if (parsed?.result?.[0]?.type === "voterid_front_new" || parsed?.result?.[0]?.type === "voterid_front_old" || parsed?.result?.[0]?.type === "voterid_pvc_front") {
                        window.backMisMatch = true;
                    } else if(!details.address?.line1 && !details.address?.line2 && !details.address?.district && !details.address?.pin){
                        window.ocrFailed = true;
                    } else {
                        $("#KmSourc__documentCapture__ocrAddr1").val(details.address?.line1 || "");
                        $("#KmSourc__documentCapture__ocrAddr2").val(details.address?.line2 || "");
                        $("#KmSourc__documentCapture__ocrAddr3").val(details.address?.district || "");
                        $("#KmSourc__documentCapture__ocr-pincode").val(details.address?.pin || "").change();
                    }
                } else {
                    window.ocrFailed = true;
                }
        }
    } catch (e) {
        ApzCOB.traceFrontEndError(e,"");
        window.ocrFailed = true;
    }
    apz.app.documentCapture.finishOcrCheck();
};
apz.app.documentCapture.panOcrCB = function(params) {
    apz.stopLoader();
    try {
        const resNode = params?.res?.APZCBO__PanCheckOcr_Res;
        if (!resNode?.apiResponse?.ResponseBody) {
            apz.app.documentCapture.handlePanOcrFailure();
        } else {
            let responseStr = resNode.apiResponse.ResponseBody.responseObj;
            let parsed = JSON.parse(responseStr);
            let details = parsed.result?.[0]?.details;
            if(parsed.statusCode === "501"){
                window.invalidPan = true;
                apz.app.documentCapture.handlePanOcrFailure();
            } else if (parsed.status === "success" && details) {
                window.panOcrAttempt = 0;
                $("#KmSourc__documentCapture__ocrPanNumber").val(details.pan_no?.value || "");
                $("#KmSourc__documentCapture__ocrName").val(details.name?.value || "");
                $("#KmSourc__documentCapture__ocr_heading").removeClass("sno");
                $("#KmSourc__documentCapture__ocr_details").removeClass("sno");
                $("#KmSourc__documentCapture__ocrNote").removeClass("sno");
                $("#KmSourc__documentCapture__ocrEdit").removeClass("sno");
                apz.app.documentCapture.checkAndEnableNext();
            } else {
                apz.app.documentCapture.handlePanOcrFailure();
            }
    }
    } catch (e) {
        ApzCOB.traceFrontEndError(e,"");
        apz.app.documentCapture.handlePanOcrFailure();
    }
};
apz.app.documentCapture.finishOcrCheck = function() {
    apz.stopLoader();
    window.ocrResponseCount++;
    $("#KmSourc__Kmbase__manual_button_ul").addClass("sno");
    $("#KmSourc__Kmbase__button_form").addClass("suc-btns suc-btn1").removeClass("suc-btn-2 form-top mt2");
    if (window.ocrResponseCount < 2) return;
    if (window.frontMisMatch || window.backMisMatch) {
            let errMsg = window.frontMisMatch ? "Please upload the front of the document" :
            "Please upload the back of the document";
            ApzCOB.fnDisplayMsg(errMsg, "E");
            $("#KmSourc__documentCapture__sc_row_134").removeClass("sno");
            $("#KmSourc__documentCapture__el_icn_2").removeClass("sno");
            $("#KmSourc__documentCapture__el_icn_4").removeClass("sno");
    } else if (window.invalidVoter) {
            ApzCOB.fnDisplayMsg("No Voter ID Detected", "E");
            $("#KmSourc__documentCapture__sc_row_134").removeClass("sno");
            $("#KmSourc__documentCapture__el_icn_2").removeClass("sno");
            $("#KmSourc__documentCapture__el_icn_4").removeClass("sno");
    } else if (window.ocrFailed) {
        window.voterOcrAttempt++;
        let msg = `Failed to fetch OCR data (Attempt ${window.voterOcrAttempt}).<br>Please try again.`;
        $("#KmSourc__Kmbase__ocr_failure_text").html(msg);
        ApzCOB.toggleModal("KmSourc__Kmbase__OCR_failure_modal");
        if (window.voterOcrAttempt >= 3) {
            $("#KmSourc__Kmbase__manual_button_ul").removeClass("sno");
            $("#KmSourc__Kmbase__button_form").removeClass("suc-btns suc-btn1").addClass("suc-btn-2 form-top mt2");
            $("#KmSourc__Kmbase__ocr_failure_text").html(
                `Failed to fetch OCR data (Attempt ${window.voterOcrAttempt}).<br>Please proceed with manual input.`);
        }
    } else {
        $("#KmSourc__documentCapture__ocr_heading").removeClass("sno");
        $("#KmSourc__documentCapture__ocr_details").removeClass("sno");
        $("#KmSourc__documentCapture__ocrNote").removeClass("sno");
        $("#KmSourc__documentCapture__ocrEdit").removeClass("sno");
        window.voterOcrAttempt = 0;
        apz.app.documentCapture.checkAndEnableNext();
    }
    window.ocrResponseCount = 0;
    window.ocrFailed = false;
    window.frontMisMatch = false;
    window.backMisMatch = false;
};
apz.app.documentCapture.handlePanOcrFailure = function() {
    if(window.invalidPan) {
        ApzCOB.fnDisplayMsg("No PAN Card Detected", "E");
        $("#KmSourc__documentCapture__sc_row_134").removeClass("sno");
        $("#KmSourc__documentCapture__el_icn_2").removeClass("sno");
        $("#KmSourc__documentCapture__el_icn_4").removeClass("sno");
    } else {
        window.panOcrAttempt = window.panOcrAttempt || 0;
        window.panOcrAttempt++;
        $("#KmSourc__Kmbase__manual_button_ul").addClass("sno");
        $("#KmSourc__Kmbase__button_form").addClass("suc-btns suc-btn1").removeClass("suc-btn-2 form-top mt2");
        let msg = `Failed to fetch OCR data (Attempt ${window.panOcrAttempt}).<br>Please try again.`;
        $("#KmSourc__Kmbase__ocr_failure_text").html(msg);
        ApzCOB.toggleModal("KmSourc__Kmbase__OCR_failure_modal");
        if (window.panOcrAttempt >= 3) {
            $("#KmSourc__Kmbase__manual_button_ul").removeClass("sno");
            $("#KmSourc__Kmbase__button_form").removeClass("suc-btns suc-btn1").addClass("suc-btn-2 form-top mt2");
            $("#KmSourc__Kmbase__ocr_failure_text").html(
                `Failed to fetch OCR data (Attempt ${window.panOcrAttempt}).<br>Please proceed with manual input.`);
            $("#KmSourc__documentCapture__el_btn_30_ul").removeClass("sno");
            $("#KmSourc__Kmbase__ct_frm_20").removeClass("suc-btns suc-btn1").addClass("suc-btn-2 form-top mt2");
            $("#KmSourc__documentCapture__el_txt_42").text("OCR failed 3 times. Please enter details manually.");
        }
    }
};
apz.app.documentCapture.retryOcr = function() {
    ApzCOB.toggleModal("KmSourc__Kmbase__OCR_failure_modal");
    if (apz.app.docType === 'Voter ID') {
        apz.app.documentCapture.initiateVoterOCR();
    } else if (apz.app.docType === 'Aadhaar') {
        ApzCOB.ImageReCapture();
    } else {
        apz.app.documentCapture.initiatePanOCR();
    }
};
apz.app.documentCapture.manualEntry = function() {
    if ($('#KmSourc__Kmbase__OCR_failure_modal').is(':visible')) {
        ApzCOB.toggleModal("KmSourc__Kmbase__OCR_failure_modal");
    }
    if(apz.app.docType === 'Aadhaar'){
        $("#KmSourc__documentCapture__sc_row_134").addClass("sno");
        $('.ocr-section').removeClass('sno');
        isAadhaarRedactEnabled = false;
    }
    if(!($(`#${docScrId}ocrName`).val ||  $(`#${docScrId}ocrAadhaarNumber`).val)){
        $(`#${docScrId}ocrVoterNumber, #${docScrId}ocrName, #${docScrId}ocrPanNumber, #${docScrId}ocrAadhaarNumber`).val(''); 
    }
    // $(`#${docScrId}ocrVoterNumber, #${docScrId}ocrName, #${docScrId}ocrPanNumber, #${docScrId}ocrAadhaarNumber`).val(''); //clearing fields if OCR/Redact fails
    $("#KmSourc__documentCapture__ocr_heading").removeClass("sno");
    $("#KmSourc__documentCapture__ocr_details").removeClass("sno");
    $("#KmSourc__documentCapture__ocrNote").removeClass("sno");
    $("#KmSourc__documentCapture__ocrEdit").removeClass("sno");
};
apz.app.documentCapture.validateVoterAddressBeforeNext = function() {
    let isValid = true;

    function check(result) {
        if (!result) isValid = false;
    }
    let addr1Id = docScrId + "ocrAddr1";
    let pincodeId = docScrId + "ocr-pincode";
    clearFieldError(addr1Id);
    clearFieldError(pincodeId);
    // Address Line 1
    let addr1Val = ($("#" + addr1Id).val() || "").trim();
    if (!addr1Val) {
        showFieldError(addr1Id, "Address Line 1 is required");
        isValid = false;
    }
    // Pincode
    let pincodeVal = ($("#" + pincodeId).val() || "").trim();
    if (!pincodeVal) {
        showFieldError(pincodeId, "Pincode is required");
        isValid = false;
    }
    if (!isValid) {
        // Scroll to first error
        let firstError = $(".error-inline:visible").first();
        if (firstError.length) {
            firstError[0].scrollIntoView({
                behavior: "smooth",
                block: "center"
            });
        }
    }
    return isValid;
};
apz.app.documentCapture.initiateAadhaarOCR = function() {
    let kycObj = {
        fetchAadhaar: true
    }
    ApzCOB.aadhaarRedactOcr(kycObj, apz.app.documentCapture.aadhaarRedactOcrCB);
};
apz.app.documentCapture.aadhaarRedactOcrCB = function(params){
    if(ApzCOB.handleServiceCallBacks(params)){
        let reqObj = JSON.parse(params.res.APZCBO__AdharRedactOcr_Res.apiResponse.ResponseBody.responseObj);
        let frontData = reqObj.front ? JSON.parse(reqObj.front) : {};
        let backData = reqObj.back ? JSON.parse(reqObj.back) : {};
        let combinedData = frontData;
        for (key in backData){
            if(backData[key].value && backData[key].value !== ""){
                combinedData[key] = backData[key];
            }
        }


        //Paint Data
        let {aadhaar, name, address, dob} = combinedData;
        let maskedAadhaar = aadhaar.value.slice(-4);
        $("#KmSourc__documentCapture__ocrAadhaarNumber").val(maskedAadhaar);
        $("#KmSourc__documentCapture__ocrName").val(name?.value || "");
        $("#KmSourc__documentCapture__ocr-dob").val(dob?.value || "");
        $("#KmSourc__documentCapture__ocrAddr1").val(address?.line1 || "");
        $("#KmSourc__documentCapture__ocrAddr2").val(address?.line2 || "");
        $("#KmSourc__documentCapture__ocrAddr3").val(address?.line3 || "");
        $("#KmSourc__documentCapture__ocr-pincode").val(address?.pin || "").change();

        //Display section
        $("#KmSourc__documentCapture__ocr_heading").removeClass("sno");
        $("#KmSourc__documentCapture__ocr_details").removeClass("sno");
        $("#KmSourc__documentCapture__ocrNote").removeClass("sno");
        $("#KmSourc__documentCapture__ocrEdit").removeClass("sno");
        apz.app.documentCapture.checkAndEnableNext();

    } else{
        ApzCOB.fnDisplayMsg("Couldn't Fetch Aaadhaar Data");
    }
    ApzCOB.hideLoader();

};

apz.app.documentCapture.aadhaarFrontOcrCB = function(params) {
    try {
        let responseStr = params.res.APZCBO__AdharRedactOcr_Res.apiResponse.ResponseBody.responseObj;
        let parsed = JSON.parse(responseStr);
        let details = parsed.result?.[0]?.details;
        if (parsed.status === "success" && details) {
            let maskedAadhaar = details.aadhaar?.value || "";
            let last4 = maskedAadhaar.slice(-4);
            $("#KmSourc__documentCapture__ocrAadhaarNumber").val(last4);
            $("#KmSourc__documentCapture__ocrName").val(details.name?.value || "");
            $("#KmSourc__documentCapture__ocr-dob").val(details.dob?.value || "");
        } else {
            window.ocrFailed = true;
        }
    } catch (e) {
        ApzCOB.traceFrontEndError(e,"");
        window.ocrFailed = true;
    }
    apz.app.documentCapture.finishAadhaarOcrCheck();
};
apz.app.documentCapture.aadhaarBackOcrCB = function(params) {
    try {
        let responseStr = params.res.APZCBO__AdharRedactOcr_Res.apiResponse.ResponseBody.responseObj;
        let parsed = JSON.parse(responseStr);
        let details = parsed.result?.[0]?.details;
        if (parsed.status === "success" && details) {
            $("#KmSourc__documentCapture__ocrAddr1").val(details.address?.line1 || "");
            $("#KmSourc__documentCapture__ocrAddr2").val(details.address?.line2 || "");
            $("#KmSourc__documentCapture__ocrAddr3").val(details.address?.district || "");
            $("#KmSourc__documentCapture__ocr-pincode").val(details.address?.pin || "").change();
        } else {
            window.ocrFailed = true;
        }
    } catch (e) {
        ApzCOB.traceFrontEndError(e,"");
        window.ocrFailed = true;
    }
    apz.app.documentCapture.finishAadhaarOcrCheck();
};
apz.app.documentCapture.finishAadhaarOcrCheck = function() {
    apz.stopLoader();
    window.ocrResponseCount++;
    $("#KmSourc__Kmbase__manual_button_ul").addClass("sno");
    $("#KmSourc__Kmbase__button_form").addClass("suc-btns suc-btn1").removeClass("suc-btn-2 form-top mt2");
    if (window.ocrResponseCount < 2) return;
    if (window.ocrFailed) {
        window.aadhaarOcrAttempt = (window.aadhaarOcrAttempt || 0) + 1;
        let msg = `Failed to fetch OCR data (Attempt ${window.aadhaarOcrAttempt}).<br>Please try again.`;
        $("#KmSourc__Kmbase__ocr_failure_text").html(msg);
        ApzCOB.toggleModal("KmSourc__Kmbase__OCR_failure_modal");
        if (window.aadhaarOcrAttempt >= 3) {
            $("#KmSourc__Kmbase__manual_button_ul").removeClass("sno");
            $("#KmSourc__Kmbase__button_form").removeClass("suc-btns suc-btn1").addClass("suc-btn-2 form-top mt2");
            $("#KmSourc__Kmbase__ocr_failure_text").html(
                `Failed to fetch OCR data (Attempt ${window.aadhaarOcrAttempt}).<br>Please proceed with manual input.`);
        }
    } else {
        $("#KmSourc__documentCapture__ocr_heading").removeClass("sno");
        $("#KmSourc__documentCapture__ocr_details").removeClass("sno");
        $("#KmSourc__documentCapture__ocrNote").removeClass("sno");
        $("#KmSourc__documentCapture__ocrEdit").removeClass("sno");
        window.aadhaarOcrAttempt = 0;
        apz.app.documentCapture.checkAndEnableNext();
    }
    window.ocrResponseCount = 0;
    window.ocrFailed = false;
};
apz.app.documentCapture.addCoAppConfirmation = function(ptype) {
    let obj = {};
    obj.remarks = '';
    if (ptype === 'KYC') {
        obj.reason = 'KYCVerificationFailed';
    }
    ApzCOB.discardCoApplicant(obj);
};
apz.app.documentCapture.dedupeServiceConfirmCoApplicantCB = function(params) {
    if (IS_CO_APPLICANT_ALTERNATE_DEDUPE) {
        $('#' + docScrId + "ocrVoterNumber").val('');
    }
    ApzCOB.toggleModal(kmbaseScr + 'dedupeCheckReject');
};
