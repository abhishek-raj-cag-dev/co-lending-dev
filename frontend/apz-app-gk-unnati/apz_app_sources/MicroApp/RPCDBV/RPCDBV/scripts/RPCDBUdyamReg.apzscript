}
apz.app.RPCDBUdyamReg.paintCustDetailsApp = function() {
    $(`#${RPCDBUdyamRegScrId}urn`).val(inSessionStore.leadDetails?.urn); // urn from lead
    $(`#${RPCDBUdyamRegScrId}custName`).val(AppCustdata?.customerName);
    $(`#${RPCDBUdyamRegScrId}aadhaar`).val(AppCustdata?.payload?.secondaryKycId || '---');
    $(`#${RPCDBUdyamRegScrId}mobile`).val(AppCustdata?.mobileNumber || '---');
    $(`#${RPCDBUdyamRegScrId}primaryKyc`).val(appValidKYC);
    $(`#${RPCDBUdyamRegScrId}coAppNamerow`).addClass('sno');
    $(`#${RPCDBUdyamRegScrId}coAppCusttyprow`).addClass('sno');
    $(`#${RPCDBUdyamRegScrId}coAppaadharrow`).addClass('sno');
    $(`#${RPCDBUdyamRegScrId}coAppmobileRow`).addClass('sno');
    $(`#${RPCDBUdyamRegScrId}coAppprimaryKycrow`).addClass('sno');
    $("#RPCDBV__RPCDBUdyamReg__custTypeRadio_option_Co-App").attr("disabled", "disabled");
    $("#RPCDBV__RPCDBUdyamReg__custTypeRadio_option__span_").addClass('sno');
    $("#RPCDBV__RPCDBUdyamReg__custTypeRadio_option_Applicant").removeAttr("disabled").prop("checked", true);
};
apz.app.RPCDBUdyamReg.PopulateDropDowns = function() {
    let tempArr = apz.isNull(gLovs) ? [{"lovDtls":"{}"}] : gLovs.filter(item => item.lovName == "UDYAM_FAILED_REASONS");
    let udayamReasons = JSON.parse(tempArr[0].lovDtls ?? {})["Udyam Failed Reasons"] ?? [];
    apz.populateDropdown(document.getElementById(RPCDBUdyamRegScrId + "reason"), ApzCOB.formatDropDownforArray(udayamReasons));
    apz.populateDropdown(document.getElementById(RPCDBUdyamRegScrId + "CoAppreason"), ApzCOB.formatDropDownforArray(udayamReasons));
};
apz.app.UdyamReg.fetchSelectedDocs = function() {
    let ldocType = $(`#${RPCDBUdyamRegScrId}successTick_ul`).is(":visible") ? "Udyam Reg Success" : "Udyam Reg Failed";
    let lcusttype = $(`#${RPCDBUdyamRegScrId}custTypeRadio input:checked`).val();
    let documentResp = inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList;
    let ldocs = documentResp.filter(docs => docs.payload.documentType === ldocType && parseInt(docs.custDtlId) === parseInt(ApzCOB
        .getCustDetailID(lcusttype)));
    return ldocs;
};
apz.app.RPCDBUdyamReg.launchNextsrcn = function() {
    ApzCOB.launchSubScreen("RPCDBDocExecutionUnnati", `${DBVerifyscrId}RPCDbkitLaunchDiv`);
}
apz.app.RPCDBUdyamReg.launchPrevious = function() {
    ApzCOB.launchSubScreen("RPCDBeNach", `${DBVerifyscrId}RPCDbkitLaunchDiv`);
}
apz.app.RPCDBUdyamReg.onChangeReason = function(pthis) {
    let val = $(`#${RPCDBUdyamRegScrId}reason`).val();
    if (inSessionStore?.udhyamDetails) {
        let appItem = inSessionStore.udhyamDetails.find(item => item.customerType === "Applicant");
        if (appItem) {
            appItem.remarks = val;
        } else {
            inSessionStore.udhyamDetails.push({
                applicationId: inSessionStore?.applicationId || inSessionStore?.applicationMaster?.applicationId,
                appId: inSessionStore?.appId || inSessionStore?.applicationMaster?.appId,
                customerType: "Applicant",
                udhyamStatus: "Failed",
                remarks: val
            });
        }
    }
};
apz.app.RPCDBUdyamReg.onChangeCoAppReason = function(pthis) {
    let val = $(`#${RPCDBUdyamRegScrId}CoAppreason`).val();
    if (inSessionStore?.udhyamDetails) {
        let coAppItem = inSessionStore.udhyamDetails.find(item => item.customerType === "Co-App");
        if (coAppItem) {
            coAppItem.remarks = val;
        } else {
            inSessionStore.udhyamDetails.push({
                applicationId: inSessionStore?.applicationId || inSessionStore?.applicationMaster?.applicationId,
                appId: inSessionStore?.appId || inSessionStore?.applicationMaster?.appId,
                customerType: "Co-App",
                udhyamStatus: "Failed",
                remarks: val
            });
        }
    }
};
apz.app.RPCDBUdyamReg.bindDropDownEvents = function() {
    $(`#${RPCDBUdyamRegScrId}reason`).off('change.udyam').on('change.udyam', function() {
        apz.app.RPCDBUdyamReg.onChangeReason(this);
    });
    $(`#${RPCDBUdyamRegScrId}CoAppreason`).off('change.udyam').on('change.udyam', function() {
        apz.app.RPCDBUdyamReg.onChangeCoAppReason(this);
    });
};
apz.app.RPCDBUdyamReg.copyInpVal = function(inputIds) {
    $.each(inputIds, function(index, inputId) {
        const $input = $('#' + inputId);
        const $icon = $input.siblings('.icon-copy');
        if (!$input.length || !$icon.length) {
            return;
        }
        $input.prop('disabled', false).prop('readonly', true).removeAttr('disabled').removeClass('disabled');
        $input.css('background-color', 'rgba(15, 33, 88, 0.08)');
        $input.closest('.select-disabled').removeAttr('disabled').removeClass('select-disabled');
        $icon.off('click.copyValue');
        $icon.on('click.copyValue', function(e) {
            e.preventDefault();
            e.stopPropagation();
            const input = $input[0];
            if (!input || !input.value) {
                return;
            }
            input.focus();
            input.select();
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(input.value).then(function() {
                    apz.app.RPCDBUdyamReg.showCopiedPopover($icon);
                }).catch(function() {
                    document.execCommand('copy');
                    apz.app.RPCDBUdyamReg.showCopiedPopover($icon);
                });
            } else {
                document.execCommand('copy');
                apz.app.RPCDBUdyamReg.showCopiedPopover($icon);
            }
        });
    });
};
apz.app.RPCDBUdyamReg.showCopiedPopover = function($input) {
    if (!$input || !$input.length) {
        return;
    }
    $('.copy-popover').remove();
    const $popover = $('<div>', { class: 'copy-popover', text: 'Copied' });
    $('body').append($popover);
    $popover.css({ display: 'block', position: 'absolute', zIndex: 999999, visibility: 'hidden' });
    const inputOffset = $input.offset();
    const inputWidth = $input.outerWidth();
    const inputHeight = $input.outerHeight();
    const popoverWidth = $popover.outerWidth();
    const popoverHeight = $popover.outerHeight();
    const inputCenter = inputOffset.left + (inputWidth / 2);
    const left = inputCenter - (popoverWidth / 2);
    const top = inputOffset.top - popoverHeight - 8;
    $popover.css({ top: top + 'px', left: left + 'px', visibility: 'visible' });
    setTimeout(function() {
        $popover.fadeOut(200, function() {
            $(this).remove();
        });
    }, 2000);
};
