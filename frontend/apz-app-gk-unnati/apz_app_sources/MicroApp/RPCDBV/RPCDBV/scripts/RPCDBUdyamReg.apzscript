        // $(`#${RPCDBUdyamRegScrId}CoAppreason`).val(lfailedCoAppData[0]?.remarks);
         apz.app.RPCDBUdyamReg.PopulateDropDowns();
         apz.setElmValue(`RPCDBV__RPCDBUdyamReg__CoAppreason`, lfailedCoAppData[0]?.remarks);
         $("#RPCDBV__RPCDBUdyamReg__CoAppreason_ext").css("height", "45px");
