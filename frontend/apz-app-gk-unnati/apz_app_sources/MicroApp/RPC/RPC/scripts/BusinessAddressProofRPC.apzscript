RPC_CURRENT_STAGE = 'BusinessAddressProofRPC';
var bussAddrPrfScrId = `RPC__${RPC_CURRENT_STAGE}__`,
    addSameAsRadio = `${bussAddrPrfScrId}addressSameAsInput`,
    bussAddrProofTagId = `${bussAddrPrfScrId}currentAddressProofInput`,
    addrFields = ['addressType', 'addressLine1', 'addressLine2', 'addressLine3', 'pinCode', 'city', 'district', 'area', 'landMark', 'state',
        'country'];
var addrType = "Occupation",
    subAddrType = "Office";
window.lAddressSameAs = '', window.validPinCode = false;
window.activeTag = '';
window.currBusinessIndex = '';
var srcMapping  = {"Rental Income": "rentalIncome","Salary": "salary", "Pension": "pension", "Agriculture": "agriculture", "Wage": "wage"};
