apz.app.OtherInformationRPC.downloadCBReport = function() {
    let custDetailID = ApzCOB.getCustDetailID(custType);
    CB_LOAN_ID = '';
    CB_LOAN_ID = inSessionStore.cibilDetailsWrapperList.filter(el => el.cibilDetails.custDtlId === custDetailID)[0].cibilDetails.payload.cbLoanId;
    ApzCOB.downloadBRECbReport(custDetailID);
}
apz.app.OtherInformationRPC.removeLoanDetails = function() {
    const elementId1 = `#RPC__${RPC_CURRENT_STAGE}__ct_frm_5`;
    const elementId2 = `#RPC__${RPC_CURRENT_STAGE}__ct_frm_4`;
    const elementId3 = `#RPC__${RPC_CURRENT_STAGE}__coApplicantInsurance`;
    const elementId5 = `#RPC__${RPC_CURRENT_STAGE}__insuranceReqd`;

    if (custType === "Applicant") {
        $(elementId1).removeClass('sno');
        $(elementId2).removeClass('sno');
        $(elementId3).addClass('sno');
        $(elementId5).removeClass('sno');
    } else {
        $(elementId1).addClass('sno');
        $(elementId2).addClass('sno');
        $(elementId3).removeClass('sno');
        $(elementId5).addClass('sno');
    }

    if ($(`#RPC__${RPC_CURRENT_STAGE}__kendraId`).hasClass("sno") || $(`#RPC__${RPC_CURRENT_STAGE}__kendraName`).hasClass("sno")) {
        $(`#RPC__${RPC_CURRENT_STAGE}__ct_frm_1`).addClass("sno");
    } else {
        $(`#RPC__${RPC_CURRENT_STAGE}__ct_frm_1`).removeClass("sno");
    }

    apz.app.OtherInformationRPC.updateCbTriggeredDate();
};
apz.app.OtherInformationRPC.updateCbTriggeredDate = function () {
    let custDtlId = custType === 'Applicant' ? Number(gApzCOB.userDetails.custDtlId) : gApzCOB.userDetails.CoApplicantCustomerId;
    const cibilDetails = inSessionStore.cibilDetailsWrapperList.find(cibil => Number(cibil.cibilDetails.custDtlId) === Number(custDtlId))?.cibilDetails;
    if (typeof cibilDetails.cbDate === 'object') {
        const dateObj = cibilDetails.cbDate;
        const cbFormattedDate = `${String(dateObj.day).padStart(2, '0')}/${String(dateObj.month).padStart(2, '0')}/${dateObj.year}`;
        $(`#${scrid}cbTriggeredDate`).text("Last CB Triggered Date - "+ cbFormattedDate);
    }
    let roiVal = ApzCOB.getPayloadDatafromWrapper('roi', 'Co-App', 'cibilDetailsWrapperList');
    $(`#RPC__${RPC_CURRENT_STAGE}__roiInput`).val(roiVal);
};

apz.app.OtherInformationRPC.fnLoadAMLQuestions = function() {
    apz.data.scrdata.RPC__loadAMLQuestions_Req = {};
    apz.data.scrdata.RPC__loadAMLQuestions_Req.amlQuestions = []
    if (apz.isNull(DBKIT_MASTERDATA) || Object.keys(DBKIT_MASTERDATA).length === 0) {
    ApzCOB.FetchDBKITMasterData("KMSOURCING")
    }
    if (apz.isNull(DBKIT_MASTERDATA)  || Object.keys(DBKIT_MASTERDATA).length === 0) {
        let amlQuestionFilePath = apz.getDataFilesPath() + "/amlQuestionaire.json"
        let amlQuesDataSet = apz.getFile(amlQuestionFilePath)
        apz.data.scrdata.RPC__loadAMLQuestions_Req.amlQuestions = JSON.parse(amlQuesDataSet)
    } else {
        apz.data.scrdata.RPC__loadAMLQuestions_Req.amlQuestions = JSON.parse(DBKIT_MASTERDATA.find(({ stageName }) => stageName === "OtherInformation")?.queries)
    }
    let amlQuestions = apz.data.scrdata.RPC__loadAMLQuestions_Req.amlQuestions;
    apz.data.loadData("loadAMLQuestions", "RPC")
    for (let i = 0; i < amlQuestions.length; i++) {
        $("#RPC__loadAMLQuestions__i__amlQuestions__question_" + i).empty();
        $("#RPC__loadAMLQuestions__i__amlQuestions__question_" + i).append(`${amlQuestions[i].question}`);
        var $li = $('#' + scrid + 'amlQuestionList_row_' + i);
        var onclickCode = $li.attr('onclick');
        if (onclickCode) {
            onclickCode = onclickCode.replace('apz.data.selectRow(this, event);', '').replace('apz.data.rowClicked(this,event);', '');
            $li.attr('onclick', onclickCode);
        }
    }
}

apz.app.OtherInformationRPC.setAMLQuestionnaireData = function(data) {
    if (!data || !data.amlQuestionList || data.amlQuestionList.length === 0) return;
    const questionRows = document.querySelectorAll('[id^="RPC__OtherInformationRPC__amlQuestionList_row_"]');
    if (!questionRows || questionRows.length === 0) return;
    data.amlQuestionList.forEach((item, index) => {
        const row = questionRows[index];
        if (!row) return;
        const rowNo = index;
        const questionEl = document.querySelector(`#RPC__loadAMLQuestions__i__amlQuestions__question_${rowNo}`);
        const questionHeader = questionEl?.querySelector('h3')?.innerText?.trim();
        if (!questionHeader || questionHeader !== item.questionType) {
            console.warn("Question mismatch at row:", rowNo);
            return;
        }
        if (item.applicant) {
            const applicantRadio = row.querySelector(
                `input[name="RPC__OtherInformationRPC__radoChk1_${rowNo}_${rowNo}"][value="${item.applicant}"]`);
            if (applicantRadio) applicantRadio.checked = true;
        }
        if (item.coApplicant) {
            const coApplicantRadio = row.querySelector(
                `input[name="RPC__OtherInformationRPC__radoChk2_${rowNo}_${rowNo}"][value="${item.coApplicant}"]`);
            if (coApplicantRadio) coApplicantRadio.checked = true;
        }
        document.querySelectorAll("#RPC__OtherInformationRPC__amlQuestionList input[type='radio']").forEach(radio => radio.disabled =
            true);
    });
};
apz.app.OtherInformationRPC.formatDobToMDY = function(dob) {
        if (!dob) return '';
        const [year, ...rest] = dob.split('-');
        return [...rest, year].join('/');
}
