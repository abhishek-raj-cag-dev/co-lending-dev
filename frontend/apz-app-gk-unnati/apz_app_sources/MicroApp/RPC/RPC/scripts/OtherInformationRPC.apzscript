apz.app.OtherInformationRPC.paintInsdetails = function() {
    if (applicantDtls.insuranceType == 'bothInsurance') {
        window.coApplicantDtls = insuranceList.find(el => el?.insuranceDetails?.insuredCustType === "Co-App")?.insuranceDetails || {};
        $(`#${scrid}AppheaderFrm`).removeClass('sno');
        $(`#${scrid}appDtlsFRM`).removeClass('sno');
        $(`#${scrid}coAppheaderFRM`).removeClass('sno');
        $(`#${scrid}coappDtlsFRM`).removeClass('sno');
        $(`#${scrid}CoappNameInput`).val(coApplicantDtls?.payload?.nomineeName)
        $(`#${scrid}CoappgenderInput`).val(coApplicantDtls?.payload?.gender)
        $(`#${scrid}CoappDobInput`).val(ApzCOB.convertDateFormat(coApplicantDtls?.payload?.nomineeDob, 'dd/mm/yyyy'))
        $(`#${scrid}CoappageInput`).val(coApplicantDtls?.payload?.age)
        $(`#${scrid}CoappRelationInput`).val(coApplicantDtls?.payload?.nomineeRelation)
    } else {
        $(`#${scrid}AppheaderFrm`).removeClass('sno');
        $(`#${scrid}appDtlsFRM`).removeClass('sno');
    }
    $(`#${scrid}appNameInput`).val(applicantDtls?.payload?.nomineeName)
    $(`#${scrid}appgenderInput`).val(applicantDtls?.payload?.gender)
    $(`#${scrid}appDobInput`).val(ApzCOB.convertDateFormat(applicantDtls?.payload?.nomineeDob, 'dd/mm/yyyy'))
    $(`#${scrid}appageInput`).val(applicantDtls?.payload?.age)
    $(`#${scrid}appRelationInput`).val(applicantDtls?.payload?.nomineeRelation)
}
apz.app.OtherInformationRPC.paintaddDocname = function() {
    let additionalDocArray = inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList?.filter(doc => doc?.payload
        ?.isAdiDoc === 'Y') || [];
    if (additionalDocArray.length > 0) {
        const groupedDocuments = additionalDocArray.reduce((acc, doc) => {
            const docName = doc?.payload?.documentName || "Unknown";
            if (!acc[docName]) {
                acc[docName] = [];
            }
            acc[docName].push(doc);
            return acc;
        }, {});
        Object.keys(groupedDocuments).forEach((docName, index) => {
            let currentDocs = groupedDocuments[docName];
            fldSelectElementID = "RPC__OtherInformationRPC__additionalDocSection_0";
            fldParentDiv = $(`#RPC__OtherInformationRPC__cloneColumn`);
            fieldCurrentIndex = index + 1;
            fieldNewId = ApzCOB.cloneDashboardDivs(fldSelectElementID, fldParentDiv, fieldCurrentIndex);
            $(`#${fieldNewId}`).removeClass("sno");
            $(`#${fieldNewId} #RPC__OtherInformationRPC__addDpcLbl`).text('Additional document' + fieldCurrentIndex);
            $(`#${fieldNewId} #RPC__OtherInformationRPC__nameOfAdditionalDoc`).val(docName).addClass('disabled');
            $(`#${fieldNewId} #RPC__OtherInformationRPC__nameOfAdditionalDoc`).attr("disabled", true);
        });
    } else {
        $(`#RPC__OtherInformationRPC__AddDocHeader`).addClass('sno');
        $(`#RPC__OtherInformationRPC__docNameFrm`).addClass('sno');
    }
}
apz.app.OtherInformationRPC.buildDDValues = function(items) {
    let params = [];
    items.forEach((desc, index) => {
        params.push({
            val: desc,
            desc: desc,
        });
    });
    if (!items.includes("Please Select")) {
        params.unshift({
            val: "",
            desc: "Please Select"
        });
    }
    return params;
};
apz.app.OtherInformationRPC.setMinMaxLength = function() {
    const fieldMapCustApp = {
        nomineeNameInput: "nomineeName",
        genderInput: "gender",
        mobileNumberInput: "mobileNumber",
        nomineeDobInput: "nomineeDob",
        ageInput: "age",
        nomineeRelationInput: "nomineeRelation"
    };
    ApzCOB.setMinMaxLength(Object.entries(fieldMapCustApp).map(([fieldId, fieldName]) => ({
        fieldName,
        fieldId: scrid + fieldId
    })));
};
apz.app.OtherInformationRPC.insNotOptDropDownValue = function() {
    let selectedReasons = $("#" + scrid + "insuranceNotOptingReasons").val();
    if (selectedReasons === "Other") {
        $("#" + scrid + "otherReasonRow").removeClass("sno");
    } else {
        $("#" + scrid + "otherReasonRow").addClass("sno");
    }
};
apz.app.OtherInformationRPC.ageCalculator = function (pthis) {
    var age = ApzCOB.getAge($(pthis).val());
    if (pthis.id === 'RPC__OtherInformationRPC__nomineeDobInput') {
        if (age > newMinAge && age < newMaxAge) {
            $('#' + scrid + 'ageInput').val(age).change();
            ApzCOB.removeErrMessgae(scrid + 'age', "element");
        } else {
            $('#' + scrid + 'ageInput').val('');
            $(pthis).val("")
            ApzCOB.fnDisplayMsg(`Please select valid age(min:${newMinAge},max:${newMaxAge})`, "E");
        }
    } 
};
apz.app.OtherInformationRPC.fnValidateMobileNumber = function (pthis) {
    if (!apz.isNull($("#" + pthis.id).val())) {
        let mobRegex = "^[6789]\\d{9}$";
        let err = ApzCOB.commonRegex(mobRegex, $("#" + pthis.id).val());
        if (!err) {
            $("#" + pthis.id).val('');
            $("#" + pthis.id + "_ul").next().removeClass("sno");
            let errTxtFieldId = $("#" + pthis.id + "_ul").next()?.find('.icon-Error')?.next() ?? $('#dummyid');
            errTxtFieldId?.text(`Please enter a valid mobile number`);
        } else {
            $("#" + pthis.id).removeClass("err");
            $("#" + pthis.id + "_ul").next().addClass("sno");
        }
    }
}
apz.app.OtherInformationRPC.clickOfEdit = function() {
    $(`#${scrid}nomineeName`).removeClass('disabled');
    $(`#${scrid}mobileNumberInput`).removeClass('disabled');
    if (hasCustNominee) {
        $(`#RPC__OtherInformationRPC__mobNO`).addClass('req');
    }
    ApzCOB.removeDisableToInput(`${scrid}nomineeNameInput`);
    ApzCOB.removeDisableToInput(`${scrid}genderInput`);
    ApzCOB.removeDisableToInput(`${scrid}nomineeRelationInput`);
    ApzCOB.removeDisableToInput(`${scrid}nomineeDobInput`);
    $(`#${scrid}nomineeDobInput`).datepicker("option", "maxDate", Date.parse(DATE_TODAY));
    $('input.hasDatepicker').datepicker("option", {
        maxDate: Date.parse(DATE_TODAY),
        yearRange: "-100:+0"
    });
}
