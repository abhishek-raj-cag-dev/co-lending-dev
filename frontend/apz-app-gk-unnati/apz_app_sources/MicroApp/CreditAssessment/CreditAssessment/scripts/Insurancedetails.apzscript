    if (confirmationModal) {
        apz.app.Cabase.closeCaConfirmarionMdl();
    }
    confirmationModal = false;
    apz.app.Insurancedetails.hideSections();
    let radioBtn = pthis.value ?? pthis;
    $(`#${insuranceDetailsScrId}sc_row_23`).removeClass("sno");
    prevSection = radioBtn;
    currSection = radioBtn;
    $('#' + insuranceDetailsScrId + 'sc_row_83').addClass('sno');
        $('#' + insuranceDetailsScrId + 'sc_row_84').addClass('sno');
    if (radioBtn === 'Applicant') {
        apz.app.Insurancedetails.updateDetailsVisibility(radioBtn);
        $(`#${insuranceDetailsScrId}totalInsurPremium`).text(ApzCOB.formatamountVal(apz.app.Insurancedetails.getPremiumValue('Applicant')));
        $('#' + insuranceDetailsScrId + 'Both').removeClass("sno");
        /*$('#' + insuranceDetailsScrId + 'sc_row_83').removeClass('sno');
        $('#' + insuranceDetailsScrId + 'sc_row_84').removeClass('sno');*/ //CustNominee Remove
