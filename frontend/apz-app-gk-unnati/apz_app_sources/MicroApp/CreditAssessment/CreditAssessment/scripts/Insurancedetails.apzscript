    } else if (radioBtn === 'Both' || radioBtn === 'Joint') {
        /*$('#' + insuranceDetailsScrId + 'sc_row_83').removeClass('sno');
        $('#' + insuranceDetailsScrId + 'sc_row_84').removeClass('sno');*/ //CustNominee Remove
        apz.app.Insurancedetails.updateDetailsVisibility('Both');
        $(`#${insuranceDetailsScrId}Both`).removeClass("sno");
        $(`#${insuranceDetailsScrId}totalInsurPremium`).text(ApzCOB.formatamountVal(apz.app.Insurancedetails.getPremiumValue('Both')));
    } else {
        $(`#${insuranceDetailsScrId}${radioBtn}`).removeClass("sno");
        $(`#${insuranceDetailsScrId}sc_row_23`).addClass("sno");
    }
    fieldsToDisableEnable.forEach(field => {
        $('#' + insuranceDetailsScrId + field + 'ErrorDiv').addClass('sno');
    })
    // Swaroop changes New KM Sourcing 7th june 2026
