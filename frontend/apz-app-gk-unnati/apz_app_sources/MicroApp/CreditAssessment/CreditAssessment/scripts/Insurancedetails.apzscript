var insuranceDetailsScrId = "CrdAss__Insurancedetails__",
    baseScrId = "CrdAss__Cabase__",
    dobAgeField = {
        "CrdAss__Insurancedetails__A_dobInput": "A_ageOfNomineeInput",
        "CrdAss__Insurancedetails__CA_dobInput": "CA_ageOfNomineeInput",
        "CrdAss__Insurancedetails__CC_dobInput": "CC_ageOfNomineeInput",
        "CrdAss__Insurancedetails__BA_dobInput": "BA_ageOfNomineeInput"
    };
window.CURRENTSCREEN = "Insurancedetails";
window.CA_CURRENT_STAGE = "Insurance";
window.applicantFields = [];
window.coappFields = [];
window.jointInsurFields = [];
//window.hasJointApplication = ''; // Swaroop changes New KM Sourcing 7th june 2026
window.insurancePremiumData = "";
window.insurancePremium = "";
window.customerType = '';
window.prevSection = '';
window.currSection = 'Applicant';
window.baseBtns = ["rejectsenback_row", "reject_btn", "sendback_btn", "bckBtn", "nxtBtn"]
window.fieldsToDisableEnable = ["A_nomineeInsurenceInput", "A_genderInput", "A_dobInput", "A_dobInput_button", "A_nomineeRelationshipInput", "A_nameOfInsurerInput",
    "CA_nomineeInsurenceInput", "CA_genderInput", "CA_dobInput", "CA_dobInput_button", "CA_nomineeRelationshipInput",  "CA_nameOfInsurerInput", "CC_nomineeInsurenceInput",
    "CC_genderInput", "CC_dobInput", "CC_nomineeRelationshipInput", "CC_nameOfInsurerInput", "BA_nomineeInsurenceInput", "BA_genderInput", "BA_dobInput",
    "BA_dobInput_button", "BA_nomineeRelationshipInput", "BA_mobileNumberInput", "BC_genderInput", "BC_dobInput", "CC_dobInput_button", "BC_nomineeRelationshipInput", "B_nameOfInsurerInput",
    "el_rdo_1_option_Both", "el_rdo_1_option_Joint", "el_rdo_1_option_Noinsurance", "el_rdo_1_option_Applicant", "el_rdo_1", "el_rdo_2_option_Y",
    "el_rdo_2_option_N"
];
window.applicantFeilds = ["A_nomineeInsurenceInput", "A_genderInput", "A_dobInput", "A_nomineeRelationshipInput", "A_nameOfInsurerInput"]
window.coAppFeilds = ["CA_nomineeInsurenceInput", "CA_genderInput", "CA_dobInput", "CA_nomineeRelationshipInput", "CA_nameOfInsurerInput",  "CC_nomineeInsurenceInput",
    "CC_genderInput", "CC_dobInput", "CC_nomineeRelationshipInput", "CC_nameOfInsurerInput"
]
window.jointFeilds = ["BA_nomineeInsurenceInput", "BA_genderInput", "BA_dobInput", "BA_nomineeRelationshipInput", "B_nameOfInsurerInput"]
window.jointInsurRadioBtn = "N";
window.jointInsurFields = ["BA_nomineeInsurenceInput", "BA_genderInput", "BA_dobInput", "BA_nomineeRelationshipInput", "BA_ageOfNomineeInput", "B_nameOfInsurerInput", "BA_mobileNumberInput"];
window.insurerFields = ['A_nameOfInsurerInput', 'B_nameOfInsurerInput', 'CA_nameOfInsurerInput', 'CC_nameOfInsurerInput'];
var hasCustNominee; // Swaroop changes New KM Sourcing 7th june 2026
var pendingInsuranceWrapperList = null;
apz.app.onLoad_Insurancedetails = function () {
};
apz.app.onShown_Insurancedetails = function () {
    if (Array.isArray(inSessionStore?.insuranceDetailsWrapperList)) {
        inSessionStore.insuranceDetailsWrapperList.forEach(item => {
            if (item.insuranceDetails && typeof item.insuranceDetails.payload === 'string' && item.insuranceDetails.payload !== '') {
                try {
                    item.insuranceDetails.payload = JSON.parse(item.insuranceDetails.payload);
                } catch(e) {
                    ApzCOB.traceFrontEndError(e,"");
                    console.error("Error parsing insurance payload in onShown_Insurancedetails:", e);
                }
            }
        });
    }
    if (Array.isArray(inSessionStore?.insuranceDetailsWrapperList) && inSessionStore.insuranceDetailsWrapperList.length > 1) {
        let appEntries = inSessionStore.insuranceDetailsWrapperList.filter(item => 
            item.insuranceDetails?.insuredCustType === 'Applicant' || 
            item.insuranceDetails?.payload?.insuredName === 'Applicant'
        );
        if (appEntries.length > 1) {
            let chosenEntry = appEntries.find(item => item.insuranceDetails?.insuranceType === 'applicant' || item.insuranceDetails?.payload?.insuranceOption === 'Applicant') || appEntries[0];
            inSessionStore.insuranceDetailsWrapperList = inSessionStore.insuranceDetailsWrapperList.filter(item => 
                !(item.insuranceDetails?.insuredCustType === 'Applicant' || item.insuranceDetails?.payload?.insuredName === 'Applicant') ||
                item === chosenEntry
            );
        }
    }
    $(`#${insuranceDetailsScrId}el_rdo_1`).addClass('disabled');
    insurerFields.forEach(el => {
        $(`#${insuranceDetailsScrId + el}_grp_lbl`).addClass('req');
    })
    // Swaroop changes New KM Sourcing 7th june 2026
    // const insuranceType = inSessionStore?.insuranceDetailsWrapperList?.find(item => item?.insuranceDetails?.insuranceType)?.insuranceDetails?.insuranceType || "";
    let insuranceType = '';
    if (apz.app.Insurancedetails.isNewInsuranceFlow()) {
        const insEntry = inSessionStore?.insuranceDetailsWrapperList
        ?.find(item => item?.insuranceDetails?.insuredCustType === 'Applicant')
        ?.insuranceDetails
        || inSessionStore?.insuranceDetailsWrapperList?.[0]?.insuranceDetails;
        const insType   = insEntry?.insuranceType || '';
        const insOption = (insEntry?.payload?.insuranceOption || '').toLowerCase();

        // insuranceOption takes priority if it explicitly says noinsurance
        // handles stale data where insuranceType was saved incorrectly
        if (insOption === 'noinsurance' || insOption === 'no insurance') {
            radio = 'No insurance';
        } else if (insType === 'jointInsurance' || insType === 'bothInsurance') {
            radio = 'Both';
        } else if (insType === 'applicant') {
            radio = 'Applicant';
        } else if (insType === 'noInsurance') {
            radio = 'No insurance';
        } else if (insOption === 'joint' || insOption === 'both') {
            radio = 'Both';
        } else if (insOption === 'applicant') {
            radio = 'Applicant';
        } else {
            radio = 'Applicant'; // safe default
        }
        insuranceType = radio;
    } else {
        // Old flow — derive from insuranceOption in any entry's payload
        const insuranceOption = inSessionStore?.insuranceDetailsWrapperList
            ?.find(item => item?.insuranceDetails?.payload?.insuranceOption)
            ?.insuranceDetails?.payload?.insuranceOption || '';
        // Map old option values to the type strings insuranceTypeNewKMSourcing expects
        const optionToTypeMap = {
            'Joint':        'bothInsurance',
            'Both':         'bothInsurance',
            'Applicant':    'applicant',
            'No insurance': 'noInsurance',
            'Noinsurance':  'noInsurance'
        };
        insuranceType = optionToTypeMap[insuranceOption] || '';
    }
    // hasCustNominee = inSessionStore.insuranceDetailsWrapperList?.some(
    //     item => item.insuranceDetails?.insuredCustType === "Cust-Nominee"
    // );
    hasCustNominee = apz.app.Insurancedetails.isNewInsuranceFlow() &&
    inSessionStore.insuranceDetailsWrapperList?.some(
        item => item.insuranceDetails?.insuredCustType === "Cust-Nominee"
    );
    hasCustNominee = false;
    if (hasCustNominee) {
        $('#CrdAss__Insurancedetails__el_rdo_2_option_Y').prop('checked', true);
    }
    apz.app.Insurancedetails.insuranceTypeNewKMSourcing(insuranceType);
    $('input').attr('autocomplete', 'off');
    apz.app.Insurancedetails.insurancePremium();
    let sectionDetected = false;
    // let applicantRadio = document.querySelector('input[type="radio"][value="Applicant"]');
    // if (applicantRadio) {
    //     applicantRadio.checked = true;
    //     apz.app.Insurancedetails.changeSection('Applicant')
    // }
    inSessionStore.insuranceDetailsWrapperList.forEach(function (k, i) {
        const ins = inSessionStore.insuranceDetailsWrapperList[i].insuranceDetails;
        const payload = ins?.payload;
        const insuredName = payload?.insuredName?.toLowerCase();
        const custType = ins?.insuredCustType;

        const isApplicantEntry = apz.app.Insurancedetails.isNewInsuranceFlow() ? (custType === 'Applicant') : (insuredName === 'applicant' || insuredName === 'no insurance' || ins?.insuranceType === 'noInsurance');
        if (isApplicantEntry && !sectionDetected) {
            let radio = '';
            if (apz.app.Insurancedetails.isNewInsuranceFlow()) {
                // New flow — derive section from insuranceType on the object, not payload fields
                const insType = ins?.insuranceType || '';
                if (insType === 'jointInsurance' || insType === 'bothInsurance') {
                    radio = 'Both';
                } else if (insType === 'applicant') {
                    radio = 'Applicant';
                } else if (insType === 'noInsurance') {
                    radio = 'No insurance';
                } else if (payload?.insuranceOption) {
                    // fallback to insuranceOption if insuranceType missing
                    radio = payload.insuranceOption === 'Joint' ? 'Both' : payload.insuranceOption;
                } else {
                    radio = 'Applicant'; // safe default for new flow
                }
            } else {
                // Old flow — original logic unchanged
                if (payload?.insuranceOption) {
                    radio = payload.insuranceOption === 'Joint' ? 'Both' : payload.insuranceOption;
                } else if (payload?.insuranceReqd === 'Y') {
                    radio = (payload.coApplicantInsurance === 'Yes') ? 'Both' : 'Applicant';
                } else {
                    radio = 'No insurance';
                }
            }
            let radioKey = radio;
            if (apz.app.Insurancedetails.isNewInsuranceFlow()) {
                if (radio === 'Both') {
                    radioKey = 'Both';
                } else if (radio === 'No insurance') {
                    radioKey = 'Noinsurance';
                }
            } else {
                if (radio === 'No insurance') {
                    radioKey = 'Noinsurance';
                }
            }
            $('#CrdAss__Insurancedetails__el_rdo_1_option_' + radioKey).prop('checked', true);
            currSection = radio;
            apz.app.Insurancedetails.changeSection(radio);
            sectionDetected = true;
        }

        // Detect Joint section from any joint entry
        if ((insuredName === 'joint' || insuredName === 'both') && !sectionDetected) {
            let radio = 'Both';
            const radioKey = 'Both';
            $('#CrdAss__Insurancedetails__el_rdo_1_option_' + radioKey).prop('checked', true);
            currSection = radio;
            apz.app.Insurancedetails.changeSection(radio);
            sectionDetected = true;
        }
    });

    apz.app.Insurancedetails.populateDropdownValues();
    apz.app.Insurancedetails.paintInsuranceDetails();
    apz.app.Cabase.hideShowBtnBasedOnScreen();
    fieldsToDisableEnable.forEach((field) => ApzCOB.addDisableToInput(`${insuranceDetailsScrId}${field}`));
    window.CA_CURRENT_STAGE_NO = CA_ALL_STAGE_FIELDS.find(stage => stage.stageName === CA_CURRENT_STAGE)?.id;
    $('#scr__CrdAss__Insurancedetails__main .hasDatepicker').prop('disabled', true);
    $('#scr__CrdAss__Insurancedetails__main input.hasDatepicker').datepicker("option", {
        maxDate: Date.parse(DATE_TODAY),
        yearRange: "-100:+0"
    });
    apz.app.Insurancedetails.setMinMaxLength();
};
apz.app.Insurancedetails.isNewInsuranceFlow = function () {
    var flag = inSessionStore?.applicationMaster?.assignedTo;
    if (flag === 'Y') return true;
    if (flag === 'N') return false;

    // Fallback — new data always has insuredCustType on at least one entry
    return inSessionStore.insuranceDetailsWrapperList?.some(
        item => !apz.isNull(item?.insuranceDetails?.insuredCustType)
    ) || false;
};
apz.app.Insurancedetails.getCustType = function (insuranceDetails) {
    let type = insuranceDetails?.insuredCustType;
    if (type) {
        return type;
    }
    // Fallback/Old flow — map insuredName → custType
    const insuredName = (insuranceDetails?.payload?.insuredName || '').toLowerCase();
    if (insuredName === 'applicant' || insuredName === 'no insurance' || insuranceDetails?.insuranceType === 'noInsurance') return 'Applicant';
    if (insuredName === 'co-app' || insuredName === 'co-applicant') return 'Co-App';
    return '';
};
apz.app.Insurancedetails.setMinMaxLength = function () {
    const fieldMap = {
        A_nomineeInsurenceInput: "Nominee",
        CA_nomineeInsurenceInput: "Nominee",
        CC_nomineeInsurenceInput: "Nominee",
        BA_nomineeInsurenceInput: "Nominee",
        BC_nomineeInsurenceInput: "Nominee",
        BA_mobileNumberInput: "MobileNumber"
    };
    ApzCOB.setMinMaxLength(Object.entries(fieldMap).map(([fieldId, fieldName]) => ({
        fieldName,
        fieldId: insuranceDetailsScrId + fieldId
    })));
};
apz.app.Insurancedetails.paintInsuranceDetails = function () {
    hasCustNominee = apz.app.Insurancedetails.isNewInsuranceFlow() &&
    inSessionStore.insuranceDetailsWrapperList?.some(
        item => item.insuranceDetails?.insuredCustType === "Cust-Nominee"
    );
    hasCustNominee = false;
    let nomineeDOB = '';
    // let loanAmt = inSessionStore.loanDetails.loanAmount;
    let loanAmt = ApzCOB.getPayloadDatafromWrapper('eligibleAmt','Co-App','cibilDetailsWrapperList');
    if (!loanAmt || parseInt(String(loanAmt).replace(/,/g, '')) == 0) {
        loanAmt = ApzCOB.getPayloadDatafromWrapper('eligibleAmt','Applicant','cibilDetailsWrapperList');
    }
    if (!loanAmt || parseInt(String(loanAmt).replace(/,/g, '')) == 0) {
        loanAmt = inSessionStore?.loanDetails?.loanAmount || inSessionStore?.loanDetails?.payload?.loanAmount;
    }
    if (!loanAmt || parseInt(String(loanAmt).replace(/,/g, '')) == 0) {
        loanAmt = inSessionStore.insuranceDetailsWrapperList?.find(
            item => item.insuranceDetails?.payload?.loanAmount
        )?.insuranceDetails?.payload?.loanAmount;
    }
    let parsedLoanAmt = parseInt(String(loanAmt || "").replace(/,/g, '')) || 0;
    if (parsedLoanAmt === 0 || parsedLoanAmt > 200000) {
        parsedLoanAmt = 200000;
    }
    loanAmt = parsedLoanAmt;
    let applicantInsuranceDetails, CoAppInsuranceDetails;
    if (inSessionStore.insuranceDetailsWrapperList.length > 0) {
        // inSessionStore.insuranceDetailsWrapperList.forEach(function (k, i) {
        //     if (inSessionStore.insuranceDetailsWrapperList[i].insuranceDetails.insuredCustType === 'Applicant') { // Swaroop changes New KM Sourcing 7th june 2026
        //         applicantInsuranceDetails = inSessionStore.insuranceDetailsWrapperList[i].insuranceDetails;
        //     } else if (inSessionStore.insuranceDetailsWrapperList[i].insuranceDetails.insuredCustType === 'Co-App') { // Swaroop changes New KM Sourcing 7th june 2026
        //         CoAppInsuranceDetails = inSessionStore.insuranceDetailsWrapperList[i].insuranceDetails;
        //         //} 
        //         // else if (inSessionStore.insuranceDetailsWrapperList[i].insuranceDetails.insuredCustType === 'Cust-Nominee') {
        //         //     CoAppInsuranceDetails = inSessionStore.insuranceDetailsWrapperList[i].insuranceDetails;
        //     } else {
        //         //
        //     }
        // })

        inSessionStore.insuranceDetailsWrapperList.forEach(function(k, i) {
            const resolvedCustType = apz.app.Insurancedetails.getCustType(inSessionStore.insuranceDetailsWrapperList[i].insuranceDetails);
            if (resolvedCustType === 'Applicant') {
                applicantInsuranceDetails = inSessionStore.insuranceDetailsWrapperList[i].insuranceDetails;
                if (apz.isNull(applicantInsuranceDetails?.payload?.insurerName)) {
                    if (applicantInsuranceDetails?.payload) {
                        applicantInsuranceDetails.payload.insurerName = PleaseSelect;
                    }
                }
            } else if (resolvedCustType === 'Co-App') {
                CoAppInsuranceDetails = inSessionStore.insuranceDetailsWrapperList[i].insuranceDetails;
                if (apz.isNull(CoAppInsuranceDetails?.payload?.insurerName)) {
                    if (CoAppInsuranceDetails?.payload) {
                        CoAppInsuranceDetails.payload.insurerName = PleaseSelect;
                    }
                }
                //} 
                // else if (inSessionStore.insuranceDetailsWrapperList[i].insuranceDetails.insuredCustType === 'Cust-Nominee') {
                //     CoAppInsuranceDetails = inSessionStore.insuranceDetailsWrapperList[i].insuranceDetails;
            } else {
                // if(inSessionStore.insuranceDetailsWrapperList[i].insuranceDetails.payload.insuredName === 'Joint') {
            //    JointApplicationDetails =  inSessionStore.insuranceDetailsWrapperList[i].insuranceDetails;
            }
        });
        $(`#${insuranceDetailsScrId}A_sumAssuredInput`).val(ApzCOB.formatamountVal(loanAmt))
        $(`#${insuranceDetailsScrId}A_nameOfInsurerInput`).val(applicantInsuranceDetails?.payload?.insurerName ?? PleaseSelect).change();
        // $(`#${insuranceDetailsScrId}A_nameOfInsurerInput`).val('CreditAccess Life Insurance');
        let custNomineeData = null;
        if (apz.app.Insurancedetails.isNewInsuranceFlow()) {
            custNomineeData = inSessionStore?.insuranceDetailsWrapperList?.find(
                item => item?.insuranceDetails?.insuredCustType === "Cust-Nominee"
            )?.insuranceDetails?.payload;
            custNomineeData = '';
            if (!custNomineeData) {
                custNomineeData = applicantInsuranceDetails?.payload;
            }
        } else {
            if (currSection === 'Applicant') {
                custNomineeData = applicantInsuranceDetails?.payload;
            } else {
                custNomineeData = inSessionStore?.insuranceDetailsWrapperList?.find(
                    item => {
                        const name = item?.insuranceDetails?.payload?.insuredName;
                        return name === "Joint" || name === "JOINT" || name === "Both" || name === "BOTH";
                    }
                )?.insuranceDetails?.payload;
            }
        }
        if (!custNomineeData) {
            custNomineeData = applicantInsuranceDetails?.payload;
        }
        let nomineeAdded = 'Y';
        let appNomAdded = applicantInsuranceDetails?.payload?.nomineeAdded;
        let coNomAdded = CoAppInsuranceDetails?.payload?.nomineeAdded;
        
        if (currSection === 'Both' || currSection === 'Joint') {
            if (appNomAdded === 'N' || coNomAdded === 'N' || appNomAdded === 'No' || coNomAdded === 'No' || !appNomAdded || !coNomAdded) {
                nomineeAdded = 'N';
            } else {
                nomineeAdded = 'Y';
            }
        } else {
            nomineeAdded = appNomAdded || 'N';
        }
        
        // If it's old flow and we still don't have nomineeAdded in payload, fallback to checking nomineeName
        if (!apz.app.Insurancedetails.isNewInsuranceFlow() && (appNomAdded === undefined || appNomAdded === null)) {
            if (custNomineeData?.nomineeName || applicantInsuranceDetails?.payload?.nomineeName) {
                nomineeAdded = "Yes";
            } else {
                nomineeAdded = "No";
            }
        }
        let jointInsurRadioBtn = (nomineeAdded === "Yes" || nomineeAdded === "Y") ? "Y" : "N";
        jointInsurRadioBtn = 'N';
        $('#CrdAss__Insurancedetails__el_rdo_2_option_N').prop('checked', true); // Remove custNominee
        if (jointInsurRadioBtn === "Y") {
            $('#CrdAss__Insurancedetails__el_rdo_2_option_Y').prop('checked', true);
        } else {
            $('#CrdAss__Insurancedetails__el_rdo_2_option_N').prop('checked', true);
        }
        apz.app.Insurancedetails.jointRadio(jointInsurRadioBtn);

        // Nominee Data Painting based on toggle
        if (currSection === 'Applicant') {
            if (jointInsurRadioBtn === 'Y') {
                // Paint in Cust-Nominee (BA_ fields)
                if (custNomineeData) {
                    $(`#${insuranceDetailsScrId}BA_nomineeInsurenceInput`).val(custNomineeData.nomineeName || '');
                    nomineeDOB = apz.app.Insurancedetails.changeDOBFormat(custNomineeData.nomineeDob);
                    $(`#${insuranceDetailsScrId}BA_dobInput`).val(nomineeDOB || '');
                    $(`#${insuranceDetailsScrId}BA_genderInput`).val(custNomineeData.gender || '');
                    $(`#${insuranceDetailsScrId}BA_nomineeRelationshipInput`).val(custNomineeData.nomineeRelation || '');
                    $(`#${insuranceDetailsScrId}BA_ageOfNomineeInput`).val(custNomineeData.age || '');
                    $(`#${insuranceDetailsScrId}BA_mobileNumberInput`).val(custNomineeData.mobileNumber || '');
                }
                // Clear Applicant side (A_ fields)
                $(`#${insuranceDetailsScrId}A_nomineeInsurenceInput`).val('');
                $(`#${insuranceDetailsScrId}A_dobInput`).val('');
                $(`#${insuranceDetailsScrId}A_genderInput`).val('');
                $(`#${insuranceDetailsScrId}A_nomineeRelationshipInput`).val('');
                $(`#${insuranceDetailsScrId}A_ageOfNomineeInput`).val('');
            } else {
                // Paint in Applicant side (A_ fields)
                if (custNomineeData) {
                    $(`#${insuranceDetailsScrId}A_nomineeInsurenceInput`).val(custNomineeData.nomineeName || '');
                    nomineeDOB = apz.app.Insurancedetails.changeDOBFormat(custNomineeData.nomineeDob);
                    $(`#${insuranceDetailsScrId}A_dobInput`).val(nomineeDOB || '');
                    $(`#${insuranceDetailsScrId}A_genderInput`).val(custNomineeData.gender || '');
                    $(`#${insuranceDetailsScrId}A_nomineeRelationshipInput`).val(custNomineeData.nomineeRelation || '');
                    $(`#${insuranceDetailsScrId}A_ageOfNomineeInput`).val(custNomineeData.age || '');
                }
                // Clear Cust-Nominee (BA_ fields)
                $(`#${insuranceDetailsScrId}BA_nomineeInsurenceInput`).val('');
                $(`#${insuranceDetailsScrId}BA_dobInput`).val('');
                $(`#${insuranceDetailsScrId}BA_genderInput`).val('');
                $(`#${insuranceDetailsScrId}BA_nomineeRelationshipInput`).val('');
                $(`#${insuranceDetailsScrId}BA_ageOfNomineeInput`).val('');
                $(`#${insuranceDetailsScrId}BA_mobileNumberInput`).val('');
            }
        } else if (currSection === 'Both' || currSection === 'Joint') {
            if (jointInsurRadioBtn === 'Y') {
                // Paint in Cust-Nominee (BA_ and BC_ fields)
                if (custNomineeData) {
                    $(`#${insuranceDetailsScrId}BA_nomineeInsurenceInput`).val(custNomineeData.nomineeName || '');
                    nomineeDOB = apz.app.Insurancedetails.changeDOBFormat(custNomineeData.nomineeDob);
                    $(`#${insuranceDetailsScrId}BA_dobInput`).val(nomineeDOB || '');
                    $(`#${insuranceDetailsScrId}BA_genderInput`).val(custNomineeData.gender || '');
                    $(`#${insuranceDetailsScrId}BA_nomineeRelationshipInput`).val(custNomineeData.nomineeRelation || '');
                    $(`#${insuranceDetailsScrId}BA_ageOfNomineeInput`).val(custNomineeData.age || '');
                    $(`#${insuranceDetailsScrId}BA_mobileNumberInput`).val(custNomineeData.mobileNumber || '');
                }
                if (CoAppInsuranceDetails?.payload) {
                    $(`#${insuranceDetailsScrId}BC_nomineeInsurenceInput`).val(CoAppInsuranceDetails.payload.nomineeName || '');
                    nomineeDOB = apz.app.Insurancedetails.changeDOBFormat(CoAppInsuranceDetails.payload.nomineeDob);
                    $(`#${insuranceDetailsScrId}BC_dobInput`).val(nomineeDOB || '');
                    $(`#${insuranceDetailsScrId}BC_nomineeRelationshipInput`).val(CoAppInsuranceDetails.payload.nomineeRelation || '');
                    $(`#${insuranceDetailsScrId}BC_ageOfNomineeInput`).val(CoAppInsuranceDetails.payload.age || '');
                    $(`#${insuranceDetailsScrId}BC_genderInput`).val(CoAppInsuranceDetails.payload.gender || '');
                }
                // Clear Applicant side (CA_ and CC_ fields)
                $(`#${insuranceDetailsScrId}CA_nomineeInsurenceInput`).val('');
                $(`#${insuranceDetailsScrId}CA_dobInput`).val('');
                $(`#${insuranceDetailsScrId}CA_genderInput`).val('');
                $(`#${insuranceDetailsScrId}CA_nomineeRelationshipInput`).val('');
                $(`#${insuranceDetailsScrId}CA_ageOfNomineeInput`).val('');
                $(`#${insuranceDetailsScrId}CC_nomineeInsurenceInput`).val('');
                $(`#${insuranceDetailsScrId}CC_dobInput`).val('');
                $(`#${insuranceDetailsScrId}CC_genderInput`).val('');
                $(`#${insuranceDetailsScrId}CC_nomineeRelationshipInput`).val('');
                $(`#${insuranceDetailsScrId}CC_ageOfNomineeInput`).val('');
            } else {
                // Paint in Applicant side (CA_ and CC_ fields)
                if (custNomineeData) {
                    $(`#${insuranceDetailsScrId}CA_nomineeInsurenceInput`).val(custNomineeData.nomineeName || '');
                    nomineeDOB = apz.app.Insurancedetails.changeDOBFormat(custNomineeData.nomineeDob);
                    $(`#${insuranceDetailsScrId}CA_dobInput`).val(nomineeDOB || '');
                    $(`#${insuranceDetailsScrId}CA_genderInput`).val(custNomineeData.gender || '');
                    $(`#${insuranceDetailsScrId}CA_nomineeRelationshipInput`).val(custNomineeData.nomineeRelation || '');
                    $(`#${insuranceDetailsScrId}CA_ageOfNomineeInput`).val(custNomineeData.age || '');
                }
                if (CoAppInsuranceDetails?.payload) {
                    $(`#${insuranceDetailsScrId}CC_nomineeInsurenceInput`).val(CoAppInsuranceDetails.payload.nomineeName || '');
                    nomineeDOB = apz.app.Insurancedetails.changeDOBFormat(CoAppInsuranceDetails.payload.nomineeDob);
                    $(`#${insuranceDetailsScrId}CC_dobInput`).val(nomineeDOB || '');
                    $(`#${insuranceDetailsScrId}CC_nomineeRelationshipInput`).val(CoAppInsuranceDetails.payload.nomineeRelation || '');
                    $(`#${insuranceDetailsScrId}CC_ageOfNomineeInput`).val(CoAppInsuranceDetails.payload.age || '');
                    $(`#${insuranceDetailsScrId}CC_genderInput`).val(CoAppInsuranceDetails.payload.gender || '');
                }
                // Clear Cust-Nominee (BA_ and BC_ fields)
                $(`#${insuranceDetailsScrId}BA_nomineeInsurenceInput`).val('');
                $(`#${insuranceDetailsScrId}BA_dobInput`).val('');
                $(`#${insuranceDetailsScrId}BA_genderInput`).val('');
                $(`#${insuranceDetailsScrId}BA_nomineeRelationshipInput`).val('');
                $(`#${insuranceDetailsScrId}BA_ageOfNomineeInput`).val('');
                $(`#${insuranceDetailsScrId}BA_mobileNumberInput`).val('');
                $(`#${insuranceDetailsScrId}BC_nomineeInsurenceInput`).val('');
                $(`#${insuranceDetailsScrId}BC_dobInput`).val('');
                $(`#${insuranceDetailsScrId}BC_nomineeRelationshipInput`).val('');
                $(`#${insuranceDetailsScrId}BC_ageOfNomineeInput`).val('');
                $(`#${insuranceDetailsScrId}BC_genderInput`).val('');
            }
        }
        
        $(`#${insuranceDetailsScrId}CA_sumAssuredInput`).val(ApzCOB.formatamountVal(loanAmt));
        $(`#${insuranceDetailsScrId}CA_nameOfInsurerInput`).val(applicantInsuranceDetails?.payload?.insurerName ?? PleaseSelect).change();
        // $(`#${insuranceDetailsScrId}CA_nameOfInsurerInput`).val('CreditAccess Life Insurance');
        $(`#${insuranceDetailsScrId}CC_sumAssuredInput`).val(ApzCOB.formatamountVal(loanAmt));
        $(`#${insuranceDetailsScrId}CC_nameOfInsurerInput`).val(CoAppInsuranceDetails?.payload?.insurerName ?? PleaseSelect).change();
        // $(`#${insuranceDetailsScrId}CC_nameOfInsurerInput`).val('CreditAccess Life Insurance');
        //joint
        $(`#${insuranceDetailsScrId}B_sumAssuredInput`).val(ApzCOB.formatamountVal(loanAmt));
        // $(`#${insuranceDetailsScrId}B_nameOfInsurerInput`).val(CoAppInsuranceDetails?.payload?.insurerName ?? PleaseSelect).change();
        // $(`#${insuranceDetailsScrId}B_nameOfInsurerInput`).val('CreditAccess Life Insurance');
        let memberPrem = 0;
        let spousePrem = 0;
        try {
            let coAppCibil = inSessionStore?.cibilDetailsWrapperList?.filter(item => {
                let payload = item.cibilDetails?.payload;
                return payload && 
                       (payload.individualIndebtness !== undefined) && 
                       String(payload.individualIndebtness).toLowerCase().includes("co-applicant");
            })?.[0];
            if (!coAppCibil) {
                let coAppId = gApzCOB.userDetails?.CoApplicantCustomerId || ApzCOB.getCustDetailID("Co-App");
                coAppCibil = inSessionStore?.cibilDetailsWrapperList?.filter(item => {
                    return item.cibilDetails?.custDtlId == coAppId;
                })?.[0];
            }
            if (!coAppCibil) {
                coAppCibil = inSessionStore?.cibilDetailsWrapperList?.[1];
            }
            let payload = coAppCibil?.cibilDetails?.payload;
            memberPrem = parseFloat(String(payload?.insuranceChargeMember || "").replace(/,/g, '')) || 0;
            spousePrem = parseFloat(String(payload?.insuranceChargeSpouse || "").replace(/,/g, '')) || 0;
        } catch (e) {
            ApzCOB.traceFrontEndError(e,"");
            console.error("Error fetching premium from cibil:", e);
        }
        
        if (!memberPrem) {
            memberPrem = parseFloat(String(applicantInsuranceDetails?.payload?.insurancePremium || "").replace(/,/g, '')) || 0;
        }
        if (!spousePrem) {
            spousePrem = parseFloat(String(CoAppInsuranceDetails?.payload?.insurancePremium || "").replace(/,/g, '')) || 0;
        }

        $(`#${insuranceDetailsScrId}A_insurancePremiumInput`).val(ApzCOB.formatamountVal(memberPrem));
        $(`#${insuranceDetailsScrId}CA_insurancePremiumInput`).val(ApzCOB.formatamountVal(memberPrem));
        $(`#${insuranceDetailsScrId}CC_insurancePremiumInput`).val(ApzCOB.formatamountVal(spousePrem));
        $(`#${insuranceDetailsScrId}B_insurancePremiumInput`).val(ApzCOB.formatamountVal(memberPrem + spousePrem));
    }
    ApzCOB.addDisableToInput(`${insuranceDetailsScrId}A_genderInput`)
    ApzCOB.addDisableToInput(`${insuranceDetailsScrId}A_nomineeRelationshipInput`)
    ApzCOB.addDisableToInput(`${insuranceDetailsScrId}CA_genderInput`)
    ApzCOB.addDisableToInput(`${insuranceDetailsScrId}CA_nomineeRelationshipInput`)
    ApzCOB.addDisableToInput(`${insuranceDetailsScrId}CC_genderInput`)
    ApzCOB.addDisableToInput(`${insuranceDetailsScrId}CC_nomineeRelationshipInput`)
    ApzCOB.addDisableToInput(`${insuranceDetailsScrId}BA_genderInput`)
    ApzCOB.addDisableToInput(`${insuranceDetailsScrId}BA_nomineeRelationshipInput`)
    ApzCOB.addDisableToInput(`${insuranceDetailsScrId}BC_genderInput`)
    ApzCOB.addDisableToInput(`${insuranceDetailsScrId}BC_nomineeRelationshipInput`)
    ApzCOB.AddOrRemoveDisableFields([`${insuranceDetailsScrId}A_nameOfInsurerInput`,`${insuranceDetailsScrId}CA_nameOfInsurerInput`,`${insuranceDetailsScrId}CC_nomineeInsurenceInput`,`${insuranceDetailsScrId}B_nameOfInsurerInput`], true);
    $('#scr__CrdAss__Insurancedetails__main .hasDatepicker').prop('disabled', true);
    $('#scr__CrdAss__Insurancedetails__main input.hasDatepicker').datepicker("option", {
        maxDate: Date.parse(DATE_TODAY),
        yearRange: "-100:+0"
    });
};
apz.app.Insurancedetails.hideSections = function () {
    $(`#${insuranceDetailsScrId}Both`).addClass("sno");
    $(`#${insuranceDetailsScrId}Applicant`).addClass("sno");
    $(`#${insuranceDetailsScrId}Both2`).addClass("sno");
};
apz.app.Insurancedetails.getPremiumValue = function (section) {
    let premium = 0;
    try {
        let coAppCibil = inSessionStore?.cibilDetailsWrapperList?.filter(item => {
            let payload = item.cibilDetails?.payload;
            return payload && 
                   (payload.individualIndebtness !== undefined) && 
                   String(payload.individualIndebtness).toLowerCase().includes("co-applicant");
        })?.[0];
        if (!coAppCibil) {
            let coAppId = gApzCOB.userDetails?.CoApplicantCustomerId || ApzCOB.getCustDetailID("Co-App");
            coAppCibil = inSessionStore?.cibilDetailsWrapperList?.filter(item => {
                return item.cibilDetails?.custDtlId == coAppId;
            })?.[0];
        }
        if (!coAppCibil) {
            coAppCibil = inSessionStore?.cibilDetailsWrapperList?.[1];
        }
        let payload = coAppCibil?.cibilDetails?.payload;
        if (section === 'Applicant') {
            premium = payload?.insuranceChargeMember || 0;
        } else if (section === 'Both' || section === 'Joint') {
            let member = parseFloat(String(payload?.insuranceChargeMember || "").replace(/,/g, '')) || 0;
            let spouse = parseFloat(String(payload?.insuranceChargeSpouse || "").replace(/,/g, '')) || 0;
            premium = member + spouse;
        }
    } catch (e) {
        ApzCOB.traceFrontEndError(e,"");
        console.error("Error fetching premium from cibilDetailsWrapperList:", e);
    }
    let cleanVal = parseFloat(String(premium).replace(/,/g, '')) || 0;
    if (!cleanVal && window.insurancePremium) {
        if (section === 'Applicant') {
            cleanVal = parseFloat(String(window.insurancePremium.actualMemberPremium).replace(/,/g, '')) || 0;
        } else if (section === 'Both' || section === 'Joint') {
            cleanVal = parseFloat(String(window.insurancePremium.totalPremium).replace(/,/g, '')) || 0;
        }
    }
    return cleanVal;
};
apz.app.Insurancedetails.updateDetailsVisibility = function (section) {
    if (section === 'Applicant') {
        if (apz.app.Insurancedetails.isNewInsuranceFlow() && jointInsurRadioBtn === 'Y') {
            $(`#${insuranceDetailsScrId}Applicant`).addClass("sno");
        } else {
            $(`#${insuranceDetailsScrId}Applicant`).removeClass("sno");
        }
        $(`#${insuranceDetailsScrId}Both`).removeClass("sno");
        $(`#${insuranceDetailsScrId}Both2`).addClass("sno");
    } else if (section === 'Both' || section === 'Joint') {
        $(`#${insuranceDetailsScrId}Both`).removeClass("sno");
        if (jointInsurRadioBtn === 'Y') {
            $(`#${insuranceDetailsScrId}Both2`).addClass("sno");
        } else {
            $(`#${insuranceDetailsScrId}Both2`).removeClass("sno");
        }
        $(`#${insuranceDetailsScrId}Applicant`).addClass("sno");
    } else {
        $(`#${insuranceDetailsScrId}Applicant`).addClass("sno");
        $(`#${insuranceDetailsScrId}Both`).addClass("sno");
        $(`#${insuranceDetailsScrId}Both2`).addClass("sno");
    }
};
