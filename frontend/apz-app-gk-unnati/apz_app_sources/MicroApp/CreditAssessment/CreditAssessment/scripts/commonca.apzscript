apz.app.flipImage = function (imgid) {
    ApzCOB.imageAction('fit', imgid);
    let docLevel = $('#' + imgid).attr("doclevel")
    let custType = imgid.split("__")[2];
    let docType = imgid.split("__")[3];
    if (custType === 'A') {
        custDetailID = gApzCOB.userDetails.custDtlId;
    } else {
        custDetailID = gApzCOB.userDetails.CoApplicantCustomerId;
    }
    if (apz.childScr == "AddressContactus") {
        try {
            let personalAddress = inSessionStore?.addressDetailsWrapperList?.[0]?.addressDetailsList?.filter(
                (custAdd) => custAdd.addressType === "Personal" && custAdd.custDtlId == custDetailID
            )?.[0];
            if (personalAddress?.payload?.addressList) {
                let addressList = personalAddress.payload.addressList;
                let currentAddressProof = addressList.filter(item => item.addressType == "Present")?.[0]?.currentAddressProof?.toLowerCase() ?? "";
                if (currentAddressProof.includes("voter") || currentAddressProof.includes("kyc")) {
                    docType = "PRIMARY_KYC";
                }
            }
        } catch (err) {
            ApzCOB.traceFrontEndError(err,"");
            console.error("Error in flipImage checking ADDRESS_PROOF: ", err);
        }
    }
    if (docLevel === '1') {
        docLevel++;
    } else if (docLevel === '2') {
        docLevel--;
    }
    applicationData = inSessionStore.applicationDocumentsWrapperList[0].applicationDocumentsList?.filter(cust => cust.custDtlId ===
        custDetailID) || [];
    applicationData = applicationData.map(doc => {
        if (parseInt(doc.payload.docLevel) === docLevel && doc.payload.documentType === docType) {
            lobj = {};
            lobj.custType = custType;
            lobj.docType = docType;
            lobj.documentName = doc.payload.documentName;
            lobj.docLevel = doc.payload.docLevel;
            lobj.actualdocType = imgid.split("__")[3];
            window.ImageLocationDetails = {
                latitude: doc.payload.latitude || "",
                longitude: doc.payload.longitude || "",
                uploadedTs: doc.payload.uploadedTs || "",
                documentFileName: doc.payload.documentFileName || ""
            };
            ApzCOB.downloadFileFromServer(doc.payload.documentFileName, apz.app.flipImageCB);
        }
    })
}
apz.app.flipImageCB = function (params) {
    let imgPaintId;
    if (CURRENTSCREEN === "photokyc") {
        imgPaintId = "CrdAss__photokyc__";
    } else if (CURRENTSCREEN === "AddressContactus") {
        imgPaintId = "CrdAss__AddressContactus__";
    } else if (CURRENTSCREEN === "CaInPrincipleDecision") {
        imgPaintId = "CrdAss__CaInPrincipleDecision__";
    }
    if (!apz.isNull(params.base64)) {
        $(`#${imgPaintId}${lobj.custType}__${lobj.actualdocType}`).attr('src', 'data:image/png;base64,' + params.base64);
        $(`#${imgPaintId}${lobj.custType}__${lobj.actualdocType}`).attr("documentName", `${lobj.documentName}`);
        $(`#${imgPaintId}${lobj.custType}__${lobj.actualdocType}`).attr("docLevel", `${lobj.docLevel}`);
        let id = `#${imgPaintId}${lobj.custType}__${lobj.actualdocType}`;
        if (Object.keys(window.ImageLocationDetails).length > 0) {
            apz.app.BaseScreens.paintImageLocationDetails(id, window.ImageLocationDetails);
        }
        apz.app.paintDocumentNameLabel(imgPaintId); // Chinna Added 12/06/2026
    } else {
        ApzCOB.fnDisplayMsg("File not found", "E");
    }
    apz.stopLoader();
}
// Chinna changes start 12/06/2026
apz.app.paintDocumentNameLabel = function (imgPaintId) {
    switch (CURRENTSCREEN) {
        case "photokyc":
            if (lobj.custType === "A" && lobj.docType === "PRIMARY_KYC") {
                $("#CrdAss__photokyc__applicVotDName_txtcnt").text(lobj.documentName);
            } else if (lobj.custType === "C" && lobj.docType === "PRIMARY_KYC") {
                $("#CrdAss__photokyc__coapplicVotDName_txtcnt").text(lobj.documentName);
            } else if (lobj.custType === "C" && lobj.docType === "RELATIONSHIP_PROOF") {
                $("#CrdAss__photokyc__rShipDVoter_txtcnt").text(lobj.documentName);
            }
            break;
        case "AddressContactus":
            if (lobj.custType === "A" && (lobj.docType === "ADDRESS_PROOF" || lobj.docType === "PRIMARY_KYC")) {
                $("#CrdAss__AddressContactus__addreContDeDName_txtcnt").text(lobj.documentName);
            }
            break;
        case "CaInPrincipleDecision":
            if (lobj.custType === "A" && lobj.docType === "PRIMARY_KYC") {
                $("#CrdAss__CaInPrincipleDecision__pKycApplicReVotDocName_txtcnt").text(lobj.documentName);
            } else if (lobj.custType === "C" && lobj.docType === "PRIMARY_KYC") {
                $("#CrdAss__CaInPrincipleDecision__pKycC0ApplicReVotDocName_txtcnt").text(lobj.documentName);
            } else if (lobj.custType === "A" && lobj.docType === "RELATIONSHIP_PROOF") {
                $("#CrdAss__CaInPrincipleDecision__caPreDesRelationDocName_txtcnt").text(lobj.documentName);
            } else if (lobj.custType === "A" && lobj.docType === "ADDRESS_PROOF") {
                $("#CrdAss__CaInPrincipleDecision__caPreCddreContDocName_txtcnt").text(lobj.documentName);
            }
            break;
    }
};
