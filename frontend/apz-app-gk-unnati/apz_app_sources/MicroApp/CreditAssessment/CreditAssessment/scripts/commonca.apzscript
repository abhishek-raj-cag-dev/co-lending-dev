        //             $("#CrdAss__AddressContactus__el_txt_38_txtcnt").text(lobj.documentName);
        //         }
        //         break;
        //     case "CaInPrincipleDecision":
        //         if (lobj.custType === "A" && lobj.docType === "PRIMARY_KYC") {
