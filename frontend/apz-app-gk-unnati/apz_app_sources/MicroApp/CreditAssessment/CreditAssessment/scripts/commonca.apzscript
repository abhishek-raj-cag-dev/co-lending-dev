var imageIDs = [];
var lobj = {};
var imgIndex = 0;
var imgArray = [];
apz.app.commonca.fetchImageIds = function () {
    imgArray = [];
    imgIndex = 0;
    imageIDs = document.querySelectorAll(".kycdocs img")
    Array.from(imageIDs).forEach(img => {
        let obj = {};
        obj.custType = img.id.split('__')[2];
        obj.docType = img.id.split('__')[3];
        obj.ActualdocType = img.id.split('__')[3];
        if (apz.childScr == "AddressContactus") {
            let custDetailID;
            if (obj.custType === 'A') {
                custDetailID = gApzCOB.userDetails.custDtlId;
            } else {
                custDetailID = gApzCOB.userDetails.CoApplicantCustomerId;
            }

            const addressList = inSessionStore?.addressDetailsWrapperList?.[0]
                ?.addressDetailsList
                ?.find(custAdd => custAdd.addressType === "Personal" && custAdd.custDtlId == custDetailID)
                ?.payload?.addressList || [];

            const currentAddressProof = addressList.find(item => item.addressType == "Present")?.currentAddressProof?.toLowerCase() ?? "";

            if (currentAddressProof.includes("voter") || currentAddressProof.includes("kyc")) {
                obj.docType = "PRIMARY_KYC";
            }
        }
        imgArray.push(obj);
    });
    if (imgArray.length > 0) {
        apz.app.paintDocuments(imgArray[imgIndex].custType, imgArray[imgIndex].docType, imgArray[imgIndex].ActualdocType);
    }
}
apz.app.paintDocuments = function (custType, docType, ActualdocType) {
    let custDetailID;
    if (custType === 'A') {
        custDetailID = gApzCOB.userDetails.custDtlId;
    } else {
        custDetailID = gApzCOB.userDetails.CoApplicantCustomerId;
    }
    if (docType === "RELATIONSHIP_PROOF") {
        let docs = inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList?.filter(
            doc => doc.payload.documentType === "RELATIONSHIP_PROOF" && doc.payload.docLevel === '1'
        ) || [];
        let matchingDoc = docs.find(doc => doc.custDtlId == custDetailID);
        if (!matchingDoc && docs.length > 0) {
            matchingDoc = docs[0];
            custDetailID = matchingDoc.custDtlId;
        }
    }
    let applicationData = [];
    applicationData = inSessionStore?.applicationDocumentsWrapperList?.[0]?.applicationDocumentsList?.filter(
        cust => cust.custDtlId === custDetailID
    ) || [];

    let matchingDoc = applicationData.find(appDoc => {
        if (appDoc.payload.documentType === docType && appDoc.payload.docLevel === '1') {
            return true;
        }
        if (appDoc.payload.documentType === docType && appDoc.payload.documentName === 'Voter Back' && apz.childScr === 'AddressContactus') {
            return true;
        }
        return false;
    });

    if (!matchingDoc) {
        imgIndex++;
        if (imgIndex < imgArray.length) {
            apz.app.paintDocuments(imgArray[imgIndex].custType, imgArray[imgIndex].docType, imgArray[imgIndex].ActualdocType);
        }
    } else {
        lobj = {};
        lobj.custType = custType;
        lobj.docType = docType;
        lobj.documentName = matchingDoc.payload.documentName;
        lobj.docLevel = matchingDoc.payload.docLevel;
        lobj.documentFileName = matchingDoc.payload.documentFileName;
        lobj.actualdocType = ActualdocType;
        window.ImageLocationDetails = {
            latitude: matchingDoc.payload.latitude || "",
            longitude: matchingDoc.payload.longitude || "",
            uploadedTs: matchingDoc.payload.uploadedTs || "",
            documentFileName: matchingDoc.payload.documentFileName || ""
        };
        ApzCOB.downloadFileFromServer(lobj.documentFileName, apz.app.paintDocumentsCB);
    }
};
apz.app.paintDocumentsCB = function (params) {
